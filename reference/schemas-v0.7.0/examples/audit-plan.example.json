      "base_r_parse_data_when_available"
    ],
    "record_parser_coverage": true
  },
  "provenance": {
    "actor": {
      "actor_id": "sc_referee.core",
      "actor_kind": "controller",
      "display_name": "sc-referee controller"
    },
    "created_at": "2026-07-27T23:30:00Z",
    "method": "deterministic_controller",
    "source_refs": [],
    "tool": "sc_referee.core",
    "tool_version": "0.5.0"
  },
  "question_policy": {
    "ask_only_material": true,
    "batch_questions": true,
    "maximum_interactive_rounds": 1,
    "unanswered_behavior": "preserve_unknown_and_continue"
  },
  "record_type": "audit_plan",
  "report_policy": {

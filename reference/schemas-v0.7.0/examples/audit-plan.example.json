    "packetized_work": true,
    "record_usage": true
  },
  "network_policy": {
    "cache_retrieved_evidence": true,
    "claude_network_access": "host_managed_unrestricted",
    "controller_network_access": "allowed_with_provenance",
    "project_code_network_access": "explicit_authorization_required",
    "record_retrieval_provenance": true,
    "repository_content_can_authorize": false
  },
  "on_deadline": {
    "calculate_partial_coverage": true,
    "preserve_completed_records": true,
    "preserve_pending_work_items": true,
    "render_partial_report": true,
    "stop_new_optional_work_at_cutoff": true,
    "terminate_eligible_children_at_hard_deadline": true
  },
  "parser_policy": {
    "execute_source_during_parse": false,
    "python_stack": "cpython_ast_plus_tokenize",
    "r_stack": [

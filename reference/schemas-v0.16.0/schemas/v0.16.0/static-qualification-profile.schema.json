{
  "$id": "https://w3id.org/sc-referee/schema/v0.16.0/static-qualification-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "bounded_report_mean_direction_v1"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "properties": {
          "selection_rules": {
            "properties": {
              "candidate_suffixes": {
                "const": [
                  ".csv",
                  ".md",
                  ".py"
                ]
              },
              "dependency_closure": {
                "const": "unique_supported_csv_mean_writer_report_transitive_path"
              },
              "surface_inventory": {
                "const": "every_literal_directional_sentence_in_complete_selected_report"
              }
            }
          },
          "target_detector": {
            "properties": {
              "detector_id": {
                "const": "detector:bounded-report-mean-direction"
              },
              "detector_version": {
                "const": "0.1.0"
              }
            }
          },
          "verifier": {
            "properties": {
              "entry_point": {
                "const": "sc_referee_evaluation.static_qualification:verify_bounded_direction_case"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "bounded_analysis_method_conflict_v1"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "properties": {
          "selection_rules": {
            "properties": {
              "candidate_suffixes": {
                "const": [
                  ".md",
                  ".py"
                ]
              },
              "dependency_closure": {
                "const": "unique_supported_founder_operand_writer_selected_report_path"
              },
              "surface_inventory": {
                "const": "every_closed_founder_orientation_declaration_in_selected_report_and_python_candidates"
              }
            }
          },
          "target_detector": {
            "properties": {
              "detector_id": {
                "const": "detector:bounded-analysis-method-conflict"
              },
              "detector_version": {
                "const": "0.1.0"
              }
            }
          },
          "verifier": {
            "properties": {
              "entry_point": {
                "const": "sc_referee_evaluation.analysis_method_qualification:verify_bounded_analysis_method_case"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_files": {
          "minimum": 1,
          "type": "integer"
        },
        "max_elapsed_milliseconds": {
          "minimum": 1,
          "type": "integer"
        },
        "max_recursion_depth": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_candidate_files",
        "max_total_bytes",
        "max_recursion_depth",
        "max_elapsed_milliseconds"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^x-"
      },
      "type": "object"
    },
    "frozen_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Timestamp"
    },
    "profile_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
    },
    "profile_kind": {
      "enum": [
        "bounded_report_mean_direction_v1",
        "bounded_analysis_method_conflict_v1"
      ]
    },
    "profile_semantic_digest": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
    },
    "profile_version": {
      "const": "1.0.0"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "static_qualification_profile"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/SchemaVersion"
    },
    "selection_protocol_artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
        },
        "artifact_kind": {
          "const": "corpus_selection_protocol"
        },
        "content_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "content_digest"
      ],
      "type": "object"
    },
    "selection_rules": {
      "additionalProperties": false,
      "properties": {
        "candidate_enumeration": {
          "const": "all_matching_regular_files_in_snapshot_sorted_by_path"
        },
        "candidate_suffixes": {
          "enum": [
            [
              ".csv",
              ".md",
              ".py"
            ],
            [
              ".md",
              ".py"
            ]
          ]
        },
        "dependency_closure": {
          "enum": [
            "unique_supported_csv_mean_writer_report_transitive_path",
            "unique_supported_founder_operand_writer_selected_report_path"
          ]
        },
        "parser_completeness": {
          "const": "strict_utf8_full_bytes_supported_grammar_or_unavailable"
        },
        "report_path_source": {
          "const": "opaque_case_assignment_manifest"
        },
        "surface_inventory": {
          "enum": [
            "every_literal_directional_sentence_in_complete_selected_report",
            "every_closed_founder_orientation_declaration_in_selected_report_and_python_candidates"
          ]
        }
      },
      "required": [
        "candidate_suffixes",
        "candidate_enumeration",
        "dependency_closure",
        "parser_completeness",
        "report_path_source",
        "surface_inventory"
      ],
      "type": "object"
    },
    "target_detector": {
      "additionalProperties": false,
      "properties": {
        "detector_id": {
          "enum": [
            "detector:bounded-report-mean-direction",
            "detector:bounded-analysis-method-conflict"
          ]
        },
        "detector_version": {
          "const": "0.1.0"
        },
        "implementation_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
        },
        "manifest": {
          "additionalProperties": false,
          "properties": {
            "record_ref": {
              "additionalProperties": false,
              "properties": {
                "record_id": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
                },
                "record_type": {
                  "const": "detector_manifest"
                }
              },
              "required": [
                "record_type",
                "record_id"
              ],
              "type": "object"
            },
            "semantic_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "record_ref",
            "semantic_digest"
          ],
          "type": "object"
        },
        "material_premise_class": {
          "const": "static_closed_scope"
        },
        "parser_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "record_ref": {
                "additionalProperties": false,
                "properties": {
                  "record_id": {
                    "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
                  },
                  "record_type": {
                    "const": "parser_manifest"
                  }
                },
                "required": [
                  "record_type",
                  "record_id"
                ],
                "type": "object"
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "record_ref",
              "semantic_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semantic_profile_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "manifest_id": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
              },
              "manifest_kind": {
                "const": "semantic_profile_manifest"
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "manifest_kind",
              "manifest_id",
              "semantic_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "version_manifests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "manifest_id": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
              },
              "manifest_kind": {
                "const": "version_manifest"
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "manifest_kind",
              "manifest_id",
              "semantic_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "manifest",
        "detector_id",
        "detector_version",
        "implementation_digest",
        "material_premise_class",
        "parser_manifests",
        "semantic_profile_manifests",
        "version_manifests"
      ],
      "type": "object"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "allowed_shared_utilities": {
          "const": [
            "canonical_json",
            "content_hashing",
            "schema_shape_validation",
            "source_reference_resolution"
          ]
        },
        "dependency_closure": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "content_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
              },
              "dependency_kind": {
                "enum": [
                  "implementation",
                  "runtime"
                ]
              },
              "path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "dependency_kind",
              "path",
              "content_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "entry_point": {
          "enum": [
            "sc_referee_evaluation.static_qualification:verify_bounded_direction_case",
            "sc_referee_evaluation.analysis_method_qualification:verify_bounded_analysis_method_case"
          ]
        },
        "implementation_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "entry_point",
        "implementation_digest",
        "dependency_closure",
        "allowed_shared_utilities"
      ],
      "type": "object"
    },
    "vocabularies": {
      "additionalProperties": false,
      "properties": {
        "applicability_obligation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "completion_statuses": {
          "const": [
            "completed",
            "error",
            "unavailable"
          ]
        },
        "counterevidence_check_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "outcomes": {
          "const": [
            "agreement",
            "conflict_absent",
            "conflict_present",
            "counterevidence_absent",
            "counterevidence_present"
          ]
        }
      },
      "required": [
        "applicability_obligation_ids",
        "counterevidence_check_ids",
        "completion_statuses",
        "outcomes"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "profile_id",
    "profile_version",
    "target_detector",
    "verifier",
    "selection_rules",
    "budgets",
    "vocabularies",
    "selection_protocol_artifact",
    "frozen_at",
    "profile_semantic_digest",
    "provenance",
    "profile_kind"
  ],
  "title": "StaticQualificationProfile",
  "type": "object"
}

{
  "$id": "https://w3id.org/sc-referee/schema/v0.15.0/detector-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "finding_candidate",
              "evaluation_finding_candidate",
              "conditional_concern_candidate",
              "material_question_candidate",
              "disclosure_candidate"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "candidate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "finding_candidate"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "assessment_type": {
                "const": "finding"
              },
              "unresolved_material_premise_ids": {
                "maxItems": 0
              }
            }
          },
          "detector_maturity": {
            "enum": [
              "validated",
              "publication_grade"
            ]
          }
        },
        "required": [
          "candidate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "evaluation_finding_candidate"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "assessment_type": {
                "const": "finding"
              },
              "material_premise_ids": {
                "minItems": 1
              },
              "unresolved_material_premise_ids": {
                "maxItems": 0
              }
            },
            "required": [
              "assessment_type",
              "material_premise_ids",
              "unresolved_material_premise_ids"
            ]
          },
          "detector_maturity": {
            "const": "experimental"
          }
        },
        "required": [
          "candidate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "no_issue_detected_within_coverage"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "status": {
                "enum": [
                  "covered",
                  "partially_covered"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "applicable",
            "not_applicable",
            "uncertain"
          ]
        },
        "unsupported_constructs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "status",
        "basis"
      ],
      "type": "object"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "assessment_type": {
          "enum": [
            "finding",
            "conditional_concern",
            "material_question",
            "disclosure"
          ]
        },
        "bounded_statement": {
          "minLength": 1,
          "type": "string"
        },
        "material_premise_ids": {
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
          },
          "minItems": 0,
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "unresolved_material_premise_ids": {
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "assessment_type",
        "title",
        "bounded_statement"
      ],
      "type": "object"
    },
    "counterevidence_execution": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
          },
          "evidence_ids": {
            "items": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
            },
            "minItems": 0,
            "type": "array"
          },
          "notes": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "no_counterevidence",
              "counterevidence_found",
              "inconclusive",
              "not_applicable"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "not_applicable",
              "unavailable",
              "error"
            ]
          }
        },
        "required": [
          "check_id",
          "status",
          "outcome"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "type": "string"
        },
        "gaps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array"
        },
        "status": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/CoverageStatus"
        }
      },
      "required": [
        "status",
        "basis"
      ],
      "type": "object"
    },
    "detector_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
    },
    "detector_manifest_digest": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
    },
    "detector_maturity": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Maturity"
    },
    "detector_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/SemVer"
    },
    "deterministic_input_digest": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
    },
    "error": {
      "type": "string"
    },
    "evaluated_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Timestamp"
    },
    "evidence": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/EvidenceItem"
      },
      "minItems": 0,
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^x-"
      },
      "type": "object"
    },
    "premise_evaluations": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/LogicalPremise"
      },
      "minItems": 0,
      "type": "array"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "detector_result"
    },
    "result_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
    },
    "runtime_mode": {
      "enum": [
        "static",
        "inspect",
        "reproduce"
      ]
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/SchemaVersion"
    },
    "state": {
      "enum": [
        "finding_candidate",
        "evaluation_finding_candidate",
        "conditional_concern_candidate",
        "material_question_candidate",
        "disclosure_candidate",
        "no_issue_detected_within_coverage",
        "not_applicable",
        "insufficient_semantics",
        "unsupported_path",
        "execution_evidence_unavailable",
        "detector_error"
      ]
    },
    "target_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 1,
      "type": "array"
    },
    "unavailable_evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "result_id",
    "audit_run_id",
    "detector_id",
    "detector_version",
    "detector_manifest_digest",
    "detector_maturity",
    "target_refs",
    "state",
    "evaluated_at",
    "runtime_mode",
    "deterministic_input_digest",
    "applicability",
    "premise_evaluations",
    "evidence",
    "counterevidence_execution",
    "coverage",
    "provenance"
  ],
  "title": "Detector Result",
  "type": "object"
}

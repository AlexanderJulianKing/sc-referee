{
  "$id": "https://w3id.org/sc-referee/schema/v0.17.0/analysis-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_status": {
            "enum": [
              "unresolved",
              "opaque"
            ]
          }
        },
        "required": [
          "observation_status"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observation_status": {
            "const": "declared"
          }
        },
        "required": [
          "observation_status"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "actor": {
                "properties": {
                  "actor_kind": {
                    "const": "human"
                  }
                },
                "required": [
                  "actor_kind"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "alternatives": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alternative_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/Identifier"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "source_refs": {
            "items": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/SourceRef"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "selected",
              "rejected",
              "candidate",
              "unknown"
            ]
          }
        },
        "required": [
          "alternative_id",
          "label",
          "state",
          "source_refs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "analysis_decision_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/Identifier"
    },
    "decision_input_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/RecordRef"
      },
      "type": "array",
      "uniqueItems": true
    },
    "decision_kind": {
      "enum": [
        "filter",
        "threshold",
        "subgroup",
        "model",
        "feature",
        "outcome",
        "exposure",
        "covariate",
        "missing_data",
        "multiple_testing",
        "other"
      ]
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "downstream_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/RecordRef"
      },
      "type": "array",
      "uniqueItems": true
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "observation_status": {
      "enum": [
        "observed",
        "declared",
        "unresolved",
        "opaque"
      ]
    },
    "outcome_influence": {
      "enum": [
        "demonstrated",
        "possible",
        "not_assessed",
        "not_applicable"
      ]
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "analysis_decision"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/SchemaVersion"
    },
    "selection_statistic": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/SourceRef"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "observed",
            "not_observed",
            "not_applicable",
            "opaque"
          ]
        },
        "value": {}
      },
      "required": [
        "state",
        "source_refs"
      ],
      "type": "object"
    },
    "source_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.17.0/common.schema.json#/$defs/SourceRef"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "analysis_decision_id",
    "audit_run_id",
    "decision_kind",
    "observation_status",
    "description",
    "decision_input_refs",
    "alternatives",
    "selection_statistic",
    "outcome_influence",
    "downstream_refs",
    "source_refs",
    "limitations",
    "provenance"
  ],
  "title": "sc-referee AnalysisDecision",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/sc-referee/schema/v0.5.0/causal-contract.schema.json",
  "title": "Causal Estimand and Identification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "causal_contract_id",
    "audit_run_id",
    "claim_refs",
    "intent",
    "estimand",
    "identification",
    "causal_structure",
    "source_refs",
    "created_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SchemaVersion"
    },
    "record_type": {
      "const": "causal_contract"
    },
    "causal_contract_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 1
    },
    "intent": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_population",
        "unit_of_analysis",
        "treatment_or_exposure",
        "treatment_strategies",
        "outcome",
        "comparison",
        "effect_measure_and_scale",
        "time_zero",
        "outcome_horizon",
        "effect_type",
        "censoring_and_competing_events",
        "interference",
        "transport_relationship"
      ],
      "properties": {
        "target_population": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "unit_of_analysis": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "treatment_or_exposure": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "treatment_strategies": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "outcome": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "comparison": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "effect_measure_and_scale": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "time_zero": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "outcome_horizon": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "effect_type": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "censoring_and_competing_events": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "interference": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "transport_relationship": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        }
      }
    },
    "identification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "adjustment_set",
        "covariate_roles",
        "exchangeability",
        "positivity",
        "consistency_and_treatment_versions",
        "measurement_and_calibration",
        "temporal_ordering"
      ],
      "properties": {
        "strategy": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "adjustment_set": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "covariate_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variable_ref",
              "role",
              "estimand_scope",
              "temporal_relation",
              "assertion_ids"
            ],
            "properties": {
              "variable_ref": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/RecordRef"
              },
              "role": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/CausalVariableRole"
              },
              "estimand_scope": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
              },
              "temporal_relation": {
                "enum": [
                  "pre_treatment",
                  "post_treatment",
                  "concurrent",
                  "post_outcome",
                  "unknown"
                ]
              },
              "assertion_ids": {
                "type": "array",
                "items": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            }
          },
          "minItems": 0
        },
        "exchangeability": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "positivity": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "consistency_and_treatment_versions": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "measurement_and_calibration": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        },
        "temporal_ordering": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SemanticSlot"
        }
      }
    },
    "causal_structure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presence",
            "graph_scope",
            "relation_assertion_ids",
            "source_refs"
          ],
          "properties": {
            "presence": {
              "const": "none"
            },
            "graph_scope": {
              "const": "not_available"
            },
            "relation_assertion_ids": {
              "const": []
            },
            "source_refs": {
              "const": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presence",
            "graph_scope",
            "relation_assertion_ids",
            "source_refs"
          ],
          "properties": {
            "presence": {
              "enum": [
                "partial",
                "complete"
              ]
            },
            "graph_scope": {
              "enum": [
                "partial_open_world",
                "complete_for_named_query",
                "closed_world"
              ]
            },
            "relation_assertion_ids": {
              "type": "array",
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "source_refs": {
              "type": "array",
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SourceRef"
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SourceRef"
      },
      "minItems": 1
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Timestamp"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-"
      },
      "additionalProperties": true
    }
  }
}

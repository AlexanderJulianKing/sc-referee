{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/sc-referee/schema/v0.5.0/material-question.schema.json",
  "title": "Material Scientific Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "question_id",
    "audit_run_id",
    "question",
    "unknown_semantic_dimension",
    "why_it_matters",
    "candidate_answers",
    "evidence_searched",
    "blocked_detector_ids",
    "affected_claim_ids",
    "linked_conditional_concern_ids",
    "priority",
    "status",
    "answer_ids",
    "created_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SchemaVersion"
    },
    "record_type": {
      "const": "material_question"
    },
    "question_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "unknown_semantic_dimension": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "candidate_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer_id",
          "label",
          "value"
        ],
        "properties": {
          "answer_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "consequence": {
            "type": "string"
          }
        }
      },
      "minItems": 2
    },
    "evidence_searched": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "result"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "blocked_detector_ids": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
      },
      "minItems": 0
    },
    "affected_claim_ids": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
      },
      "minItems": 0
    },
    "linked_conditional_concern_ids": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
      },
      "minItems": 0
    },
    "priority": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/ReviewPriority"
    },
    "status": {
      "enum": [
        "open",
        "answered",
        "deferred",
        "superseded"
      ]
    },
    "answer_ids": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
      },
      "minItems": 0
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Timestamp"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-"
      },
      "additionalProperties": true
    }
  }
}

    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "work_item"
    },
    "scheduling": {
      "additionalProperties": false,
      "properties": {
        "cache_status": {
          "enum": [
            "miss",
            "hit",
            "stale",
            "not_cacheable"
          ]
        },
        "claim_materiality": {
          "enum": [
            "none",
            "local",
            "claim_material",
            "multi_claim",
            "conclusion_material",
            "unknown"
          ]
        },
        "component_maturity": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Maturity"
        },
        "downstream_reach": {
          "minimum": 0,
          "type": "integer"
        },
        "estimated_elapsed_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "execution_privilege": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/ExecutionLevel"
        },
        "expected_information_gain": {
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        }
      },
      "required": [
        "estimated_elapsed_seconds",
        "expected_information_gain",
        "claim_materiality",
        "downstream_reach",
        "component_maturity",
        "cache_status",
        "execution_privilege"
      ],
      "type": "object"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/SchemaVersion"
    },
    "started_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Timestamp"
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "submitted",
        "awaiting_answer",
        "completed",
        "rejected",
        "skipped",
        "failed",
        "cancelled",
        "awaiting_authorization"
      ]
    },
    "target_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "work_item_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
    }

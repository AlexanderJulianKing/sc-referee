{
  "$id": "https://w3id.org/sc-referee/schema/v0.18.0/work-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "claim_extraction",
              "semantic_resolution",
              "material_question_drafting",
              "source_evidence_verification"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "scheduling": {
            "properties": {
              "execution_privilege": {
                "const": "safe_inspection"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "output_refs": {
            "minItems": 1
          }
        },
        "required": [
          "completed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_answer"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "material_question_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "packet": {
            "properties": {
              "packet_kind": {
                "const": "semantic_or_auditor_work_v1"
              }
            },
            "required": [
              "packet_kind"
            ]
          },
          "scheduling": {
            "properties": {
              "execution_privilege": {
                "not": {
                  "const": "project_code_execution"
                }
              }
            }
          },
          "status": {
            "not": {
              "const": "awaiting_authorization"
            }
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "project_execution"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "packet": {
            "properties": {
              "packet_kind": {
                "const": "project_execution_request_v1"
              }
            },
            "required": [
              "packet_kind"
            ]
          },
          "scheduling": {
            "properties": {
              "execution_privilege": {
                "const": "project_code_execution"
              }
            }
          },
          "status": {
            "const": "awaiting_authorization"
          }
        }
      }
    }
  ],
  "properties": {
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
    },
    "completed_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Timestamp"
    },
    "completion_reason": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Timestamp"
    },
    "dependency_work_item_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
          },
          "record_type": {
            "const": "work_item"
          }
        },
        "required": [
          "record_type",
          "record_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^x-"
      },
      "type": "object"
    },
    "kind": {
      "enum": [
        "claim_extraction",
        "semantic_resolution",
        "material_question_drafting",
        "source_evidence_verification",
        "detector_evaluation",
        "auditor_owned_verification",
        "project_execution"
      ]
    },
    "material_question_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
          },
          "record_type": {
            "const": "material_question"
          }
        },
        "required": [
          "record_type",
          "record_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "output_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "packet": {
      "oneOf": [
        {
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "source_refs": {
                  "minItems": 1
                }
              },
              "required": [
                "source_refs"
              ]
            },
            {
              "properties": {
                "record_refs": {
                  "minItems": 1
                }
              },
              "required": [
                "record_refs"
              ]
            }
          ],
          "properties": {
            "limitations": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "packet_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            },
            "packet_digest_profile": {
              "const": "canonical-json-excluding-packet-digest-v1"
            },
            "packet_kind": {
              "const": "semantic_or_auditor_work_v1"
            },
            "packet_version": {
              "const": "1.0.0"
            },
            "policy": {
              "additionalProperties": false,
              "properties": {
                "accepted_status_allowed": {
                  "const": false
                },
                "model_may_establish_material_premise": {
                  "const": false
                },
                "open_ended_issue_discovery": {
                  "const": false
                },
                "project_code_execution": {
                  "const": false
                }
              },
              "required": [
                "open_ended_issue_discovery",
                "project_code_execution",
                "model_may_establish_material_premise",
                "accepted_status_allowed"
              ],
              "type": "object"
            },
            "prompt_template_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            },
            "prompt_template_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
            },
            "record_refs": {
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
              },
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "required_output_record_types": {
              "items": {
                "enum": [
                  "claim",
                  "semantic_assertion",
                  "material_question"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "snapshot_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            },
            "source_refs": {
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/SourceRef"
              },
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "unresolved_dimensions": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "packet_kind",
            "packet_version",
            "packet_digest",
            "packet_digest_profile",
            "prompt_template_id",
            "prompt_template_digest",
            "snapshot_digest",
            "source_refs",
            "record_refs",
            "unresolved_dimensions",
            "required_output_record_types",
            "limitations",
            "policy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowed_output_paths": {
              "items": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}])[^\\u0000]+$",
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "declared_input_refs": {
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
              },
              "maxItems": 256,
              "type": "array",
              "uniqueItems": true
            },
            "launch_envelope": {
              "additionalProperties": false,
              "allOf": [
                {
                  "else": {
                    "properties": {
                      "argv": {
                        "items": {
                          "maxLength": 4096,
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 128,
                        "minItems": 1,
                        "type": "array"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "unresolved_fields": {
                        "contains": {
                          "const": "argv"
                        }
                      }
                    },
                    "required": [
                      "unresolved_fields"
                    ]
                  },
                  "then": {
                    "properties": {
                      "argv": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "else": {
                    "properties": {
                      "environment": {
                        "additionalProperties": false,
                        "properties": {
                          "entries": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "maxLength": 128,
                                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                                  "type": "string"
                                },
                                "value": {
                                  "maxLength": 4096,
                                  "type": "string"
                                }
                              },
                              "required": [
                                "name",
                                "value"
                              ],
                              "type": "object"
                            },
                            "maxItems": 64,
                            "type": "array",
                            "uniqueItems": true
                          },
                          "normalized_digest": {
                            "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
                          }
                        },
                        "required": [
                          "entries",
                          "normalized_digest"
                        ],
                        "type": "object"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "unresolved_fields": {
                        "contains": {
                          "const": "environment"
                        }
                      }
                    },
                    "required": [
                      "unresolved_fields"
                    ]
                  },
                  "then": {
                    "properties": {
                      "environment": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "else": {
                    "properties": {
                      "image": {
                        "additionalProperties": false,
                        "properties": {
                          "manifest_digest": {
                            "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
                          },
                          "reference": {
                            "maxLength": 2048,
                            "pattern": "^.+@sha256:[a-f0-9]{64}$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "reference",
                          "manifest_digest"
                        ],
                        "type": "object"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "unresolved_fields": {
                        "contains": {
                          "const": "image"
                        }
                      }
                    },
                    "required": [
                      "unresolved_fields"
                    ]
                  },
                  "then": {
                    "properties": {
                      "image": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "else": {
                    "properties": {
                      "limits": {
                        "additionalProperties": false,
                        "properties": {
                          "cpu_quota_millis": {
                            "minimum": 1,
                            "type": "integer"
                          },
                          "memory_bytes": {
                            "minimum": 1,
                            "type": "integer"
                          },
                          "open_files": {
                            "minimum": 1,
                            "type": "integer"
                          },
                          "process_count": {
                            "minimum": 1,
                            "type": "integer"
                          },
                          "wall_time_seconds": {
                            "minimum": 1,
                            "type": "integer"
                          },
                          "writable_bytes": {
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "cpu_quota_millis",
                          "memory_bytes",
                          "open_files",
                          "process_count",
                          "wall_time_seconds",
                          "writable_bytes"
                        ],
                        "type": "object"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "unresolved_fields": {
                        "contains": {
                          "const": "limits"
                        }
                      }
                    },
                    "required": [
                      "unresolved_fields"
                    ]
                  },
                  "then": {
                    "properties": {
                      "limits": {
                        "type": "null"
                      }
                    }
                  }
                }
              ],
              "properties": {
                "argv": {
                  "oneOf": [
                    {
                      "items": {
                        "maxLength": 4096,
                        "minLength": 1,
                        "type": "string"
                      },
                      "maxItems": 128,
                      "minItems": 1,
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "environment": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "entries": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "name": {
                                "maxLength": 128,
                                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                                "type": "string"
                              },
                              "value": {
                                "maxLength": 4096,
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "value"
                            ],
                            "type": "object"
                          },
                          "maxItems": 64,
                          "type": "array",
                          "uniqueItems": true
                        },
                        "normalized_digest": {
                          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
                        }
                      },
                      "required": [
                        "entries",
                        "normalized_digest"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "image": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "manifest_digest": {
                          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
                        },
                        "reference": {
                          "maxLength": 2048,
                          "pattern": "^.+@sha256:[a-f0-9]{64}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "reference",
                        "manifest_digest"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "limits": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "cpu_quota_millis": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "memory_bytes": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "open_files": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "process_count": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "wall_time_seconds": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "writable_bytes": {
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "cpu_quota_millis",
                        "memory_bytes",
                        "open_files",
                        "process_count",
                        "wall_time_seconds",
                        "writable_bytes"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unresolved_fields": {
                  "items": {
                    "enum": [
                      "argv",
                      "environment",
                      "image",
                      "limits"
                    ]
                  },
                  "maxItems": 4,
                  "type": "array",
                  "uniqueItems": true
                }
              },
              "required": [
                "argv",
                "environment",
                "image",
                "limits",
                "unresolved_fields"
              ],
              "type": "object"
            },
            "limitations": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "packet_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            },
            "packet_digest_profile": {
              "const": "canonical-json-excluding-packet-digest-v1"
            },
            "packet_kind": {
              "const": "project_execution_request_v1"
            },
            "packet_version": {
              "const": "1.0.0"
            },
            "policy": {
              "additionalProperties": false,
              "properties": {
                "direct_interactive_authorization_required": {
                  "const": true
                },
                "host_or_hpc_escalation_allowed": {
                  "const": false
                },
                "launch_authorized": {
                  "const": false
                },
                "model_output_may_authorize_or_broaden": {
                  "const": false
                },
                "network_policy": {
                  "const": "denied"
                },
                "repository_text_may_authorize_or_broaden": {
                  "const": false
                },
                "scientist_output_may_authorize_or_broaden": {
                  "const": false
                }
              },
              "required": [
                "launch_authorized",
                "direct_interactive_authorization_required",
                "network_policy",
                "repository_text_may_authorize_or_broaden",
                "model_output_may_authorize_or_broaden",
                "scientist_output_may_authorize_or_broaden",
                "host_or_hpc_escalation_allowed"
              ],
              "type": "object"
            },
            "purpose": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "required_output_record_types": {
              "items": {
                "enum": [
                  "artifact",
                  "asset_identity",
                  "audit_run",
                  "environment",
                  "execution",
                  "file_record",
                  "project_execution_authorization",
                  "sandbox_capability"
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "source_snapshot": {
              "additionalProperties": false,
              "properties": {
                "record_ref": {
                  "additionalProperties": false,
                  "properties": {
                    "record_id": {
                      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
                    },
                    "record_type": {
                      "const": "repository_snapshot"
                    }
                  },
                  "required": [
                    "record_type",
                    "record_id"
                  ],
                  "type": "object"
                },
                "semantic_digest": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
                }
              },
              "required": [
                "record_ref",
                "semantic_digest"
              ],
              "type": "object"
            },
            "target_refs": {
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "packet_kind",
            "packet_version",
            "packet_digest",
            "packet_digest_profile",
            "source_snapshot",
            "purpose",
            "target_refs",
            "declared_input_refs",
            "allowed_output_paths",
            "launch_envelope",
            "required_output_record_types",
            "limitations",
            "policy"
          ],
          "type": "object"
        }
      ]

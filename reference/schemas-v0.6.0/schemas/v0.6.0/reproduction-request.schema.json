{
  "$id": "https://w3id.org/sc-referee/schema/v0.6.0/reproduction-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_claim_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 0,
      "type": "array"
    },
    "affected_detector_ids": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/Identifier"
      },
      "minItems": 0,
      "type": "array"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/Identifier"
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/Timestamp"
    },
    "environment_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "expected_outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string"
          },
          "identity_expectation": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/DataIdentityTier"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "role",
          "identity_expectation"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^x-"
      },
      "type": "object"
    },
    "imported_evidence_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 0,
      "type": "array"
    },
    "input_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/Provenance"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "record_type": {
      "const": "reproduction_request"
    },
    "reproduction_request_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/Identifier"
    },
    "requested_action": {
      "additionalProperties": false,
      "properties": {
        "command_template": {
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "run_existing_target",
            "collect_runtime_trace",
            "export_artifact",
            "compute_checksum",
            "capture_environment",
            "other"
          ]
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "type": "object"
    },
    "resource_class": {
      "enum": [
        "local_small",
        "local_large",
        "hpc_cpu",
        "hpc_gpu",
        "unknown"
      ]
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/SchemaVersion"
    },
    "security_considerations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "approved_for_external_run",
        "exported",
        "evidence_imported",
        "declined"
      ]
    },
    "target_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.6.0/common.schema.json#/$defs/RecordRef"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "reproduction_request_id",
    "audit_run_id",
    "status",
    "target_refs",
    "reason",
    "affected_claim_refs",
    "affected_detector_ids",
    "requested_action",
    "input_requirements",
    "environment_requirements",
    "resource_class",
    "security_considerations",
    "expected_outputs",
    "created_at",
    "provenance"
  ],
  "title": "External Reproduction Request",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/sc-referee/schema/v0.5.0/audit-plan.schema.json",
  "title": "sc-referee Audit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "audit_plan_id",
    "mode",
    "scope",
    "deadlines",
    "model_policy",
    "execution_policy",
    "network_policy",
    "data_policy",
    "question_policy",
    "finding_policy",
    "snapshot_policy",
    "parser_policy",
    "storage_policy",
    "cache_policy",
    "sandbox_policy",
    "report_policy",
    "on_deadline",
    "created_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/SchemaVersion"
    },
    "record_type": {
      "const": "audit_plan"
    },
    "audit_plan_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Identifier"
    },
    "mode": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/AuditMode"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_root",
        "inventory",
        "deep_inspection",
        "include_selection_envelope",
        "publication_surface_policy"
      ],
      "properties": {
        "project_root": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "const": "whole_project"
        },
        "deep_inspection": {
          "const": "final_claim_backward_slices"
        },
        "include_selection_envelope": {
          "const": true
        },
        "publication_surface_policy": {
          "const": "precedence_then_ask_if_ambiguous"
        },
        "explicit_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "scheduling_cutoff_seconds",
        "hard_deadline_seconds",
        "pause_states",
        "no_automatic_mode_escalation",
        "resume_creates_linked_run_segment"
      ],
      "properties": {
        "clock": {
          "const": "user_visible_elapsed"
        },
        "scheduling_cutoff_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "hard_deadline_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "pause_states": {
          "const": [
            "awaiting_scientist_response"
          ]
        },
        "no_automatic_mode_escalation": {
          "const": true
        },
        "resume_creates_linked_run_segment": {
          "const": true
        }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditor_call_limit",
        "auditor_input_token_limit",
        "auditor_output_token_limit",
        "limit_authority",
        "record_usage",
        "packetized_work",
        "allow_bounded_semantic_extraction",
        "allow_open_ended_scientific_issue_search",
        "allow_model_finding_admission"
      ],
      "properties": {
        "auditor_call_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "auditor_input_token_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "auditor_output_token_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "limit_authority": {
          "const": "host_managed"
        },
        "record_usage": {
          "const": true
        },
        "packetized_work": {
          "const": true
        },
        "allow_bounded_semantic_extraction": {
          "const": true
        },
        "allow_open_ended_scientific_issue_search": {
          "const": false
        },
        "allow_model_finding_admission": {
          "const": false
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_first",
        "automatic_execution_levels",
        "project_code_execution",
        "project_code_network_access",
        "allow_dependency_installation",
        "dependency_installation_isolation",
        "unversioned_environment_status",
        "allow_local_project_installation",
        "allow_system_package_installation",
        "allow_full_workflow_execution",
        "allow_hpc_submission",
        "unsafe_deserialization",
        "repository_mount",
        "writable_roots"
      ],
      "properties": {
        "static_first": {
          "const": true
        },
        "automatic_execution_levels": {
          "type": "array",
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/ExecutionLevel"
          },
          "minItems": 2,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "const": "safe_inspection"
              }
            },
            {
              "contains": {
                "const": "auditor_owned_verification"
              }
            },
            {
              "not": {
                "contains": {
                  "const": "project_code_execution"
                }
              }
            }
          ]
        },
        "project_code_execution": {
          "enum": [
            "denied",
            "explicitly_authorized"
          ]
        },
        "project_code_network_access": {
          "enum": [
            "denied",
            "explicitly_authorized"
          ]
        },
        "allow_dependency_installation": {
          "type": "boolean",
          "description": "Whether the selected mode permits automatic project dependency installation in an isolated audit-owned environment. Quick mode may set false; standard and publication defaults set true."
        },
        "dependency_installation_isolation": {
          "const": "isolated_environment_only"
        },
        "unversioned_environment_status": {
          "const": "approximate"
        },
        "allow_local_project_installation": {
          "const": false
        },
        "allow_system_package_installation": {
          "const": false
        },
        "allow_full_workflow_execution": {
          "const": false
        },
        "allow_hpc_submission": {
          "const": false
        },
        "unsafe_deserialization": {
          "const": "deny"
        },
        "repository_mount": {
          "const": "read_only"
        },
        "writable_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude_network_access",
        "controller_network_access",
        "project_code_network_access",
        "record_retrieval_provenance",
        "cache_retrieved_evidence",
        "repository_content_can_authorize"
      ],
      "properties": {
        "claude_network_access": {
          "const": "host_managed_unrestricted"
        },
        "controller_network_access": {
          "const": "allowed_with_provenance"
        },
        "project_code_network_access": {
          "const": "explicit_authorization_required"
        },
        "record_retrieval_provenance": {
          "const": true
        },
        "cache_retrieved_evidence": {
          "const": true
        },
        "repository_content_can_authorize": {
          "const": false
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_policy",
        "max_total_bytes_read_from_large_assets",
        "max_source_packet_bytes"
      ],
      "properties": {
        "identity_policy": {
          "const": "tiered"
        },
        "max_total_bytes_read_from_large_assets": {
          "type": "integer",
          "minimum": 0
        },
        "max_source_packet_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "question_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ask_only_material",
        "batch_questions",
        "unanswered_behavior"
      ],
      "properties": {
        "ask_only_material": {
          "const": true
        },
        "batch_questions": {
          "const": true
        },
        "maximum_interactive_rounds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "unanswered_behavior": {
          "const": "preserve_unknown_and_continue"
        }
      }
    },
    "finding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_means_demonstrated_issue_only",
        "minimum_detector_maturity",
        "require_all_five_admission_conditions",
        "require_finite_counterevidence_protocol",
        "reserve_severity_for_findings",
        "emit_numerical_finding_confidence",
        "never_emit_global_correctness_status",
        "group_findings_by_root_cause"
      ],
      "properties": {
        "finding_means_demonstrated_issue_only": {
          "const": true
        },
        "minimum_detector_maturity": {
          "enum": [
            "validated",
            "publication_grade"
          ]
        },
        "require_all_five_admission_conditions": {
          "const": true
        },
        "require_finite_counterevidence_protocol": {
          "const": true
        },
        "reserve_severity_for_findings": {
          "const": true
        },
        "emit_numerical_finding_confidence": {
          "const": false
        },
        "never_emit_global_correctness_status": {
          "const": true
        },
        "group_findings_by_root_cause": {
          "const": true
        }
      }
    },
    "on_deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_new_optional_work_at_cutoff",
        "terminate_eligible_children_at_hard_deadline",
        "preserve_completed_records",
        "preserve_pending_work_items",
        "calculate_partial_coverage",
        "render_partial_report"
      ],
      "properties": {
        "stop_new_optional_work_at_cutoff": {
          "const": true
        },
        "terminate_eligible_children_at_hard_deadline": {
          "const": true
        },
        "preserve_completed_records": {
          "const": true
        },
        "preserve_pending_work_items": {
          "const": true
        },
        "calculate_partial_coverage": {
          "const": true
        },
        "render_partial_report": {
          "const": true
        }
      }
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Timestamp"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.5.0/common.schema.json#/$defs/Provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-"
      },
      "additionalProperties": true
    },
    "snapshot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "live_mutation_behavior",
        "mix_live_content_into_run"
      ],
      "properties": {
        "strategy": {
          "const": "immutable_initial_snapshot"
        },
        "live_mutation_behavior": {
          "const": "continue_snapshot_mark_workspace_diverged"
        },
        "mix_live_content_into_run": {
          "const": false
        }
      }
    },
    "parser_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_stack",
        "r_stack",
        "execute_source_during_parse",
        "record_parser_coverage"
      ],
      "properties": {
        "python_stack": {
          "const": "cpython_ast_plus_tokenize"
        },
        "r_stack": {
          "const": [
            "tree_sitter_r",
            "base_r_parse_data_when_available"
          ]
        },
        "execute_source_during_parse": {
          "const": false
        },
        "record_parser_coverage": {
          "const": true
        }
      }
    },
    "storage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_records",
        "scientist_editable_records",
        "generated_query_index",
        "query_index_disposable"
      ],
      "properties": {
        "canonical_records": {
          "const": "json_or_jsonl"
        },
        "scientist_editable_records": {
          "const": "yaml_or_json"
        },
        "generated_query_index": {
          "const": "sqlite"
        },
        "query_index_disposable": {
          "const": true
        }
      }
    },
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_derived_scope",
        "cross_repository_semantic_cache",
        "global_cache_allowed_classes"
      ],
      "properties": {
        "source_derived_scope": {
          "const": "project_local_only"
        },
        "cross_repository_semantic_cache": {
          "const": false
        },
        "global_cache_allowed_classes": {
          "const": [
            "parser_binaries_and_grammars",
            "public_package_downloads",
            "isolated_dependency_environments",
            "public_external_evidence",
            "tool_owned_immutable_assets"
          ]
        }
      }
    },
    "sandbox_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_code_backend",
        "unsafe_fallback",
        "auditor_owned_verification_backend",
        "report_capabilities"
      ],
      "properties": {
        "project_code_backend": {
          "const": "rootless_oci_required"
        },
        "unsafe_fallback": {
          "const": false
        },
        "auditor_owned_verification_backend": {
          "const": "restricted_subprocess_allowed"
        },
        "report_capabilities": {
          "const": true
        }
      }
    },
    "report_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer",
        "self_contained",
        "external_assets",
        "core_readable_without_javascript",
        "template_autoescape"
      ],
      "properties": {
        "renderer": {
          "const": "jinja2_static_html"
        },
        "self_contained": {
          "const": true
        },
        "external_assets": {
          "const": false
        },
        "core_readable_without_javascript": {
          "const": true
        },
        "template_autoescape": {
          "const": true
        }
      }
    }
  }
}

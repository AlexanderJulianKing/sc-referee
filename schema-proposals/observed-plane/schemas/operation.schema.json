{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/operation.schema.json",
  "title": "sc-referee Operation review candidate",
  "$comment": "Nonpublic ADR-0002 template. An operation is observed structure, not scientific validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "operation_id",
    "audit_run_id",
    "kind",
    "source_refs",
    "input_refs",
    "output_refs",
    "literal_parameters",
    "determinism",
    "parser_result_ref",
    "inspection_status",
    "opaque_boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SchemaVersion"
    },
    "record_type": {"const": "operation"},
    "operation_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
    },
    "kind": {
      "enum": [
        "read", "write", "parse", "validate", "join", "filter", "exclude", "sample",
        "transform", "normalize", "calibrate", "impute", "aggregate", "reshape",
        "select_feature", "choose_threshold", "choose_subgroup", "choose_model",
        "fit_model", "test_hypothesis", "estimate", "predict", "diagnose", "resample",
        "adjust_multiple_testing", "render", "export", "opaque_operation"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"
      },
      "minItems": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"
      },
      "uniqueItems": true
    },
    "output_refs": {
      "type": "array",
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"
      },
      "uniqueItems": true
    },
    "literal_parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/LiteralValue"}
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "tool_identity_ref": {"$ref": "#/$defs/ToolIdentityRef"}
      }
    },
    "environment_ref": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"
    },
    "determinism": {"enum": ["deterministic", "nondeterministic", "unknown"]},
    "parser_result_ref": {"$ref": "#/$defs/ParserResultRef"},
    "inspection_status": {"enum": ["supported", "partial", "opaque", "unsupported"]},
    "opaque_boundaries": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Provenance"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "opaque_operation"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "inspection_status": {"const": "opaque"},
          "opaque_boundaries": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"inspection_status": {"const": "opaque"}},
        "required": ["inspection_status"]
      },
      "then": {"properties": {"kind": {"const": "opaque_operation"}}}
    }
  ],
  "$defs": {
    "LiteralValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {
          "type": "array",
          "items": {"type": ["string", "number", "boolean", "null"]}
        }
      ]
    },
    "ParserResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id"],
      "properties": {
        "record_type": {"const": "parser_result"},
        "record_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
        }
      }
    },
    "ToolIdentityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_id"],
      "properties": {
        "record_type": {"const": "tool_identity"},
        "record_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
        }
      }
    }
  }
}

{
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/variable.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sc-referee Variable",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"scientific_meaning_status": {"const": "resolved_by_assertion"}},
        "required": ["scientific_meaning_status"]
      },
      "then": {"properties": {"semantic_assertion_refs": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"scientific_meaning_status": {"const": "unresolved"}},
        "required": ["scientific_meaning_status"]
      },
      "then": {"properties": {"semantic_assertion_refs": {"maxItems": 0}}}
    }
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SchemaVersion"
    },
    "record_type": {"const": "variable"},
    "variable_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
    },
    "audit_run_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
    },
    "data_asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_type": {"const": "data_asset"},
        "record_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
        }
      },
      "required": ["record_type", "record_id"]
    },
    "observed_name": {"type": "string", "minLength": 1},
    "storage_type": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "datetime",
        "categorical",
        "mixed",
        "unknown"
      ]
    },
    "observed_level_count": {"type": "integer", "minimum": 0},
    "scientific_meaning_status": {
      "enum": ["unresolved", "resolved_by_assertion", "conflicted", "not_applicable"]
    },
    "semantic_assertion_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_type": {"const": "semantic_assertion"},
          "record_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"
          }
        },
        "required": ["record_type", "record_id"]
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Provenance"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "variable_id",
    "audit_run_id",
    "data_asset_ref",
    "observed_name",
    "storage_type",
    "scientific_meaning_status",
    "semantic_assertion_refs",
    "source_refs",
    "limitations",
    "provenance"
  ]
}

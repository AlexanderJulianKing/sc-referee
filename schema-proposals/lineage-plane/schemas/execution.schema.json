{
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/execution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sc-referee Execution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SchemaVersion"},
    "record_type": {"const": "execution"},
    "execution_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "audit_run_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "execution_kind": {"enum": ["auditor_verification", "project_workflow", "imported"]},
    "actor": {"enum": ["sc_referee_auditor", "project_workflow", "external_import"]},
    "method": {"type": "string", "minLength": 1},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {"type": "string", "minLength": 1},
        "normalized_digest": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Digest"},
        "tool_identity_ref": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
      },
      "required": ["display", "normalized_digest"]
    },
    "input_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
    },
    "output_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
    },
    "environment_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_type": {"const": "environment"},
        "record_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"}
      },
      "required": ["record_type", "record_id"]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "imported", "unavailable"]},
        "started_at": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Timestamp"},
        "finished_at": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Timestamp"}
      },
      "required": ["state"],
      "allOf": [
        {
          "if": {"properties": {"state": {"enum": ["observed", "imported"]}}, "required": ["state"]},
          "then": {"required": ["started_at", "finished_at"]},
          "else": {"not": {"anyOf": [{"required": ["started_at"]}, {"required": ["finished_at"]}]}}
        }
      ]
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["succeeded", "failed", "timed_out", "not_observed"]},
        "code": {"type": "integer"}
      },
      "required": ["state"]
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_code_executed": {"type": "boolean"},
        "authorization_status": {"enum": ["not_required", "authorized", "not_authorized", "unknown"]},
        "sandbox_capability_ref": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"},
        "network_policy": {"enum": ["denied", "allowed", "unknown", "not_applicable"]}
      },
      "required": ["project_code_executed", "authorization_status", "network_policy"]
    },
    "identity_strength": {"enum": ["exact", "imported_strong", "imported_weak", "unknown"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Provenance"}
  },
  "required": [
    "schema_version", "record_type", "execution_id", "audit_run_id", "execution_kind",
    "actor", "method", "command", "input_refs", "output_refs", "environment_ref",
    "timing", "exit", "sandbox", "identity_strength", "source_refs", "limitations", "provenance"
  ],
  "allOf": [
    {
      "if": {"properties": {"execution_kind": {"const": "auditor_verification"}}, "required": ["execution_kind"]},
      "then": {
        "properties": {
          "actor": {"const": "sc_referee_auditor"},
          "sandbox": {
            "properties": {
              "project_code_executed": {"const": false},
              "authorization_status": {"const": "not_required"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"execution_kind": {"const": "project_workflow"}}, "required": ["execution_kind"]},
      "then": {
        "properties": {
          "actor": {"const": "project_workflow"},
          "sandbox": {
            "properties": {
              "project_code_executed": {"const": true},
              "authorization_status": {"const": "authorized"}
            },
            "required": ["sandbox_capability_ref"]
          }
        }
      }
    }
  ]
}

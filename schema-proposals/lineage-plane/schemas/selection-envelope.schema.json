{
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/selection-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sc-referee SelectionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SchemaVersion"},
    "record_type": {"const": "selection_envelope"},
    "selection_envelope_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "audit_run_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "completeness_status": {"enum": ["complete", "partial", "unavailable", "opaque"]},
    "scope_description": {"type": "string", "minLength": 1},
    "analysis_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_type": {"const": "analysis_decision"},
          "record_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"}
        },
        "required": ["record_type", "record_id"]
      }
    },
    "candidate_alternative_count": {"type": "integer", "minimum": 0},
    "affected_claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
    },
    "affected_result_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Provenance"}
  },
  "required": [
    "schema_version", "record_type", "selection_envelope_id", "audit_run_id",
    "completeness_status", "scope_description", "analysis_decision_refs",
    "candidate_alternative_count", "affected_claim_refs", "affected_result_refs",
    "source_refs", "limitations", "provenance"
  ],
  "allOf": [
    {
      "if": {"properties": {"completeness_status": {"const": "complete"}}, "required": ["completeness_status"]},
      "then": {
        "properties": {
          "analysis_decision_refs": {"minItems": 1},
          "limitations": {"maxItems": 0}
        }
      },
      "else": {"properties": {"limitations": {"minItems": 1}}}
    }
  ]
}

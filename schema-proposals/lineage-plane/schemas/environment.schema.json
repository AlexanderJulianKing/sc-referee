{
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/environment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sc-referee Environment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SchemaVersion"},
    "record_type": {"const": "environment"},
    "environment_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "audit_run_id": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Identifier"},
    "environment_kind": {"enum": ["auditor_runtime", "project_runtime", "imported_runtime"]},
    "identity_status": {"enum": ["exact", "partial", "unavailable", "opaque"]},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1}
      },
      "required": ["name"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1}
      }
    },
    "dependency_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"}
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {"$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/Provenance"}
  },
  "required": [
    "schema_version", "record_type", "environment_id", "audit_run_id",
    "environment_kind", "identity_status", "runtime", "platform", "dependency_refs",
    "source_refs", "limitations", "provenance"
  ],
  "allOf": [
    {
      "if": {"properties": {"identity_status": {"const": "exact"}}, "required": ["identity_status"]},
      "then": {"properties": {"limitations": {"maxItems": 0}}},
      "else": {"properties": {"limitations": {"minItems": 1}}}
    }
  ]
}

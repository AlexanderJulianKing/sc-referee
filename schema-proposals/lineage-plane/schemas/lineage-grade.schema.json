{
  "$id": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/lineage-grade.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sc-referee Claim lineage grades",
  "$defs": {
    "Grade": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "complete"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"limitations": {"maxItems": 0}},
            "anyOf": [
              {"properties": {"record_refs": {"minItems": 1}}},
              {"properties": {"source_refs": {"minItems": 1}}}
            ]
          },
          "else": {"properties": {"limitations": {"minItems": 1}}}
        }
      ],
      "properties": {
        "status": {
          "enum": ["complete", "partial", "missing", "unavailable", "opaque"]
        },
        "record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/RecordRef"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v__SCHEMA_VERSION__/common.schema.json#/$defs/SourceRef"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["status", "record_refs", "source_refs", "limitations"]
    },
    "GradeSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_origin": {"$ref": "#/$defs/Grade"},
        "result_origin": {"$ref": "#/$defs/Grade"},
        "computational_origin": {"$ref": "#/$defs/Grade"},
        "input_origin": {"$ref": "#/$defs/Grade"},
        "execution_origin": {"$ref": "#/$defs/Grade"},
        "semantic_origin": {"$ref": "#/$defs/Grade"}
      },
      "required": [
        "report_origin",
        "result_origin",
        "computational_origin",
        "input_origin",
        "execution_origin",
        "semantic_origin"
      ]
    }
  }
}

{
  "$id": "https://w3id.org/sc-referee/schema/v0.15.0/static-qualification-proof.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "proof_status": {
            "const": "complete"
          }
        },
        "required": [
          "proof_status"
        ]
      },
      "then": {
        "properties": {
          "derived_facts": {
            "type": "object"
          },
          "retained_bytes": {
            "minItems": 3
          }
        }
      }
    }
  ],
  "properties": {
    "applicability_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
          },
          "completion_status": {
            "enum": [
              "completed",
              "unavailable",
              "error"
            ]
          },
          "detail_code": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_paths": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "outcome": {
            "oneOf": [
              {
                "enum": [
                  "agreement",
                  "conflict_absent",
                  "conflict_present",
                  "counterevidence_absent",
                  "counterevidence_present"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "check_id",
          "completion_status",
          "outcome",
          "evidence_paths",
          "detail_code"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "case_assignment_artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
        },
        "artifact_kind": {
          "const": "opaque_case_assignment"
        },
        "content_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "content_digest"
      ],
      "type": "object"
    },
    "chronology": {
      "additionalProperties": false,
      "properties": {
        "case_assigned_at": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Timestamp"
        },
        "detector_dispatched_at": {
          "type": "null"
        },
        "label_frozen_at": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Timestamp"
        },
        "profile_frozen_at": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Timestamp"
        },
        "proof_frozen_at": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Timestamp"
        },
        "stage3_started_at": {
          "type": "null"
        }
      },
      "required": [
        "profile_frozen_at",
        "case_assigned_at",
        "label_frozen_at",
        "proof_frozen_at",
        "detector_dispatched_at",
        "stage3_started_at"
      ],
      "type": "object"
    },
    "counterevidence_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
          },
          "completion_status": {
            "enum": [
              "completed",
              "unavailable",
              "error"
            ]
          },
          "detail_code": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_paths": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "outcome": {
            "oneOf": [
              {
                "enum": [
                  "agreement",
                  "conflict_absent",
                  "conflict_present",
                  "counterevidence_absent",
                  "counterevidence_present"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "check_id",
          "completion_status",
          "outcome",
          "evidence_paths",
          "detail_code"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "dependency_graph": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from_node_id": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
              },
              "relation": {
                "enum": [
                  "enumerates",
                  "reads",
                  "derives",
                  "writes",
                  "checks",
                  "excludes"
                ]
              },
              "to_node_id": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
              }
            },
            "required": [
              "from_node_id",
              "to_node_id",
              "relation"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        },
        "nodes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
              },
              "node_kind": {
                "enum": [
                  "raw_byte_source",
                  "candidate",
                  "dependency",
                  "derived_fact",
                  "check"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "node_id",
              "node_kind",
              "path",
              "semantic_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "type": "object"
    },
    "derived_facts": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "candidate_paths": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "computed_orientation": {
              "enum": [
                "left_higher",
                "right_higher",
                "equal"
              ]
            },
            "data_path": {
              "minLength": 1,
              "type": "string"
            },
            "group_column": {
              "minLength": 1,
              "type": "string"
            },
            "left_group": {
              "minLength": 1,
              "type": "string"
            },
            "left_mean": {
              "type": "number"
            },
            "left_values": {
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "type": "array"
            },
            "literal_claims": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "end": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "orientation": {
                    "enum": [
                      "left_higher",
                      "right_higher",
                      "equal"
                    ]
                  },
                  "sentence": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "start": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "sentence",
                  "orientation",
                  "start",
                  "end"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "outcome_column": {
              "minLength": 1,
              "type": "string"
            },
            "right_group": {
              "minLength": 1,
              "type": "string"
            },
            "right_mean": {
              "type": "number"
            },
            "right_values": {
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "type": "array"
            },
            "selected_report_path": {
              "minLength": 1,
              "type": "string"
            },
            "supported_closure_paths": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 3,
              "type": "array",
              "uniqueItems": true
            },
            "supported_exclusions": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "reason_code": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "reason_code"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "writer_path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "selected_report_path",
            "data_path",
            "writer_path",
            "group_column",
            "outcome_column",
            "left_group",
            "right_group",
            "left_values",
            "right_values",
            "left_mean",
            "right_mean",
            "computed_orientation",
            "literal_claims",
            "candidate_paths",
            "supported_closure_paths",
            "supported_exclusions"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^x-"
      },
      "type": "object"
    },
    "label_freeze_artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
        },
        "artifact_kind": {
          "const": "scientific_label_freeze"
        },
        "content_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "content_digest"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
            },
            "record_type": {
              "const": "static_qualification_profile"
            }
          },
          "required": [
            "record_type",
            "record_id"
          ],
          "type": "object"
        },
        "semantic_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "record_ref",
        "semantic_digest"
      ],
      "type": "object"
    },
    "proof_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
    },
    "proof_semantic_digest": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
    },
    "proof_status": {
      "enum": [
        "complete",
        "unavailable",
        "error"
      ]
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "static_qualification_proof"
    },
    "retained_bytes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_identity": {
            "additionalProperties": false,
            "properties": {
              "record_ref": {
                "additionalProperties": false,
                "properties": {
                  "record_id": {
                    "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
                  },
                  "record_type": {
                    "const": "asset_identity"
                  }
                },
                "required": [
                  "record_type",
                  "record_id"
                ],
                "type": "object"
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "record_ref",
              "semantic_digest"
            ],
            "type": "object"
          },
          "byte_size": {
            "minimum": 0,
            "type": "integer"
          },
          "content_digest": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
          },
          "encoding": {
            "const": "utf-8"
          },
          "file_record": {
            "additionalProperties": false,
            "properties": {
              "record_ref": {
                "additionalProperties": false,
                "properties": {
                  "record_id": {
                    "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
                  },
                  "record_type": {
                    "const": "file_record"
                  }
                },
                "required": [
                  "record_type",
                  "record_id"
                ],
                "type": "object"
              },
              "semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "record_ref",
              "semantic_digest"
            ],
            "type": "object"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "byte_size",
          "content_digest",
          "encoding",
          "file_record",
          "asset_identity"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/SchemaVersion"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Identifier"
            },
            "record_type": {
              "const": "repository_snapshot"
            }
          },
          "required": [
            "record_type",
            "record_id"
          ],
          "type": "object"
        },
        "semantic_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.15.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "record_ref",
        "semantic_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "proof_id",
    "profile",
    "case_assignment_artifact",
    "label_freeze_artifact",
    "snapshot",
    "retained_bytes",
    "dependency_graph",
    "applicability_results",
    "counterevidence_results",
    "derived_facts",
    "chronology",
    "proof_status",
    "proof_semantic_digest",
    "limitations",
    "provenance"
  ],
  "title": "StaticQualificationProof",
  "type": "object"
}

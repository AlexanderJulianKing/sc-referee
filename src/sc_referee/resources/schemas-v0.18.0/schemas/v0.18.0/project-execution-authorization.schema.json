{
  "$id": "https://w3id.org/sc-referee/schema/v0.18.0/project-execution-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledgements": {
      "additionalProperties": false,
      "properties": {
        "network_denied": {
          "const": true
        },
        "no_host_or_hpc_escalation": {
          "const": true
        },
        "output_confined_to_audit_root": {
          "const": true
        },
        "project_code_is_untrusted": {
          "const": true
        },
        "project_code_will_execute": {
          "const": true
        }
      },
      "required": [
        "project_code_will_execute",
        "project_code_is_untrusted",
        "output_confined_to_audit_root",
        "network_denied",
        "no_host_or_hpc_escalation"
      ],
      "type": "object"
    },
    "authorization_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
    },
    "authorizing_actor": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Actor"
    },
    "command": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "normalized_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "argv",
        "normalized_digest"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 128,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "value": {
                "maxLength": 4096,
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "normalized_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
        }
      },
      "required": [
        "entries",
        "normalized_digest"
      ],
      "type": "object"
    },
    "expires_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Timestamp"
    },
    "identity_assurance": {
      "const": "declared_local_user"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "manifest_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
        },
        "reference": {
          "maxLength": 2048,
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "manifest_digest"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "cpu_quota_millis": {
          "minimum": 1,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "open_files": {
          "minimum": 1,
          "type": "integer"
        },
        "process_count": {
          "minimum": 1,
          "type": "integer"
        },
        "wall_time_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "writable_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "cpu_quota_millis",
        "memory_bytes",
        "open_files",
        "process_count",
        "wall_time_seconds",
        "writable_bytes"
      ],
      "type": "object"
    },
    "network_policy": {
      "const": "denied"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "project_execution_authorization"
    },
    "registry_binding": {
      "additionalProperties": false,
      "properties": {
        "linked_output_root_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
        },
        "registry_id": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "registry_id",
        "linked_output_root_id"
      ],
      "type": "object"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/SchemaVersion"
    },
    "scope": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "purpose": {
                "type": "null"
              },
              "target_refs": {
                "type": "null"
              },
              "work_item_semantic_digest": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "work_item_binding_status": {
                "const": "complete_project_execution_work_item"
              }
            },
            "required": [
              "work_item_binding_status"
            ]
          },
          "then": {
            "properties": {
              "purpose": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "target_refs": {
                "items": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "work_item_semantic_digest": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
              }
            }
          }
        }
      ],
      "properties": {
        "allowed_output_paths": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}])[^\\u0000]+$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "capability": {
          "additionalProperties": false,
          "properties": {
            "record_ref": {
              "additionalProperties": false,
              "properties": {
                "record_id": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
                },
                "record_type": {
                  "const": "sandbox_capability"
                }
              },
              "required": [
                "record_type",
                "record_id"
              ],
              "type": "object"
            },
            "semantic_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "record_ref",
            "semantic_digest"
          ],
          "type": "object"
        },
        "declared_input_refs": {
          "items": {
            "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "linked_audit_run_ref": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
            },
            "record_type": {
              "const": "audit_run"
            }
          },
          "required": [
            "record_type",
            "record_id"
          ],
          "type": "object"
        },
        "purpose": {
          "oneOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "additionalProperties": false,
          "properties": {
            "record_ref": {
              "additionalProperties": false,
              "properties": {
                "record_id": {
                  "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
                },
                "record_type": {
                  "const": "repository_snapshot"
                }
              },
              "required": [
                "record_type",
                "record_id"
              ],
              "type": "object"
            },
            "semantic_digest": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "record_ref",
            "semantic_digest"
          ],
          "type": "object"
        },
        "source_audit_run_ref": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
            },
            "record_type": {
              "const": "audit_run"
            }
          },
          "required": [
            "record_type",
            "record_id"
          ],
          "type": "object"
        },
        "source_semantic_lock_digest": {
          "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
        },
        "target_refs": {
          "oneOf": [
            {
              "items": {
                "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/RecordRef"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "work_item_binding_status": {
          "enum": [
            "complete_project_execution_work_item",
            "legacy_work_item_semantics_unavailable"
          ]
        },
        "work_item_ref": {
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Identifier"
            },
            "record_type": {
              "const": "work_item"
            }
          },
          "required": [
            "record_type",
            "record_id"
          ],
          "type": "object"
        },
        "work_item_semantic_digest": {
          "oneOf": [
            {
              "$ref": "https://w3id.org/sc-referee/schema/v0.18.0/common.schema.json#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_audit_run_ref",
        "source_semantic_lock_digest",
        "linked_audit_run_ref",
        "work_item_ref",
        "snapshot",
        "capability",
        "declared_input_refs",
        "allowed_output_paths",
        "purpose",
        "target_refs",
        "work_item_binding_status",
        "work_item_semantic_digest"
      ],
      "type": "object"
    },
    "single_use_nonce": {
      "maxLength": 256,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "authorization_id",
    "scope",
    "image",
    "command",
    "environment",
    "network_policy",
    "limits",
    "expires_at",
    "single_use_nonce",
    "authorizing_actor",
    "identity_assurance",
    "acknowledgements",
    "registry_binding",
    "limitations",
    "provenance"
  ],
  "title": "sc-referee Project Execution Authorization",
  "type": "object"
}

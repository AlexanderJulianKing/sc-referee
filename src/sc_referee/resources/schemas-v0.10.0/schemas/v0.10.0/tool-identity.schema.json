{
  "$id": "https://w3id.org/sc-referee/schema/v0.10.0/tool-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_digest": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.10.0/common.schema.json#/$defs/Digest"
    },
    "captured_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.10.0/common.schema.json#/$defs/Timestamp"
    },
    "claude_skill_command": {
      "const": "/scientific-audit"
    },
    "cli_executable": {
      "const": "sc-referee"
    },
    "compatibility_cli_aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "component_versions": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "distribution_name": {
      "const": "sc-referee"
    },
    "extensions": {
      "additionalProperties": true,
      "type": "object"
    },
    "import_namespace": {
      "const": "sc_referee"
    },
    "namespaced_plugin_command": {
      "const": "/sc-referee:scientific-audit"
    },
    "product_name": {
      "const": "sc-referee"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.10.0/common.schema.json#/$defs/Provenance"
    },
    "python_runtime": {
      "pattern": "^3\\.(1[1-9]|[2-9][0-9])(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "record_type": {
      "const": "tool_identity"
    },
    "schema_namespace": {
      "const": "https://w3id.org/sc-referee/schema/v0.10.0/"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.10.0/common.schema.json#/$defs/SchemaVersion"
    },
    "tool_identity_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.10.0/common.schema.json#/$defs/Identifier"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "tool_identity_id",
    "product_name",
    "distribution_name",
    "import_namespace",
    "cli_executable",
    "claude_skill_command",
    "schema_namespace",
    "component_versions",
    "build_digest",
    "python_runtime",
    "captured_at",
    "provenance"
  ],
  "title": "sc-referee Tool Identity",
  "type": "object"
}

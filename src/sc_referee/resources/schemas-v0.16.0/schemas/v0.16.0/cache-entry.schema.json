{
  "$id": "https://w3id.org/sc-referee/schema/v0.16.0/cache-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contains_source_derived_information": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "cache_scope": {
            "const": "project_local"
          },
          "cross_repository_reuse_allowed": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "cache_entry_id": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Identifier"
    },
    "cache_scope": {
      "enum": [
        "project_local",
        "user_global_tool_asset"
      ]
    },
    "contains_source_derived_information": {
      "type": "boolean"
    },
    "content_class": {
      "enum": [
        "source_derived",
        "public_tool_asset",
        "public_external_evidence",
        "dependency_environment"
      ]
    },
    "created_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Timestamp"
    },
    "cross_repository_reuse_allowed": {
      "type": "boolean"
    },
    "dependency_keys": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": true,
      "type": "object"
    },
    "input_digests": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Digest"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invalidated_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Timestamp"
    },
    "invalidation_reason": {
      "minLength": 1,
      "type": "string"
    },
    "last_validated_at": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Timestamp"
    },
    "output_refs": {
      "items": {
        "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/RecordRef"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/Provenance"
    },
    "record_type": {
      "const": "cache_entry"
    },
    "schema_version": {
      "$ref": "https://w3id.org/sc-referee/schema/v0.16.0/common.schema.json#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "cache_entry_id",
    "cache_scope",
    "content_class",
    "input_digests",
    "output_refs",
    "contains_source_derived_information",
    "cross_repository_reuse_allowed",
    "created_at",
    "provenance"
  ],
  "title": "sc-referee Cache Entry",
  "type": "object"
}

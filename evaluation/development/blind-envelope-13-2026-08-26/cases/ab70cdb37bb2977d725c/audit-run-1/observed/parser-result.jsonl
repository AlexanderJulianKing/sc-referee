{"audit_run_id":"audit:ebbaf2fed4d54ebabd2dc832592c26b8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":36,"end_line":3,"start_column":1,"start_line":3,"text":"File: `gout_titration_outcomes.csv`"},{"end_column":83,"end_line":5,"start_column":1,"start_line":5,"text":"One row is one adult participant in the gout titration study, assessed once at the"},{"end_column":84,"end_line":6,"start_column":1,"start_line":6,"text":"six-month review. There are 58 rows plus a header row: 29 participants on the rapid"},{"end_column":87,"end_line":7,"start_column":1,"start_line":7,"text":"titration schedule and 29 on the slow schedule. Every participant has a value in every"},{"end_column":45,"end_line":8,"start_column":1,"start_line":8,"text":"outcome column, so there are no blank cells."},{"end_column":79,"end_line":10,"start_column":1,"start_line":10,"text":"The five outcome columns appear in the order the study protocol declared them."},{"end_column":37,"end_line":14,"start_column":1,"start_line":14,"text":"| Column | Meaning | Unit or scale |"},{"end_column":20,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- | --- |"},{"end_column":124,"end_line":16,"start_column":1,"start_line":16,"text":"| `participant_id` | Study identifier for the participant, one per row, format `GT-001` to `GT-058` | identifier, no unit |"},{"end_column":193,"end_line":17,"start_column":1,"start_line":17,"text":"| `titration_schedule` | Urate-lowering titration schedule the participant was on: `rapid` (dose increases every two weeks) or `slow` (dose increases every six weeks) | two-level group label |"},{"end_column":115,"end_line":18,"start_column":1,"start_line":18,"text":"| `serum_urate_umol_l` | Declared outcome 1: serum urate at the six-month review | micromoles per litre (umol/L) |"},{"end_column":153,"end_line":19,"start_column":1,"start_line":19,"text":"| `gout_flares_past_3_months_count` | Declared outcome 2: number of gout flares in the three months before the review | count of flares (whole number) |"},{"end_column":132,"end_line":20,"start_column":1,"start_line":20,"text":"| `egfr_ml_min_1_73m2` | Declared outcome 3: estimated glomerular filtration rate | millilitres per minute per 1.73 square metres |"},{"end_column":86,"end_line":21,"start_column":1,"start_line":21,"text":"| `crp_mg_l` | Declared outcome 4: C-reactive protein | milligrams per litre (mg/L) |"},{"end_column":171,"end_line":22,"start_column":1,"start_line":22,"text":"| `worst_joint_pain_0_10_scale` | Declared outcome 5: worst joint pain in the past week | 0 to 10 numeric rating scale, whole number, 0 = no pain, 10 = worst imaginable |"},{"end_column":82,"end_line":26,"start_column":1,"start_line":26,"text":"- The values are invented for this exercise, not measurements from real patients."},{"end_column":84,"end_line":27,"start_column":1,"start_line":27,"text":"- Values were drawn from normal distributions with clinically plausible centres and"},{"end_column":89,"end_line":28,"start_column":3,"start_line":28,"text":"spreads, then held inside plausible clinical limits. Flare counts and pain scores were"},{"end_column":28,"end_line":29,"start_column":3,"start_line":29,"text":"rounded to whole numbers."},{"end_column":86,"end_line":30,"start_column":1,"start_line":30,"text":"- `generate_data.py` in this directory is the script that produced the CSV. It uses a"},{"end_column":63,"end_line":31,"start_column":3,"start_line":31,"text":"fixed random seed, so rerunning it reproduces the same file."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:932fb614134e85736f2b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:c51a1cd5635350e55ea329d5de11f1478bb52b8b56be98192ea3bafd74cccb5e","end_line":31,"locator":"DATA_DESCRIPTION.md:1-31","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:ebbaf2fed4d54ebabd2dc832592c26b8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":113,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `titration_schedule` column of `gout_titration_outcomes.csv`."},{"end_column":170,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: serum_urate_umol_l, gout_flares_past_3_months_count, egfr_ml_min_1_73m2, crp_mg_l, worst_joint_pain_0_10_scale."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4bf0bdf1ce45735e60cb","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:87f341ee55b23f08195f2a450f58b879d230267b9de27fca22262bd2fd35d0f5","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:e81b8e800d3748539305c787193658f4","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":39,"end_line":3,"start_column":1,"start_line":3,"text":"File: `ostrich_chick_grower_trial.csv`"},{"end_column":89,"end_line":7,"start_column":1,"start_line":7,"text":"One row is one ostrich chick. Sixty-four individually identified chicks were reared on a"},{"end_column":88,"end_line":8,"start_column":1,"start_line":8,"text":"commercial farm to 90 days of age, 32 on each of two grower rations, and each chick was"},{"end_column":88,"end_line":9,"start_column":1,"start_line":9,"text":"measured once at the end of the rearing period. The file has 64 data rows plus a header"},{"end_column":83,"end_line":10,"start_column":1,"start_line":10,"text":"row. Every chick has a value in every outcome column, so there are no blank cells."},{"end_column":89,"end_line":14,"start_column":1,"start_line":14,"text":"Columns appear in this order. The eight outcome columns follow the order declared in the"},{"end_column":16,"end_line":15,"start_column":1,"start_line":15,"text":"trial protocol."},{"end_column":32,"end_line":17,"start_column":1,"start_line":17,"text":"| # | Column | Meaning | Unit |"},{"end_column":32,"end_line":18,"start_column":1,"start_line":18,"text":"|---|--------|---------|------|"},{"end_column":124,"end_line":19,"start_column":1,"start_line":19,"text":"| 1 | `bird_id` | Identifier of the individual chick, `OS001` through `OS064`, unique within the file | none (identifier) |"},{"end_column":236,"end_line":20,"start_column":1,"start_line":20,"text":"| 2 | `diet_group` | Rearing diet the chick was allocated to. Exactly two distinct values: `standard` for the farm's standard grower ration, `lucerne_enriched` for the lucerne-enriched, higher-fibre grower ration | none (group label) |"},{"end_column":92,"end_line":21,"start_column":1,"start_line":21,"text":"| 3 | `body_weight_kg` | Live body weight of the chick at 90 days of age | kilograms (kg) |"},{"end_column":120,"end_line":22,"start_column":1,"start_line":22,"text":"| 4 | `average_daily_gain_g_per_day` | Average daily live-weight gain over the rearing period | grams per day (g/day) |"},{"end_column":183,"end_line":23,"start_column":1,"start_line":23,"text":"| 5 | `feed_conversion_ratio` | Feed conversion ratio: kilograms of feed consumed per kilogram of live-weight gain. Lower means more efficient | none (kg feed per kg gain, a ratio) |"},{"end_column":125,"end_line":24,"start_column":1,"start_line":24,"text":"| 6 | `tibiotarsus_length_cm` | Length of the tibiotarsus, the main lower leg bone, measured at 90 days | centimetres (cm) |"},{"end_column":106,"end_line":25,"start_column":1,"start_line":25,"text":"| 7 | `hock_circumference_cm` | Circumference of the hock joint, measured at 90 days | centimetres (cm) |"},{"end_column":107,"end_line":26,"start_column":1,"start_line":26,"text":"| 8 | `serum_total_protein_g_per_l` | Total protein concentration in blood serum | grams per litre (g/L) |"},{"end_column":106,"end_line":27,"start_column":1,"start_line":27,"text":"| 9 | `serum_calcium_mmol_per_l` | Calcium concentration in blood serum | millimoles per litre (mmol/L) |"},{"end_column":121,"end_line":28,"start_column":1,"start_line":28,"text":"| 10 | `packed_cell_volume_percent` | Packed cell volume, the share of blood volume made up of red cells | percent (%) |"},{"end_column":85,"end_line":32,"start_column":1,"start_line":32,"text":"Rows are shuffled, so the two diet groups are interleaved rather than blocked. Group"},{"end_column":61,"end_line":33,"start_column":1,"start_line":33,"text":"membership is read from `diet_group`, not from row position."},{"end_column":89,"end_line":37,"start_column":1,"start_line":37,"text":"The measurements are invented for this project, not collected from real birds. They were"},{"end_column":89,"end_line":38,"start_column":1,"start_line":38,"text":"produced by `make_data.py` in this directory with a fixed random seed, so rerunning that"},{"end_column":80,"end_line":39,"start_column":1,"start_line":39,"text":"script reproduces the same file. Values were drawn per bird from group-specific"},{"end_column":92,"end_line":40,"start_column":1,"start_line":40,"text":"distributions and clipped to plausible physiological limits, with a shared bird-level frame"},{"end_column":89,"end_line":41,"start_column":1,"start_line":41,"text":"factor linking the size-related outcomes so that heavier chicks also tend to show faster"},{"end_column":43,"end_line":42,"start_column":1,"start_line":42,"text":"gain, longer tibiotarsus and thicker hock."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:03249dbb5cd82704577a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f5f67b71a594ab424e96cbf67ef433537c2132ca4f40bdbdb2add441c9e957fa","end_line":42,"locator":"DATA_DESCRIPTION.md:1-42","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:e81b8e800d3748539305c787193658f4","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":108,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `diet_group` column of `ostrich_chick_grower_trial.csv`."},{"end_column":256,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: body_weight_kg, average_daily_gain_g_per_day, feed_conversion_ratio, tibiotarsus_length_cm, hock_circumference_cm, serum_total_protein_g_per_l, serum_calcium_mmol_per_l, packed_cell_volume_percent."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:97873e1f47b61e800a7c","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:8aad26daf17dcdf6d422a8e615ec9fe0b8361403256041108e82ffa5272e0df5","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

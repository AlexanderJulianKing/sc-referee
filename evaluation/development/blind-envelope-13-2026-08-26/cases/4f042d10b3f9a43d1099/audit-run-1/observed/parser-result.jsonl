schema_version":"0.21.0","source_ref":{"content_digest":"sha256:3a2179e1161d6dec46150fc779da3575060a441549fff24abf173c4d786f3f58","end_line":81,"locator":"analysis.py:1-81","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:4a4293ffae4d4240bf864a414171efcd","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":97,"end_line":5,"start_column":1,"start_line":5,"text":"The data file is `groundnut_drying_quality.csv`. One row is one groundnut lot, which is a single"},{"end_column":96,"end_line":6,"start_column":1,"start_line":6,"text":"farmer delivery of roughly 50 kg of freshly lifted groundnuts brought to the collection centre."},{"end_column":97,"end_line":7,"start_column":1,"start_line":7,"text":"Each lot was dried as a unit by one drying method and then sampled once for laboratory analysis."},{"end_column":96,"end_line":8,"start_column":1,"start_line":8,"text":"There are 40 lots: 20 dried in a simple solar dryer and 20 dried in the traditional way on open"},{"end_column":82,"end_line":9,"start_column":1,"start_line":9,"text":"mats. Every lot has a value in every outcome column, so there are no blank cells."},{"end_column":38,"end_line":11,"start_column":1,"start_line":11,"text":"| Column | Meaning | Unit or values |"},{"end_column":20,"end_line":12,"start_column":1,"start_line":12,"text":"| --- | --- | --- |"},{"end_column":119,"end_line":13,"start_column":1,"start_line":13,"text":"| `lot_id` | Identifier for the farmer delivery, in delivery order down the file | Text, `LOT-001` through `LOT-040` |"},{"end_column":93,"end_line":14,"start_column":1,"start_line":14,"text":"| `drying_method` | How the lot was dried | Text, two values: `solar_dryer` and `open_mat` |"},{"end_column":106,"end_line":15,"start_column":1,"start_line":15,"text":"| `moisture_content_percent_wb` | Moisture content of the dried kernels, wet basis | Percent, wet basis |"},{"end_column":105,"end_line":16,"start_column":1,"start_line":16,"text":"| `aflatoxin_b1_ug_per_kg` | Aflatoxin B1 concentration in the dried kernels | Micrograms per kilogram |"},{"end_column":124,"end_line":17,"start_column":1,"start_line":17,"text":"| `free_fatty_acids_percent_oleic` | Free fatty acid content of the extracted oil, as oleic acid | Percent, as oleic acid |"},{"end_column":98,"end_line":19,"start_column":1,"start_line":19,"text":"The three outcome columns are in the order the outcomes were declared in the study plan: moisture"},{"end_column":60,"end_line":20,"start_column":1,"start_line":20,"text":"content first, aflatoxin B1 second, free fatty acids third."},{"end_column":96,"end_line":24,"start_column":1,"start_line":24,"text":"`analysis.py` reads the CSV and compares the two drying methods on each declared outcome with a"},{"end_column":91,"end_line":25,"start_column":1,"start_line":25,"text":"two-sample t-test. The same kind of test is used for all three outcomes. Each outcome is a"},{"end_column":97,"end_line":26,"start_column":1,"start_line":26,"text":"separate quality attribute with its own acceptance limit, so each one is judged on its own terms"},{"end_column":99,"end_line":27,"start_column":1,"start_line":27,"text":"against the conventional 0.05 threshold. Group sizes are 20 solar-dried lots and 20 mat-dried lots"},{"end_column":19,"end_line":28,"start_column":1,"start_line":28,"text":"for every outcome."},{"end_column":95,"end_line":34,"start_column":1,"start_line":34,"text":"Mean 7.632 for solar drying and 8.232 for open mats, a difference of -0.600 percentage points."},{"end_column":99,"end_line":35,"start_column":1,"start_line":35,"text":"The t statistic is -2.5961 and the p-value is 0.0133. At the 0.05 threshold the two drying methods"},{"end_column":42,"end_line":36,"start_column":1,"start_line":36,"text":"differ significantly on moisture content."},{"end_column":96,"end_line":38,"start_column":1,"start_line":38,"text":"Lots that come off the mats hold more water. Moisture is the master control on how a lot keeps."},{"end_column":96,"end_line":39,"start_column":1,"start_line":39,"text":"Wetter kernels support mould growth in the store and lose weight later as they dry down, so the"},{"end_column":92,"end_line":40,"start_column":1,"start_line":40,"text":"mat-dried lots carry more storage risk and need more careful drying before they are bagged."},{"end_column":91,"end_line":44,"start_column":1,"start_line":44,"text":"Mean 6.230 for solar drying and 9.630 for open mats, a difference of -3.400 micrograms per"},{"end_column":94,"end_line":45,"start_column":1,"start_line":45,"text":"kilogram. The t statistic is -2.2502 and the p-value is 0.0303. At the 0.05 threshold the two"},{"end_column":53,"end_line":46,"start_column":1,"start_line":46,"text":"drying methods differ significantly on aflatoxin B1."},{"end_column":97,"end_line":48,"start_column":1,"start_line":48,"text":"This is the food safety outcome. Aflatoxin B1 is a toxin made by *Aspergillus* moulds, and it is"},{"end_column":99,"end_line":49,"start_column":1,"start_line":49,"text":"the one measurement here that can make a lot unfit to sell or unfit to eat rather than merely poor"},{"end_column":92,"end_line":50,"start_column":1,"start_line":50,"text":"quality. Mat-dried lots average more than half again as much of it. The contaminant is also"},{"end_column":98,"end_line":51,"start_column":1,"start_line":51,"text":"right-skewed, meaning most lots sit low while a few run far higher, so the group mean understates"},{"end_column":90,"end_line":52,"start_column":1,"start_line":52,"text":"what the worst individual deliveries look like. A single hot lot can pull a whole blended"},{"end_column":34,"end_line":53,"start_column":1,"start_line":53,"text":"consignment over a buyer's limit."},{"end_column":95,"end_line":57,"start_column":1,"start_line":57,"text":"Mean 0.855 for solar drying and 1.030 for open mats, a difference of -0.175 percentage points."},{"end_column":99,"end_line":58,"start_column":1,"start_line":58,"text":"The t statistic is -2.1987 and the p-value is 0.0341. At the 0.05 threshold the two drying methods"},{"end_column":42,"end_line":59,"start_column":1,"start_line":59,"text":"differ significantly on free fatty acids."},{"end_column":100,"end_line":61,"start_column":1,"start_line":61,"text":"Free fatty acids measure how far the oil in the kernel has broken down. Higher values mean oil that"},{"end_column":98,"end_line":62,"start_column":1,"start_line":62,"text":"is closer to going rancid, which costs the lot on flavour, on shelf life, and on the price an oil"},{"end_column":96,"end_line":63,"start_column":1,"start_line":63,"text":"buyer will pay. The mat-dried lots are worse on this outcome too, which fits the slower, wetter"},{"end_column":32,"end_line":64,"start_column":1,"start_line":64,"text":"drying those lots went through."},{"end_column":96,"end_line":68,"start_column":1,"start_line":68,"text":"Solar drying came out better than open-mat drying on all three declared outcomes, and all three"},{"end_column":91,"end_line":69,"start_column":1,"start_line":69,"text":"differences reach significance at the 0.05 threshold. Solar-dried lots were drier by 0.600"},{"end_column":96,"end_line":70,"start_column":1,"start_line":70,"text":"percentage points of moisture, carried 3.400 micrograms per kilogram less aflatoxin B1, and had"},{"end_column":48,"end_line":71,"start_column":1,"start_line":71,"text":"0.175 percentage points lower free fatty acids."},{"end_column":99,"end_line":73,"start_column":1,"start_line":73,"text":"The recommendation to the collection centre is to move deliveries onto the simple solar dryers and"},{"end_column":95,"end_line":74,"start_column":1,"start_line":74,"text":"to treat open-mat drying as the fallback for times when dryer capacity runs out. The aflatoxin"},{"end_column":94,"end_line":75,"start_column":1,"start_line":75,"text":"result is the one that should drive the decision, because it is a safety issue and not only a"},{"end_column":99,"end_line":76,"start_column":1,"start_line":76,"text":"quality issue. Two practical steps go with it. First, keep testing incoming lots one by one rather"},{"end_column":97,"end_line":77,"start_column":1,"start_line":77,"text":"than relying on the group average, since the skewed aflatoxin values mean a few deliveries carry"},{"end_column":96,"end_line":78,"start_column":1,"start_line":78,"text":"most of the risk. Second, if mat drying has to be used, keep those lots separate at intake so a"},{"end_column":79,"end_line":79,"start_column":1,"start_line":79,"text":"high-aflatoxin lot cannot contaminate a good consignment when lots are bulked."},{"end_column":68,"end_line":81,"start_column":1,"start_line":81,"text":"All numbers in this report are the values printed by `analysis.py`."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d262001cd87742fbc3b2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:75ac8821e51d3374e05a47314722d1b72483d41719707212646a3b72d97b86bc","end_line":81,"locator":"report.md:1-81","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

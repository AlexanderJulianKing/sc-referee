.py","quoted_text":"print(f\"  t statistic: {result['statistic']:.4f}\")","source_kind":"file_span","start_column":9,"start_line":68}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:95add1f8bc25e427fbd1","output_refs":[],"record_type":"operation","run_id":"audit:4a4293ffae4d4240bf864a414171efcd","source_refs":[{"content_digest":"sha256:3a2179e1161d6dec46150fc779da3575060a441549fff24abf173c4d786f3f58","end_column":53,"end_line":69,"locator":"analysis.py:69-69","path":"analysis.py","quoted_text":"print(f\"  p-value: {result['p_value']:.4f}\")","source_kind":"file_span","start_column":9,"start_line":69}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:b98fa3d9631aeb28fa7a","output_refs":[],"record_type":"operation","run_id":"audit:4a4293ffae4d4240bf864a414171efcd","source_refs":[{"content_digest":"sha256:3a2179e1161d6dec46150fc779da3575060a441549fff24abf173c4d786f3f58","end_column":58,"end_line":70,"locator":"analysis.py:70-70","path":"analysis.py","quoted_text":"print(f\"  verdict at alpha = {ALPHA}: {verdict}\")","source_kind":"file_span","start_column":9,"start_line":70}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:652fd5cb505dde7df4f7","output_refs":[],"record_type":"operation","run_id":"audit:4a4293ffae4d4240bf864a414171efcd","source_refs":[{"content_digest":"sha256:3a2179e1161d6dec46150fc779da3575060a441549fff24abf173c4d786f3f58","end_column":16,"end_line":71,"locator":"analysis.py:71-71","path":"analysis.py","quoted_text":"print()","source_kind":"file_span","start_column":9,"start_line":71}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"ope
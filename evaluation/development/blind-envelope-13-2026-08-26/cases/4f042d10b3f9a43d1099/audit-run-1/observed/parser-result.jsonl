{"audit_run_id":"audit:4a4293ffae4d4240bf864a414171efcd","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":37,"end_line":3,"start_column":1,"start_line":3,"text":"File: `groundnut_drying_quality.csv`"},{"end_column":92,"end_line":7,"start_column":1,"start_line":7,"text":"One row is one groundnut lot. A lot is a single farmer delivery of roughly 50 kg of freshly"},{"end_column":95,"end_line":8,"start_column":1,"start_line":8,"text":"lifted groundnuts brought to the collection centre. Each lot was dried as a unit by one drying"},{"end_column":95,"end_line":9,"start_column":1,"start_line":9,"text":"method, then sampled once for laboratory analysis. The file holds 40 lots (40 data rows plus a"},{"end_column":96,"end_line":10,"start_column":1,"start_line":10,"text":"header row): 20 dried in a simple solar dryer and 20 dried in the traditional way on open mats."},{"end_column":76,"end_line":11,"start_column":1,"start_line":11,"text":"Every lot has a value in every outcome column, so there are no blank cells."},{"end_column":37,"end_line":15,"start_column":1,"start_line":15,"text":"| Column | Meaning | Unit / values |"},{"end_column":20,"end_line":16,"start_column":1,"start_line":16,"text":"| --- | --- | --- |"},{"end_column":119,"end_line":17,"start_column":1,"start_line":17,"text":"| `lot_id` | Identifier for the farmer delivery, in delivery order down the file | Text, `LOT-001` through `LOT-040` |"},{"end_column":152,"end_line":18,"start_column":1,"start_line":18,"text":"| `drying_method` | How the lot was dried | Text, exactly two values: `solar_dryer` (simple solar dryer) and `open_mat` (traditional open-mat drying) |"},{"end_column":120,"end_line":19,"start_column":1,"start_line":19,"text":"| `moisture_content_percent_wb` | Moisture content of the dried kernels, measured on a wet basis | Percent, wet basis |"},{"end_column":105,"end_line":20,"start_column":1,"start_line":20,"text":"| `aflatoxin_b1_ug_per_kg` | Aflatoxin B1 concentration in the dried kernels | Micrograms per kilogram |"},{"end_column":134,"end_line":21,"start_column":1,"start_line":21,"text":"| `free_fatty_acids_percent_oleic` | Free fatty acid content of the extracted oil, expressed as oleic acid | Percent, as oleic acid |"},{"end_column":92,"end_line":23,"start_column":1,"start_line":23,"text":"The three outcome columns appear in the order the outcomes were declared in the study plan:"},{"end_column":69,"end_line":24,"start_column":1,"start_line":24,"text":"moisture content first, aflatoxin B1 second, free fatty acids third."},{"end_column":94,"end_line":28,"start_column":1,"start_line":28,"text":"The measurements are invented but chosen to be plausible for a humid tropical harvest season."},{"end_column":98,"end_line":29,"start_column":1,"start_line":29,"text":"Moisture content sits in the high single digits in percent. Aflatoxin B1 is right-skewed, so most"},{"end_column":97,"end_line":30,"start_column":1,"start_line":30,"text":"lots sit low and a few run much higher, which is how the contaminant behaves in real deliveries."},{"end_column":99,"end_line":31,"start_column":1,"start_line":31,"text":"Free fatty acids sit near one percent. Numbers are rounded the way a laboratory sheet would report"},{"end_column":82,"end_line":32,"start_column":1,"start_line":32,"text":"them: moisture and free fatty acids to two decimals, aflatoxin B1 to one decimal."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:71c1186b6ec7838ac1ce","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:8b48ff6ae0640a469e55be7395028b50e5a7f92cfb1f45cac30d0fed97d5bdf8","end_line":32,"locator":"DATA_DESCRIPTION.md:1-32","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:4a4293ffae4d4240bf864a414171efcd","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":109,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `drying_method` column of `groundnut_drying_quality.csv`."},{"end_column":143,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: moisture_content_percent_wb, aflatoxin_b1_ug_per_kg, free_fatty_acids_percent_oleic."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:eba8fc49d1560b99ce10","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:34c7acfecf04dccf7bf4fe7eaa50a50aad97d046d7fb7211d8102bb935922cda","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:8b71447144e54bafa544570109e0f784","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":36,"end_line":3,"start_column":1,"start_line":3,"text":"File: `penguin_chick_condition.csv`"},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"One row is one Adelie penguin chick, measured once at about 25 days of age. The file"},{"end_column":85,"end_line":6,"start_column":1,"start_line":6,"text":"holds 48 chicks (plus a header row): 25 from the near sub-colony and 23 from the far"},{"end_column":85,"end_line":7,"start_column":1,"start_line":7,"text":"sub-colony of a single breeding site. Every chick has a value in every column; there"},{"end_column":20,"end_line":8,"start_column":1,"start_line":8,"text":"are no blank cells."},{"end_column":28,"end_line":12,"start_column":1,"start_line":12,"text":"| Column | Meaning | Unit |"},{"end_column":20,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- |"},{"end_column":104,"end_line":14,"start_column":1,"start_line":14,"text":"| `chick_id` | Identifier for the chick, unique across the file (`AP001`–`AP048`) | none (text label) |"},{"end_column":184,"end_line":15,"start_column":1,"start_line":15,"text":"| `sub_colony` | Which sub-colony the chick belongs to. Exactly two values: `near` (adults forage a short distance away) and `far` (adults commute much further) | none (group label) |"},{"end_column":55,"end_line":16,"start_column":1,"start_line":16,"text":"| `body_mass_g` | Body mass of the chick | grams (g) |"},{"end_column":73,"end_line":17,"start_column":1,"start_line":17,"text":"| `flipper_length_mm` | Flipper length of the chick | millimetres (mm) |"},{"end_column":86,"end_line":18,"start_column":1,"start_line":18,"text":"| `haemoglobin_g_dl` | Blood haemoglobin concentration | grams per decilitre (g/dL) |"},{"end_column":100,"end_line":19,"start_column":1,"start_line":19,"text":"| `corticosterone_ng_ml` | Plasma corticosterone concentration | nanograms per millilitre (ng/mL) |"},{"end_column":84,"end_line":21,"start_column":1,"start_line":21,"text":"The four outcome columns appear in the order declared in the study plan: body mass,"},{"end_column":45,"end_line":22,"start_column":1,"start_line":22,"text":"flipper length, haemoglobin, corticosterone."},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"- Values are invented but chosen to be plausible for wild chicks of this age."},{"end_column":69,"end_line":27,"start_column":1,"start_line":27,"text":"- Rows are not sorted by sub-colony; the two groups are interleaved."},{"end_column":79,"end_line":28,"start_column":1,"start_line":28,"text":"- Recorded precision: body mass whole grams, flipper length one decimal place,"},{"end_column":68,"end_line":29,"start_column":3,"start_line":29,"text":"haemoglobin one decimal place, corticosterone two decimal places."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:af3467a646bdc3a73b25","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f9902fb6195041193cf7f7d9d544b5b49b18e344f312daf2d00c735cd39ee9e4","end_line":29,"locator":"DATA_DESCRIPTION.md:1-29","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:8b71447144e54bafa544570109e0f784","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":105,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `sub_colony` column of `penguin_chick_condition.csv`."},{"end_column":130,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: body_mass_g, flipper_length_mm, haemoglobin_g_dl, corticosterone_ng_ml."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:92d0522e000762c680ab","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:972f66e255cdadc08547cebdd121231d67ab238abf4a23edf5ae3430acabaab7","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

"end_line":48,"locator":"analysis.py:48-48","path":"analysis.py","quoted_text":"len(data)","source_kind":"file_span","start_column":43,"start_line":48}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:d861690af088caf76afe","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":80,"end_line":49,"locator":"analysis.py:49-49","path":"analysis.py","quoted_text":"print(\"Test used for every outcome: Welch's two-sample t-test (two-sided)\")","source_kind":"file_span","start_column":5,"start_line":49}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:f6c340bb45c2ee1047a8","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":72,"end_line":50,"locator":"analysis.py:50-50","path":"analysis.py","quoted_text":"print(f\"Significance threshold for every outcome: alpha = {ALPHA}\")","source_kind":"file_span","start_column":5,"start_line":50}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:6df19745dce218fa25ca","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":12,"end_line":51,"locator":"analysis.py:51-51","path":"analysis.py","quoted_text":"print()","source_kind":"file_span","start_column":5,"start_line":51}]},{"implementation":"python.call:report_outcome","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:c24ea1c82af4bab6587e","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":6,"end_line":61,"locator":"analysis.py:54-61","path":"analysis.py","quoted_text":"report_outcome(\n        1,\n        \"body_mass_g\",\n        \"Body mass\",\n        \"g\",\n        near[\"body_mass_g\"],\n        far[\"body_mass_g\"],\n    )","source_kind":"file_span","start_column":5,"start_line":54}]},{"implementation":"python.call:report_outcome","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:beaf536ce5c0d8c9255f","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":6,"end_line":71,"locator":"analysis.py:64-71","path":"analysis.py","quoted_text":"report_outcome(\n        2,\n        \"flipper_length_mm\",\n        \"Flipper length\",\n        \"mm\",\n        near[\"flipper_length_mm\"],\n        far[\"flipper_length_mm\"],\n    )","source_kind":"file_span","start_column":5,"start_line":64}]},{"implementation":"python.call:report_outcome","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:c8e462c8a23d84884c04","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":6,"end_line":81,"locator":"analysis.py:74-81","path":"analysis.py","quoted_text":"report_outcome(\n        3,\n        \"haemoglobin_g_dl\",\n        \"Blood haemoglobin\",\n        \"g/dL\",\n        near[\"haemoglobin_g_dl\"],\n        far[\"haemoglobin_g_dl\"],\n    )","source_kind":"file_span","start_column":5,"start_line":74}]},{"implementation":"python.call:report_outcome","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:3fb5049d944f04aada28","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":6,"end_line":91,"locator":"analysis.py:84-91","path":"analysis.py","quoted_text":"report_outcome(\n        4,\n        \"corticosterone_ng_ml\",\n        \"Plasma corticosterone\",\n        \"ng/mL\",\n        near[\"corticosterone_ng_ml\"],\n        far[\"corticosterone_ng_ml\"],\n    )","source_kind":"file_span","start_column":5,"start_line":84}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:c547547ea15147fe4163","output_refs":[],"record_type":"operation","run_id":"audit:8b71447144e54bafa544570109e0f784","source_refs":[{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_column":11,"end_line":95,"locator":"analysis.py:95-95","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":95}]}],"x-token-count":362},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:b035e20094144f46a3cc","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:877b374b91af0b0b7a7ff8d17bc44db9f7f2190a0021f7c729693ab612eff34a","end_line":95,"locator":"analysis.py:1-95","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:8b71447144e54bafa544570109e0f784","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"The data file is `penguin_chick_condition.csv`. One row is one Adelie penguin chick,"},{"end_column":86,"end_line":6,"start_column":1,"start_line":6,"text":"measured once at about 25 days of age. There are 48 chicks: 25 in the near sub-colony"},{"end_column":83,"end_line":7,"start_column":1,"start_line":7,"text":"and 23 in the far sub-colony of the same breeding site. Every chick has a value in"},{"end_column":44,"end_line":8,"start_column":1,"start_line":8,"text":"every column, and there are no blank cells."},{"end_column":28,"end_line":10,"start_column":1,"start_line":10,"text":"| Column | Meaning | Unit |"},{"end_column":20,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- | --- |"},{"end_column":86,"end_line":12,"start_column":1,"start_line":12,"text":"| `chick_id` | Identifier for the chick, unique across the file | none (text label) |"},{"end_column":157,"end_line":13,"start_column":1,"start_line":13,"text":"| `sub_colony` | Sub-colony the chick belongs to: `near` (adults forage a short distance away) or `far` (adults commute much further) | none (group label) |"},{"end_column":55,"end_line":14,"start_column":1,"start_line":14,"text":"| `body_mass_g` | Body mass of the chick | grams (g) |"},{"end_column":73,"end_line":15,"start_column":1,"start_line":15,"text":"| `flipper_length_mm` | Flipper length of the chick | millimetres (mm) |"},{"end_column":86,"end_line":16,"start_column":1,"start_line":16,"text":"| `haemoglobin_g_dl` | Blood haemoglobin concentration | grams per decilitre (g/dL) |"},{"end_column":100,"end_line":17,"start_column":1,"start_line":17,"text":"| `corticosterone_ng_ml` | Plasma corticosterone concentration | nanograms per millilitre (ng/mL) |"},{"end_column":84,"end_line":19,"start_column":1,"start_line":19,"text":"The four outcome columns appear in the order declared in the study plan: body mass,"},{"end_column":45,"end_line":20,"start_column":1,"start_line":20,"text":"flipper length, haemoglobin, corticosterone."},{"end_column":86,"end_line":24,"start_column":1,"start_line":24,"text":"`analysis.py` reads the CSV and compares the near and far sub-colonies on each of the"},{"end_column":85,"end_line":25,"start_column":1,"start_line":25,"text":"four declared outcomes. The same test is used for every outcome: a two-sided Welch's"},{"end_column":83,"end_line":26,"start_column":1,"start_line":26,"text":"two-sample t-test, which does not assume the two groups have equal variances. Each"},{"end_column":86,"end_line":27,"start_column":1,"start_line":27,"text":"outcome answers its own biological question about chick condition, so each comparison"},{"end_column":63,"end_line":28,"start_column":1,"start_line":28,"text":"is judged on its own terms at the conventional 0.05 threshold."},{"end_column":80,"end_line":34,"start_column":1,"start_line":34,"text":"n = 25 near, 23 far. Mean near 2665.680 g, mean far 2487.522 g, a difference of"},{"end_column":41,"end_line":35,"start_column":1,"start_line":35,"text":"178.158 g. Welch t = 2.6720, p = 0.0104."},{"end_column":81,"end_line":37,"start_column":1,"start_line":37,"text":"Verdict at 0.05: significant. The near and far sub-colonies differ in body mass."},{"end_column":84,"end_line":38,"start_column":1,"start_line":38,"text":"Chicks in the near sub-colony are on average about 178 g heavier, which is what you"},{"end_column":86,"end_line":39,"start_column":1,"start_line":39,"text":"would expect if their parents deliver food after shorter foraging trips. Body mass at"},{"end_column":79,"end_line":40,"start_column":1,"start_line":40,"text":"this age is the most direct measure of how much food a chick has been getting."},{"end_column":80,"end_line":44,"start_column":1,"start_line":44,"text":"n = 25 near, 23 far. Mean near 139.060 mm, mean far 135.674 mm, a difference of"},{"end_column":40,"end_line":45,"start_column":1,"start_line":45,"text":"3.386 mm. Welch t = 1.6497, p = 0.1058."},{"end_column":86,"end_line":47,"start_column":1,"start_line":47,"text":"Verdict at 0.05: not significant. There is no clear difference in flipper length. The"},{"end_column":82,"end_line":48,"start_column":1,"start_line":48,"text":"near chicks average about 3.4 mm longer, but the spread within each group is wide"},{"end_column":87,"end_line":49,"start_column":1,"start_line":49,"text":"enough that this size of gap is not unusual by chance. Skeletal growth appears similar"},{"end_column":87,"end_line":50,"start_column":1,"start_line":50,"text":"in the two sub-colonies, which fits the idea that structural size responds more slowly"},{"end_column":54,"end_line":51,"start_column":1,"start_line":51,"text":"than mass to short-term differences in food delivery."},{"end_column":82,"end_line":55,"start_column":1,"start_line":55,"text":"n = 25 near, 23 far. Mean near 16.528 g/dL, mean far 16.230 g/dL, a difference of"},{"end_column":42,"end_line":56,"start_column":1,"start_line":56,"text":"0.298 g/dL. Welch t = 0.7854, p = 0.4365."},{"end_column":86,"end_line":58,"start_column":1,"start_line":58,"text":"Verdict at 0.05: not significant. Haemoglobin looks the same in the two sub-colonies."},{"end_column":84,"end_line":59,"start_column":1,"start_line":59,"text":"The gap of about 0.3 g/dL is small next to the within-group spread. Oxygen-carrying"},{"end_column":86,"end_line":60,"start_column":1,"start_line":60,"text":"capacity, which matters for diving later in life, is not detectably affected by which"},{"end_column":34,"end_line":61,"start_column":1,"start_line":61,"text":"sub-colony a chick was reared in."},{"end_column":82,"end_line":65,"start_column":1,"start_line":65,"text":"n = 25 near, 23 far. Mean near 7.172 ng/mL, mean far 8.289 ng/mL, a difference of"},{"end_column":45,"end_line":66,"start_column":1,"start_line":66,"text":"-1.117 ng/mL. Welch t = -1.3797, p = 0.1743."},{"end_column":83,"end_line":68,"start_column":1,"start_line":68,"text":"Verdict at 0.05: not significant. Corticosterone, the main stress hormone measured"},{"end_column":81,"end_line":69,"start_column":1,"start_line":69,"text":"here, does not differ clearly between the sub-colonies. Far chicks average about"},{"end_column":84,"end_line":70,"start_column":1,"start_line":70,"text":"1.1 ng/mL higher, the direction you would expect if longer waits between meals were"},{"end_column":80,"end_line":71,"start_column":1,"start_line":71,"text":"stressful, but the difference is not large enough relative to the scatter to be"},{"end_column":42,"end_line":72,"start_column":1,"start_line":72,"text":"distinguished from chance in this sample."},{"end_column":82,"end_line":76,"start_column":1,"start_line":76,"text":"Of the four declared aspects of chick condition, only body mass separates the two"},{"end_column":83,"end_line":77,"start_column":1,"start_line":77,"text":"sub-colonies at the 0.05 threshold: chicks in the near sub-colony are heavier than"},{"end_column":83,"end_line":78,"start_column":1,"start_line":78,"text":"chicks in the far sub-colony. Flipper length, haemoglobin, and corticosterone show"},{"end_column":85,"end_line":79,"start_column":1,"start_line":79,"text":"differences in the expected directions but none reach significance in this sample of"},{"end_column":86,"end_line":80,"start_column":1,"start_line":80,"text":"48 chicks. The picture is one of a difference in current energy stores rather than in"},{"end_column":74,"end_line":81,"start_column":1,"start_line":81,"text":"skeletal growth, blood oxygen capacity, or measured stress hormone level."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:a811335bb3803ed476d3","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f0ed9834bc1c73695cbfd516d68b62b37b84d6d9aabc1085e34603511c261ae7","end_line":81,"locator":"report.md:1-81","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

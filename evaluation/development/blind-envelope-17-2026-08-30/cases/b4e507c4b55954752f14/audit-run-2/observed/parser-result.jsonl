9929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_column":55,"end_line":84,"locator":"analysis.py:84-84","path":"analysis.py","quoted_text":"b.mean()","source_kind":"file_span","start_column":47,"start_line":84}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:0530222d59f5fc038208","output_refs":[],"record_type":"operation","run_id":"audit:25da8830db5c439d9ed2b7d616d53564","source_refs":[{"content_digest":"sha256:779929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_column":50,"end_line":85,"locator":"analysis.py:85-85","path":"analysis.py","quoted_text":"print(\"   %s = %.4f\" % (p_label, p_used))","source_kind":"file_span","start_column":9,"start_line":85}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:b35a2cdeb971747ee576","output_refs":[],"record_type":"operation","run_id":"audit:25da8830db5c439d9ed2b7d616d53564","source_refs":[{"content_digest":"sha256:779929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_column":42,"end_line":86,"locator":"analysis.py:86-86","path":"analysis.py","quoted_text":"print(\"   verdict: %s\" % verdict)","source_kind":"file_span","start_column":9,"start_line":86}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:5dea5f051fa602da3cd4","output_refs":[],"record_type":"operation","run_id":"audit:25da8830db5c439d9ed2b7d616d53564","source_refs":[{"content_digest":"sha256:779929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_column":18,"end_line":87,"locator":"analysis.py:87-87","path":"analysis.py","quoted_text":"print(\"\")","source_kind":"file_span","start_column":9,"start_line":87}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:2e68577dc5bbaa3bb09f","output_refs":[],"record_type":"operation","run_id":"audit:25da8830db5c439d9ed2b7d616d53564","source_refs":[{"content_digest":"sha256:779929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_column":11,"end_line":91,"locator":"analysis.py:91-91","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":91}]}],"x-token-count":412},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:a08f517294810affd0a1","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:779929231eaa6b56005f6ab37314890f8c876bc7d8b97ed7cabbd0f7b1e8f052","end_line":91,"locator":"analysis.py:1-91","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:25da8830db5c439d9ed2b7d616d53564","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Occupational health team, claims processing site. Internal evaluation summary."},{"end_column":88,"end_line":7,"start_column":1,"start_line":7,"text":"We evaluated height-adjustable sit-stand workstations for desk-based claims processors."},{"end_column":88,"end_line":8,"start_column":1,"start_line":8,"text":"Fifty-six employees doing the same job at the same site took part for twelve weeks. The"},{"end_column":33,"end_line":9,"start_column":1,"start_line":9,"text":"two workstation conditions were:"},{"end_column":80,"end_line":11,"start_column":1,"start_line":11,"text":"- **fixed desk** — 28 employees continued at their existing fixed-height desks;"},{"end_column":91,"end_line":12,"start_column":1,"start_line":12,"text":"- **sit-stand** — 28 employees received a height-adjustable sit-stand workstation together"},{"end_column":33,"end_line":13,"start_column":3,"start_line":13,"text":"with a short training session."},{"end_column":88,"end_line":15,"start_column":1,"start_line":15,"text":"These two conditions are the only comparison in the evaluation. Measurements were taken"},{"end_column":88,"end_line":16,"start_column":1,"start_line":16,"text":"over the final working week, from the questionnaires, the chair-and-desk posture logger"},{"end_column":27,"end_line":17,"start_column":1,"start_line":17,"text":"and the keyboard software."},{"end_column":83,"end_line":21,"start_column":1,"start_line":21,"text":"The data file is `workstation_evaluation.csv`. **One row is one employee.** All 56"},{"end_column":88,"end_line":22,"start_column":1,"start_line":22,"text":"employees appear exactly once, 28 in each condition, with no missing cells and no extra"},{"end_column":23,"end_line":23,"start_column":1,"start_line":23,"text":"rows. The columns are:"},{"end_column":27,"end_line":25,"start_column":1,"start_line":25,"text":"| Column | What it holds |"},{"end_column":27,"end_line":26,"start_column":1,"start_line":26,"text":"|--------|---------------|"},{"end_column":90,"end_line":27,"start_column":1,"start_line":27,"text":"| `employee_id` | employee identifier, `EMP` prefix plus a zero-padded two-digit serial |"},{"end_column":84,"end_line":28,"start_column":1,"start_line":28,"text":"| `workstation_group` | workstation condition, either `fixed_desk` or `sit_stand` |"},{"end_column":125,"end_line":29,"start_column":1,"start_line":29,"text":"| `neck_shoulder_discomfort_0_10` | neck and shoulder discomfort over the past week, 0 to 10 rating scale, higher is worse |"},{"end_column":115,"end_line":30,"start_column":1,"start_line":30,"text":"| `lower_back_discomfort_0_10` | lower-back discomfort over the past week, 0 to 10 rating scale, higher is worse |"},{"end_column":73,"end_line":31,"start_column":1,"start_line":31,"text":"| `sitting_time_min` | sitting time during the working day, in minutes |"},{"end_column":101,"end_line":32,"start_column":1,"start_line":32,"text":"| `sit_to_stand_changes_per_day` | number of sit-to-stand posture changes per working day, a count |"},{"end_column":83,"end_line":33,"start_column":1,"start_line":33,"text":"| `end_of_day_fatigue_0_10` | end-of-day fatigue, 0 to 10 scale, higher is worse |"},{"end_column":90,"end_line":34,"start_column":1,"start_line":34,"text":"| `typing_throughput_kpm` | typing throughput, keystrokes per minute during logged work |"},{"end_column":99,"end_line":35,"start_column":1,"start_line":35,"text":"| `work_engagement_0_6` | work engagement, 0 to 6 questionnaire scale, higher means more engaged |"},{"end_column":90,"end_line":37,"start_column":1,"start_line":37,"text":"Columns three to nine are the seven declared outcome variables, in the order fixed in the"},{"end_column":60,"end_line":38,"start_column":1,"start_line":38,"text":"evaluation protocol before the workstations were installed."},{"end_column":89,"end_line":42,"start_column":1,"start_line":42,"text":"All of the analysis is in `analysis.py`. For each of the seven declared outcomes, in the"},{"end_column":81,"end_line":43,"start_column":1,"start_line":43,"text":"declared order, the two workstation conditions were compared with an independent"},{"end_column":19,"end_line":44,"start_column":1,"start_line":44,"text":"two-sample t-test."},{"end_column":82,"end_line":46,"start_column":1,"start_line":46,"text":"The protocol distinguishes two kinds of outcome, and we treated them differently."},{"end_column":84,"end_line":48,"start_column":1,"start_line":48,"text":"- The **three musculoskeletal outcomes** — neck and shoulder discomfort, lower-back"},{"end_column":90,"end_line":49,"start_column":3,"start_line":49,"text":"discomfort and sitting time — are what the evaluation was commissioned to answer. Their"},{"end_column":91,"end_line":50,"start_column":3,"start_line":50,"text":"p-values were corrected by hand in the script: each raw p-value was multiplied by 7, the"},{"end_column":89,"end_line":51,"start_column":3,"start_line":51,"text":"number of comparisons made in this evaluation, and any product above one was capped at"},{"end_column":90,"end_line":52,"start_column":3,"start_line":52,"text":"one. These three outcomes were judged against the conventional 0.05 threshold using the"},{"end_column":20,"end_line":53,"start_column":3,"start_line":53,"text":"corrected values."},{"end_column":87,"end_line":54,"start_column":1,"start_line":54,"text":"- The **four supporting outcomes** — sit-to-stand posture changes, end-of-day fatigue,"},{"end_column":89,"end_line":55,"start_column":3,"start_line":55,"text":"typing throughput and work engagement — were each judged against the conventional 0.05"},{"end_column":74,"end_line":56,"start_column":3,"start_line":56,"text":"threshold using their own raw p-value, exactly as the test produced it."},{"end_column":89,"end_line":60,"start_column":1,"start_line":60,"text":"Each outcome below is given in the declared order, with the mean for each condition, the"},{"end_column":65,"end_line":61,"start_column":1,"start_line":61,"text":"p-value used to judge it, and the verdict at the 0.05 threshold."},{"end_column":78,"end_line":63,"start_column":1,"start_line":63,"text":"**1. Neck and shoulder discomfort (0-10)** — fixed desk 4.79, sit-stand 3.64."},{"end_column":59,"end_line":64,"start_column":1,"start_line":64,"text":"Raw p = 0.0248; corrected p = 0.1734. **Not significant.**"},{"end_column":71,"end_line":66,"start_column":1,"start_line":66,"text":"**2. Lower-back discomfort (0-10)** — fixed desk 4.07, sit-stand 3.25."},{"end_column":59,"end_line":67,"start_column":1,"start_line":67,"text":"Raw p = 0.0845; corrected p = 0.5912. **Not significant.**"},{"end_column":85,"end_line":69,"start_column":1,"start_line":69,"text":"**3. Sitting time (minutes per working day)** — fixed desk 371.64, sit-stand 293.04."},{"end_column":62,"end_line":70,"start_column":1,"start_line":70,"text":"Raw p = 0.00000099; corrected p = 0.0000069. **Significant.**"},{"end_column":90,"end_line":72,"start_column":1,"start_line":72,"text":"**4. Sit-to-stand posture changes (per working day)** — fixed desk 8.82, sit-stand 17.18."},{"end_column":41,"end_line":73,"start_column":1,"start_line":73,"text":"Raw p = 0.000000000021. **Significant.**"},{"end_column":68,"end_line":75,"start_column":1,"start_line":75,"text":"**5. End-of-day fatigue (0-10)** — fixed desk 5.25, sit-stand 4.57."},{"end_column":37,"end_line":76,"start_column":1,"start_line":76,"text":"Raw p = 0.0998. **Not significant.**"},{"end_column":88,"end_line":78,"start_column":1,"start_line":78,"text":"**6. Typing throughput (keystrokes per minute)** — fixed desk 209.77, sit-stand 205.41."},{"end_column":37,"end_line":79,"start_column":1,"start_line":79,"text":"Raw p = 0.5863. **Not significant.**"},{"end_column":64,"end_line":81,"start_column":1,"start_line":81,"text":"**7. Work engagement (0-6)** — fixed desk 3.89, sit-stand 4.08."},{"end_column":37,"end_line":82,"start_column":1,"start_line":82,"text":"Raw p = 0.4069. **Not significant.**"},{"end_column":89,"end_line":86,"start_column":1,"start_line":86,"text":"The sit-stand workstations changed how employees spent the working day. Employees with a"},{"end_column":88,"end_line":87,"start_column":1,"start_line":87,"text":"sit-stand workstation sat about 79 minutes less per working day and made about twice as"},{"end_column":87,"end_line":88,"start_column":1,"start_line":88,"text":"many sit-to-stand posture changes, roughly 17 against 9. Both of these differences are"},{"end_column":42,"end_line":89,"start_column":1,"start_line":89,"text":"significant on the tests as judged above."},{"end_column":91,"end_line":91,"start_column":1,"start_line":91,"text":"The discomfort ratings moved in the expected direction, with sit-stand employees reporting"},{"end_column":88,"end_line":92,"start_column":1,"start_line":92,"text":"about 1.1 points less neck and shoulder discomfort and about 0.8 points less lower-back"},{"end_column":91,"end_line":93,"start_column":1,"start_line":93,"text":"discomfort, but neither reached significance once the correction for the seven comparisons"},{"end_column":92,"end_line":94,"start_column":1,"start_line":94,"text":"was applied. End-of-day fatigue was also lower in the sit-stand group, by about 0.7 points,"},{"end_column":89,"end_line":95,"start_column":1,"start_line":95,"text":"without reaching the threshold. Typing throughput and work engagement were close between"},{"end_column":85,"end_line":96,"start_column":1,"start_line":96,"text":"the two conditions, so there is no sign here that the workstations cost the team any"},{"end_column":8,"end_line":97,"start_column":1,"start_line":97,"text":"output."},{"end_column":87,"end_line":99,"start_column":1,"start_line":99,"text":"**Recommendation to the employer.** The behaviour change is clear and the productivity"},{"end_column":90,"end_line":100,"start_column":1,"start_line":100,"text":"measures show no penalty, so continuing with sit-stand workstations for desk-based claims"},{"end_column":89,"end_line":101,"start_column":1,"start_line":101,"text":"processors is reasonable on those grounds. The comfort benefit, which is the outcome the"},{"end_column":87,"end_line":102,"start_column":1,"start_line":102,"text":"evaluation was commissioned to answer, is suggested by the data but not established at"},{"end_column":85,"end_line":103,"start_column":1,"start_line":103,"text":"this sample size. If the employer wants an answer on discomfort, a larger group or a"},{"end_column":87,"end_line":104,"start_column":1,"start_line":104,"text":"longer follow-up would be needed. We would also keep the short training session in any"},{"end_column":59,"end_line":105,"start_column":1,"start_line":105,"text":"rollout, since that was part of the condition tested here."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:abc3933d365d18ecae23","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:386b58a154961b1654c7d5c4bc2c1e9943c3d67ec110f9beaa4a5d39036e6e51","end_line":105,"locator":"report.md:1-105","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

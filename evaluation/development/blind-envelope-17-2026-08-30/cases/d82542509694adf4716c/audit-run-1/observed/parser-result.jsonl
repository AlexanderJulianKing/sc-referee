chema_version":"0.21.0","source_ref":{"content_digest":"sha256:054b8c08f4c2a02c5bc41244579b9da392ed9cfbc7e2d4b54ed4c140124a9326","end_line":79,"locator":"analysis.py:1-79","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:70648ae831e645bcacd3e52c3e8aa634","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":91,"end_line":5,"start_column":1,"start_line":5,"text":"Forty-eight adult African grey parrots at the rescue and rehoming centre, all individually"},{"end_column":93,"end_line":6,"start_column":1,"start_line":6,"text":"housed in identical aviaries and all previously maintained on a seed-based diet, were put on"},{"end_column":92,"end_line":7,"start_column":1,"start_line":7,"text":"one of two maintenance diets for twelve weeks: a complete extruded pelleted diet (24 birds)"},{"end_column":89,"end_line":8,"start_column":1,"start_line":8,"text":"or a continued seed-based diet with fresh produce (24 birds). The two diets are the only"},{"end_column":88,"end_line":9,"start_column":1,"start_line":9,"text":"comparison here. At the end of the twelve weeks each bird was sampled and scored by the"},{"end_column":90,"end_line":10,"start_column":1,"start_line":10,"text":"attending veterinarian. The question for each declared outcome is simply whether the diet"},{"end_column":59,"end_line":11,"start_column":1,"start_line":11,"text":"changed it: vitamin A status, body mass, calcium, plumage."},{"end_column":91,"end_line":15,"start_column":1,"start_line":15,"text":"File: `parrot_diet_data.csv`. One row is one bird, sampled and scored once at week twelve."},{"end_column":86,"end_line":16,"start_column":1,"start_line":16,"text":"There are 48 rows, 24 birds on each diet, and every bird has a value in every column."},{"end_column":25,"end_line":18,"start_column":1,"start_line":18,"text":"| Column | Description |"},{"end_column":14,"end_line":19,"start_column":1,"start_line":19,"text":"| --- | --- |"},{"end_column":58,"end_line":20,"start_column":1,"start_line":20,"text":"| `bird_id` | Bird identifier, `AGP01` through `AGP48`. |"},{"end_column":54,"end_line":21,"start_column":1,"start_line":21,"text":"| `diet` | Group column, either `pellet` or `seed`. |"},{"end_column":98,"end_line":22,"start_column":1,"start_line":22,"text":"| `plasma_retinol_ug_dl` | Plasma retinol (vitamin A) at week twelve, micrograms per decilitre. |"},{"end_column":53,"end_line":23,"start_column":1,"start_line":23,"text":"| `body_mass_g` | Body mass at week twelve, grams. |"},{"end_column":89,"end_line":24,"start_column":1,"start_line":24,"text":"| `plasma_calcium_mmol_l` | Plasma total calcium at week twelve, millimoles per litre. |"},{"end_column":99,"end_line":25,"start_column":1,"start_line":25,"text":"| `feather_condition_score` | Feather condition score at week twelve, 0 to 20, higher is better. |"},{"end_column":93,"end_line":27,"start_column":1,"start_line":27,"text":"The four outcome columns appear in the declared order fixed in the study protocol before the"},{"end_column":67,"end_line":28,"start_column":1,"start_line":28,"text":"diets began: retinol, body mass, calcium, feather condition score."},{"end_column":91,"end_line":32,"start_column":1,"start_line":32,"text":"Each declared outcome was compared between the two diet groups with an independent-samples"},{"end_column":92,"end_line":33,"start_column":1,"start_line":33,"text":"t-test, the standard two-group comparison for continuous data, run on the 24 pellet-fed and"},{"end_column":84,"end_line":34,"start_column":1,"start_line":34,"text":"24 seed-fed birds. Each outcome was judged on its own against the conventional 0.05"},{"end_column":24,"end_line":35,"start_column":1,"start_line":35,"text":"significance threshold."},{"end_column":88,"end_line":39,"start_column":1,"start_line":39,"text":"**Plasma retinol (vitamin A).** Pellet-fed mean 38.72 ug/dl, seed-fed mean 25.31 ug/dl;"},{"end_column":59,"end_line":40,"start_column":1,"start_line":40,"text":"t = 4.600, p = 0.00003. Significant at the 0.05 threshold."},{"end_column":90,"end_line":42,"start_column":1,"start_line":42,"text":"**Body mass.** Pellet-fed mean 452.5 g, seed-fed mean 459.1 g; t = -0.764, p = 0.449. Not"},{"end_column":35,"end_line":43,"start_column":1,"start_line":43,"text":"significant at the 0.05 threshold."},{"end_column":84,"end_line":45,"start_column":1,"start_line":45,"text":"**Plasma total calcium.** Pellet-fed mean 2.245 mmol/l, seed-fed mean 2.037 mmol/l;"},{"end_column":58,"end_line":46,"start_column":1,"start_line":46,"text":"t = 3.361, p = 0.0016. Significant at the 0.05 threshold."},{"end_column":84,"end_line":48,"start_column":1,"start_line":48,"text":"**Feather condition score.** Pellet-fed mean 15.71, seed-fed mean 14.04; t = 2.357,"},{"end_column":46,"end_line":49,"start_column":1,"start_line":49,"text":"p = 0.023. Significant at the 0.05 threshold."},{"end_column":91,"end_line":53,"start_column":1,"start_line":53,"text":"Over twelve weeks the pelleted diet affected three of the four declared aspects of health."},{"end_column":93,"end_line":54,"start_column":1,"start_line":54,"text":"Vitamin A status was the largest change: retinol was about 13 ug/dl higher in the pellet-fed"},{"end_column":88,"end_line":55,"start_column":1,"start_line":55,"text":"birds. Plasma calcium was higher on pellets by about 0.21 mmol/l, and feather condition"},{"end_column":92,"end_line":56,"start_column":1,"start_line":56,"text":"scored about 1.7 points better on the 0 to 20 scale. Body mass did not differ; the birds on"},{"end_column":91,"end_line":57,"start_column":1,"start_line":57,"text":"pellets weighed about 7 g less on average, well within the scatter seen in both groups. In"},{"end_column":87,"end_line":58,"start_column":1,"start_line":58,"text":"short, the pelleted diet improved vitamin A status, calcium and plumage in these birds"},{"end_column":46,"end_line":59,"start_column":1,"start_line":59,"text":"without moving body mass in either direction."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:79e3b04c8809c40297f0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:d7b2ad7fde6c0a00bf8d2ff0a22b4535ee633fdf261931f7ba90baca3937eadb","end_line":59,"locator":"report.md:1-59","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

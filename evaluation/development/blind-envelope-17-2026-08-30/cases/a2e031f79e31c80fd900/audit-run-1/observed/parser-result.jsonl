"\"  verdict at alpha = {}: {}\".format(ALPHA, verdict)","source_kind":"file_span","start_column":15,"start_line":77}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:623f101024e270bfbf7c","output_refs":[],"record_type":"operation","run_id":"audit:1a859e89ae60486eb3ad2390d8b7512c","source_refs":[{"content_digest":"sha256:615dacd03798acf1284ced57f46d6f9be05ac4aa010742e0b387b4651a8459d9","end_column":16,"end_line":78,"locator":"analysis.py:78-78","path":"analysis.py","quoted_text":"print()","source_kind":"file_span","start_column":9,"start_line":78}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:b617cf8ae93557cae919","output_refs":[],"record_type":"operation","run_id":"audit:1a859e89ae60486eb3ad2390d8b7512c","source_refs":[{"content_digest":"sha256:615dacd03798acf1284ced57f46d6f9be05ac4aa010742e0b387b4651a8459d9","end_column":11,"end_line":82,"locator":"analysis.py:82-82","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":82}]}],"x-token-count":409},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:a0489987801e6f839eb6","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:615dacd03798acf1284ced57f46d6f9be05ac4aa010742e0b387b4651a8459d9","end_line":82,"locator":"analysis.py:1-82","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:1a859e89ae60486eb3ad2390d8b7512c","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":88,"end_line":5,"start_column":1,"start_line":5,"text":"Epiphytic lichen on tree trunks takes up what is in the air around it, so it works as a"},{"end_column":95,"end_line":6,"start_column":1,"start_line":6,"text":"biomonitor of traffic-related pollution. This survey asks whether lichen growing on lime trees"},{"end_column":95,"end_line":7,"start_column":1,"start_line":7,"text":"beside a busy arterial road differs from lichen on lime trees standing well away from traffic,"},{"end_column":32,"end_line":8,"start_column":1,"start_line":8,"text":"across six declared indicators."},{"end_column":97,"end_line":10,"start_column":1,"start_line":10,"text":"Sixty-four mature lime trees of similar age and girth were sampled in one city, in two settings:"},{"end_column":70,"end_line":12,"start_column":1,"start_line":12,"text":"- `roadside` — 32 trees standing within 15 m of a busy arterial road."},{"end_column":90,"end_line":13,"start_column":1,"start_line":13,"text":"- `park_interior` — 32 trees standing inside large parkland, at least 300 m from any road"},{"end_column":20,"end_line":14,"start_column":3,"start_line":14,"text":"carrying traffic."},{"end_column":96,"end_line":16,"start_column":1,"start_line":16,"text":"One composite lichen thallus sample was taken from the trunk of each tree at a standard height,"},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"and the trunk cover survey used the same fixed quadrat area on every tree."},{"end_column":97,"end_line":21,"start_column":1,"start_line":21,"text":"`lichen_biomonitoring.csv` holds one row per sampled tree, 64 rows plus a header. One row is one"},{"end_column":94,"end_line":22,"start_column":1,"start_line":22,"text":"lime tree: its identifier, the setting it stands in, and the six declared outcome values from"},{"end_column":93,"end_line":23,"start_column":1,"start_line":23,"text":"that tree's single composite thallus sample and its trunk quadrat. Every tree has a value in"},{"end_column":14,"end_line":24,"start_column":1,"start_line":24,"text":"every column."},{"end_column":32,"end_line":26,"start_column":1,"start_line":26,"text":"| Column | Unit | Description |"},{"end_column":20,"end_line":27,"start_column":1,"start_line":27,"text":"| --- | --- | --- |"},{"end_column":60,"end_line":28,"start_column":1,"start_line":28,"text":"| `tree_id` | — | Tree identifier, `LT01` through `LT64`. |"},{"end_column":72,"end_line":29,"start_column":1,"start_line":29,"text":"| `setting` | — | Group column, either `roadside` or `park_interior`. |"},{"end_column":89,"end_line":30,"start_column":1,"start_line":30,"text":"| `nitrogen_pct` | percent of dry mass | Declared outcome 1: thallus nitrogen content. |"},{"end_column":85,"end_line":31,"start_column":1,"start_line":31,"text":"| `sulfur_pct` | percent of dry mass | Declared outcome 2: thallus sulfur content. |"},{"end_column":88,"end_line":32,"start_column":1,"start_line":32,"text":"| `lead_mg_kg` | mg per kg dry mass | Declared outcome 3: thallus lead concentration. |"},{"end_column":88,"end_line":33,"start_column":1,"start_line":33,"text":"| `zinc_mg_kg` | mg per kg dry mass | Declared outcome 4: thallus zinc concentration. |"},{"end_column":145,"end_line":34,"start_column":1,"start_line":34,"text":"| `chla_phaeo_ratio` | unitless | Declared outcome 5: chlorophyll a to phaeophytin ratio, a vitality index. Lower means more degraded pigment. |"},{"end_column":98,"end_line":35,"start_column":1,"start_line":35,"text":"| `lichen_cover_pct` | percent of quadrat area | Declared outcome 6: lichen cover on the trunk. |"},{"end_column":94,"end_line":39,"start_column":1,"start_line":39,"text":"Each of the six declared outcomes is its own environmental question, so each one was compared"},{"end_column":96,"end_line":40,"start_column":1,"start_line":40,"text":"between the two settings separately. For each outcome the roadside values were compared against"},{"end_column":98,"end_line":41,"start_column":1,"start_line":41,"text":"the park-interior values with a two-sample t-test (`scipy.stats.ttest_ind`), giving a t statistic"},{"end_column":98,"end_line":42,"start_column":1,"start_line":42,"text":"and a p-value. Each outcome was then judged on its own against the conventional 0.05 significance"},{"end_column":95,"end_line":43,"start_column":1,"start_line":43,"text":"threshold. The analysis is in `analysis.py`, which reads the CSV, holds the six outcomes as an"},{"end_column":97,"end_line":44,"start_column":1,"start_line":44,"text":"ordered list in the survey-plan order, and gathers the per-outcome results in one pass over that"},{"end_column":6,"end_line":45,"start_column":1,"start_line":45,"text":"list."},{"end_column":95,"end_line":49,"start_column":1,"start_line":49,"text":"Group means, p-values, and verdicts, in the declared order. The t statistic is signed roadside"},{"end_column":80,"end_line":50,"start_column":1,"start_line":50,"text":"minus park interior, so a negative t means the roadside value is the lower one."},{"end_column":92,"end_line":54,"start_column":1,"start_line":54,"text":"Park interior mean 1.1412 percent, roadside mean 1.4816 percent. t = 4.9175, p = 0.0000068."},{"end_column":73,"end_line":55,"start_column":1,"start_line":55,"text":"Significant at the 0.05 threshold. Nitrogen is elevated beside the road."},{"end_column":93,"end_line":59,"start_column":1,"start_line":59,"text":"Park interior mean 0.0570 percent, roadside mean 0.0852 percent. t = 5.7678, p = 0.00000027."},{"end_column":71,"end_line":60,"start_column":1,"start_line":60,"text":"Significant at the 0.05 threshold. Sulfur is elevated beside the road."},{"end_column":89,"end_line":64,"start_column":1,"start_line":64,"text":"Park interior mean 4.5281 mg/kg, roadside mean 6.8219 mg/kg. t = 5.4831, p = 0.00000082."},{"end_column":69,"end_line":65,"start_column":1,"start_line":65,"text":"Significant at the 0.05 threshold. Lead is elevated beside the road."},{"end_column":91,"end_line":69,"start_column":1,"start_line":69,"text":"Park interior mean 43.5312 mg/kg, roadside mean 61.6937 mg/kg. t = 5.4860, p = 0.00000081."},{"end_column":69,"end_line":70,"start_column":1,"start_line":70,"text":"Significant at the 0.05 threshold. Zinc is elevated beside the road."},{"end_column":96,"end_line":74,"start_column":1,"start_line":74,"text":"Park interior mean 1.0619, roadside mean 0.8406. t = -4.8899, p = 0.0000075. Significant at the"},{"end_column":83,"end_line":75,"start_column":1,"start_line":75,"text":"0.05 threshold. The ratio is lower beside the road, meaning more degraded pigment."},{"end_column":87,"end_line":79,"start_column":1,"start_line":79,"text":"Park interior mean 37.22 percent of quadrat, roadside mean 23.16 percent. t = -7.7696,"},{"end_column":87,"end_line":80,"start_column":1,"start_line":80,"text":"p = 0.000000000099. Significant at the 0.05 threshold. Cover is lower beside the road."},{"end_column":96,"end_line":84,"start_column":1,"start_line":84,"text":"All six declared indicators separated the two settings at the 0.05 threshold. The four chemical"},{"end_column":96,"end_line":85,"start_column":1,"start_line":85,"text":"indicators run in the direction traffic would predict: thallus nitrogen, sulfur, lead, and zinc"},{"end_column":98,"end_line":86,"start_column":1,"start_line":86,"text":"are all higher on the roadside trees. The two condition indicators run the other way, as expected"},{"end_column":93,"end_line":87,"start_column":1,"start_line":87,"text":"for stressed lichen: the chlorophyll a to phaeophytin ratio is lower on roadside trunks, and"},{"end_column":97,"end_line":88,"start_column":1,"start_line":88,"text":"lichen cover on the fixed quadrat is roughly a third lower there. Lichen cover gave the sharpest"},{"end_column":98,"end_line":89,"start_column":1,"start_line":89,"text":"separation of the six, and the chlorophyll ratio and nitrogen the least sharp, though all six sat"},{"end_column":26,"end_line":90,"start_column":1,"start_line":90,"text":"well below the threshold."},{"end_column":95,"end_line":92,"start_column":1,"start_line":92,"text":"For routine monitoring of this arterial road, thallus chemistry and trunk cover both carry the"},{"end_column":97,"end_line":93,"start_column":1,"start_line":93,"text":"signal, and lichen cover has the practical advantage of needing only a field quadrat rather than"},{"end_column":21,"end_line":94,"start_column":1,"start_line":94,"text":"laboratory analysis."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:07dcedef48ebb2a8f8cc","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:7ab0847e05632ae05f9d1f5fc44c079b44f1321552564136a3c807b7b95be417","end_line":94,"locator":"report.md:1-94","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

art_line":53}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:880b4fe71a2a7085f7b2","output_refs":[],"record_type":"operation","run_id":"audit:c34cc885ef2f4624ab5a3d25a51b98ed","source_refs":[{"content_digest":"sha256:f91e7b28b1d56d22e377cdd08ec1a06ad236ea7942bcda2513259e2516d26714","end_column":11,"end_line":57,"locator":"analysis.py:57-57","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":57}]}],"x-token-count":225},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:8ba4e7885eed7a5070a1","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f91e7b28b1d56d22e377cdd08ec1a06ad236ea7942bcda2513259e2516d26714","end_line":57,"locator":"analysis.py:1-57","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:c34cc885ef2f4624ab5a3d25a51b98ed","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"Our speech and language therapy service wanted to know whether the way therapy"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"hours are spread out changes how well people with chronic aphasia do. Fifty-four"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"adults took part, all four to twelve months after a single left-hemisphere"},{"end_column":66,"end_line":8,"start_column":1,"start_line":8,"text":"stroke and all with chronic aphasia of mild to moderate severity."},{"end_column":76,"end_line":10,"start_column":1,"start_line":10,"text":"Twenty-seven were allocated to the **intensive** schedule: fifteen hours of"},{"end_column":69,"end_line":11,"start_column":1,"start_line":11,"text":"therapy per week for three weeks. Twenty-seven were allocated to the"},{"end_column":81,"end_line":12,"start_column":1,"start_line":12,"text":"**distributed** schedule: the same total number of hours spread over nine weeks."},{"end_column":81,"end_line":13,"start_column":1,"start_line":13,"text":"The schedule is the only thing that differs between the two groups. Everyone was"},{"end_column":74,"end_line":14,"start_column":1,"start_line":14,"text":"assessed once at the end of therapy by an assessor who did not know which"},{"end_column":39,"end_line":15,"start_column":1,"start_line":15,"text":"schedule the participant had received."},{"end_column":81,"end_line":17,"start_column":1,"start_line":17,"text":"The service evaluation protocol fixed three outcomes before recruitment, in this"},{"end_column":70,"end_line":18,"start_column":1,"start_line":18,"text":"order: picture-naming accuracy, connected-speech rate, and functional"},{"end_column":15,"end_line":19,"start_column":1,"start_line":19,"text":"communication."},{"end_column":81,"end_line":23,"start_column":1,"start_line":23,"text":"The data are in `aphasia_therapy_data.csv`. **One row is one participant**, with"},{"end_column":70,"end_line":24,"start_column":1,"start_line":24,"text":"their allocated schedule and their three end-of-therapy scores. Every"},{"end_column":77,"end_line":25,"start_column":1,"start_line":25,"text":"participant appears exactly once, there are 54 rows, and no cell is missing."},{"end_column":17,"end_line":27,"start_column":1,"start_line":27,"text":"The columns are:"},{"end_column":27,"end_line":29,"start_column":1,"start_line":29,"text":"| Column | What it holds |"},{"end_column":14,"end_line":30,"start_column":1,"start_line":30,"text":"| --- | --- |"},{"end_column":68,"end_line":31,"start_column":1,"start_line":31,"text":"| `participant_id` | Participant identifier, `P01` through `P54`. |"},{"end_column":76,"end_line":32,"start_column":1,"start_line":32,"text":"| `group` | The therapy schedule allocated: `intensive` or `distributed`. |"},{"end_column":129,"end_line":33,"start_column":1,"start_line":33,"text":"| `naming_accuracy_pct` | Picture-naming accuracy at the end of therapy, as a percentage of the 60 test items named correctly. |"},{"end_column":109,"end_line":34,"start_column":1,"start_line":34,"text":"| `speech_rate_wpm` | Connected-speech rate in the standard picture-description task, in words per minute. |"},{"end_column":163,"end_line":35,"start_column":1,"start_line":35,"text":"| `functional_communication_0_100` | Functional communication in everyday life, rated by a familiar communication partner on a 0 to 100 scale. Higher is better. |"},{"end_column":78,"end_line":39,"start_column":1,"start_line":39,"text":"Each declared outcome answers a separate clinical question: does the schedule"},{"end_column":71,"end_line":40,"start_column":1,"start_line":40,"text":"change naming, does it change speech rate, and does it change everyday"},{"end_column":79,"end_line":41,"start_column":1,"start_line":41,"text":"communication. So each outcome was compared between the two groups on its own,"},{"end_column":70,"end_line":42,"start_column":1,"start_line":42,"text":"using a two-sample t-test for continuous data, and judged against the"},{"end_column":68,"end_line":43,"start_column":1,"start_line":43,"text":"conventional 0.05 significance threshold. All of the analysis is in"},{"end_column":82,"end_line":44,"start_column":1,"start_line":44,"text":"`analysis.py`, which loops once over the three outcomes in the protocol order and"},{"end_column":31,"end_line":45,"start_column":1,"start_line":45,"text":"applies the same test to each."},{"end_column":81,"end_line":49,"start_column":1,"start_line":49,"text":"**1. Picture-naming accuracy (`naming_accuracy_pct`).** Intensive averaged 52.90"},{"end_column":77,"end_line":50,"start_column":1,"start_line":50,"text":"percent, distributed averaged 43.52 percent, a difference of 9.39 percentage"},{"end_column":82,"end_line":51,"start_column":1,"start_line":51,"text":"points in favour of the intensive schedule. t = 2.550, p = 0.0138. Significant at"},{"end_column":20,"end_line":52,"start_column":1,"start_line":52,"text":"the 0.05 threshold."},{"end_column":81,"end_line":54,"start_column":1,"start_line":54,"text":"**2. Connected-speech rate (`speech_rate_wpm`).** Intensive averaged 68.30 words"},{"end_column":81,"end_line":55,"start_column":1,"start_line":55,"text":"per minute, distributed averaged 61.50, a difference of 6.80 words per minute in"},{"end_column":81,"end_line":56,"start_column":1,"start_line":56,"text":"favour of the intensive schedule. t = 2.178, p = 0.0340. Significant at the 0.05"},{"end_column":11,"end_line":57,"start_column":1,"start_line":57,"text":"threshold."},{"end_column":78,"end_line":59,"start_column":1,"start_line":59,"text":"**3. Functional communication (`functional_communication_0_100`).** Intensive"},{"end_column":80,"end_line":60,"start_column":1,"start_line":60,"text":"averaged 62.41 points, distributed averaged 58.48, a difference of 3.93 points."},{"end_column":62,"end_line":61,"start_column":1,"start_line":61,"text":"t = 1.321, p = 0.1923. Not significant at the 0.05 threshold."},{"end_column":81,"end_line":65,"start_column":1,"start_line":65,"text":"The intensive schedule showed an advantage on the two impairment-level measures."},{"end_column":79,"end_line":66,"start_column":1,"start_line":66,"text":"People who received their hours over three weeks named more pictures correctly"},{"end_column":77,"end_line":67,"start_column":1,"start_line":67,"text":"and spoke at a faster rate than people who received the same hours over nine"},{"end_column":76,"end_line":68,"start_column":1,"start_line":68,"text":"weeks. On the partner-rated measure of everyday communication the intensive"},{"end_column":81,"end_line":69,"start_column":1,"start_line":69,"text":"group scored a little higher, but the difference was small and did not reach the"},{"end_column":74,"end_line":70,"start_column":1,"start_line":70,"text":"0.05 threshold, so this evaluation does not show a schedule effect there."},{"end_column":80,"end_line":72,"start_column":1,"start_line":72,"text":"The groups overlapped a good deal on every measure, and these are small numbers"},{"end_column":75,"end_line":73,"start_column":1,"start_line":73,"text":"for a service evaluation, so the results are best read as a reason to look"},{"end_column":65,"end_line":74,"start_column":1,"start_line":74,"text":"further at intensive scheduling rather than as a settled answer."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:6a90023126091822fc73","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:ade13c9a63112308aa2cf465faf79d9a62f575b36ae791b0cf530bd1065f5c31","end_line":74,"locator":"report.md:1-74","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

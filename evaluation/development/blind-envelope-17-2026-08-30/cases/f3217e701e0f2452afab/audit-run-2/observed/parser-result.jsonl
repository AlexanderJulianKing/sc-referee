{"audit_run_id":"audit:69211f61a37f48efb9657891d1df006c","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"To find out which set-yoghurt product properties change when the conventional"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"thermophilic starter is replaced by an exopolysaccharide-producing (EPS)"},{"end_column":72,"end_line":7,"start_column":1,"start_line":7,"text":"starter. The two starter cultures are the only comparison in the study."},{"end_column":72,"end_line":9,"start_column":1,"start_line":9,"text":"Sixty individual cups were filled on one day from a single homogenised,"},{"end_column":73,"end_line":10,"start_column":1,"start_line":10,"text":"heat-treated milk lot. Thirty cups were inoculated with the conventional"},{"end_column":74,"end_line":11,"start_column":1,"start_line":11,"text":"starter and thirty with the EPS starter, then incubated and chilled under"},{"end_column":80,"end_line":12,"start_column":1,"start_line":12,"text":"identical conditions. Each cup was opened and measured individually after seven"},{"end_column":25,"end_line":13,"start_column":1,"start_line":13,"text":"days of chilled storage."},{"end_column":78,"end_line":17,"start_column":1,"start_line":17,"text":"All values are in `yoghurt_cups.csv`. **One row is one cup**: its identifier,"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"the starter culture it was inoculated with, and its value for each of the eight"},{"end_column":74,"end_line":19,"start_column":1,"start_line":19,"text":"declared outcomes. There are 60 rows, 30 per group, and no missing cells."},{"end_column":27,"end_line":21,"start_column":1,"start_line":21,"text":"| Column | What it holds |"},{"end_column":27,"end_line":22,"start_column":1,"start_line":22,"text":"|--------|---------------|"},{"end_column":67,"end_line":23,"start_column":1,"start_line":23,"text":"| `cup_id` | Cup identifier, `cup_001` to `cup_060`, one per cup |"},{"end_column":62,"end_line":24,"start_column":1,"start_line":24,"text":"| `starter_culture` | Group column, `conventional` or `eps` |"},{"end_column":52,"end_line":25,"start_column":1,"start_line":25,"text":"| `ph_24h` | pH of the cup 24 hours after filling |"},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"| `titratable_acidity_pct` | Titratable acidity at day seven, % lactic acid |"},{"end_column":72,"end_line":27,"start_column":1,"start_line":27,"text":"| `syneresis_pct` | Syneresis (whey drainage) at day seven, % by mass |"},{"end_column":78,"end_line":28,"start_column":1,"start_line":28,"text":"| `gel_firmness_n` | Gel firmness at day seven by penetration test, newtons |"},{"end_column":90,"end_line":29,"start_column":1,"start_line":29,"text":"| `apparent_viscosity_pa_s` | Apparent viscosity at day seven at fixed shear rate, Pa·s |"},{"end_column":74,"end_line":30,"start_column":1,"start_line":30,"text":"| `water_holding_capacity_pct` | Water-holding capacity at day seven, % |"},{"end_column":77,"end_line":31,"start_column":1,"start_line":31,"text":"| `lab_count_log10_cfu_g` | Viable lactic acid bacteria count, log10 CFU/g |"},{"end_column":81,"end_line":32,"start_column":1,"start_line":32,"text":"| `sensory_smoothness_score` | Trained panel mean smoothness rating, 1-9 scale |"},{"end_column":79,"end_line":34,"start_column":1,"start_line":34,"text":"The eight outcome columns are in the declared outcome order fixed in the trial"},{"end_column":24,"end_line":35,"start_column":1,"start_line":35,"text":"plan before production."},{"end_column":73,"end_line":39,"start_column":1,"start_line":39,"text":"Each of the eight declared outcomes was compared between the two starter"},{"end_column":80,"end_line":40,"start_column":1,"start_line":40,"text":"cultures with a two-sample t-test, working through the declared outcome list in"},{"end_column":48,"end_line":41,"start_column":1,"start_line":41,"text":"order. The threshold was the conventional 0.05."},{"end_column":77,"end_line":43,"start_column":1,"start_line":43,"text":"The trial plan names two primary product-quality outcomes: **`syneresis_pct`"},{"end_column":72,"end_line":44,"start_column":1,"start_line":44,"text":"and `gel_firmness_n`**. Their two p-values were passed together through"},{"end_column":79,"end_line":45,"start_column":1,"start_line":45,"text":"`statsmodels.stats.multitest.multipletests` (Holm) and those two outcomes were"},{"end_column":78,"end_line":46,"start_column":1,"start_line":46,"text":"judged against 0.05 using the adjusted values the routine returned. The other"},{"end_column":79,"end_line":47,"start_column":1,"start_line":47,"text":"six outcomes are declared secondary and each was judged against 0.05 using its"},{"end_column":46,"end_line":48,"start_column":1,"start_line":48,"text":"own plain p-value as it came out of the test."},{"end_column":77,"end_line":50,"start_column":1,"start_line":50,"text":"All of the analysis code is in `analysis.py`, which reads the CSV and prints"},{"end_column":17,"end_line":51,"start_column":1,"start_line":51,"text":"the table below."},{"end_column":79,"end_line":55,"start_column":1,"start_line":55,"text":"Means are the group means over the 30 cups in each group. The p-value shown is"},{"end_column":76,"end_line":56,"start_column":1,"start_line":56,"text":"the adjusted one for the two primary outcomes and the plain one for the six"},{"end_column":20,"end_line":57,"start_column":1,"start_line":57,"text":"secondary outcomes."},{"end_column":69,"end_line":59,"start_column":1,"start_line":59,"text":"| # | Outcome | Role | Conventional | EPS | p-value used | Verdict |"},{"end_column":69,"end_line":60,"start_column":1,"start_line":60,"text":"|---|---------|------|--------------|-----|--------------|---------|"},{"end_column":78,"end_line":61,"start_column":1,"start_line":61,"text":"| 1 | `ph_24h` | secondary | 4.444 | 4.375 | 8.41e-05 (plain) | significant |"},{"end_column":95,"end_line":62,"start_column":1,"start_line":62,"text":"| 2 | `titratable_acidity_pct` | secondary | 0.855 | 0.956 | 4.384e-07 (plain) | significant |"},{"end_column":88,"end_line":63,"start_column":1,"start_line":63,"text":"| 3 | `syneresis_pct` | primary | 12.863 | 8.750 | 2.954e-07 (adjusted) | significant |"},{"end_column":88,"end_line":64,"start_column":1,"start_line":64,"text":"| 4 | `gel_firmness_n` | primary | 0.414 | 0.555 | 2.954e-07 (adjusted) | significant |"},{"end_column":96,"end_line":65,"start_column":1,"start_line":65,"text":"| 5 | `apparent_viscosity_pa_s` | secondary | 1.850 | 2.499 | 5.438e-08 (plain) | significant |"},{"end_column":101,"end_line":66,"start_column":1,"start_line":66,"text":"| 6 | `water_holding_capacity_pct` | secondary | 58.160 | 65.677 | 0.0001107 (plain) | significant |"},{"end_column":92,"end_line":67,"start_column":1,"start_line":67,"text":"| 7 | `lab_count_log10_cfu_g` | secondary | 8.356 | 8.462 | 0.02167 (plain) | significant |"},{"end_column":97,"end_line":68,"start_column":1,"start_line":68,"text":"| 8 | `sensory_smoothness_score` | secondary | 5.397 | 6.290 | 0.0007104 (plain) | significant |"},{"end_column":78,"end_line":70,"start_column":1,"start_line":70,"text":"Before adjustment the two primary p-values were 2.758e-07 for `syneresis_pct`"},{"end_column":36,"end_line":71,"start_column":1,"start_line":71,"text":"and 1.477e-07 for `gel_firmness_n`."},{"end_column":72,"end_line":75,"start_column":1,"start_line":75,"text":"The EPS starter changed the texture and water-binding properties of the"},{"end_column":78,"end_line":76,"start_column":1,"start_line":76,"text":"product. Both primary product-quality outcomes moved in the desired direction"},{"end_column":78,"end_line":77,"start_column":1,"start_line":77,"text":"and stayed significant after adjustment: syneresis fell from 12.9% to 8.8% by"},{"end_column":74,"end_line":78,"start_column":1,"start_line":78,"text":"mass, and gel firmness rose from 0.41 N to 0.56 N. The supporting texture"},{"end_column":77,"end_line":79,"start_column":1,"start_line":79,"text":"outcomes moved with them, with apparent viscosity up from 1.85 to 2.50 Pa·s,"},{"end_column":80,"end_line":80,"start_column":1,"start_line":80,"text":"water-holding capacity up from 58.2% to 65.7%, and panel smoothness up from 5.4"},{"end_column":15,"end_line":81,"start_column":1,"start_line":81,"text":"to 6.3 points."},{"end_column":79,"end_line":83,"start_column":1,"start_line":83,"text":"The fermentation outcomes shifted as well but by much less in practical terms."},{"end_column":74,"end_line":84,"start_column":1,"start_line":84,"text":"The EPS cups finished 0.07 pH units lower at 24 hours and 0.10 percentage"},{"end_column":80,"end_line":85,"start_column":1,"start_line":85,"text":"points higher in titratable acidity at day seven, and the viable count differed"},{"end_column":71,"end_line":86,"start_column":1,"start_line":86,"text":"by about 0.11 log10 CFU/g, which is within the range we would treat as"},{"end_column":39,"end_line":87,"start_column":1,"start_line":87,"text":"equivalent for a starter of this type."},{"end_column":79,"end_line":89,"start_column":1,"start_line":89,"text":"For product development the useful result is the texture package: less whey on"},{"end_column":73,"end_line":90,"start_column":1,"start_line":90,"text":"the surface, a firmer gel, higher viscosity, better water holding, and a"},{"end_column":78,"end_line":91,"start_column":1,"start_line":91,"text":"smoother mouthfeel, with acidification and viability essentially unchanged in"},{"end_column":17,"end_line":92,"start_column":1,"start_line":92,"text":"practical terms."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:f8b8c326f55a2a3fd547","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:8ad78746dbb8acec8c34264862a28201424583c04a21923a4370f1964863ad0a","end_line":92,"locator":"report.md:1-92","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

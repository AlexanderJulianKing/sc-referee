{"audit_run_id":"audit:05cc20f67db34aca8a377e7f82a5c83c","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":32,"end_line":3,"start_column":1,"start_line":3,"text":"File: `mussel_rearing_data.csv`"},{"end_column":93,"end_line":5,"start_column":1,"start_line":5,"text":"One row is one individually tagged juvenile freshwater pearl mussel from the captive cohort,"},{"end_column":97,"end_line":6,"start_column":1,"start_line":6,"text":"measured at the end of the twelve-month rearing trial. The file holds 66 rows plus a header row:"},{"end_column":97,"end_line":7,"start_column":1,"start_line":7,"text":"33 juveniles reared on a fine sand bed and 33 reared on a coarse gravel bed, all in flow-through"},{"end_column":99,"end_line":8,"start_column":1,"start_line":8,"text":"cells supplied from the same header tank. Every mussel has a value for every outcome; there are no"},{"end_column":33,"end_line":9,"start_column":1,"start_line":9,"text":"missing cells and no extra rows."},{"end_column":36,"end_line":13,"start_column":1,"start_line":13,"text":"| Column | Type | Units | Meaning |"},{"end_column":26,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- | --- |"},{"end_column":154,"end_line":15,"start_column":1,"start_line":15,"text":"| `mussel_tag` | text | none | Individual tag identifier, prefix `PM` plus a zero-padded three-digit serial (`PM001` to `PM066`). Unique for every row. |"},{"end_column":143,"end_line":16,"start_column":1,"start_line":16,"text":"| `substrate` | text | none | Rearing substrate group. Exactly two distinct values: `sand` (fine sand bed) and `gravel` (coarse gravel bed). |"},{"end_column":147,"end_line":17,"start_column":1,"start_line":17,"text":"| `shell_length_increment_mm` | number | millimetres | Growth in shell length over the twelve months, recorded to 0.01 mm with digital calipers. |"},{"end_column":103,"end_line":18,"start_column":1,"start_line":18,"text":"| `wet_mass_gain_g` | number | grams | Gain in wet mass over the twelve months, recorded to 0.001 g. |"},{"end_column":129,"end_line":19,"start_column":1,"start_line":19,"text":"| `condition_index_pct` | number | percent | Condition index: soft tissue dry mass as a percentage of shell dry mass, to 0.01. |"},{"end_column":123,"end_line":20,"start_column":1,"start_line":20,"text":"| `foot_glycogen_mg_per_g` | number | milligrams per gram dry mass | Glycogen concentration in foot tissue, to 0.1 mg/g. |"},{"end_column":135,"end_line":21,"start_column":1,"start_line":21,"text":"| `clearance_rate_l_per_h` | number | litres per hour per individual | Clearance rate from the standard feeding assay, to 0.001 L/h. |"},{"end_column":92,"end_line":23,"start_column":1,"start_line":23,"text":"The five outcome columns appear in the order declared in the rearing protocol: shell length"},{"end_column":74,"end_line":24,"start_column":1,"start_line":24,"text":"increment, wet mass gain, condition index, foot glycogen, clearance rate."},{"end_column":85,"end_line":28,"start_column":1,"start_line":28,"text":"- Values are fixed and committed in the CSV. They are not produced at analysis time."},{"end_column":93,"end_line":29,"start_column":1,"start_line":29,"text":"- Rows are ordered by tag serial. Substrate assignment is mixed across the serial order, not"},{"end_column":73,"end_line":30,"start_column":3,"start_line":30,"text":"blocked, so group membership must be read from the `substrate` column."},{"end_column":95,"end_line":31,"start_column":1,"start_line":31,"text":"- Individual scatter within each group is wide, as expected for a captive cohort with variable"},{"end_column":66,"end_line":32,"start_column":3,"start_line":32,"text":"individual growth, and the two groups overlap on every outcome."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ad028a3065718127c7ae","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:0caebbf2e7bbcf5962623f5bdb0d744dcbb7405986c62939cd62ad7e2e4c6ce3","end_line":32,"locator":"DATA_DESCRIPTION.md:1-32","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:05cc20f67db34aca8a377e7f82a5c83c","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":100,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `substrate` column of `mussel_rearing_data.csv`."},{"end_column":171,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: shell_length_increment_mm, wet_mass_gain_g, condition_index_pct, foot_glycogen_mg_per_g, clearance_rate_l_per_h."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:7518c0bc2016162adf92","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:eeb58f93610df024348cc2b0df6d5cb91ba023064acc63ef8ba94e7c936f9283","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

s":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":58,"end_line":77,"locator":"analysis.py:77-77","path":"analysis.py","quoted_text":"compare_outcome(straw, shavings, column)","source_kind":"file_span","start_column":18,"start_line":77}]},{"implementation":"python.call:results.append","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:c7a3cec9a22ee1036a70","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":40,"end_line":79,"locator":"analysis.py:79-79","path":"analysis.py","quoted_text":"results.append((label, result))","source_kind":"file_span","start_column":9,"start_line":79}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:b6ab3aa0c8aa6d3e6fb0","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":30,"end_line":87,"locator":"analysis.py:82-87","path":"analysis.py","quoted_text":"print(f\"{label:<34}\"\n              f\"{result['mean_straw']:>9.2f}\"\n              f\"{result['mean_shavings']:>11.2f}\"\n              f\"{result['difference']:>9.2f}\"\n              f\"{result['p_value']:>10.4f}\"\n              f\"  {verdict}\")","source_kind":"file_span","start_column":9,"start_line":82}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:6ab6d9f1913249914f97","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":12,"end_line":89,"locator":"analysis.py:89-89","path":"analysis.py","quoted_text":"print()","source_kind":"file_span","start_column":5,"start_line":89}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:adf122274dc2140481a8","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":36,"end_line":91,"locator":"analysis.py:90-91","path":"analysis.py","quoted_text":"print(\"Verdicts by outcome (p < 0.05 means bedding significantly \"\n          \"affected the outcome):\")","source_kind":"file_span","start_column":5,"start_line":90}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:ab7ac2d9827404af47ef","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":68,"end_line":94,"locator":"analysis.py:94-94","path":"analysis.py","quoted_text":"print(f\"  {label}: p = {result['p_value']:.4f} -> {state}\")","source_kind":"file_span","start_column":9,"start_line":94}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:6c67aa892969a0688909","output_refs":[],"record_type":"operation","run_id":"audit:880dfb5a0da64d0ca24d735623be2677","source_refs":[{"content_digest":"sha256:6e1d202d33ee26385523f406938fbd48b4b445fc3d505a75611f81b9953463d4","end_column":11,"end_line":98,"locator":"analysis.py:98-98","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"st
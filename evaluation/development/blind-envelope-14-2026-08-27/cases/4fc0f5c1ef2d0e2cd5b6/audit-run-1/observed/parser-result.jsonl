{"audit_run_id":"audit:880dfb5a0da64d0ca24d735623be2677","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":96,"end_line":3,"start_column":1,"start_line":3,"text":"One row is one turkey bird, measured individually at the end of the twelve-week rearing period."},{"end_column":98,"end_line":4,"start_column":1,"start_line":4,"text":"The file has a header row and 60 data rows, one per bird: 30 birds reared on chopped straw and 30"},{"end_column":96,"end_line":5,"start_column":1,"start_line":5,"text":"reared on softwood shavings. All birds are from the same hatch and strain and were reared under"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"identical feeding, stocking density, and ventilation. There are no blank cells."},{"end_column":32,"end_line":10,"start_column":1,"start_line":10,"text":"| Column | Type | Description |"},{"end_column":20,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- | --- |"},{"end_column":70,"end_line":12,"start_column":1,"start_line":12,"text":"| `bird_id` | text | Unique bird identifier, `T001` through `T060`. |"},{"end_column":113,"end_line":13,"start_column":1,"start_line":13,"text":"| `bedding` | text | Bedding group. Exactly two values: `chopped_straw` or `softwood_shavings`. 30 birds each. |"},{"end_column":92,"end_line":14,"start_column":1,"start_line":14,"text":"| `body_weight_kg` | number, 2 decimals | Live body weight at twelve weeks, in kilograms. |"},{"end_column":101,"end_line":15,"start_column":1,"start_line":15,"text":"| `breast_yield_pct` | number, 2 decimals | Breast muscle yield as a percentage of carcass weight. |"},{"end_column":105,"end_line":16,"start_column":1,"start_line":16,"text":"| `footpad_score` | whole number 0-4 | Footpad dermatitis score; 0 is no lesion, 4 is the most severe. |"},{"end_column":98,"end_line":17,"start_column":1,"start_line":17,"text":"| `hock_burn_score` | whole number 0-2 | Hock burn score; 0 is no lesion, 2 is the most severe. |"},{"end_column":92,"end_line":18,"start_column":1,"start_line":18,"text":"| `tibia_ash_pct` | number, 2 decimals | Tibia ash content, percent of dry defatted bone. |"},{"end_column":116,"end_line":19,"start_column":1,"start_line":19,"text":"| `plasma_cort_ng_per_ml` | number, 2 decimals | Plasma corticosterone at slaughter, in nanograms per millilitre. |"},{"end_column":100,"end_line":21,"start_column":1,"start_line":21,"text":"The six outcome columns appear in the pre-declared order of the outcome family: body weight, breast"},{"end_column":73,"end_line":22,"start_column":1,"start_line":22,"text":"yield, footpad score, hock burn score, tibia ash, plasma corticosterone."},{"end_column":31,"end_line":26,"start_column":1,"start_line":26,"text":"| Column | Minimum | Maximum |"},{"end_column":20,"end_line":27,"start_column":1,"start_line":27,"text":"| --- | --- | --- |"},{"end_column":37,"end_line":28,"start_column":1,"start_line":28,"text":"| `body_weight_kg` | 10.88 | 15.26 |"},{"end_column":39,"end_line":29,"start_column":1,"start_line":29,"text":"| `breast_yield_pct` | 23.81 | 30.22 |"},{"end_column":28,"end_line":30,"start_column":1,"start_line":30,"text":"| `footpad_score` | 0 | 4 |"},{"end_column":30,"end_line":31,"start_column":1,"start_line":31,"text":"| `hock_burn_score` | 0 | 2 |"},{"end_column":36,"end_line":32,"start_column":1,"start_line":32,"text":"| `tibia_ash_pct` | 44.00 | 51.92 |"},{"end_column":42,"end_line":33,"start_column":1,"start_line":33,"text":"| `plasma_cort_ng_per_ml` | 1.06 | 7.22 |"},{"end_column":93,"end_line":37,"start_column":1,"start_line":37,"text":"The values are simulated flock data, not measurements from real birds. They were produced by"},{"end_column":97,"end_line":38,"start_column":1,"start_line":38,"text":"`make_data.py`, which is kept with this description and is not part of the analysis project. Row"},{"end_column":99,"end_line":39,"start_column":1,"start_line":39,"text":"order is the bird id order; bedding was assigned at random across the 60 ids with exactly 30 birds"},{"end_column":11,"end_line":40,"start_column":1,"start_line":40,"text":"per group."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:a067194ed28bebd8fb83","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:51f5fc36b9ea4ad3f5047020b8e0f6d93aa1132ca9a37ce04bcd1eb3b99ad760","end_line":40,"locator":"DATA_DESCRIPTION.md:1-40","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:880dfb5a0da64d0ca24d735623be2677","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":93,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `bedding` column of `turkey_bedding.csv`."},{"end_column":162,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: body_weight_kg, breast_yield_pct, footpad_score, hock_burn_score, tibia_ash_pct, plasma_cort_ng_per_ml."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:da60bf96542556de4c09","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:fdb4f387598cf65c59a8ced4a8a4fe524838360e3b38e84f23609bd42cef61d0","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

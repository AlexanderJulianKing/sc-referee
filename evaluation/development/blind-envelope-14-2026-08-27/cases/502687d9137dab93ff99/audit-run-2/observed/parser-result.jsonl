ent_digest":"sha256:9ea925e6dec9b5ccce96d641bdbf8841ebd5c73fb1641448ed076879d62f3fbd","end_column":21,"end_line":72,"locator":"analysis.py:72-72","path":"analysis.py","quoted_text":"print(\"Conclusions\")","source_kind":"file_span","start_column":1,"start_line":72}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:f56094bc35c2bb3440d6","output_refs":[],"record_type":"operation","run_id":"audit:f3d293f3b269421db181a36ac0f4c048","source_refs":[{"content_digest":"sha256:9ea925e6dec9b5ccce96d641bdbf8841ebd5c73fb1641448ed076879d62f3fbd","end_column":61,"end_line":79,"locator":"analysis.py:77-79","path":"analysis.py","quoted_text":"print(f\"- {OUTCOME_LABELS[outcome]}: the coating significantly affects \"\n              f\"this outcome (p = {result['p_value']:.4f}); the coated coupons \"\n              f\"are {direction} than the uncoated coupons.\")","source_kind":"file_span","start_column":9,"start_line":77}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:8b947ae7cb428a2f95d2","output_refs":[],"record_type":"operation","run_id":"audit:f3d293f3b269421db181a36ac0f4c048","source_refs":[{"content_digest":"sha256:9ea925e6dec9b5ccce96d641bdbf8841ebd5c73fb1641448ed076879d62f3fbd","end_column":69,"end_line":82,"locator":"analysis.py:81-82","path":"analysis.py","quoted_text":"print(f\"- {OUTCOME_LABELS[outcome]}: the coating does not significantly \"\n              f\"affect this outcome (p = {result['p_value']:.4f}).\")","source_kind":"file_span","start_column":9,"start_line":81}]}],"x-token-count":378},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:a51ba786fc3b3258a4bb","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},
{"audit_run_id":"audit:f3d293f3b269421db181a36ac0f4c048","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":68,"end_line":5,"start_column":1,"start_line":5,"text":"`biofilm_coupons.csv` — one CSV with a header row and 44 data rows."},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"One row is one sterile silicone catheter coupon. Each coupon was incubated on"},{"end_column":80,"end_line":10,"start_column":1,"start_line":10,"text":"its own in an identical flow cell, with the same reference bacterial strain and"},{"end_column":72,"end_line":11,"start_column":1,"start_line":11,"text":"the same artificial urine medium, for 48 hours. It was then removed and"},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"measured for all four declared biofilm outcomes. So a row holds the complete"},{"end_column":65,"end_line":13,"start_column":1,"start_line":13,"text":"outcome family for a single coupon, and no coupon appears twice."},{"end_column":79,"end_line":15,"start_column":1,"start_line":15,"text":"The 44 coupons split into 22 uncoated and 22 hydrophilic-coated. Every cell is"},{"end_column":29,"end_line":16,"start_column":1,"start_line":16,"text":"filled; there are no blanks."},{"end_column":40,"end_line":20,"start_column":1,"start_line":20,"text":"| Column | Type | Units | Description |"},{"end_column":26,"end_line":21,"start_column":1,"start_line":21,"text":"| --- | --- | --- | --- |"},{"end_column":84,"end_line":22,"start_column":1,"start_line":22,"text":"| `coupon_id` | text | — | Coupon label, `CP-01` through `CP-44`. Unique per row. |"},{"end_column":83,"end_line":23,"start_column":1,"start_line":23,"text":"| `surface` | text | — | Group. Exactly two values: `uncoated` or `hydrophilic`. |"},{"end_column":147,"end_line":24,"start_column":1,"start_line":24,"text":"| `biofilm_od590` | number | optical density at 590 nm | Declared outcome 1. Biofilm biomass by crystal violet staining. Recorded to 3 decimals. |"},{"end_column":155,"end_line":25,"start_column":1,"start_line":25,"text":"| `viable_log10_cfu_per_cm2` | number | log10 CFU per cm^2 | Declared outcome 2. Viable cells recovered from the coupon surface. Recorded to 2 decimals. |"},{"end_column":131,"end_line":26,"start_column":1,"start_line":26,"text":"| `thickness_um` | number | micrometres | Declared outcome 3. Mean biofilm thickness by confocal imaging. Recorded to 1 decimal. |"},{"end_column":162,"end_line":27,"start_column":1,"start_line":27,"text":"| `eps_protein_ug_per_cm2` | number | micrograms per cm^2 | Declared outcome 4. Extracellular polymeric substance protein on the coupon. Recorded to 1 decimal. |"},{"end_column":70,"end_line":29,"start_column":1,"start_line":29,"text":"Outcome columns appear in the declared order: biomass, viable counts,"},{"end_column":24,"end_line":30,"start_column":1,"start_line":30,"text":"thickness, EPS protein."},{"end_column":80,"end_line":34,"start_column":1,"start_line":34,"text":"- Decimals reflect how each instrument reports: the plate reader to 3 decimals,"},{"end_column":68,"end_line":35,"start_column":3,"start_line":35,"text":"plate counts to 2, confocal thickness and the protein assay to 1."},{"end_column":79,"end_line":36,"start_column":1,"start_line":36,"text":"- Coupons were prepared and numbered as one batch, then assigned to a surface,"},{"end_column":76,"end_line":37,"start_column":3,"start_line":37,"text":"so the two groups are interleaved through the `coupon_id` sequence rather"},{"end_column":16,"end_line":38,"start_column":3,"start_line":38,"text":"than blocked."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1ef920c5da33c18cd544","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:2de62b65305f78c2a1bdbbe79d4a4d105decc6bc6bdc45710d2b3b46cc4e96ea","end_line":38,"locator":"DATA_DESCRIPTION.md:1-38","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:f3d293f3b269421db181a36ac0f4c048","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":94,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `surface` column of `biofilm_coupons.csv`."},{"end_column":137,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: biofilm_od590, viable_log10_cfu_per_cm2, thickness_um, eps_protein_ug_per_cm2."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b2e570d46d8eaed84a63","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:e9e400c8a06586f459e44f179014dd448e9ea408da3f320fa988b54f4144d6e8","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

al","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:a1b439c44b88a4cb53eb","output_refs":[],"record_type":"operation","run_id":"audit:c9cd5fad11c748e3bf0d465c02aaca60","source_refs":[{"content_digest":"sha256:9b91e232e4856d8ac87c942c24134ce27706022472a6d9fe5b0d4e4e35f49579","end_column":66,"end_line":39,"locator":"make_data.py:39-39","path":"make_data.py","quoted_text":"rng_distance.normal(0.0, TANK_SD_CM, size=N_TANKS)","source_kind":"file_span","start_column":16,"start_line":39}]},{"implementation":"python.call:rng_distance.normal","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:1f36d2bfb7c04a130e05","output_refs":[],"record_type":"operation","run_id":"audit:c9cd5fad11c748e3bf0d465c02aaca60","source_refs":[{"content_digest":"sha256:9b91e232e4856d8ac87c942c24134ce27706022472a6d9fe5b0d4e4e35f49579","end_column":81,"end_line":40,"locator":"make_data.py:40-40","path":"make_data.py","quoted_text":"rng_distance.normal(0.0, FISH_SD_CM, size=(N_TANKS, FISH_PER_TANK))","source_kind":"file_span","start_column":14,"start_line":40}]},{"implementation":"python.call:np.clip","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:9a464063689a8dc54039","output_refs":[],"record_type":"operation","run_id":"audit:c9cd5fad11c748e3bf0d465c02aaca60","source_refs":[{"content_digest":"sha256:9b91e232e4856d8ac87c942c24134ce27706022472a6d9fe5b0d4e4e35f49579","end_column":2,"end_line":46,"locator":"make_data.py:42-46","path":"make_data.py","quoted_text":"np.clip(\n    rng_body.normal(BODY_MEAN_MM, BODY_SD_MM, size=(N_TANKS, FISH_PER_TANK)),\n    BODY_MIN_MM,\n    BODY_MAX_MM,\n)","source_kind":"file_span","start_column":16,"start_line":42}]},{"implementation":"python.call:rng_body.normal","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"
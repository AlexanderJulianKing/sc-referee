:"file_span","start_column":35,"start_line":87}]},{"implementation":"python.call:<dynamic>.nunique","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:3d78ca86fa453b15ab31","output_refs":[],"record_type":"operation","run_id":"audit:970888b153da4a689352ace6bddd02b9","source_refs":[{"content_digest":"sha256:b94793da5849e5e9567e25a70217807a791345be6397cdb10c88af90c7632895","end_column":77,"end_line":87,"locator":"make_data.py:87-87","path":"make_data.py","quoted_text":"df[\"nest_tag\"].nunique()","source_kind":"file_span","start_column":53,"start_line":87}]}],"x-token-count":467},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:73b0719f93ec8388106c","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b94793da5849e5e9567e25a70217807a791345be6397cdb10c88af90c7632895","end_line":87,"locator":"make_data.py:1-87","path":"make_data.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:970888b153da4a689352ace6bddd02b9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":96,"end_line":5,"start_column":1,"start_line":5,"text":"All measurements are held in `nestling_mass.csv`. One row of that file is one nestling, weighed"},{"end_column":91,"end_line":6,"start_column":1,"start_line":6,"text":"and measured a single time on day 12 after hatching. Each row carries that chick's own two"},{"end_column":98,"end_line":7,"start_column":1,"start_line":7,"text":"measurements together with the box it was raised in, the feeding treatment that box received, and"},{"end_column":52,"end_line":8,"start_column":1,"start_line":8,"text":"the date its brood hatched. No chick appears twice."},{"end_column":26,"end_line":10,"start_column":1,"start_line":10,"text":"The file has six columns:"},{"end_column":25,"end_line":12,"start_column":1,"start_line":12,"text":"| Column | Description |"},{"end_column":10,"end_line":13,"start_column":1,"start_line":13,"text":"|---|---|"},{"end_column":161,"end_line":14,"start_column":1,"start_line":14,"text":"| `nest_tag` | The nestbox the chick was raised in, written as `NB-` plus the box number used in the plot (for example `NB-04`). Sixteen distinct tags appear. |"},{"end_column":102,"end_line":15,"start_column":1,"start_line":15,"text":"| `food_treatment` | The feeding treatment applied at that box, either `supplemented` or `control`. |"},{"end_column":109,"end_line":16,"start_column":1,"start_line":16,"text":"| `chick_ring` | The ring number of the individual nestling (for example `A1201`), unique across the file. |"},{"end_column":106,"end_line":17,"start_column":1,"start_line":17,"text":"| `hatch_date` | The date the brood hatched, as an ISO date. Hatch dates span 2026-04-22 to 2026-05-06. |"},{"end_column":137,"end_line":18,"start_column":1,"start_line":18,"text":"| `mass_g_day12` | Body mass of the nestling in grams on day 12 after hatching, to one decimal place. This is the outcome of interest. |"},{"end_column":118,"end_line":19,"start_column":1,"start_line":19,"text":"| `tarsus_mm` | Tarsus length of the same nestling in millimetres on day 12, recorded as an index of skeletal size. |"},{"end_column":51,"end_line":21,"start_column":1,"start_line":21,"text":"The file contains 64 data rows and one header row."},{"end_column":97,"end_line":25,"start_column":1,"start_line":25,"text":"Sixteen nestboxes in the long-term study population were used. Eight boxes were allocated to the"},{"end_column":98,"end_line":26,"start_column":1,"start_line":26,"text":"supplemented treatment, in which a mealworm feeder was placed within 5 m of the box from hatching"},{"end_column":90,"end_line":27,"start_column":1,"start_line":27,"text":"onward and kept stocked; the remaining eight boxes were left unsupplemented and served as"},{"end_column":94,"end_line":28,"start_column":1,"start_line":28,"text":"controls. Every box in the study held exactly four surviving nestlings on day 12, and each of"},{"end_column":92,"end_line":29,"start_column":1,"start_line":29,"text":"those chicks was caught once, weighed to 0.1 g, and measured for tarsus length before being"},{"end_column":95,"end_line":30,"start_column":1,"start_line":30,"text":"returned to the box. This yields 32 supplemented nestlings and 32 control nestlings, 64 day-12"},{"end_column":26,"end_line":31,"start_column":1,"start_line":31,"text":"mass measurements in all."},{"end_column":92,"end_line":35,"start_column":1,"start_line":35,"text":"Day-12 body mass was compared between the two feeding treatments with a two-sample *t*-test"},{"end_column":63,"end_line":36,"start_column":1,"start_line":36,"text":"(`scipy.stats.ttest_ind`, two-sided, equal variances assumed)."},{"end_column":98,"end_line":38,"start_column":1,"start_line":38,"text":"The measurements entering the test were the individual `mass_g_day12` values. Every nestling from"},{"end_column":99,"end_line":39,"start_column":1,"start_line":39,"text":"a supplemented box contributed its own mass to the first sample, and every nestling from a control"},{"end_column":98,"end_line":40,"start_column":1,"start_line":40,"text":"box contributed its own mass to the second sample, so each of the 64 weighings is one observation"},{"end_column":97,"end_line":41,"start_column":1,"start_line":41,"text":"in the analysis. The sample size claimed for the test is therefore **N = 32 per group, N = 64 in"},{"end_column":88,"end_line":42,"start_column":1,"start_line":42,"text":"total**, with 62 degrees of freedom. No other column was used in the test: `tarsus_mm`,"},{"end_column":99,"end_line":43,"start_column":1,"start_line":43,"text":"`hatch_date`, `nest_tag`, and `chick_ring` were carried in the file for record-keeping but did not"},{"end_column":23,"end_line":44,"start_column":1,"start_line":44,"text":"enter this comparison."},{"end_column":99,"end_line":48,"start_column":1,"start_line":48,"text":"Nestlings from supplemented boxes averaged 15.91 g on day 12 (SD = 1.25 g, n = 32). Nestlings from"},{"end_column":93,"end_line":49,"start_column":1,"start_line":49,"text":"control boxes averaged 15.43 g (SD = 1.12 g, n = 32). The supplemented chicks were therefore"},{"end_column":58,"end_line":50,"start_column":1,"start_line":50,"text":"0.47 g heavier on average, about 3% of mean control mass."},{"end_column":97,"end_line":52,"start_column":1,"start_line":52,"text":"The two-sample *t*-test on these 64 measurements gave *t* = 1.589 with 62 degrees of freedom and"},{"end_column":13,"end_line":53,"start_column":1,"start_line":53,"text":"*p* = 0.117."},{"end_column":94,"end_line":55,"start_column":1,"start_line":55,"text":"Individual masses ranged from 13.0 g to 18.6 g across the whole sample, and the two treatment"},{"end_column":50,"end_line":56,"start_column":1,"start_line":56,"text":"distributions overlapped broadly over that range."},{"end_column":97,"end_line":60,"start_column":1,"start_line":60,"text":"Day-12 nestlings in supplemented broods were on average about half a gram heavier than nestlings"},{"end_column":94,"end_line":61,"start_column":1,"start_line":61,"text":"in unsupplemented broods, but at the conventional 5% threshold the difference between the two"},{"end_column":97,"end_line":62,"start_column":1,"start_line":62,"text":"groups was not statistically significant (*t* = 1.589, *p* = 0.117, N = 32 nestlings per group)."},{"end_column":99,"end_line":63,"start_column":1,"start_line":63,"text":"The measured effect of placing a mealworm feeder at the box is in the expected direction and small"},{"end_column":67,"end_line":64,"start_column":1,"start_line":64,"text":"relative to the variation in mass among chicks in this population."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:9bf7dde8def20bd2c86c","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:c1859597911f2d7e0bf31553aa06f14b5c81fe1de633483ffa7de32693525bb3","end_line":64,"locator":"report.md:1-64","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

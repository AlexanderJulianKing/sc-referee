all:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:18988fda651a96ac8ed1","output_refs":[],"record_type":"operation","run_id":"audit:1bdda2c7a1564fadbf615f4af6a0e3cd","source_refs":[{"content_digest":"sha256:bf00f35c6daea6ddde0df2496e013036101631b47e0fcdb4c87e2a78c953c3f0","end_column":28,"end_line":78,"locator":"analysis.py:75-78","path":"analysis.py","quoted_text":"print(f\"{result['label']:<30} {result['unit']:<8} \"\n              f\"{result['mean_rack']:>10.2f} {result['mean_block']:>11.2f} \"\n              f\"{result['difference']:>11.2f} {result['p_value']:>9.4f}  \"\n              f\"{verdict}\")","source_kind":"file_span","start_column":9,"start_line":75}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:e0a712773074c4ece41d","output_refs":[],"record_type":"operation","run_id":"audit:1bdda2c7a1564fadbf615f4af6a0e3cd","source_refs":[{"content_digest":"sha256:bf00f35c6daea6ddde0df2496e013036101631b47e0fcdb4c87e2a78c953c3f0","end_column":11,"end_line":84,"locator":"analysis.py:84-84","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":84}]}],"x-token-count":428},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:0bfda7e47170c346c600","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:bf00f35c6daea6ddde0df2496e013036101631b47e0fcdb4c87e2a78c953c3f0","end_line":84,"locator":"analysis.py:1-84","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"p
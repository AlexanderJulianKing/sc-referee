8b439dd","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f13a143e27e0ca47d013b6924c26452e38b530a41f22588b38457eada09a4fd6","end_line":107,"locator":"analysis.py:1-107","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:ef99ca3b7184445e895cbcd6335eca1b","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":97,"end_line":3,"start_column":1,"start_line":3,"text":"Randomised comparison of a continuous cold compress (worn for the first six hours after surgery,"},{"end_column":99,"end_line":4,"start_column":1,"start_line":4,"text":"29 patients) against an intermittent cold compress (twenty minutes on, twenty minutes off over the"},{"end_column":30,"end_line":5,"start_column":1,"start_line":5,"text":"same six hours, 29 patients)."},{"end_column":96,"end_line":9,"start_column":1,"start_line":9,"text":"File: `molar_cold_therapy.csv`. **One row is one patient**: the cold therapy schedule they were"},{"end_column":98,"end_line":10,"start_column":1,"start_line":10,"text":"allocated to and their six declared outcome measurements. 58 rows, 29 per arm, no missing values."},{"end_column":28,"end_line":12,"start_column":1,"start_line":12,"text":"| Column | Unit | Meaning |"},{"end_column":20,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- |"},{"end_column":65,"end_line":14,"start_column":1,"start_line":14,"text":"| `patient_id` | none | Per-patient identifier, `P01` to `P58` |"},{"end_column":80,"end_line":15,"start_column":1,"start_line":15,"text":"| `cold_schedule` | none | Allocated schedule: `continuous` or `intermittent` |"},{"end_column":124,"end_line":16,"start_column":1,"start_line":16,"text":"| `swelling_d2_mm` | mm | Outcome 1 (primary). Facial swelling on day 2, increase over the pre-operative facial reference |"},{"end_column":92,"end_line":17,"start_column":1,"start_line":17,"text":"| `opening_d2_mm` | mm | Outcome 2 (primary). Maximum interincisal mouth opening on day 2 |"},{"end_column":82,"end_line":18,"start_column":1,"start_line":18,"text":"| `pain_d1_vas` | 0-100 VAS points | Outcome 3 (secondary). Worst pain on day 1 |"},{"end_column":82,"end_line":19,"start_column":1,"start_line":19,"text":"| `pain_d3_vas` | 0-100 VAS points | Outcome 4 (secondary). Worst pain on day 3 |"},{"end_column":104,"end_line":20,"start_column":1,"start_line":20,"text":"| `rescue_tabs_n` | count | Outcome 5 (secondary). Rescue analgesic tablets over the first three days |"},{"end_column":87,"end_line":21,"start_column":1,"start_line":21,"text":"| `diet_return_d` | days | Outcome 6 (secondary). Days until return to a normal diet |"},{"end_column":94,"end_line":23,"start_column":1,"start_line":23,"text":"Higher swelling, pain, tablet counts and diet-return days mean a worse recovery; higher mouth"},{"end_column":33,"end_line":24,"start_column":1,"start_line":24,"text":"opening means a better recovery."},{"end_column":89,"end_line":28,"start_column":1,"start_line":28,"text":"Each of the six pre-declared outcomes was compared between the two arms with a two-sided"},{"end_column":96,"end_line":29,"start_column":1,"start_line":29,"text":"two-sample t-test (`scipy.stats.ttest_ind`), reporting the group means, the t statistic and the"},{"end_column":9,"end_line":30,"start_column":1,"start_line":30,"text":"p-value."},{"end_column":99,"end_line":32,"start_column":1,"start_line":32,"text":"The protocol named `swelling_d2_mm` and `opening_d2_mm` as the primary endpoints, so those are the"},{"end_column":99,"end_line":33,"start_column":1,"start_line":33,"text":"endpoints given multiplicity protection. Their two p-values were passed through the Holm procedure"},{"end_column":96,"end_line":34,"start_column":1,"start_line":34,"text":"(`statsmodels.stats.multitest.multipletests`, `method=\"holm\"`), and their significance verdicts"},{"end_column":78,"end_line":35,"start_column":1,"start_line":35,"text":"were read from the Holm-adjusted p-values at the conventional 0.05 threshold."},{"end_column":99,"end_line":37,"start_column":1,"start_line":37,"text":"The four secondary outcomes were each treated as their own separate pre-declared question, so each"},{"end_column":100,"end_line":38,"start_column":1,"start_line":38,"text":"secondary verdict comes from its raw p-value compared with the 0.05 threshold, exactly as measured."},{"end_column":35,"end_line":39,"start_column":1,"start_line":39,"text":"No further adjustment was applied."},{"end_column":83,"end_line":41,"start_column":1,"start_line":41,"text":"All numbers below are the output of `analysis.py` run on `molar_cold_therapy.csv`."},{"end_column":87,"end_line":47,"start_column":1,"start_line":47,"text":"| # | Outcome | Mean, continuous | Mean, intermittent | t | Raw p | Holm p | Verdict |"},{"end_column":50,"end_line":48,"start_column":1,"start_line":48,"text":"| --- | --- | --- | --- | --- | --- | --- | --- |"},{"end_column":87,"end_line":49,"start_column":1,"start_line":49,"text":"| 1 | `swelling_d2_mm` | 9.11 | 12.41 | -4.010 | 0.00018 | 0.00036 | **Significant** |"},{"end_column":84,"end_line":50,"start_column":1,"start_line":50,"text":"| 2 | `opening_d2_mm` | 34.00 | 30.00 | 2.576 | 0.0127 | 0.0127 | **Significant** |"},{"end_column":91,"end_line":52,"start_column":1,"start_line":52,"text":"Both primary endpoints favour the continuous compress and both stay significant after Holm"},{"end_column":95,"end_line":53,"start_column":1,"start_line":53,"text":"adjustment. Day 2 swelling was 3.30 mm lower with continuous cold, and day 2 mouth opening was"},{"end_column":15,"end_line":54,"start_column":1,"start_line":54,"text":"4.00 mm wider."},{"end_column":74,"end_line":58,"start_column":1,"start_line":58,"text":"| # | Outcome | Mean, continuous | Mean, intermittent | t | p | Verdict |"},{"end_column":44,"end_line":59,"start_column":1,"start_line":59,"text":"| --- | --- | --- | --- | --- | --- | --- |"},{"end_column":74,"end_line":60,"start_column":1,"start_line":60,"text":"| 3 | `pain_d1_vas` | 46.97 | 51.07 | -1.113 | 0.2705 | Not significant |"},{"end_column":74,"end_line":61,"start_column":1,"start_line":61,"text":"| 4 | `pain_d3_vas` | 23.97 | 27.00 | -0.909 | 0.3672 | Not significant |"},{"end_column":74,"end_line":62,"start_column":1,"start_line":62,"text":"| 5 | `rescue_tabs_n` | 6.28 | 6.76 | -0.639 | 0.5262 | Not significant |"},{"end_column":74,"end_line":63,"start_column":1,"start_line":63,"text":"| 6 | `diet_return_d` | 3.34 | 3.66 | -1.007 | 0.3182 | Not significant |"},{"end_column":98,"end_line":65,"start_column":1,"start_line":65,"text":"All four secondary outcomes point in the same direction as the primaries, with the continuous arm"},{"end_column":99,"end_line":66,"start_column":1,"start_line":66,"text":"slightly better on each, but none reaches the 0.05 threshold: 4.10 fewer VAS points on day 1, 3.03"},{"end_column":81,"end_line":67,"start_column":1,"start_line":67,"text":"fewer on day 3, 0.48 fewer rescue tablets, and 0.31 fewer days to a normal diet."},{"end_column":96,"end_line":71,"start_column":1,"start_line":71,"text":"In this trial, wearing the cold compress continuously through the first six postoperative hours"},{"end_column":97,"end_line":72,"start_column":1,"start_line":72,"text":"gave a measurably better day 2 recovery than the twenty-on/twenty-off schedule on both protected"},{"end_column":98,"end_line":73,"start_column":1,"start_line":73,"text":"endpoints. The swelling difference of about 3.3 mm and the mouth opening difference of about 4 mm"},{"end_column":94,"end_line":74,"start_column":1,"start_line":74,"text":"are the size of effect an oral surgeon would notice at the day 2 review, and both survive the"},{"end_column":53,"end_line":75,"start_column":1,"start_line":75,"text":"adjustment applied across the two primary endpoints."},{"end_column":94,"end_line":77,"start_column":1,"start_line":77,"text":"The comfort and function measures tell a softer story. Pain scores on day 1 and day 3, rescue"},{"end_column":99,"end_line":78,"start_column":1,"start_line":78,"text":"tablet use, and time back to a normal diet all lean toward continuous cold, but each difference is"},{"end_column":98,"end_line":79,"start_column":1,"start_line":79,"text":"small relative to the patient-to-patient scatter and none is statistically significant on its own"},{"end_column":95,"end_line":80,"start_column":1,"start_line":80,"text":"pre-declared test. With 29 patients per arm, differences of this size would not be expected to"},{"end_column":97,"end_line":81,"start_column":1,"start_line":81,"text":"separate reliably, so these results are best read as consistent with the primary findings rather"},{"end_column":42,"end_line":82,"start_column":1,"start_line":82,"text":"than as evidence of an analgesic benefit."},{"end_column":100,"end_line":84,"start_column":1,"start_line":84,"text":"Practically, the trial supports advising continuous cold application over the first six hours where"},{"end_column":99,"end_line":85,"start_column":1,"start_line":85,"text":"the patient can tolerate it, on the grounds of less day 2 swelling and better mouth opening, while"},{"end_column":92,"end_line":86,"start_column":1,"start_line":86,"text":"setting the expectation that early pain and analgesic use will be much the same either way."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d03e38c1f7e85eb87cb6","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f70b8a2c357c1b08801be1841a72fbab3fd44eed7e64554cfa21c04c80422ec7","end_line":86,"locator":"report.md:1-86","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

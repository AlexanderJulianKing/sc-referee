{"audit_run_id":"audit:ef99ca3b7184445e895cbcd6335eca1b","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":31,"end_line":3,"start_column":1,"start_line":3,"text":"File: `molar_cold_therapy.csv`"},{"end_column":92,"end_line":5,"start_column":1,"start_line":5,"text":"Randomised clinical study of cold therapy after surgical removal of an impacted lower third"},{"end_column":87,"end_line":6,"start_column":1,"start_line":6,"text":"molar. 58 adult patients, each contributing one operated side and one set of follow-up"},{"end_column":14,"end_line":7,"start_column":1,"start_line":7,"text":"measurements."},{"end_column":89,"end_line":9,"start_column":1,"start_line":9,"text":"**One row is one patient**: their allocated cold therapy schedule and their six declared"},{"end_column":87,"end_line":10,"start_column":1,"start_line":10,"text":"outcome measurements. There are 58 rows plus a header row, 29 patients per arm, and no"},{"end_column":68,"end_line":11,"start_column":1,"start_line":11,"text":"missing values, so every patient has a number for all six outcomes."},{"end_column":35,"end_line":15,"start_column":1,"start_line":15,"text":"| Column | Type | Unit | Meaning |"},{"end_column":26,"end_line":16,"start_column":1,"start_line":16,"text":"| --- | --- | --- | --- |"},{"end_column":97,"end_line":17,"start_column":1,"start_line":17,"text":"| `patient_id` | text | none | Per-patient identifier, `P01` through `P58`, unique in the file |"},{"end_column":317,"end_line":18,"start_column":1,"start_line":18,"text":"| `cold_schedule` | text | none | Allocated cold therapy schedule. Exactly two distinct values: `continuous` (cold compress worn continuously for the first six hours after surgery, 29 patients) and `intermittent` (cold compress applied twenty minutes on and twenty minutes off over the same six hours, 29 patients) |"},{"end_column":172,"end_line":19,"start_column":1,"start_line":19,"text":"| `swelling_d2_mm` | number, 1 decimal | millimetres | Outcome 1 (primary). Facial swelling on day 2, as the increase over the pre-operative facial reference measurement |"},{"end_column":121,"end_line":20,"start_column":1,"start_line":20,"text":"| `opening_d2_mm` | number, 1 decimal | millimetres | Outcome 2 (primary). Maximum interincisal mouth opening on day 2 |"},{"end_column":129,"end_line":21,"start_column":1,"start_line":21,"text":"| `pain_d1_vas` | integer | points, 0-100 VAS | Outcome 3 (secondary). Worst pain on day 1 on a 0 to 100 visual analogue scale |"},{"end_column":136,"end_line":22,"start_column":1,"start_line":22,"text":"| `pain_d3_vas` | integer | points, 0-100 VAS | Outcome 4 (secondary). Worst pain on day 3 on the same 0 to 100 visual analogue scale |"},{"end_column":120,"end_line":23,"start_column":1,"start_line":23,"text":"| `rescue_tabs_n` | integer | count | Outcome 5 (secondary). Rescue analgesic tablets taken over the first three days |"},{"end_column":97,"end_line":24,"start_column":1,"start_line":24,"text":"| `diet_return_d` | integer | days | Outcome 6 (secondary). Days until return to a normal diet |"},{"end_column":94,"end_line":26,"start_column":1,"start_line":26,"text":"Columns appear in the order listed: identifier, group, then the six outcomes in the order the"},{"end_column":94,"end_line":27,"start_column":1,"start_line":27,"text":"protocol declared them. Outcomes 1 and 2 were declared as the primary outcomes and outcomes 3"},{"end_column":37,"end_line":28,"start_column":1,"start_line":28,"text":"through 6 as the secondary outcomes."},{"end_column":31,"end_line":32,"start_column":1,"start_line":32,"text":"| Column | Minimum | Maximum |"},{"end_column":20,"end_line":33,"start_column":1,"start_line":33,"text":"| --- | --- | --- |"},{"end_column":34,"end_line":34,"start_column":1,"start_line":34,"text":"| `swelling_d2_mm` | 4.9 | 19.4 |"},{"end_column":34,"end_line":35,"start_column":1,"start_line":35,"text":"| `opening_d2_mm` | 19.5 | 46.6 |"},{"end_column":28,"end_line":36,"start_column":1,"start_line":36,"text":"| `pain_d1_vas` | 21 | 86 |"},{"end_column":27,"end_line":37,"start_column":1,"start_line":37,"text":"| `pain_d3_vas` | 2 | 55 |"},{"end_column":29,"end_line":38,"start_column":1,"start_line":38,"text":"| `rescue_tabs_n` | 0 | 12 |"},{"end_column":28,"end_line":39,"start_column":1,"start_line":39,"text":"| `diet_return_d` | 1 | 6 |"},{"end_column":91,"end_line":41,"start_column":1,"start_line":41,"text":"Higher `swelling_d2_mm`, `pain_d1_vas`, `pain_d3_vas`, `rescue_tabs_n` and `diet_return_d`"},{"end_column":90,"end_line":42,"start_column":1,"start_line":42,"text":"indicate a worse recovery; higher `opening_d2_mm` indicates a better recovery, because it"},{"end_column":50,"end_line":43,"start_column":1,"start_line":43,"text":"measures how wide the patient can open the mouth."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:232478a9be24eb2767a8","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:3e45ec7d8ff08f64cd6dbd5cc639fbbcbb83516eb16d6e6e53036d62813941c5","end_line":43,"locator":"DATA_DESCRIPTION.md:1-43","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:ef99ca3b7184445e895cbcd6335eca1b","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":103,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `cold_schedule` column of `molar_cold_therapy.csv`."},{"end_column":145,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: swelling_d2_mm, opening_d2_mm, pain_d1_vas, pain_d3_vas, rescue_tabs_n, diet_return_d."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1d8653fcca0cdddefebb","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:97570d6cdc1679cbd02c26ca1ab2e71b0ef8e9129edf13c9c7dce12f10976f8d","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

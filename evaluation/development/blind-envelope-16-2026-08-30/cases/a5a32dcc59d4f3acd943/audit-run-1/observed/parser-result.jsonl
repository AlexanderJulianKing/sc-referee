5bd172c9168ecd9d2f7b42cb47f4beec097e2220985f54c4129dd96a60e708f","end_line":78,"locator":"analysis.py:1-78","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3d30e67565eb48e3b5c454ef52fd1b8e","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":82,"end_line":5,"start_column":1,"start_line":5,"text":"The analysis uses `tinnitus_sound_therapy.csv`, which holds 70 data rows. One row"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"is one participant: a single adult with chronic subjective tinnitus of at least"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"six months duration, carrying that participant's therapy allocation and their"},{"end_column":73,"end_line":8,"start_column":1,"start_line":8,"text":"five declared outcome measurements from the week-twelve assessment. Each"},{"end_column":59,"end_line":9,"start_column":1,"start_line":9,"text":"participant appears exactly once, and no value is missing."},{"end_column":25,"end_line":11,"start_column":1,"start_line":11,"text":"| Column | Description |"},{"end_column":14,"end_line":12,"start_column":1,"start_line":12,"text":"| --- | --- |"},{"end_column":60,"end_line":13,"start_column":1,"start_line":13,"text":"| `pid` | Per-participant identifier, `p01` through `p70` |"},{"end_column":82,"end_line":14,"start_column":1,"start_line":14,"text":"| `noise_type` | Therapy allocation: `notched` (n = 35) or `broadband` (n = 35) |"},{"end_column":96,"end_line":15,"start_column":1,"start_line":15,"text":"| `thi_pts` | Tinnitus handicap inventory total, points on a 0 to 100 scale (higher is worse) |"},{"end_column":89,"end_line":16,"start_column":1,"start_line":16,"text":"| `loudness_pts` | Tinnitus loudness rating, points on a 0 to 10 visual analogue scale |"},{"end_column":93,"end_line":17,"start_column":1,"start_line":17,"text":"| `sleep_idx_pts` | Sleep quality index, points on a 0 to 21 scale (higher is worse sleep) |"},{"end_column":82,"end_line":18,"start_column":1,"start_line":18,"text":"| `anxiety_pts` | Anxiety subscale, points on a 0 to 21 scale (higher is worse) |"},{"end_column":71,"end_line":19,"start_column":1,"start_line":19,"text":"| `mml_db` | Minimum masking level, decibels sensation level (dB SL) |"},{"end_column":73,"end_line":21,"start_column":1,"start_line":21,"text":"The five outcome columns appear in the order the protocol declared them."},{"end_column":78,"end_line":25,"start_column":1,"start_line":25,"text":"Each of the five declared outcomes is compared between the two therapy groups"},{"end_column":81,"end_line":26,"start_column":1,"start_line":26,"text":"with a two-sample t test for independent samples, reporting the group means, the"},{"end_column":29,"end_line":27,"start_column":1,"start_line":27,"text":"t statistic and the p-value."},{"end_column":79,"end_line":29,"start_column":1,"start_line":29,"text":"The per-outcome significance threshold is 0.01, and that number comes from the"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"protocol's multiplicity plan, fixed in advance of data collection. The declared"},{"end_column":77,"end_line":31,"start_column":1,"start_line":31,"text":"outcome family holds exactly five outcomes. The study accepts a conventional"},{"end_column":71,"end_line":32,"start_column":1,"start_line":32,"text":"family-wise error rate of 0.05 across that whole family. Dividing that"},{"end_column":66,"end_line":33,"start_column":1,"start_line":33,"text":"family-wise rate by the five outcomes, 0.05 / 5 = 0.01, gives the"},{"end_column":79,"end_line":34,"start_column":1,"start_line":34,"text":"Bonferroni-corrected per-outcome level. The protocol fixed 0.01 on that basis,"},{"end_column":77,"end_line":35,"start_column":1,"start_line":35,"text":"and the analysis judges every outcome in the family against it. The analysis"},{"end_column":75,"end_line":36,"start_column":1,"start_line":36,"text":"script applies 0.01 as a constant handed to it by the protocol and does no"},{"end_column":34,"end_line":37,"start_column":1,"start_line":37,"text":"correction arithmetic of its own."},{"end_column":81,"end_line":41,"start_column":1,"start_line":41,"text":"Group means, test statistics and p-values for all five outcomes, in the declared"},{"end_column":79,"end_line":42,"start_column":1,"start_line":42,"text":"order. The conclusion column judges each p-value against the fixed per-outcome"},{"end_column":15,"end_line":43,"start_column":1,"start_line":43,"text":"level of 0.01."},{"end_column":75,"end_line":45,"start_column":1,"start_line":45,"text":"| Outcome | Mean, notched | Mean, broadband | t | p | Conclusion at 0.01 |"},{"end_column":38,"end_line":46,"start_column":1,"start_line":46,"text":"| --- | --- | --- | --- | --- | --- |"},{"end_column":66,"end_line":47,"start_column":1,"start_line":47,"text":"| `thi_pts` | 34.114 | 43.829 | -3.248 | 0.001805 | Significant |"},{"end_column":69,"end_line":48,"start_column":1,"start_line":48,"text":"| `loudness_pts` | 4.097 | 5.291 | -3.352 | 0.001314 | Significant |"},{"end_column":74,"end_line":49,"start_column":1,"start_line":49,"text":"| `sleep_idx_pts` | 7.400 | 8.286 | -1.323 | 0.190345 | Not significant |"},{"end_column":72,"end_line":50,"start_column":1,"start_line":50,"text":"| `anxiety_pts` | 7.057 | 7.629 | -0.747 | 0.457543 | Not significant |"},{"end_column":67,"end_line":51,"start_column":1,"start_line":51,"text":"| `mml_db` | 8.889 | 9.400 | -0.634 | 0.527948 | Not significant |"},{"end_column":78,"end_line":53,"start_column":1,"start_line":53,"text":"Two of the five declared outcomes clear the 0.01 level: the tinnitus handicap"},{"end_column":79,"end_line":54,"start_column":1,"start_line":54,"text":"inventory total and the tinnitus loudness rating. The sleep quality index, the"},{"end_column":55,"end_line":55,"start_column":1,"start_line":55,"text":"anxiety subscale and the minimum masking level do not."},{"end_column":81,"end_line":59,"start_column":1,"start_line":59,"text":"At the week-twelve assessment, participants on individually shaped notched-noise"},{"end_column":75,"end_line":60,"start_column":1,"start_line":60,"text":"therapy reported a tinnitus handicap inventory total 9.7 points lower than"},{"end_column":77,"end_line":61,"start_column":1,"start_line":61,"text":"participants on unmodified broadband noise, and a loudness rating 1.2 points"},{"end_column":76,"end_line":62,"start_column":1,"start_line":62,"text":"lower on the 0 to 10 visual analogue scale. Both differences favour notched"},{"end_column":78,"end_line":63,"start_column":1,"start_line":63,"text":"noise and both meet the protocol's per-outcome level of 0.01, so they are the"},{"end_column":34,"end_line":64,"start_column":1,"start_line":64,"text":"two findings this trial supports."},{"end_column":75,"end_line":66,"start_column":1,"start_line":66,"text":"The remaining three outcomes show small differences in the same direction,"},{"end_column":78,"end_line":67,"start_column":1,"start_line":67,"text":"0.9 points on the sleep quality index, 0.6 points on the anxiety subscale and"},{"end_column":80,"end_line":68,"start_column":1,"start_line":68,"text":"0.5 dB SL on the minimum masking level, none of which reach the 0.01 level. For"},{"end_column":79,"end_line":69,"start_column":1,"start_line":69,"text":"an audiology audience the practical reading is that the benefit seen here sits"},{"end_column":77,"end_line":70,"start_column":1,"start_line":70,"text":"in what patients report about their tinnitus, its perceived handicap and its"},{"end_column":80,"end_line":71,"start_column":1,"start_line":71,"text":"loudness, rather than in the psychoacoustic masking measure or in the sleep and"},{"end_column":77,"end_line":72,"start_column":1,"start_line":72,"text":"anxiety scales. Minimum masking level in particular is essentially unchanged"},{"end_column":80,"end_line":73,"start_column":1,"start_line":73,"text":"between protocols, so a clinician should not expect the notched-noise advantage"},{"end_column":71,"end_line":74,"start_column":1,"start_line":74,"text":"to show up in that bench measurement. These results come from a single"},{"end_column":79,"end_line":75,"start_column":1,"start_line":75,"text":"twelve-week assessment with 35 participants per group, and the non-significant"},{"end_column":81,"end_line":76,"start_column":1,"start_line":76,"text":"outcomes are not evidence of no effect: this trial is not large enough to settle"},{"end_column":70,"end_line":77,"start_column":1,"start_line":77,"text":"differences of the size observed in sleep, anxiety and masking level."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c00bd0a7898ea7685821","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:cefbbb3e0105cc6f665f3dbbb205b123152fb3912938f582e322de166c551859","end_line":77,"locator":"report.md:1-77","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

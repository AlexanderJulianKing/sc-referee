73aa4439c869277f13","end_column":49,"end_line":72,"locator":"analysis.py:71-72","path":"analysis.py","quoted_text":"print(\"Significant at alpha = {}: {} of {} declared outcomes.\".format(\n        ALPHA, significant_count, len(results)))","source_kind":"file_span","start_column":5,"start_line":71}]},{"implementation":"python.call:<dynamic>.format","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:4467582b8fe9492372f2","output_refs":[],"record_type":"operation","run_id":"audit:9f3a10f97fe04093bf47b9f27fdf1cab","source_refs":[{"content_digest":"sha256:e64ec6f3c35190b3a1fb49a6708ea064b209224b9523a473aa4439c869277f13","end_column":48,"end_line":72,"locator":"analysis.py:71-72","path":"analysis.py","quoted_text":"\"Significant at alpha = {}: {} of {} declared outcomes.\".format(\n        ALPHA, significant_count, len(results))","source_kind":"file_span","start_column":11,"start_line":71}]},{"implementation":"python.call:len","input_refs":[],"inspection_status":"supported","kind":"aggregate","literal_parameters":{},"operation_id":"operation:a16f2db2cba8eefafc88","output_refs":[],"record_type":"operation","run_id":"audit:9f3a10f97fe04093bf47b9f27fdf1cab","source_refs":[{"content_digest":"sha256:e64ec6f3c35190b3a1fb49a6708ea064b209224b9523a473aa4439c869277f13","end_column":47,"end_line":72,"locator":"analysis.py:72-72","path":"analysis.py","quoted_text":"len(results)","source_kind":"file_span","start_column":35,"start_line":72}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:747e9aa247a5295d29ca","output_refs":[],"record_type":"operation","run_id":"audit:9f3a10f97fe04093bf47b9f27fdf1cab","source_refs":[{"content_digest":"sha256:e64ec6f3c35190b3a1fb49a6708ea064b209224b9523a473aa4439c869277f13","end_column":11,"end_line":78,"locator":"analysis.py:78-78","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":78}]}],"x-token-count":411},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:c1cde53764ba3cef8598","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:e64ec6f3c35190b3a1fb49a6708ea064b209224b9523a473aa4439c869277f13","end_line":78,"locator":"analysis.py:1-78","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:9f3a10f97fe04093bf47b9f27fdf1cab","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":96,"end_line":5,"start_column":1,"start_line":5,"text":"The analysis uses `quail_flooring.csv`. **One row is one Japanese quail chick.** Each of the 48"},{"end_column":98,"end_line":6,"start_column":1,"start_line":6,"text":"chicks was housed individually from hatch to 21 days of age on one of the two brooder floor types"},{"end_column":99,"end_line":7,"start_column":1,"start_line":7,"text":"and was measured once at the end of the 21-day rearing period, so every chick appears exactly once"},{"end_column":67,"end_line":8,"start_column":1,"start_line":8,"text":"and has a value for all six outcomes. There are no missing values."},{"end_column":32,"end_line":10,"start_column":1,"start_line":10,"text":"| Column | Unit | Description |"},{"end_column":20,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- | --- |"},{"end_column":58,"end_line":12,"start_column":1,"start_line":12,"text":"| `chick_id` | — | Per-chick identifier, `q01` to `q48` |"},{"end_column":80,"end_line":13,"start_column":1,"start_line":13,"text":"| `floor_type` | — | Brooder floor: `mesh` (24 chicks) or `straw` (24 chicks) |"},{"end_column":49,"end_line":14,"start_column":1,"start_line":14,"text":"| `body_weight_g` | g | Body weight at 21 days |"},{"end_column":82,"end_line":15,"start_column":1,"start_line":15,"text":"| `feed_intake_g_d` | g/day | Average daily feed intake over the rearing period |"},{"end_column":90,"end_line":16,"start_column":1,"start_line":16,"text":"| `footpad_score_pts` | points | Foot-pad lesion score at 21 days, 0 to 4 integer scale |"},{"end_column":53,"end_line":17,"start_column":1,"start_line":17,"text":"| `tibia_strength_n` | N | Tibia breaking strength |"},{"end_column":73,"end_line":18,"start_column":1,"start_line":18,"text":"| `corticosterone_ng_ml` | ng/mL | Plasma corticosterone concentration |"},{"end_column":60,"end_line":19,"start_column":1,"start_line":19,"text":"| `tonic_immobility_s` | s | Duration of tonic immobility |"},{"end_column":92,"end_line":23,"start_column":1,"start_line":23,"text":"The trial declared a family of six outcomes in advance, in the order listed above. For each"},{"end_column":94,"end_line":24,"start_column":1,"start_line":24,"text":"outcome, the mesh group (n = 24) and the straw group (n = 24) were compared with a two-sample"},{"end_column":95,"end_line":25,"start_column":1,"start_line":25,"text":"t-test (`scipy.stats.ttest_ind`), and the outcome was called significant when its p-value fell"},{"end_column":96,"end_line":26,"start_column":1,"start_line":26,"text":"below the conventional 0.05 threshold. Each outcome is a distinct pre-declared welfare question"},{"end_column":91,"end_line":27,"start_column":1,"start_line":27,"text":"about the flooring, so each receives its own verdict at 0.05 on its own merits. The script"},{"end_column":95,"end_line":28,"start_column":1,"start_line":28,"text":"`analysis.py` works through the declared outcome list in a single pass, applying the identical"},{"end_column":36,"end_line":29,"start_column":1,"start_line":29,"text":"comparison to each outcome in turn."},{"end_column":67,"end_line":33,"start_column":1,"start_line":33,"text":"| # | Outcome | Mesh mean | Straw mean | t | p | Verdict at 0.05 |"},{"end_column":44,"end_line":34,"start_column":1,"start_line":34,"text":"| --- | --- | --- | --- | --- | --- | --- |"},{"end_column":72,"end_line":35,"start_column":1,"start_line":35,"text":"| 1 | Body weight (g) | 89.32 | 94.41 | -2.537 | 0.0146 | Significant |"},{"end_column":90,"end_line":36,"start_column":1,"start_line":36,"text":"| 2 | Average daily feed intake (g/day) | 11.59 | 12.26 | -2.506 | 0.0158 | Significant |"},{"end_column":86,"end_line":37,"start_column":1,"start_line":37,"text":"| 3 | Foot-pad lesion score (points) | 1.79 | 0.71 | 4.307 | 0.000086 | Significant |"},{"end_column":88,"end_line":38,"start_column":1,"start_line":38,"text":"| 4 | Tibia breaking strength (N) | 27.18 | 29.82 | -1.949 | 0.0575 | Not significant |"},{"end_column":87,"end_line":39,"start_column":1,"start_line":39,"text":"| 5 | Plasma corticosterone (ng/mL) | 4.87 | 4.29 | 1.146 | 0.2576 | Not significant |"},{"end_column":82,"end_line":40,"start_column":1,"start_line":40,"text":"| 6 | Tonic immobility (s) | 120.17 | 104.67 | 1.060 | 0.2946 | Not significant |"},{"end_column":48,"end_line":42,"start_column":1,"start_line":42,"text":"Per-outcome conclusions, in the declared order:"},{"end_column":97,"end_line":44,"start_column":1,"start_line":44,"text":"1. **Body weight.** Chicks on straw were about 5.1 g heavier at 21 days than chicks on mesh. The"},{"end_column":38,"end_line":45,"start_column":4,"start_line":45,"text":"difference is significant at 0.05."},{"end_column":98,"end_line":46,"start_column":1,"start_line":46,"text":"2. **Feed intake.** Chicks on straw ate about 0.67 g/day more than chicks on mesh. Significant at"},{"end_column":9,"end_line":47,"start_column":4,"start_line":47,"text":"0.05."},{"end_column":92,"end_line":48,"start_column":1,"start_line":48,"text":"3. **Foot-pad lesion score.** Chicks on mesh scored about 1.08 points higher, meaning worse"},{"end_column":99,"end_line":49,"start_column":4,"start_line":49,"text":"lesions, than chicks on straw. Significant at 0.05, and the strongest separation in the family."},{"end_column":100,"end_line":50,"start_column":1,"start_line":50,"text":"4. **Tibia breaking strength.** Bones from straw-reared chicks broke at about 2.6 N more force, but"},{"end_column":53,"end_line":51,"start_column":4,"start_line":51,"text":"the difference does not reach the 0.05 threshold."},{"end_column":94,"end_line":52,"start_column":1,"start_line":52,"text":"5. **Plasma corticosterone.** Mesh birds averaged about 0.58 ng/mL higher, a small difference"},{"end_column":69,"end_line":53,"start_column":4,"start_line":53,"text":"against wide bird-to-bird variation, and not significant at 0.05."},{"end_column":92,"end_line":54,"start_column":1,"start_line":54,"text":"6. **Tonic immobility.** Mesh birds stayed immobile about 15 s longer on average, again not"},{"end_column":24,"end_line":55,"start_column":4,"start_line":55,"text":"significant at 0.05."},{"end_column":60,"end_line":57,"start_column":1,"start_line":57,"text":"Three of the six declared outcomes are significant at 0.05."},{"end_column":98,"end_line":61,"start_column":1,"start_line":61,"text":"On this trial, chopped straw litter looks better than plastic mesh for the first three weeks. The"},{"end_column":98,"end_line":62,"start_column":1,"start_line":62,"text":"clearest result is foot-pad health: mesh-reared chicks carried noticeably worse foot-pad lesions,"},{"end_column":100,"end_line":63,"start_column":1,"start_line":63,"text":"which is both a welfare cost and a downgrade risk at processing. Growth follows the same direction,"},{"end_column":99,"end_line":64,"start_column":1,"start_line":64,"text":"with straw-reared chicks eating slightly more each day and finishing about 5 g heavier at 21 days."},{"end_column":98,"end_line":66,"start_column":1,"start_line":66,"text":"The bone, hormone and fear-behaviour measures all lean the same way, favouring straw, but none of"},{"end_column":100,"end_line":67,"start_column":1,"start_line":67,"text":"those three reaches the 0.05 threshold here, so this trial does not establish a difference on them."},{"end_column":93,"end_line":68,"start_column":1,"start_line":68,"text":"Tibia strength in particular sits just outside the threshold (p = 0.0575) and would be worth"},{"end_column":67,"end_line":69,"start_column":1,"start_line":69,"text":"re-testing with more birds before drawing a conclusion either way."},{"end_column":100,"end_line":71,"start_column":1,"start_line":71,"text":"Practically: if a hatchery is choosing brooder flooring on the evidence in this trial, straw litter"},{"end_column":93,"end_line":72,"start_column":1,"start_line":72,"text":"is the option supported by the significant outcomes. The trade-offs that this trial does not"},{"end_column":100,"end_line":73,"start_column":1,"start_line":73,"text":"measure, such as litter cost, labour, and litter-borne disease management, still need to be weighed"},{"end_column":44,"end_line":74,"start_column":1,"start_line":74,"text":"alongside these welfare and growth results."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e6249fd3e34ce8400ab4","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:fd46b29c5d24c17e695c4c55839671e4ed22e9d45c8947bc31f7bc8b19c9f956","end_line":74,"locator":"report.md:1-74","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

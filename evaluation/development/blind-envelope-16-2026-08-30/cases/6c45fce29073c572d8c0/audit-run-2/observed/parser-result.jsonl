{"audit_run_id":"audit:bd2721b5ffd7481ba61b058ab48afaf7","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":34,"end_line":3,"start_column":1,"start_line":3,"text":"File: `lobster_shelter_trial.csv`"},{"end_column":97,"end_line":7,"start_column":1,"start_line":7,"text":"One row is one individually reared juvenile European lobster, followed for 60 days from a single"},{"end_column":97,"end_line":8,"start_column":1,"start_line":8,"text":"settlement cohort. The row carries that animal's shelter treatment and its value for each of the"},{"end_column":100,"end_line":9,"start_column":1,"start_line":9,"text":"five declared outcomes. The file holds 72 rows, one per animal, plus a header row. Every animal was"},{"end_column":87,"end_line":10,"start_column":1,"start_line":10,"text":"measured on every outcome, so there are no missing values and no animal appears twice."},{"end_column":36,"end_line":14,"start_column":1,"start_line":14,"text":"| Column | Type | Units | Meaning |"},{"end_column":26,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- | --- | --- |"},{"end_column":118,"end_line":16,"start_column":1,"start_line":16,"text":"| `lobster_id` | text | none | Short identifier for the individual animal, `L01` through `L72`. Unique in the file. |"},{"end_column":215,"end_line":17,"start_column":1,"start_line":17,"text":"| `shelter_type` | text | none | Rearing shelter the animal was held with. Exactly two values: `crushed_shell` (crushed shell substrate, 36 animals) and `plastic_tube` (moulded plastic tube shelters, 36 animals). |"},{"end_column":117,"end_line":18,"start_column":1,"start_line":18,"text":"| `carapace_increment_mm` | number | millimetres | Declared outcome 1. Growth in carapace length over the 60 days. |"},{"end_column":91,"end_line":19,"start_column":1,"start_line":19,"text":"| `mass_gain_g` | number | grams | Declared outcome 2. Wet mass gained over the 60 days. |"},{"end_column":121,"end_line":20,"start_column":1,"start_line":20,"text":"| `moult_count` | whole number | count | Declared outcome 3. Number of moults the animal completed during the 60 days. |"},{"end_column":181,"end_line":21,"start_column":1,"start_line":21,"text":"| `shelter_time_s` | whole number | seconds | Declared outcome 4. Time the animal spent sheltering during one standard ten minute observation, so the value can run from 0 to 600. |"},{"end_column":144,"end_line":22,"start_column":1,"start_line":22,"text":"| `haemolymph_protein_g_l` | number | grams per litre | Declared outcome 5. Total protein in the haemolymph, sampled at the end of the trial. |"},{"end_column":95,"end_line":24,"start_column":1,"start_line":24,"text":"The five outcome columns appear in the order the experiment declared them in advance: carapace"},{"end_column":72,"end_line":25,"start_column":1,"start_line":25,"text":"increment, mass gain, moult count, sheltering time, haemolymph protein."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1935c771ae5111dc445b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:a8da9b250cc1aefba3e480f95f604c8e4cda95cc83f7b7dfca8434fa4ad26aaf","end_line":25,"locator":"DATA_DESCRIPTION.md:1-25","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:bd2721b5ffd7481ba61b058ab48afaf7","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":105,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `shelter_type` column of `lobster_shelter_trial.csv`."},{"end_column":147,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: carapace_increment_mm, mass_gain_g, moult_count, shelter_time_s, haemolymph_protein_g_l."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d0f0bf1e10ff56a5eb6e","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:00da8c2954703f668ae45d1c946e8e5bb0600047ca682a37ddef1d36a4b62bf2","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

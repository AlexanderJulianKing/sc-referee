{"audit_run_id":"audit:bd2721b5ffd7481ba61b058ab48afaf7","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":96,"end_line":5,"start_column":1,"start_line":5,"text":"File: `lobster_shelter_trial.csv`. One row is one individually reared juvenile European lobster"},{"end_column":94,"end_line":6,"start_column":1,"start_line":6,"text":"from a single settlement cohort, followed for 60 days. The file holds 72 rows, 36 animals per"},{"end_column":38,"end_line":7,"start_column":1,"start_line":7,"text":"shelter type, with no missing values."},{"end_column":29,"end_line":9,"start_column":1,"start_line":9,"text":"| Column | Units | Meaning |"},{"end_column":20,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- |"},{"end_column":79,"end_line":11,"start_column":1,"start_line":11,"text":"| `lobster_id` | none | Identifier for the individual animal, `L01` to `L72` |"},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"| `shelter_type` | none | Rearing shelter: `crushed_shell` or `plastic_tube` |"},{"end_column":94,"end_line":13,"start_column":1,"start_line":13,"text":"| `carapace_increment_mm` | mm | Declared outcome 1: carapace length increment over 60 days |"},{"end_column":71,"end_line":14,"start_column":1,"start_line":14,"text":"| `mass_gain_g` | g | Declared outcome 2: wet mass gain over 60 days |"},{"end_column":79,"end_line":15,"start_column":1,"start_line":15,"text":"| `moult_count` | count | Declared outcome 3: moults completed in the period |"},{"end_column":93,"end_line":16,"start_column":1,"start_line":16,"text":"| `shelter_time_s` | s | Declared outcome 4: sheltering time in one ten minute observation |"},{"end_column":95,"end_line":17,"start_column":1,"start_line":17,"text":"| `haemolymph_protein_g_l` | g/L | Declared outcome 5: end of trial haemolymph total protein |"},{"end_column":98,"end_line":21,"start_column":1,"start_line":21,"text":"Each of the five declared outcomes was compared between the two shelter types with an independent"},{"end_column":81,"end_line":22,"start_column":1,"start_line":22,"text":"two-sample t-test (`scipy.stats.ttest_ind`), giving one raw p-value per outcome."},{"end_column":95,"end_line":24,"start_column":1,"start_line":24,"text":"The five declared outcomes form a single pre-declared family and were adjusted together as one"},{"end_column":89,"end_line":25,"start_column":1,"start_line":25,"text":"family at a family-wise level of 0.05. The adjustment was carried out by the third-party"},{"end_column":90,"end_line":26,"start_column":1,"start_line":26,"text":"statistics package **pingouin** (version 0.5.5), using `pingouin.multicomp` with the Holm"},{"end_column":95,"end_line":27,"start_column":1,"start_line":27,"text":"step-down procedure, which was handed the complete set of five raw p-values in one call. Every"},{"end_column":97,"end_line":28,"start_column":1,"start_line":28,"text":"significance verdict below is taken from the adjusted values pingouin returned; no verdict comes"},{"end_column":20,"end_line":29,"start_column":1,"start_line":29,"text":"from a raw p-value."},{"end_column":43,"end_line":33,"start_column":1,"start_line":33,"text":"Outcomes are listed in the declared order."},{"end_column":110,"end_line":35,"start_column":1,"start_line":35,"text":"| # | Outcome | Mean, crushed shell | Mean, plastic tube | Raw p | Adjusted p | Verdict at family-wise 0.05 |"},{"end_column":44,"end_line":36,"start_column":1,"start_line":36,"text":"| --- | --- | --- | --- | --- | --- | --- |"},{"end_column":82,"end_line":37,"start_column":1,"start_line":37,"text":"| 1 | `carapace_increment_mm` | 4.801 | 3.899 | 0.00207 | 0.00620 | Significant |"},{"end_column":72,"end_line":38,"start_column":1,"start_line":38,"text":"| 2 | `mass_gain_g` | 2.150 | 1.720 | 0.00061 | 0.00243 | Significant |"},{"end_column":76,"end_line":39,"start_column":1,"start_line":39,"text":"| 3 | `moult_count` | 2.361 | 2.167 | 0.24934 | 0.31329 | Not significant |"},{"end_column":79,"end_line":40,"start_column":1,"start_line":40,"text":"| 4 | `shelter_time_s` | 402.056 | 465.972 | 0.00044 | 0.00218 | Significant |"},{"end_column":89,"end_line":41,"start_column":1,"start_line":41,"text":"| 5 | `haemolymph_protein_g_l` | 40.989 | 39.008 | 0.15664 | 0.31329 | Not significant |"},{"end_column":48,"end_line":43,"start_column":1,"start_line":43,"text":"Per-outcome conclusions, in the declared order:"},{"end_column":97,"end_line":45,"start_column":1,"start_line":45,"text":"1. Carapace increment differs between shelter types. Animals on crushed shell grew about 0.90 mm"},{"end_column":26,"end_line":46,"start_column":4,"start_line":46,"text":"more over the 60 days."},{"end_column":95,"end_line":47,"start_column":1,"start_line":47,"text":"2. Mass gain differs between shelter types. Animals on crushed shell gained about 0.43 g more."},{"end_column":96,"end_line":48,"start_column":1,"start_line":48,"text":"3. Moult count shows no difference that survives the family-wise correction (means 2.36 against"},{"end_column":10,"end_line":49,"start_column":4,"start_line":49,"text":"2.17)."},{"end_column":92,"end_line":50,"start_column":1,"start_line":50,"text":"4. Sheltering time differs between shelter types. Animals with plastic tubes spent about 64"},{"end_column":58,"end_line":51,"start_column":4,"start_line":51,"text":"seconds more of the ten minute observation sheltering."},{"end_column":90,"end_line":52,"start_column":1,"start_line":52,"text":"5. Haemolymph protein shows no difference that survives the family-wise correction (means"},{"end_column":33,"end_line":53,"start_column":4,"start_line":53,"text":"40.99 g/L against 39.01 g/L)."},{"end_column":93,"end_line":57,"start_column":1,"start_line":57,"text":"On this cohort, crushed shell substrate went with faster growth on both size measures, while"},{"end_column":89,"end_line":58,"start_column":1,"start_line":58,"text":"moulded plastic tubes went with more time spent sheltering. Moult count and end of trial"},{"end_column":97,"end_line":59,"start_column":1,"start_line":59,"text":"haemolymph protein did not separate the two shelter types once the whole declared family of five"},{"end_column":95,"end_line":60,"start_column":1,"start_line":60,"text":"outcomes was corrected together, so this trial gives no evidence that the shelter type changes"},{"end_column":59,"end_line":61,"start_column":1,"start_line":61,"text":"moult frequency or nutritional condition as measured here."},{"end_column":98,"end_line":63,"start_column":1,"start_line":63,"text":"A hatchery whose release target is size at release has a reason from these data to prefer crushed"},{"end_column":89,"end_line":64,"start_column":1,"start_line":64,"text":"shell substrate. A hatchery that instead wants juveniles to shelter more, for example if"},{"end_column":96,"end_line":65,"start_column":1,"start_line":65,"text":"post-release predation is the binding constraint, would read the sheltering result in favour of"},{"end_column":98,"end_line":66,"start_column":1,"start_line":66,"text":"tube shelters. These are the two ends of a trade-off within one 60 day trial on 72 animals from a"},{"end_column":93,"end_line":67,"start_column":1,"start_line":67,"text":"single cohort, and nothing here measures survival after release, so the choice should not be"},{"end_column":29,"end_line":68,"start_column":1,"start_line":68,"text":"settled on this trial alone."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:88a96275d9ecfef50bf0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f58cae1ec810781cdb87a878ad640509ef16ef506b2a145ad586833a37a6a13a","end_line":68,"locator":"report.md:1-68","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

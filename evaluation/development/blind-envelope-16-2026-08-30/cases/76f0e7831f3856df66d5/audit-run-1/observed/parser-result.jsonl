{"audit_run_id":"audit:9548f9a0a8604ba99f783a200d18d31a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":96,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `cut_regime` column of `hedge_sections.csv`."},{"end_column":148,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: berry_mass_gpm, stem_density_spm, plant_richness_spp, basal_gap_pct, invert_biomass_mgpm."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:5d70dd070c9860f3b3a1","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:d0926ed11a6b5eee2d6c2080b632f8a6a6acbdf303e51571d7034a0e8185e3e1","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

_type":"operation","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":10,"end_line":93,"locator":"analysis.py:88-93","path":"analysis.py","quoted_text":"print(\n            f\"  {r['outcome']}: mean({GROUP_A}) = {r['mean_foam_pad']:.4f}, \"\n            f\"mean({GROUP_B}) = {r['mean_sacking_wrap']:.4f}, \"\n            f\"t = {r['t_stat']:.4f}, p = {r['p_value']:.6g}, \"\n            f\"Sidak threshold = {SIDAK_THRESHOLD:.6f} -> {r['verdict']}\"\n        )","source_kind":"file_span","start_column":9,"start_line":88}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:e7b845af6ae5fc08378c","output_refs":[],"record_type":"operation","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":11,"end_line":97,"locator":"analysis.py:97-97","path":"analysis.py","quoted_text":"main()","source_kind":"file_span","start_column":5,"start_line":97}]}],"x-token-count":377},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:python-ast-tokenize","parser_result_id":"parser-result:88ffd873b530e5320405","parser_version":"0.15.1","provenance":{"actor":{"actor_id":"parser:python-ast-tokenize","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_parse","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_line":97,"locator":"analysis.py:1-97","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":83,"end_line":5,"start_column":1,"start_line":5,"text":"The analysis uses `girth_pad_trial.csv`. **One row is one donkey**: a single adult"},{"end_column":83,"end_line":6,"start_column":1,"start_line":6,"text":"working donkey assessed once, after four weeks of normal brick-cart work, with its"},{"end_column":83,"end_line":7,"start_column":1,"start_line":7,"text":"harness group and its five declared outcome measurements from that one assessment."},{"end_column":64,"end_line":8,"start_column":1,"start_line":8,"text":"There are 48 rows, 24 donkeys per group, and no missing values."},{"end_column":25,"end_line":10,"start_column":1,"start_line":10,"text":"| Column | Description |"},{"end_column":14,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- |"},{"end_column":56,"end_line":12,"start_column":1,"start_line":12,"text":"| `donkey_id` | Per-donkey identifier, `D01` to `D48` |"},{"end_column":89,"end_line":13,"start_column":1,"start_line":13,"text":"| `girth_type` | Harness group: `foam_pad` (24 donkeys) or `sacking_wrap` (24 donkeys) |"},{"end_column":82,"end_line":14,"start_column":1,"start_line":14,"text":"| `lesion_score_pts` | Girth-region skin lesion score, points on a 0 to 5 scale |"},{"end_column":73,"end_line":15,"start_column":1,"start_line":15,"text":"| `hair_loss_cm2` | Area of girth-region hair loss, square centimetres |"},{"end_column":87,"end_line":16,"start_column":1,"start_line":16,"text":"| `nociceptive_threshold_n` | Mechanical nociceptive threshold at the girth, newtons |"},{"end_column":74,"end_line":17,"start_column":1,"start_line":17,"text":"| `body_condition_pts` | Body condition score, points on a 1 to 9 scale |"},{"end_column":91,"end_line":18,"start_column":1,"start_line":18,"text":"| `rectal_temp_c` | Rectal temperature 15 minutes after the working day, degrees Celsius |"},{"end_column":70,"end_line":20,"start_column":1,"start_line":20,"text":"The five outcome columns appear in the order the trial declared them."},{"end_column":86,"end_line":24,"start_column":1,"start_line":24,"text":"Each of the five declared outcomes was compared between the two harness groups with a"},{"end_column":19,"end_line":25,"start_column":1,"start_line":25,"text":"two-sample t-test."},{"end_column":89,"end_line":27,"start_column":1,"start_line":27,"text":"The five outcomes form one declared family, so the family-wise error rate was controlled"},{"end_column":39,"end_line":28,"start_column":1,"start_line":28,"text":"with a Sidak per-comparison threshold:"},{"end_column":32,"end_line":30,"start_column":1,"start_line":30,"text":"- family-wise error level: 0.05"},{"end_column":35,"end_line":31,"start_column":1,"start_line":31,"text":"- family size: 5 declared outcomes"},{"end_column":70,"end_line":32,"start_column":1,"start_line":32,"text":"- Sidak per-comparison threshold: 1 - (1 - 0.05)^(1/5) = **0.010206**"},{"end_column":88,"end_line":34,"start_column":1,"start_line":34,"text":"Every outcome was judged against that computed threshold of 0.010206, not against 0.05."},{"end_column":88,"end_line":38,"start_column":1,"start_line":38,"text":"| Outcome | Mean, foam pad | Mean, sacking wrap | p-value | Sidak threshold | Verdict |"},{"end_column":38,"end_line":39,"start_column":1,"start_line":39,"text":"| --- | --- | --- | --- | --- | --- |"},{"end_column":75,"end_line":40,"start_column":1,"start_line":40,"text":"| `lesion_score_pts` | 0.917 | 2.333 | 3.30e-07 | 0.010206 | significant |"},{"end_column":74,"end_line":41,"start_column":1,"start_line":41,"text":"| `hair_loss_cm2` | 11.875 | 27.475 | 5.12e-06 | 0.010206 | significant |"},{"end_column":84,"end_line":42,"start_column":1,"start_line":42,"text":"| `nociceptive_threshold_n` | 24.471 | 20.129 | 0.001163 | 0.010206 | significant |"},{"end_column":79,"end_line":43,"start_column":1,"start_line":43,"text":"| `body_condition_pts` | 4.333 | 4.229 | 0.6109 | 0.010206 | not significant |"},{"end_column":76,"end_line":44,"start_column":1,"start_line":44,"text":"| `rectal_temp_c` | 38.400 | 38.492 | 0.3830 | 0.010206 | not significant |"},{"end_column":48,"end_line":46,"start_column":1,"start_line":46,"text":"Per-outcome conclusions, in the declared order:"},{"end_column":84,"end_line":48,"start_column":1,"start_line":48,"text":"1. **Lesion score.** Donkeys in the foam pad scored 1.42 points lower on the 0 to 5"},{"end_column":75,"end_line":49,"start_column":4,"start_line":49,"text":"lesion scale. The p-value is below the Sidak threshold, so significant."},{"end_column":86,"end_line":50,"start_column":1,"start_line":50,"text":"2. **Hair loss.** Foam-pad donkeys lost 15.6 cm2 less hair in the girth region, about"},{"end_column":81,"end_line":51,"start_column":4,"start_line":51,"text":"57% less than the sacking-wrapped group. Below the threshold, so significant."},{"end_column":85,"end_line":52,"start_column":1,"start_line":52,"text":"3. **Nociceptive threshold.** Foam-pad donkeys tolerated 4.34 N more pressure before"},{"end_column":91,"end_line":53,"start_column":4,"start_line":53,"text":"responding, meaning less girth-region sensitivity. Below the threshold, so significant."},{"end_column":85,"end_line":54,"start_column":1,"start_line":54,"text":"4. **Body condition.** The groups differed by 0.10 points on the 1 to 9 scale. Above"},{"end_column":38,"end_line":55,"start_column":4,"start_line":55,"text":"the threshold, so not significant."},{"end_column":82,"end_line":56,"start_column":1,"start_line":56,"text":"5. **Rectal temperature.** The groups differed by 0.09 degrees Celsius. Above the"},{"end_column":34,"end_line":57,"start_column":4,"start_line":57,"text":"threshold, so not significant."},{"end_column":89,"end_line":61,"start_column":1,"start_line":61,"text":"All three girth-region outcomes moved in the direction that favours the closed-cell foam"},{"end_column":88,"end_line":62,"start_column":1,"start_line":62,"text":"pad: less visible skin damage, less hair loss, and less pressure sensitivity after four"},{"end_column":83,"end_line":63,"start_column":1,"start_line":63,"text":"weeks of work. Each cleared the stricter Sidak threshold, so the pattern is not an"},{"end_column":43,"end_line":64,"start_column":1,"start_line":64,"text":"artefact of testing five outcomes at once."},{"end_column":87,"end_line":66,"start_column":1,"start_line":66,"text":"The two whole-animal outcomes, body condition and rectal temperature, were essentially"},{"end_column":83,"end_line":67,"start_column":1,"start_line":67,"text":"unchanged. That is what a welfare programme should expect over four weeks: the pad"},{"end_column":86,"end_line":68,"start_column":1,"start_line":68,"text":"changes the harness contact area, not the donkey's nutrition or thermal load. It also"},{"end_column":87,"end_line":69,"start_column":1,"start_line":69,"text":"suggests the girth-region gains are local effects of the padding rather than a general"},{"end_column":46,"end_line":70,"start_column":1,"start_line":70,"text":"difference between the two groups of animals."},{"end_column":87,"end_line":72,"start_column":1,"start_line":72,"text":"For a working-animal welfare programme, this supports rolling out the closed-cell foam"},{"end_column":89,"end_line":73,"start_column":1,"start_line":73,"text":"girth pad as a low-cost change aimed at girth lesions, a common harness injury site. The"},{"end_column":89,"end_line":74,"start_column":1,"start_line":74,"text":"caveats are the ones this design carries: 48 animals assessed at a single four-week time"},{"end_column":80,"end_line":75,"start_column":1,"start_line":75,"text":"point, so the results say nothing about durability of the pad, longer-term body"},{"end_column":85,"end_line":76,"start_column":1,"start_line":76,"text":"condition, or whether the same benefit holds under different cart loads or climates."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c38fd1a248090a07321d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:2a4f22231c3457fbe8d1f41829d0b67844cadd26b9d7a65de6950290a7d8898e","end_line":76,"locator":"report.md:1-76","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

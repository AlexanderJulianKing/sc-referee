n","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":42,"end_line":71,"locator":"analysis.py:71-71","path":"analysis.py","quoted_text":"a.mean()","source_kind":"file_span","start_column":34,"start_line":71}]},{"implementation":"python.call:b.mean","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:a1abe66e9a3449ad3be0","output_refs":[],"record_type":"operation","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":46,"end_line":72,"locator":"analysis.py:72-72","path":"analysis.py","quoted_text":"b.mean()","source_kind":"file_span","start_column":38,"start_line":72}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:21c78973070a45a8e956","output_refs":[],"record_type":"operation","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":10,"end_line":83,"locator":"analysis.py:80-83","path":"analysis.py","quoted_text":"print(\n            f\"{outcome:<26}{a.mean():>16.4f}{b.mean():>18.4f}\"\n            f\"{p_value:>14.6g}{SIDAK_THRESHOLD:>12.6f}  {verdict}\"\n        )","source_kind":"file_span","start_column":9,"start_line":80}]},{"implementation":"python.call:a.mean","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:f09c6e80a717d1d6b86c","output_refs":[],"record_type":"operation","run_id":"audit:82c85106871740efbcd9f0e49a91d3c5","source_refs":[{"content_digest":"sha256:406a6764ed779dfee1aa158f544f2112267e56d52ab61734ff2557923df4bd78","end_column":37,"end_line":81,"locator":"ana
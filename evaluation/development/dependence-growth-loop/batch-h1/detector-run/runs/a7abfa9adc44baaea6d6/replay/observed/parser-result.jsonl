{"audit_run_id":"audit:1e6b0fabce9340d092a085ce25f4dff8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Wrack Bay is a barrier-island lagoon whose shallow freshwater lens is watched"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"for saltwater intrusion. Thirty permanent monitoring wells are screened in the"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"surficial aquifer, and each well belongs to one of three shoreline zones: the"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"dune ridge farthest from open water, the back-barrier flats behind it, and the"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"tidal flat nearest the inlet. Every well was visited four times during a single"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"field season. On each visit the well was purged and one grab sample was pumped"},{"end_column":75,"end_line":9,"start_column":1,"start_line":9,"text":"from the screen and sent to the laboratory for chloride analysis. The file"},{"end_column":73,"end_line":10,"start_column":1,"start_line":10,"text":"therefore holds 120 sample rows: four rows for each of the thirty wells."},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":77,"end_line":14,"start_column":1,"start_line":14,"text":"- well_id: identifier of the monitoring well the sample was pumped from. The"},{"end_column":80,"end_line":15,"start_column":3,"start_line":15,"text":"same well identifier appears once for each of its four visits, so identifiers"},{"end_column":24,"end_line":16,"start_column":3,"start_line":16,"text":"repeat down the file."},{"end_column":79,"end_line":17,"start_column":1,"start_line":17,"text":"- coastal_zone: the shoreline zone the well sits in (dune_ridge, back_barrier,"},{"end_column":79,"end_line":18,"start_column":3,"start_line":18,"text":"tidal_flat). This is a fixed property of the well, so it is identical across"},{"end_column":40,"end_line":19,"start_column":3,"start_line":19,"text":"all four rows belonging to that well."},{"end_column":72,"end_line":20,"start_column":1,"start_line":20,"text":"- visit: which of the four scheduled sampling visits produced this row,"},{"end_column":24,"end_line":21,"start_column":3,"start_line":21,"text":"numbered 1 through 4."},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"- depth_m: screened depth of the well below ground surface, in metres. Another"},{"end_column":65,"end_line":23,"start_column":3,"start_line":23,"text":"fixed well property, repeated on all four of that well's rows."},{"end_column":78,"end_line":24,"start_column":1,"start_line":24,"text":"- chloride_mg_l: chloride concentration measured in that visit's grab sample,"},{"end_column":80,"end_line":25,"start_column":3,"start_line":25,"text":"in milligrams per litre. The regulatory action limit used by the programme is"},{"end_column":12,"end_line":26,"start_column":3,"start_line":26,"text":"250 mg/L."},{"end_column":83,"end_line":28,"start_column":1,"start_line":28,"text":"One row is: one grab sample pumped from one monitoring well on one scheduled visit"},{"end_column":33,"end_line":29,"start_column":1,"start_line":29,"text":"Independent unit column: well_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:9bd102e98ccf6b019004","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:94e35d96b6bf3fbf9a3b3f6855280d1b538dca09cd8826017b61872d8f2cc1c9","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:1e6b0fabce9340d092a085ce25f4dff8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":88,"end_line":5,"start_column":1,"start_line":5,"text":"Source table: data/input.csv (120 sample rows from 30 monitoring wells, 4 visits each)."},{"end_column":74,"end_line":6,"start_column":1,"start_line":6,"text":"A sample counts as an exceedance when chloride is at or above 250.0 mg/L."},{"end_column":61,"end_line":8,"start_column":1,"start_line":8,"text":"| Shoreline zone | Samples | Exceedances | Exceedance rate |"},{"end_column":29,"end_line":9,"start_column":1,"start_line":9,"text":"| --- | ---: | ---: | ---: |"},{"end_column":33,"end_line":10,"start_column":1,"start_line":10,"text":"| Dune ridge | 40 | 10 | 0.250 |"},{"end_column":35,"end_line":11,"start_column":1,"start_line":11,"text":"| Back barrier | 40 | 20 | 0.500 |"},{"end_column":33,"end_line":12,"start_column":1,"start_line":12,"text":"| Tidal flat | 40 | 30 | 0.750 |"},{"end_column":80,"end_line":16,"start_column":1,"start_line":16,"text":"Pearson chi-squared test of independence (scipy.stats.chi2_contingency) applied"},{"end_column":80,"end_line":17,"start_column":1,"start_line":17,"text":"to the 3 x 2 table of shoreline zone by exceedance status, with each sample row"},{"end_column":28,"end_line":18,"start_column":1,"start_line":18,"text":"entered as one observation."},{"end_column":33,"end_line":20,"start_column":1,"start_line":20,"text":"- chi-squared statistic: 20.0000"},{"end_column":24,"end_line":21,"start_column":1,"start_line":21,"text":"- degrees of freedom: 2"},{"end_column":21,"end_line":22,"start_column":1,"start_line":22,"text":"- p-value: 4.540e-05"},{"end_column":20,"end_line":23,"start_column":1,"start_line":23,"text":"- Cramer's V: 0.408"},{"end_column":323,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Exceedance status is associated with shoreline zone: Pearson chi-squared test of independence on 120 sample rows gives chi-squared = 20.0000, df = 2, p = 4.540e-05 (Cramer's V = 0.408), with the exceedance rate rising from 0.250 on the dune ridge to 0.500 on the back barrier and 0.750 on the tidal flat."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d723f333d4d56b820cdc","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:e72b87102d156928d6c047184c01e25c60e3294e168a9377d1dddafabe0a71b2","end_line":27,"locator":"results/report.md:1-27","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

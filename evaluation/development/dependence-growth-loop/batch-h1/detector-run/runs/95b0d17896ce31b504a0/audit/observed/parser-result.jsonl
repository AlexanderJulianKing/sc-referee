{"audit_run_id":"audit:8156faaea2e24769a890a624ecdd4b95","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"One nesting female mason bee was followed at each of 23 widely separated meadow"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"patches during a single spring. A patch held exactly one monitored bee, and no"},{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"bee was watched at more than one patch, so the bees are the independent units of"},{"end_column":47,"end_line":6,"start_column":1,"start_line":6,"text":"the study and the file holds one line per bee."},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"For every bee an observer scored a run of departures from the nest entrance and"},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"noted, for each departure, whether the bee circled clockwise or counterclockwise"},{"end_column":80,"end_line":10,"start_column":1,"start_line":10,"text":"before flying off. Those repeated within-bee departures appear in the file only"},{"end_column":80,"end_line":11,"start_column":1,"start_line":11,"text":"as two summary counts; the analysis reduces them to a single majority-direction"},{"end_column":80,"end_line":12,"start_column":1,"start_line":12,"text":"call for that bee before anything is tested, so no individual departure is ever"},{"end_column":32,"end_line":13,"start_column":1,"start_line":13,"text":"treated as its own observation."},{"end_column":120,"end_line":15,"start_column":1,"start_line":15,"text":"One row is: one individual mason bee, summarised over all of the nest departures scored for her at her own meadow patch"},{"end_column":32,"end_line":16,"start_column":1,"start_line":16,"text":"Independent unit column: bee_id"},{"end_column":22,"end_line":17,"start_column":1,"start_line":17,"text":"One trial is: one row"},{"end_column":8,"end_line":19,"start_column":1,"start_line":19,"text":"Columns"},{"end_column":83,"end_line":21,"start_column":1,"start_line":21,"text":"- bee_id: unique label for the individual bee; each label appears on a single line"},{"end_column":83,"end_line":22,"start_column":1,"start_line":22,"text":"- meadow_patch: the patch where that bee nested; every patch holds exactly one bee"},{"end_column":71,"end_line":23,"start_column":1,"start_line":23,"text":"- forewing_length_mm: right forewing length of the bee, in millimetres"},{"end_column":129,"end_line":24,"start_column":1,"start_line":24,"text":"- departures_scored: how many departures were watched for that bee (always an odd number, so a majority direction always exists)"},{"end_column":105,"end_line":25,"start_column":1,"start_line":25,"text":"- clockwise_departures: how many of those departures were clockwise; the remainder were counterclockwise"},{"end_column":81,"end_line":27,"start_column":1,"start_line":27,"text":"The question is whether mason bees as a group favour one circling direction. The"},{"end_column":77,"end_line":28,"start_column":1,"start_line":28,"text":"count handed to the exact binomial test is the number of bees whose majority"},{"end_column":75,"end_line":29,"start_column":1,"start_line":29,"text":"call is clockwise, out of the number of bees, compared against an unbiased"},{"end_column":25,"end_line":30,"start_column":1,"start_line":30,"text":"expectation of one half."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:66ca78dc653cc4da31e2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:528dae6bf77e1169e386db8e378a9ece74a9cd46acbd31c474c1a8e41e6a8a78","end_line":30,"locator":"data-description.md:1-30","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:8156faaea2e24769a890a624ecdd4b95","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Each of the 23 bees in `data/input.csv` occupied its own meadow patch and"},{"end_column":72,"end_line":6,"start_column":1,"start_line":6,"text":"contributes exactly one row. The 305 scored departures are not analysed"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"individually: within a bee the departures are collapsed to a single majority"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"call (clockwise or counterclockwise), so the analysed sample is one call per"},{"end_column":5,"end_line":9,"start_column":1,"start_line":9,"text":"bee."},{"end_column":73,"end_line":13,"start_column":1,"start_line":13,"text":"Exact two-sided binomial test (`scipy.stats.binomtest`) of the number of"},{"end_column":76,"end_line":14,"start_column":1,"start_line":14,"text":"clockwise-majority bees against a no-bias expectation of 0.5, alpha = 0.05."},{"end_column":44,"end_line":18,"start_column":1,"start_line":18,"text":"- Clockwise-majority bees: 17 of 23 (0.739)"},{"end_column":36,"end_line":19,"start_column":1,"start_line":19,"text":"- Counterclockwise-majority bees: 6"},{"end_column":34,"end_line":20,"start_column":1,"start_line":20,"text":"- Exact two-sided p-value: 0.0347"},{"end_column":223,"end_line":22,"start_column":1,"start_line":22,"text":"[selected-result] Exact two-sided binomial test on one majority-direction call per bee: 17/23 bees (0.739) circled clockwise more often than counterclockwise, p = 0.0347; the 50:50 no-bias null is rejected at alpha = 0.05."},{"end_column":74,"end_line":24,"start_column":1,"start_line":24,"text":"The bees, not the individual departures, are the replicated units, so the"},{"end_column":53,"end_line":25,"start_column":1,"start_line":25,"text":"test statistic rests on 23 independent observations."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:8f06c6b3b5ab1650f2a0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b3fb0dae7474cdde70f287080f3e78d46b8b617b8b7ee0eb94208a697ba84d5a","end_line":25,"locator":"results/report.md:1-25","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

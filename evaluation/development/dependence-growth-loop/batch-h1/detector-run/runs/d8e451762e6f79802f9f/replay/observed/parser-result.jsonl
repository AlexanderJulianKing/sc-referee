{"audit_run_id":"audit:b4fb5990e80c43eeadf2c89ea40148f1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":3,"start_column":1,"start_line":3,"text":"Six individually paint-marked bumblebee foragers from one commercial colony were"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"tested in a Y-maze that offered a UV-bright artificial corolla in one arm and a"},{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"visually matched UV-dull corolla in the other arm. The arm holding the UV-bright"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"corolla was swapped between releases so that a bee could not solve the task by"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"position alone. For every release we recorded which corolla received the bee's"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"first landing and how long that landing took. Foragers were run in up to four"},{"end_column":74,"end_line":9,"start_column":1,"start_line":9,"text":"test blocks, so most bees appear in the file several times; the number of"},{"end_column":74,"end_line":10,"start_column":1,"start_line":10,"text":"releases per bee differs because some individuals stopped foraging early."},{"end_column":143,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one Y-maze release in which a single marked forager made a first landing on either the UV-bright or the UV-dull artificial corolla"},{"end_column":36,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: forager_id"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"One trial is: one row"},{"end_column":14,"end_line":16,"start_column":1,"start_line":16,"text":"Column guide:"},{"end_column":87,"end_line":18,"start_column":1,"start_line":18,"text":"- trial_uid: unique label for the release, numbered in the order the releases were run"},{"end_column":54,"end_line":19,"start_column":1,"start_line":19,"text":"- forager_id: paint mark of the bee that was released"},{"end_column":78,"end_line":20,"start_column":1,"start_line":20,"text":"- test_block: which of the four test blocks the release belongs to (B1 to B4)"},{"end_column":90,"end_line":21,"start_column":1,"start_line":21,"text":"- arena_arm_uv_bright: maze arm, L or R, that held the UV-bright corolla for that release"},{"end_column":91,"end_line":22,"start_column":1,"start_line":22,"text":"- first_visit_choice: corolla that received the first landing, either uv_bright or uv_dull"},{"end_column":56,"end_line":23,"start_column":1,"start_line":23,"text":"- latency_s: seconds from release to that first landing"},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"The file contains 20 releases contributed by 6 bees, with between two and four"},{"end_column":18,"end_line":26,"start_column":1,"start_line":26,"text":"releases per bee."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:092ca39e206ce7da0889","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2d64562ced7f3e8d92a0029f063ab105e92981293e27e27ce62a94ca3aea2c82","end_line":26,"locator":"data-description.md:1-26","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:b4fb5990e80c43eeadf2c89ea40148f1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one Y-maze trial, scored by the artificial"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"corolla that received the first landing. The file holds 20 trials contributed"},{"end_column":22,"end_line":7,"start_column":1,"start_line":7,"text":"by 6 marked foragers."},{"end_column":49,"end_line":9,"start_column":1,"start_line":9,"text":"| forager_id | trials | uv_bright first visits |"},{"end_column":20,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- |"},{"end_column":19,"end_line":11,"start_column":1,"start_line":11,"text":"| FOR-01 | 4 | 4 |"},{"end_column":19,"end_line":12,"start_column":1,"start_line":12,"text":"| FOR-02 | 4 | 3 |"},{"end_column":19,"end_line":13,"start_column":1,"start_line":13,"text":"| FOR-03 | 4 | 4 |"},{"end_column":19,"end_line":14,"start_column":1,"start_line":14,"text":"| FOR-04 | 3 | 2 |"},{"end_column":19,"end_line":15,"start_column":1,"start_line":15,"text":"| FOR-05 | 3 | 1 |"},{"end_column":19,"end_line":16,"start_column":1,"start_line":16,"text":"| FOR-06 | 2 | 1 |"},{"end_column":79,"end_line":20,"start_column":1,"start_line":20,"text":"Every trial row was entered as one Bernoulli observation and the pooled counts"},{"end_column":77,"end_line":21,"start_column":1,"start_line":21,"text":"were submitted to an exact two-sided binomial test (`scipy.stats.binomtest`)"},{"end_column":40,"end_line":22,"start_column":1,"start_line":22,"text":"against the chance expectation p = 0.5."},{"end_column":76,"end_line":26,"start_column":1,"start_line":26,"text":"Foragers landed first on the UV-bright corolla in 15 of 20 trials (observed"},{"end_column":14,"end_line":27,"start_column":1,"start_line":27,"text":"share 0.750)."},{"end_column":206,"end_line":29,"start_column":1,"start_line":29,"text":"[selected-result] Exact two-sided binomial test of 15 uv_bright first visits out of 20 trials against p = 0.5: p = 0.041389 (observed share 0.750); the deviation from chance is significant at the 5% level."},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"The 20 trials come from 6 foragers, so several rows describe the same insect"},{"end_column":76,"end_line":34,"start_column":1,"start_line":34,"text":"tested again; the test above nonetheless weighs each row as one independent"},{"end_column":53,"end_line":35,"start_column":1,"start_line":35,"text":"draw. Trial order within a forager was not modelled."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c9471ce48d10aa5b294e","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:dad6c66bd1eaf7559a90824097ac089462af88be2b5153815fbba481abda8183","end_line":35,"locator":"results/report.md:1-35","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:2d307c58e84e4429b4e1f4451222985a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Eight queenright Bombus impatiens colonies were each connected in turn to a"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"flight arena holding two artificial flower arrays: one whose corolla discs are"},{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"UV-reflective and one plain white. Every colony was watched during three"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"separate foraging bouts on three different mornings, and an observer tallied"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"every landing on each array during the bout. The side of the arena holding the"},{"end_column":47,"end_line":8,"start_column":1,"start_line":8,"text":"UV-reflective array was swapped between bouts."},{"end_column":86,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one foraging bout by one colony, with the landing tallies for both arrays"},{"end_column":35,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: colony_id"},{"end_column":22,"end_line":12,"start_column":1,"start_line":12,"text":"One trial is: one row"},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":86,"end_line":15,"start_column":1,"start_line":15,"text":"- colony_id: label of the source colony, C01 through C08; three rows carry each label"},{"end_column":63,"end_line":16,"start_column":1,"start_line":16,"text":"- bout_index: 1, 2 or 3, the order of the bout for that colony"},{"end_column":82,"end_line":17,"start_column":1,"start_line":17,"text":"- array_side: side of the arena that held the UV-reflective array during the bout"},{"end_column":59,"end_line":18,"start_column":1,"start_line":18,"text":"- visits_uv: number of landings on the UV-reflective array"},{"end_column":60,"end_line":19,"start_column":1,"start_line":19,"text":"- visits_white: number of landings on the plain white array"},{"end_column":61,"end_line":20,"start_column":1,"start_line":20,"text":"- bout_minutes: length of the observation window, in minutes"},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"The three bouts belonging to a colony draw on the same set of foragers and the"},{"end_column":80,"end_line":23,"start_column":1,"start_line":23,"text":"same colony-level state, so rows sharing a colony_id are related to one another"},{"end_column":40,"end_line":24,"start_column":1,"start_line":24,"text":"rather than free-standing observations."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:db54f07baa07131adadf","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:e01153a333bfb2837a40736e22e5ec70ce81d3d531365c775880989f0625b7d3","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:2d307c58e84e4429b4e1f4451222985a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":60,"end_line":5,"start_column":1,"start_line":5,"text":"24 foraging bouts were scored across 8 queenright colonies."},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"A bout counts as a UV pick when the forager delivered more visits to the"},{"end_column":51,"end_line":7,"start_column":1,"start_line":7,"text":"UV-reflective array than to the plain white array."},{"end_column":34,"end_line":9,"start_column":1,"start_line":9,"text":"UV picks: 18 of 24 bouts (75.0%)."},{"end_column":30,"end_line":11,"start_column":1,"start_line":11,"text":"| colony | UV picks | bouts |"},{"end_column":20,"end_line":12,"start_column":1,"start_line":12,"text":"| --- | --- | --- |"},{"end_column":16,"end_line":13,"start_column":1,"start_line":13,"text":"| C01 | 3 | 3 |"},{"end_column":16,"end_line":14,"start_column":1,"start_line":14,"text":"| C02 | 3 | 3 |"},{"end_column":16,"end_line":15,"start_column":1,"start_line":15,"text":"| C03 | 3 | 3 |"},{"end_column":16,"end_line":16,"start_column":1,"start_line":16,"text":"| C04 | 3 | 3 |"},{"end_column":16,"end_line":17,"start_column":1,"start_line":17,"text":"| C05 | 3 | 3 |"},{"end_column":16,"end_line":18,"start_column":1,"start_line":18,"text":"| C06 | 2 | 3 |"},{"end_column":16,"end_line":19,"start_column":1,"start_line":19,"text":"| C07 | 1 | 3 |"},{"end_column":16,"end_line":20,"start_column":1,"start_line":20,"text":"| C08 | 0 | 3 |"},{"end_column":69,"end_line":24,"start_column":1,"start_line":24,"text":"Exact two-sided binomial test on the 24 bout outcomes against a null"},{"end_column":63,"end_line":25,"start_column":1,"start_line":25,"text":"UV-pick probability of 0.500; each bout enters the test as one"},{"end_column":19,"end_line":26,"start_column":1,"start_line":26,"text":"independent trial."},{"end_column":205,"end_line":30,"start_column":1,"start_line":30,"text":"[selected-result] Exact binomial test: 18 UV picks in 24 bouts (observed share 0.750), two-sided p = 0.0227 against p0 = 0.500; foragers picked the UV-reflective array more often than the null preference."},{"end_column":47,"end_line":32,"start_column":1,"start_line":32,"text":"Null hypothesis rejected at alpha = 0.05: yes."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ea3428e9e7070f536e96","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:afb6b73605f053777fc704bcf6c8b8efb4b852b8d1fe113579e5bf3973fc7f64","end_line":32,"locator":"results/report.md:1-32","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

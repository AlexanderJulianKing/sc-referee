{"audit_run_id":"audit:74fb2cd4c2584c338eefbb4494636331","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":3,"start_column":1,"start_line":3,"text":"data/input.csv holds the measurements from a small additive-manufacturing"},{"end_column":76,"end_line":4,"start_column":1,"start_line":4,"text":"study. Twelve metal build plates were produced on the same laser powder-bed"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"fusion machine: six plates were printed lying flat and six were printed on"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"edge. After printing, each plate was sectioned into four tensile coupons taken"},{"end_column":74,"end_line":7,"start_column":1,"start_line":7,"text":"from fixed positions A, B, C and D across the plate, and every coupon was"},{"end_column":42,"end_line":8,"start_column":1,"start_line":8,"text":"pulled to failure on the same test frame."},{"end_column":21,"end_line":10,"start_column":1,"start_line":10,"text":"Columns in the file:"},{"end_column":54,"end_line":12,"start_column":1,"start_line":12,"text":"- coupon_id: label for the individual tensile coupon."},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"- plate_id: label of the build plate the coupon was cut from. Each plate label"},{"end_column":59,"end_line":14,"start_column":3,"start_line":14,"text":"appears four times, once per coupon cut from that plate."},{"end_column":77,"end_line":15,"start_column":1,"start_line":15,"text":"- build_orientation: how the plate was oriented during printing, either flat"},{"end_column":75,"end_line":16,"start_column":3,"start_line":16,"text":"or edge. The value is a property of the plate, so it is the same for all"},{"end_column":29,"end_line":17,"start_column":3,"start_line":17,"text":"four coupons from a plate."},{"end_column":78,"end_line":18,"start_column":1,"start_line":18,"text":"- coupon_slot: which of the four positions on the plate the coupon came from."},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"- tensile_strength_mpa: ultimate tensile strength of the coupon in megapascals."},{"end_column":76,"end_line":21,"start_column":1,"start_line":21,"text":"One row is: one tensile coupon cut from a build plate and pulled to failure"},{"end_column":34,"end_line":22,"start_column":1,"start_line":22,"text":"Independent unit column: plate_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:734773d80bc6cd847453","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:d96ce8f7c08fed553e4a3661b02c6c4b0b37d301db5284f0050a3ebaf66ab2f5","end_line":22,"locator":"data-description.md:1-22","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:74fb2cd4c2584c338eefbb4494636331","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":29,"end_line":5,"start_column":1,"start_line":5,"text":"- Input file: data/input.csv"},{"end_column":27,"end_line":6,"start_column":1,"start_line":6,"text":"- Coupon rows analysed: 48"},{"end_column":36,"end_line":7,"start_column":1,"start_line":7,"text":"- Distinct build plates in file: 12"},{"end_column":45,"end_line":8,"start_column":1,"start_line":8,"text":"- Rows per orientation: flat = 24, edge = 24"},{"end_column":57,"end_line":12,"start_column":1,"start_line":12,"text":"| Build orientation | Rows | Mean UTS (MPa) | SD (MPa) |"},{"end_column":26,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- | --- |"},{"end_column":32,"end_line":14,"start_column":1,"start_line":14,"text":"| flat | 24 | 300.500 | 5.748 |"},{"end_column":32,"end_line":15,"start_column":1,"start_line":15,"text":"| edge | 24 | 340.500 | 6.058 |"},{"end_column":79,"end_line":19,"start_column":1,"start_line":19,"text":"A two-sample Student t-test with pooled variance compares the ultimate tensile"},{"end_column":80,"end_line":20,"start_column":1,"start_line":20,"text":"strength of edge-built coupons with that of flat-built coupons. Each coupon row"},{"end_column":59,"end_line":21,"start_column":1,"start_line":21,"text":"in data/input.csv contributes one observation to the test."},{"end_column":247,"end_line":23,"start_column":1,"start_line":23,"text":"[selected-result] Two-sample Student t-test (pooled variance) on 48 coupon rows: edge-built coupons averaged 340.500 MPa (SD 6.058) versus 300.500 MPa (SD 5.748) for flat-built coupons, a mean difference of 40.000 MPa, t(46) = 23.465, p < 0.0001."},{"end_column":74,"end_line":27,"start_column":1,"start_line":27,"text":"Coupons printed in the edge orientation reached a higher ultimate tensile"},{"end_column":80,"end_line":28,"start_column":1,"start_line":28,"text":"strength than coupons printed flat, and the difference is large relative to the"},{"end_column":49,"end_line":29,"start_column":1,"start_line":29,"text":"coupon-to-coupon spread within each orientation."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:17e1d9cb154e15cd9b2a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:3ff80a6db338a5e1b597a2a92c0668b2dfa23e4cd34fa198bb2520905af4fa98","end_line":29,"locator":"results/report.md:1-29","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

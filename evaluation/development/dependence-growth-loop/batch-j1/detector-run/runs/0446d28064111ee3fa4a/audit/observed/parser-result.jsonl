{"audit_run_id":"audit:cbbe6c6a9afb4d18bb54f4d887241d9e","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"A machine shop wanted to know whether machine-tool bases poured from polymer"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"concrete damp vibration better than bases cast from gray iron. Twelve finished"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"bases were built: six gray cast iron and six polymer concrete. Each base was"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"suspended on air springs, fitted with a single accelerometer, and struck with an"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"instrumented modal hammer. A test engineer kept five usable strikes on every"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"base, so the table contains several rows that come from the same physical base."},{"end_column":68,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one instrumented hammer strike on one machine-tool base"},{"end_column":33,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: base_id"},{"end_column":8,"end_line":13,"start_column":1,"start_line":13,"text":"Columns"},{"end_column":81,"end_line":15,"start_column":1,"start_line":15,"text":"- base_id: label of the physical base that was struck (CI-01..CI-06 are the gray"},{"end_column":59,"end_line":16,"start_column":3,"start_line":16,"text":"cast iron bases, PC-01..PC-06 the polymer concrete ones)"},{"end_column":72,"end_line":17,"start_column":1,"start_line":17,"text":"- base_material: the material the base was made from, gray_cast_iron or"},{"end_column":19,"end_line":18,"start_column":3,"start_line":18,"text":"polymer_concrete"},{"end_column":79,"end_line":19,"start_column":1,"start_line":19,"text":"- strike_index: which of the five recorded strikes on that base this row holds"},{"end_column":77,"end_line":20,"start_column":1,"start_line":20,"text":"- mount_preload_nm: bolt preload used on the mounting fixture, newton-metres"},{"end_column":65,"end_line":21,"start_column":1,"start_line":21,"text":"- peak_accel_g: peak accelerometer response for the strike, in g"},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"- damping_ratio_pct: first-mode damping ratio fitted from the strike response,"},{"end_column":38,"end_line":23,"start_column":3,"start_line":23,"text":"as a percentage of critical damping"},{"end_column":76,"end_line":25,"start_column":1,"start_line":25,"text":"The material is a property of the base, not of the individual strike: every"},{"end_column":61,"end_line":26,"start_column":1,"start_line":26,"text":"strike on a given base carries the same base_material value."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:9a9ec874b8473c9cf8ff","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8f1900e4379ac9ed01b0d5213126c7ef54f9556dfaff5b9f7c99102233260f96","end_line":26,"locator":"data-description.md:1-26","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:cbbe6c6a9afb4d18bb54f4d887241d9e","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"Modal impact tests on machine-tool bases. Each row of the input table is one"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"instrumented hammer strike, and the response variable is the first-mode damping"},{"end_column":81,"end_line":7,"start_column":1,"start_line":7,"text":"ratio expressed as a percentage of critical damping. The table holds 60 strikes:"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"6 gray cast iron bases and 6 polymer concrete bases, with 5 strikes recorded on"},{"end_column":11,"end_line":9,"start_column":1,"start_line":9,"text":"each base."},{"end_column":80,"end_line":13,"start_column":1,"start_line":13,"text":"Welch's two-sample t-test (scipy.stats.ttest_ind with equal_var=False) compares"},{"end_column":78,"end_line":14,"start_column":1,"start_line":14,"text":"the damping ratio of polymer concrete strikes against gray cast iron strikes."},{"end_column":75,"end_line":15,"start_column":1,"start_line":15,"text":"Every recorded strike is entered into the test as one observation, so each"},{"end_column":44,"end_line":16,"start_column":1,"start_line":16,"text":"material group contributes 30 observations."},{"end_column":56,"end_line":20,"start_column":1,"start_line":20,"text":"| material         | strikes | mean damping ratio (%) |"},{"end_column":56,"end_line":21,"start_column":1,"start_line":21,"text":"| ---------------- | ------- | ---------------------- |"},{"end_column":56,"end_line":22,"start_column":1,"start_line":22,"text":"| gray_cast_iron   | 30      | 1.190                  |"},{"end_column":56,"end_line":23,"start_column":1,"start_line":23,"text":"| polymer_concrete | 30      | 2.510                  |"},{"end_column":74,"end_line":25,"start_column":1,"start_line":25,"text":"Mean difference (polymer concrete minus gray cast iron): 1.320 percentage"},{"end_column":47,"end_line":26,"start_column":1,"start_line":26,"text":"points. Welch t = 17.11, df = 40.2, p < 1e-15."},{"end_column":293,"end_line":28,"start_column":1,"start_line":28,"text":"[selected-result] Polymer concrete machine-tool bases damp the first bending mode more strongly than gray cast iron bases: mean damping ratio 2.510% versus 1.190%, a difference of 1.320 percentage points (Welch two-sample t-test over 30 strikes per material, t = 17.11, df = 40.2, p < 1e-15)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:aad7aa4232ba848404d9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:da20b6c8016aa1a4c4cbb840df0ea59c9186e87daed64e66bde0edcd3732ee6c","end_line":28,"locator":"results/report.md:1-28","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

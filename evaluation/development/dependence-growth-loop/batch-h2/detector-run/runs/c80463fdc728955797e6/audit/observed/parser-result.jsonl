{"audit_run_id":"audit:0053bb844cff46d0895726b0bdf0e899","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"The file records a heat-tolerance screen of two field-grown coffee cultivars,"},{"end_column":81,"end_line":4,"start_column":1,"start_line":4,"text":"Catuai and Obata, at a single research farm. Twelve shrubs were sampled, six per"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"cultivar. From each shrub, four leaves were cut, one from each of four canopy"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"positions (sun_upper, sun_mid, shade_mid, shade_lower). Every leaf went through"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"the same chlorophyll-fluorescence temperature ramp, and `tcrit_c` records the"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"critical temperature in degrees Celsius at which basal fluorescence begins to"},{"end_column":79,"end_line":9,"start_column":1,"start_line":9,"text":"rise steeply. Because four leaves come from each shrub, the file holds 48 rows"},{"end_column":74,"end_line":10,"start_column":1,"start_line":10,"text":"but only 12 shrubs; the four leaves sharing a shrub_id share that shrub's"},{"end_column":48,"end_line":11,"start_column":1,"start_line":11,"text":"genotype, soil, water status, and microclimate."},{"end_column":9,"end_line":13,"start_column":1,"start_line":13,"text":"Columns:"},{"end_column":78,"end_line":15,"start_column":1,"start_line":15,"text":"- leaf_id: unique label for the individual leaf that was measured (L001-L048)"},{"end_column":63,"end_line":16,"start_column":1,"start_line":16,"text":"- shrub_id: label of the shrub the leaf was cut from (S01-S12)"},{"end_column":28,"end_line":17,"start_column":1,"start_line":17,"text":"- cultivar: Catuai or Obata"},{"end_column":70,"end_line":18,"start_column":1,"start_line":18,"text":"- block: field block the shrub grows in (north_slope or valley_floor)"},{"end_column":51,"end_line":19,"start_column":1,"start_line":19,"text":"- canopy_layer: canopy position the leaf came from"},{"end_column":65,"end_line":20,"start_column":1,"start_line":20,"text":"- tcrit_c: critical temperature of that leaf, in degrees Celsius"},{"end_column":89,"end_line":22,"start_column":1,"start_line":22,"text":"One row is: one leaf cut from one coffee shrub and put through a single temperature ramp"},{"end_column":34,"end_line":23,"start_column":1,"start_line":23,"text":"Independent unit column: shrub_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:36b5c0e2cd57d811ec91","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1f14cd0ff6d3855f303286580de95b8d7d301f93b33b2c4cecf653f09248a1e6","end_line":23,"locator":"data-description.md:1-23","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:0053bb844cff46d0895726b0bdf0e899","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one leaf sampled for a chlorophyll-fluorescence"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"temperature ramp; `tcrit_c` is the critical temperature (C) at which the rapid"},{"end_column":74,"end_line":7,"start_column":1,"start_line":7,"text":"rise in basal fluorescence begins. The file contains 48 leaf measurements"},{"end_column":69,"end_line":8,"start_column":1,"start_line":8,"text":"collected from field-grown shrubs of the cultivars Catuai and Obata."},{"end_column":80,"end_line":12,"start_column":1,"start_line":12,"text":"Every leaf measurement in the file was entered as a single observation, and the"},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"two cultivars were compared with Welch's two-sample t-test (unequal variances,"},{"end_column":25,"end_line":14,"start_column":1,"start_line":14,"text":"two-sided) on `tcrit_c`."},{"end_column":78,"end_line":18,"start_column":1,"start_line":18,"text":"| cultivar | leaf measurements | shrubs sampled | mean tcrit_c (C) | SD (C) |"},{"end_column":32,"end_line":19,"start_column":1,"start_line":19,"text":"| --- | --- | --- | --- | --- |"},{"end_column":37,"end_line":20,"start_column":1,"start_line":20,"text":"| Catuai | 24 | 6 | 48.000 | 0.862 |"},{"end_column":36,"end_line":21,"start_column":1,"start_line":21,"text":"| Obata | 24 | 6 | 46.500 | 1.059 |"},{"end_column":206,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Welch two-sample t-test on 48 leaf measurements: t = 5.382, df = 44.17, two-sided p < 0.0001; mean tcrit_c is 1.500 C higher in Catuai (48.000 C, n = 24) than in Obata (46.500 C, n = 24)."},{"end_column":79,"end_line":27,"start_column":1,"start_line":27,"text":"The test statistic above spends one degree of freedom per leaf measurement, so"},{"end_column":61,"end_line":28,"start_column":1,"start_line":28,"text":"the reported df of 44.17 comes from the 48 rows in the file."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:24f0c2fd7dfffcb5c83a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1e6e4f7c3313ce1882c854f42df2a625b7b26249f370039e0bea11a380573bb3","end_line":28,"locator":"results/report.md:1-28","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

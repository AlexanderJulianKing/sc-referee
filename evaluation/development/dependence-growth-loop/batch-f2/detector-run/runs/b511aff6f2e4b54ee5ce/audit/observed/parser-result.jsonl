{"audit_run_id":"audit:2c638b830bf942e693370d29757da3ae","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":72,"end_line":3,"start_column":1,"start_line":3,"text":"The file holds stomatal conductance readings from a screenhouse misting"},{"end_column":74,"end_line":4,"start_column":1,"start_line":4,"text":"trial on potted coffee shrubs. Five shrubs were used. On each shrub, four"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"leaves were tagged. Every tagged leaf was clamped in a porometer once just"},{"end_column":72,"end_line":6,"start_column":1,"start_line":6,"text":"before a 90-second canopy misting pulse and once again about 90 seconds"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"after the pulse ended, so each tagged leaf contributes one before value and"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"one after value. All five shrubs were misted in the same session with the"},{"end_column":72,"end_line":9,"start_column":1,"start_line":9,"text":"same nozzle setting; the four leaves on a shrub share that shrub's pot,"},{"end_column":53,"end_line":10,"start_column":1,"start_line":10,"text":"watering history, canopy position and mist exposure."},{"end_column":113,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one tagged coffee shrub leaf, with its conductance read once before and once after the misting pulse"},{"end_column":34,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: shrub_id"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"One trial is: one row"},{"end_column":9,"end_line":16,"start_column":1,"start_line":16,"text":"Columns:"},{"end_column":76,"end_line":18,"start_column":1,"start_line":18,"text":"- shrub_id: label of the potted shrub the tagged leaf grew on. Five labels,"},{"end_column":50,"end_line":19,"start_column":3,"start_line":19,"text":"S-01 through S-05, each appearing on four rows."},{"end_column":74,"end_line":20,"start_column":1,"start_line":20,"text":"- leaf_tag: label of the tagged leaf within its own shrub (L1 to L4). The"},{"end_column":74,"end_line":21,"start_column":3,"start_line":21,"text":"same four tags are reused on every shrub, so leaf_tag only identifies a"},{"end_column":36,"end_line":22,"start_column":3,"start_line":22,"text":"leaf once you also know shrub_id."},{"end_column":76,"end_line":23,"start_column":1,"start_line":23,"text":"- pre_mist_gs: stomatal conductance measured just before the misting pulse,"},{"end_column":63,"end_line":24,"start_column":3,"start_line":24,"text":"in mmol per square metre per second, rounded to whole units."},{"end_column":73,"end_line":25,"start_column":1,"start_line":25,"text":"- post_mist_gs: stomatal conductance measured about 90 seconds after the"},{"end_column":34,"end_line":26,"start_column":3,"start_line":26,"text":"pulse, same units and rounding."},{"end_column":77,"end_line":28,"start_column":1,"start_line":28,"text":"No values are missing and no leaf was measured twice at the same time point."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:6b15c91ef13cec5b827c","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:67a5323d427d08ff8ef6f45f94ca8601de722bf5ce6e29d489f453c68386a191","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:2c638b830bf942e693370d29757da3ae","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Question: after a 90-second canopy misting pulse, does stomatal conductance"},{"end_column":73,"end_line":4,"start_column":1,"start_line":4,"text":"on a coffee shrub leaf go up or down? Each leaf was read once before and"},{"end_column":60,"end_line":5,"start_column":1,"start_line":5,"text":"once after the pulse, and the two readings were subtracted."},{"end_column":40,"end_line":9,"start_column":1,"start_line":9,"text":"- Leaf readings in `data/input.csv`: 20"},{"end_column":51,"end_line":10,"start_column":1,"start_line":10,"text":"- Leaves with higher conductance after misting: 16"},{"end_column":49,"end_line":11,"start_column":1,"start_line":11,"text":"- Leaves with lower conductance after misting: 4"},{"end_column":51,"end_line":12,"start_column":1,"start_line":12,"text":"- Leaves with no change (dropped from the test): 0"},{"end_column":21,"end_line":16,"start_column":1,"start_line":16,"text":"| Quantity | Value |"},{"end_column":14,"end_line":17,"start_column":1,"start_line":17,"text":"| --- | --- |"},{"end_column":39,"end_line":18,"start_column":1,"start_line":18,"text":"| Mean pre-mist conductance | 157.35 |"},{"end_column":40,"end_line":19,"start_column":1,"start_line":19,"text":"| Mean post-mist conductance | 169.65 |"},{"end_column":36,"end_line":20,"start_column":1,"start_line":20,"text":"| Mean within-leaf change | 12.30 |"},{"end_column":38,"end_line":21,"start_column":1,"start_line":21,"text":"| Median within-leaf change | 15.50 |"},{"end_column":77,"end_line":25,"start_column":1,"start_line":25,"text":"Exact two-sided binomial sign test (scipy.stats.binomtest) applied to the 20"},{"end_column":76,"end_line":26,"start_column":1,"start_line":26,"text":"leaf readings, with each leaf reading supplied as one independent trial and"},{"end_column":78,"end_line":27,"start_column":1,"start_line":27,"text":"a null success probability of 0.5 (a leaf is equally likely to rise or fall)."},{"end_column":190,"end_line":29,"start_column":1,"start_line":29,"text":"[selected-result] Exact two-sided binomial sign test over 20 leaf readings: 16 of 20 (80.00%) rose after misting, p = 0.0118 against p0 = 0.5, so the 50/50 null is rejected at alpha = 0.05."},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"The test statistic is the count of rising leaves, 16 out of 20 trials. Under"},{"end_column":74,"end_line":34,"start_column":1,"start_line":34,"text":"the null the two-sided exact tail probability is 0.0118, and the observed"},{"end_column":23,"end_line":35,"start_column":1,"start_line":35,"text":"rise fraction is 0.80."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b604055f21d846be98ad","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8534214904a4cac4d0ee78a775f23c27e4e4a6ead28e07e712c21f1031c7b27a","end_line":35,"locator":"results/report.md:1-35","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:d8afb812179540b78697303f75eef1e1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"This table records a nest-choice survey of the rock ant Temnothorax rugatulus"},{"end_column":70,"end_line":4,"start_column":1,"start_line":4,"text":"carried out along one ridge during a single field season. Twenty-four"},{"end_column":72,"end_line":5,"start_column":1,"start_line":5,"text":"queenright colonies were located, each living under a different granite"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"outcrop, and no two sampled outcrops were closer than fifty metres. Each"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"colony was lifted intact into a plaster arena offering two identical cavities,"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"one shaded by a dark filter and one left open to ambient light, and was scored"},{"end_column":79,"end_line":9,"start_column":1,"start_line":9,"text":"once for the cavity into which it completed its emigration. After scoring, the"},{"end_column":63,"end_line":10,"start_column":1,"start_line":10,"text":"colony was returned to its outcrop and was never tested again."},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":78,"end_line":14,"start_column":1,"start_line":14,"text":"- colony_id: the label of the colony; every label appears on exactly one row."},{"end_column":75,"end_line":15,"start_column":1,"start_line":15,"text":"- collection_outcrop: the granite outcrop the colony was taken from; every"},{"end_column":39,"end_line":16,"start_column":3,"start_line":16,"text":"outcrop supplied exactly one colony."},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"- worker_count: number of workers censused in the colony before the assay."},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"- assay_temp_c: arena air temperature in degrees Celsius during the trial."},{"end_column":74,"end_line":19,"start_column":1,"start_line":19,"text":"- cavity_chosen: the cavity the colony settled in, \"shaded\" or \"exposed\"."},{"end_column":96,"end_line":21,"start_column":1,"start_line":21,"text":"One row is: one field-collected ant colony scored once in a single two-cavity nest-choice trial"},{"end_column":35,"end_line":22,"start_column":1,"start_line":22,"text":"Independent unit column: colony_id"},{"end_column":22,"end_line":23,"start_column":1,"start_line":23,"text":"One trial is: one row"},{"end_column":72,"end_line":25,"start_column":1,"start_line":25,"text":"Because a colony is measured a single time and no two colonies share an"},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"outcrop, the table holds no repeated measurements and no nesting. The twenty-"},{"end_column":76,"end_line":27,"start_column":1,"start_line":27,"text":"four recorded choices are twenty-four independent yes/no outcomes, which is"},{"end_column":66,"end_line":28,"start_column":1,"start_line":28,"text":"exactly what the binomial sampling model in the analysis assumes."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1289557b2f5bd060e509","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:f3b4c1d25ac99e5778ab457368c9e14ab15d76cfe672180963b8d5275111f451","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:d8afb812179540b78697303f75eef1e1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Each colony in this survey was collected from its own granite outcrop, at"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"least fifty metres from the next, and was released into the two-cavity arena"},{"end_column":72,"end_line":7,"start_column":1,"start_line":7,"text":"exactly once. One row of the data table is therefore one colony and one"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"trial: no colony was retested, and no colony contributes a second choice."},{"end_column":71,"end_line":12,"start_column":1,"start_line":12,"text":"Exact two-sided binomial test (scipy.stats.binomtest) on the number of"},{"end_column":74,"end_line":13,"start_column":1,"start_line":13,"text":"colonies that emigrated into the shaded cavity, against the no-preference"},{"end_column":20,"end_line":14,"start_column":1,"start_line":14,"text":"expectation of 0.5."},{"end_column":23,"end_line":18,"start_column":1,"start_line":18,"text":"- Colonies assayed: 24"},{"end_column":37,"end_line":19,"start_column":1,"start_line":19,"text":"- Emigrated to the shaded cavity: 19"},{"end_column":37,"end_line":20,"start_column":1,"start_line":20,"text":"- Emigrated to the exposed cavity: 5"},{"end_column":46,"end_line":21,"start_column":1,"start_line":21,"text":"- Observed proportion choosing shaded: 0.7917"},{"end_column":23,"end_line":22,"start_column":1,"start_line":22,"text":"- Null proportion: 0.5"},{"end_column":35,"end_line":23,"start_column":1,"start_line":23,"text":"- Exact two-sided p-value: 0.00661"},{"end_column":220,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Exact two-sided binomial test on 24 independent colonies: 19 of 24 (proportion 0.7917) chose the shaded cavity against a null of 0.5, p = 0.00661, so the no-preference null is rejected at alpha = 0.05."},{"end_column":78,"end_line":29,"start_column":1,"start_line":29,"text":"The bias toward the dim cavity is strong and unlikely under indifference. The"},{"end_column":73,"end_line":30,"start_column":1,"start_line":30,"text":"count that enters the test is a count of separate colonies, so the exact"},{"end_column":65,"end_line":31,"start_column":1,"start_line":31,"text":"binomial sampling model matches the way the data were collected."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:cf49816e6729b47e6017","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:94ef2896e98ecc8375dbc492b09aff991da54b15f2582efabc4f8b68478b2370","end_line":31,"locator":"results/report.md:1-31","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

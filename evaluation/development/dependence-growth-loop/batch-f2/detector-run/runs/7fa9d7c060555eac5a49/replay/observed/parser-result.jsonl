{"audit_run_id":"audit:2727cfe661b7407aa8dae9c5f4dc3946","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":3,"start_column":1,"start_line":3,"text":"The file records a single outdoor mesocosm experiment run over one summer"},{"end_column":78,"end_line":4,"start_column":1,"start_line":4,"text":"season at a freshwater field station. Twenty-four garden ponds of roughly one"},{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"thousand litres were filled from the same source water, stocked once with a"},{"end_column":71,"end_line":6,"start_column":1,"start_line":6,"text":"founder population of Daphnia pulex, and assigned to one of two canopy"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"treatments: \"shaded\", in which a floating duckweed mat was left to cover the"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"surface, or \"open\", in which the mat was skimmed off each week. At the close"},{"end_column":71,"end_line":9,"start_column":1,"start_line":9,"text":"of the season every pond was scored a single time, as \"persisted\" if a"},{"end_column":76,"end_line":10,"start_column":1,"start_line":10,"text":"reproducing Daphnia population was still present and \"collapsed\" otherwise."},{"end_column":123,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one outdoor mesocosm pond, with its assigned canopy treatment and its single end-of-season persistence outcome"},{"end_column":33,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: pond_id"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"One trial is: one row"},{"end_column":9,"end_line":16,"start_column":1,"start_line":16,"text":"Columns:"},{"end_column":77,"end_line":18,"start_column":1,"start_line":18,"text":"- pond_id: the pond label; unique across the file, so each pond appears once"},{"end_column":60,"end_line":19,"start_column":1,"start_line":19,"text":"- canopy: the assigned treatment, either \"shaded\" or \"open\""},{"end_column":49,"end_line":20,"start_column":1,"start_line":20,"text":"- volume_l: working volume of the pond in litres"},{"end_column":73,"end_line":21,"start_column":1,"start_line":21,"text":"- stocking_density_per_l: founder Daphnia stocked per litre at the start"},{"end_column":81,"end_line":22,"start_column":1,"start_line":22,"text":"- mean_surface_temp_c: mean surface temperature over the season, degrees Celsius"},{"end_column":67,"end_line":23,"start_column":1,"start_line":23,"text":"- outcome: \"persisted\" or \"collapsed\" at the end-of-season scoring"},{"end_column":76,"end_line":25,"start_column":1,"start_line":25,"text":"The ponds stood apart from one another, were filled and stocked separately,"},{"end_column":79,"end_line":26,"start_column":1,"start_line":26,"text":"and never exchanged water, so the 24 rows are 24 independent units and no pond"},{"end_column":74,"end_line":27,"start_column":1,"start_line":27,"text":"supplies more than one outcome. Volume, stocking density and mean surface"},{"end_column":79,"end_line":28,"start_column":1,"start_line":28,"text":"temperature are recorded as context; they describe the pond as a whole and are"},{"end_column":41,"end_line":29,"start_column":1,"start_line":29,"text":"not repeated measurements within a pond."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:66d08c3a541607fbc830","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:0191735947fc682d0265cfc7072f1bf6e1c45df420d57d1f9157ab1b4a1cbb86","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:2727cfe661b7407aa8dae9c5f4dc3946","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":70,"end_line":5,"start_column":1,"start_line":5,"text":"Each of the 24 outdoor mesocosm ponds was stocked once with a founder"},{"end_column":76,"end_line":6,"start_column":1,"start_line":6,"text":"Daphnia pulex population, assigned to one canopy treatment, and scored once"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"at the end of the season as either persisted or collapsed. The pond is both"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"the unit of assignment and the unit of analysis: every pond_id value appears"},{"end_column":77,"end_line":9,"start_column":1,"start_line":9,"text":"in exactly one row, so no pond contributes more than a single outcome to the"},{"end_column":13,"end_line":10,"start_column":1,"start_line":10,"text":"table below."},{"end_column":62,"end_line":14,"start_column":1,"start_line":14,"text":"| canopy | persisted | collapsed | ponds | persistence rate |"},{"end_column":32,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- | --- | --- | --- |"},{"end_column":32,"end_line":16,"start_column":1,"start_line":16,"text":"| shaded | 9 | 3 | 12 | 75.0% |"},{"end_column":30,"end_line":17,"start_column":1,"start_line":17,"text":"| open | 3 | 9 | 12 | 25.0% |"},{"end_column":77,"end_line":21,"start_column":1,"start_line":21,"text":"Two-sided Fisher exact test on the 2x2 table of independent ponds, one trial"},{"end_column":10,"end_line":22,"start_column":1,"start_line":22,"text":"per pond."},{"end_column":27,"end_line":24,"start_column":1,"start_line":24,"text":"- sample odds ratio: 9.000"},{"end_column":30,"end_line":25,"start_column":1,"start_line":25,"text":"- two-sided p-value: 0.039126"},{"end_column":56,"end_line":26,"start_column":1,"start_line":26,"text":"- difference in persistence rate (shaded - open): 0.500"},{"end_column":260,"end_line":28,"start_column":1,"start_line":28,"text":"[selected-result] Two-sided Fisher exact test on 24 independent mesocosm ponds: shaded ponds persisted in 9 of 12 cases versus 3 of 12 open ponds (sample odds ratio 9.000, p = 0.039126), so canopy shading is associated with higher persistence at the 5% level."},{"end_column":76,"end_line":32,"start_column":1,"start_line":32,"text":"The exact p-value is the sum of hypergeometric probabilities no larger than"},{"end_column":73,"end_line":33,"start_column":1,"start_line":33,"text":"that of the observed table under fixed row and column margins. Each pond"},{"end_column":78,"end_line":34,"start_column":1,"start_line":34,"text":"enters the table once, so the fixed margins refer to independent ponds and no"},{"end_column":74,"end_line":35,"start_column":1,"start_line":35,"text":"within-pond replication inflates the counts. Volume, stocking density and"},{"end_column":70,"end_line":36,"start_column":1,"start_line":36,"text":"mean surface temperature were recorded but not used as strata, so the"},{"end_column":72,"end_line":37,"start_column":1,"start_line":37,"text":"association is unadjusted, and with 24 ponds in total the odds ratio is"},{"end_column":11,"end_line":38,"start_column":1,"start_line":38,"text":"imprecise."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:19f2f369865077a761f9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6e82c4674f055c390233200fb079e4c1ead6e357d2ea508c98aab54b53af660e","end_line":38,"locator":"results/report.md:1-38","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

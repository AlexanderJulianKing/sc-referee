{"audit_run_id":"audit:9fd2ba67b43144c79e7d12230d6273e3","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"`data/input.csv` holds the raw water-quality readings from a spring flushing"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"survey of twelve municipal service reservoirs (drinking-water storage tanks) in"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"the North Ridge distribution zone. Each reservoir has either an epoxy interior"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"liner or a cement-mortar interior liner, and each one was tapped at the same"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"four fixed sampling ports (1.5, 3.0, 4.5 and 6.0 m below the full-tank water"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"line) during a single visit. Every reservoir therefore appears in four separate"},{"end_column":66,"end_line":9,"start_column":1,"start_line":9,"text":"rows of the file, and its identifier repeats once per port depth."},{"end_column":9,"end_line":11,"start_column":1,"start_line":11,"text":"Columns:"},{"end_column":78,"end_line":13,"start_column":1,"start_line":13,"text":"- `tank_id`: the reservoir the sample came from, e.g. TK-102. Twelve distinct"},{"end_column":40,"end_line":14,"start_column":3,"start_line":14,"text":"reservoirs appear, each in four rows."},{"end_column":73,"end_line":15,"start_column":1,"start_line":15,"text":"- `liner_type`: the interior lining of that reservoir, either `epoxy` or"},{"end_column":81,"end_line":16,"start_column":3,"start_line":16,"text":"`cement-mortar`. It is a fixed property of the reservoir, so it is the same in"},{"end_column":42,"end_line":17,"start_column":3,"start_line":17,"text":"all four rows belonging to a reservoir."},{"end_column":78,"end_line":18,"start_column":1,"start_line":18,"text":"- `port_depth_m`: depth of the sampling port below the water line, in metres."},{"end_column":74,"end_line":19,"start_column":1,"start_line":19,"text":"- `free_chlorine_mgl`: free chlorine residual measured in that sample, in"},{"end_column":24,"end_line":20,"start_column":3,"start_line":20,"text":"milligrams per litre."},{"end_column":79,"end_line":21,"start_column":1,"start_line":21,"text":"- `water_temp_c`: water temperature at that port at the moment of sampling, in"},{"end_column":19,"end_line":22,"start_column":3,"start_line":22,"text":"degrees Celsius."},{"end_column":160,"end_line":24,"start_column":1,"start_line":24,"text":"One row is: a single water sample drawn from one sampling port of one reservoir, with the free chlorine residual and water temperature measured on that sample."},{"end_column":33,"end_line":25,"start_column":1,"start_line":25,"text":"Independent unit column: tank_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:09043a0c28350287045d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1bf89a85d47901c5f18ea5298af42132375212a31748fec69efb0bf043e27503","end_line":25,"locator":"data-description.md:1-25","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:9fd2ba67b43144c79e7d12230d6273e3","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"Twelve municipal service reservoirs in the North Ridge distribution zone were"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"sampled during a single spring flushing window. Six carry an epoxy liner and"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"six carry a cement-mortar liner. Each reservoir was tapped at four fixed port"},{"end_column":70,"end_line":8,"start_column":1,"start_line":8,"text":"depths (1.5, 3.0, 4.5 and 6.0 m), giving 48 free chlorine readings in"},{"end_column":18,"end_line":9,"start_column":1,"start_line":9,"text":"`data/input.csv`."},{"end_column":74,"end_line":13,"start_column":1,"start_line":13,"text":"Each reading was entered as one observation and the two liner groups were"},{"end_column":71,"end_line":14,"start_column":1,"start_line":14,"text":"compared with a two-sided Welch two-sample t-test (unequal variances)."},{"end_column":60,"end_line":16,"start_column":1,"start_line":16,"text":"| liner | samples | mean free chlorine (mg/L) | SD (mg/L) |"},{"end_column":29,"end_line":17,"start_column":1,"start_line":17,"text":"| --- | ---: | ---: | ---: |"},{"end_column":31,"end_line":18,"start_column":1,"start_line":18,"text":"| epoxy | 24 | 0.850 | 0.112 |"},{"end_column":39,"end_line":19,"start_column":1,"start_line":19,"text":"| cement-mortar | 24 | 0.650 | 0.111 |"},{"end_column":56,"end_line":21,"start_column":1,"start_line":21,"text":"Mean difference (epoxy minus cement-mortar): 0.200 mg/L"},{"end_column":38,"end_line":23,"start_column":1,"start_line":23,"text":"Welch t = 6.226, df = 46.0, p < 0.001"},{"end_column":216,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Epoxy-lined reservoirs carried 0.200 mg/L more free chlorine than cement-mortar-lined reservoirs (two-sided Welch two-sample t-test over 48 readings, 24 per liner: t = 6.226, df = 46.0, p < 0.001)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e7129e4e01ea0628791f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:0f262e89651d1ab5379a334c3e98ed02da4298fae2051b6ac170454ed4e4e9d8","end_line":27,"locator":"results/report.md:1-27","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:57b51ba03f4c4873bcc07e3eba61a059","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"The file `data/input.csv` comes from a small bakery-lab trial comparing two"},{"end_column":73,"end_line":4,"start_column":1,"start_line":4,"text":"flours. Twelve starter jars were built and kept together in one proofing"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"cabinet: six jars were fed rye flour and six were fed spelt flour, so the flour"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"treatment belongs to the jar, not to any single measurement. After feeding, a"},{"end_column":81,"end_line":7,"start_column":1,"start_line":7,"text":"technician returned to every jar four times, at 6, 12, 18 and 24 hours, and each"},{"end_column":76,"end_line":8,"start_column":1,"start_line":8,"text":"time recorded the height of the risen gas column and the pH of the starter."},{"end_column":77,"end_line":9,"start_column":1,"start_line":9,"text":"Because of that schedule, each jar shows up in the file four times, once per"},{"end_column":65,"end_line":10,"start_column":1,"start_line":10,"text":"visit, and those four numbers come from the same batch of dough."},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":76,"end_line":14,"start_column":1,"start_line":14,"text":"- `reading_id`: label for one measurement event (48 of them, all distinct)."},{"end_column":66,"end_line":15,"start_column":1,"start_line":15,"text":"- `jar_id`: which starter jar was measured; twelve jars in total."},{"end_column":68,"end_line":16,"start_column":1,"start_line":16,"text":"- `flour_type`: the flour fed to that jar, either `rye` or `spelt`."},{"end_column":74,"end_line":17,"start_column":1,"start_line":17,"text":"- `incubation_h`: hours elapsed since feeding when the reading was taken."},{"end_column":51,"end_line":18,"start_column":1,"start_line":18,"text":"- `starter_ph`: pH of the starter at that reading."},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"- `rise_mm`: height of the risen dough column, in millimetres, at that reading."},{"end_column":116,"end_line":21,"start_column":1,"start_line":21,"text":"One row is: one timed measurement of rise height and pH taken from a single starter jar at a single incubation time"},{"end_column":32,"end_line":22,"start_column":1,"start_line":22,"text":"Independent unit column: jar_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:7e1c31459604b3daab9a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:4a25938c90b43150430a7c851a1eada492061dc35820ed2463327b52b10fc588","end_line":22,"locator":"data-description.md:1-22","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:57b51ba03f4c4873bcc07e3eba61a059","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"`data/input.csv` holds 48 timed rise readings from 12 fermentation jars."},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"Each jar contributed 4 readings, taken at hours 6, 12, 18, 24 after feeding."},{"end_column":60,"end_line":8,"start_column":1,"start_line":8,"text":"| flour_type | jars | readings | mean rise (mm) | sd (mm) |"},{"end_column":36,"end_line":9,"start_column":1,"start_line":9,"text":"| --- | ---: | ---: | ---: | ---: |"},{"end_column":32,"end_line":10,"start_column":1,"start_line":10,"text":"| rye | 6 | 24 | 20.00 | 3.16 |"},{"end_column":34,"end_line":11,"start_column":1,"start_line":11,"text":"| spelt | 6 | 24 | 27.00 | 3.16 |"},{"end_column":79,"end_line":15,"start_column":1,"start_line":15,"text":"Every one of the 48 rows was entered as a separate observation in a two-sided,"},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"equal-variance two-sample Student t-test comparing rise height between the two"},{"end_column":79,"end_line":17,"start_column":1,"start_line":17,"text":"flour types (rye minus spelt). The group summaries above use the same 48 rows."},{"end_column":132,"end_line":21,"start_column":1,"start_line":21,"text":"[selected-result] Two-sample t-test over 48 rise readings: rye minus spelt = -7.00 mm, t(46) = -7.67, p < 0.001, Cohen's d = -2.21."},{"end_column":78,"end_line":23,"start_column":1,"start_line":23,"text":"Rye jars measured about 7 mm lower than spelt jars across the 24-hour window,"},{"end_column":82,"end_line":24,"start_column":1,"start_line":24,"text":"and at the level of individual readings the gap is flagged as highly significant."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:a24effc63db76bcde5bc","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8a2cbfd2ae6a487888e4806cf0ab005228925820cbca7004bd10e58f6c55d76e","end_line":24,"locator":"results/report.md:1-24","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

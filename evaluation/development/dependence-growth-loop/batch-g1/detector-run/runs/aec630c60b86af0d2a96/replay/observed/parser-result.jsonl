{"audit_run_id":"audit:ae74a413433447bfa293c3154b320623","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":3,"start_column":1,"start_line":3,"text":"Five juvenile cave salamanders were collected from a single spring outflow, held"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"in a common tank on the same feeding schedule, and tested in a two-armed Y-maze"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"in which one arm was warmed to about 18 degrees C while the other was held near"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"11 degrees C. Each animal was released into the start box four times, once per"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"day on four consecutive days, giving twenty scored releases in total. For every"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"release an observer recorded which arm the animal entered first and how many"},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"seconds passed between release and that first entry. The warm and cool arms were"},{"end_column":81,"end_line":10,"start_column":1,"start_line":10,"text":"swapped between days so that a fixed side preference could not by itself produce"},{"end_column":24,"end_line":11,"start_column":1,"start_line":11,"text":"the pattern of choices."},{"end_column":74,"end_line":13,"start_column":1,"start_line":13,"text":"The file data/input.csv has one line per scored release. The columns are:"},{"end_column":59,"end_line":15,"start_column":1,"start_line":15,"text":"- trial_uid: label for the scored release, T01 through T20"},{"end_column":69,"end_line":16,"start_column":1,"start_line":16,"text":"- salamander_id: the animal that was released, SAL-01 through SAL-05"},{"end_column":80,"end_line":17,"start_column":1,"start_line":17,"text":"- trial_day: which of the four testing days the release belongs to, 1 through 4"},{"end_column":57,"end_line":18,"start_column":1,"start_line":18,"text":"- arm_chosen: the arm entered first, either warm or cool"},{"end_column":63,"end_line":19,"start_column":1,"start_line":19,"text":"- latency_s: whole seconds from release to the first arm entry"},{"end_column":79,"end_line":21,"start_column":1,"start_line":21,"text":"Because every animal appears on four separate lines, the same five salamanders"},{"end_column":42,"end_line":22,"start_column":1,"start_line":22,"text":"account for all twenty lines in the file."},{"end_column":126,"end_line":24,"start_column":1,"start_line":24,"text":"One row is: one Y-maze release of one salamander on one day, recording the arm it entered first and the latency to that entry"},{"end_column":39,"end_line":25,"start_column":1,"start_line":25,"text":"Independent unit column: salamander_id"},{"end_column":22,"end_line":26,"start_column":1,"start_line":26,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:a634e56d76296142a7fc","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:98c70e2b37a84a2ad297672dfb9ec04ad208bdac6a3256aeaea01c4b4a7634d7","end_line":26,"locator":"data-description.md:1-26","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:ae74a413433447bfa293c3154b320623","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"Each release in the Y-maze is scored for the arm the animal first entered (warm"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"or cool). Every scored release is entered as one independent Bernoulli trial and"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"the pooled counts are submitted to an exact two-sided binomial test against the"},{"end_column":55,"end_line":8,"start_column":1,"start_line":8,"text":"no-preference null of p = 0.5 (scipy.stats.binomtest)."},{"end_column":22,"end_line":12,"start_column":1,"start_line":12,"text":"- Scored releases: 20"},{"end_column":23,"end_line":13,"start_column":1,"start_line":13,"text":"- Warm-arm choices: 15"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"- Cool-arm choices: 5"},{"end_column":25,"end_line":15,"start_column":1,"start_line":15,"text":"- Proportion warm: 0.750"},{"end_column":36,"end_line":16,"start_column":1,"start_line":16,"text":"- Mean first-choice latency: 62.0 s"},{"end_column":143,"end_line":20,"start_column":1,"start_line":20,"text":"[selected-result] Exact two-sided binomial test, 15 warm-arm choices in 20 scored releases, null p = 0.5: proportion warm = 0.750, p = 0.0414."},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"The pooled releases depart from indifference at the conventional 5% threshold,"},{"end_column":63,"end_line":23,"start_column":1,"start_line":23,"text":"so the assay is reported as evidence of a warm-arm preference."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:90a2172e8821b38cc1c6","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:16100d488a0195ad9a137a1dd689a77687c9705245350d2fc465b86be52f4d69","end_line":23,"locator":"results/report.md:1-23","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

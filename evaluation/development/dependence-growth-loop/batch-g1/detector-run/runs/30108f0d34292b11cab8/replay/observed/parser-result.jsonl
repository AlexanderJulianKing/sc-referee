{"audit_run_id":"audit:3a6c5c4c1e534854ac444a70e6bbd6b3","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":3,"start_column":1,"start_line":3,"text":"Five full-scale anaerobic digesters at a municipal water-resource recovery"},{"end_column":76,"end_line":4,"start_column":1,"start_line":4,"text":"facility were followed for four consecutive weeks. Each digester is plumbed"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"with two parallel feed trains: one is fed thermally hydrolysed sludge, the"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"other is fed the same sludge with no pretreatment. Once per week an operator"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"walks a sampling round, draws a matched pair of biogas samples (one from each"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"train of the same digester), and records the specific methane yield of both."},{"end_column":79,"end_line":9,"start_column":1,"start_line":9,"text":"The file therefore holds four weekly sampling sessions for every digester, and"},{"end_column":78,"end_line":10,"start_column":1,"start_line":10,"text":"the two yield columns in a row always come from the same digester in the same"},{"end_column":6,"end_line":11,"start_column":1,"start_line":11,"text":"week."},{"end_column":149,"end_line":13,"start_column":1,"start_line":13,"text":"One row is: one weekly paired sampling session on a single digester, holding that week's pretreated and control specific methane yields side by side"},{"end_column":37,"end_line":14,"start_column":1,"start_line":14,"text":"Independent unit column: digester_id"},{"end_column":22,"end_line":15,"start_column":1,"start_line":15,"text":"One trial is: one row"},{"end_column":9,"end_line":17,"start_column":1,"start_line":17,"text":"Columns:"},{"end_column":141,"end_line":18,"start_column":1,"start_line":18,"text":"- digester_id: label of the digester the session belongs to (D-01 through D-05); the same digester contributes four rows, one per study week"},{"end_column":39,"end_line":19,"start_column":1,"start_line":19,"text":"- week: study week number, 1 through 4"},{"end_column":87,"end_line":20,"start_column":1,"start_line":20,"text":"- operator_shift: whether that sampling round was walked on the day or the night shift"},{"end_column":153,"end_line":21,"start_column":1,"start_line":21,"text":"- pretreated_yield_m3_per_kgvs: specific methane yield of the thermally hydrolysed train, in cubic metres of methane per kilogram of volatile solids fed"},{"end_column":95,"end_line":22,"start_column":1,"start_line":22,"text":"- control_yield_m3_per_kgvs: specific methane yield of the untreated control train, same units"},{"end_column":79,"end_line":24,"start_column":1,"start_line":24,"text":"Digesters differ from one another in sludge blend, mixing regime and retention"},{"end_column":76,"end_line":25,"start_column":1,"start_line":25,"text":"time, so the weekly readings taken from one digester tend to move together."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d025a8ee9aad432daba0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:0beab72381f87f2530493e9b5ee2dbb945bf78372b66b810e9ccc619ff647499","end_line":25,"locator":"data-description.md:1-25","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3a6c5c4c1e534854ac444a70e6bbd6b3","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Each logged session pairs a pretreated train against a control train fed in"},{"end_column":75,"end_line":4,"start_column":1,"start_line":4,"text":"parallel on the same day, so every session returns one win-or-loss verdict"},{"end_column":27,"end_line":5,"start_column":1,"start_line":5,"text":"for the pretreatment step."},{"end_column":42,"end_line":9,"start_column":1,"start_line":9,"text":"- Sessions read from `data/input.csv`: 20"},{"end_column":47,"end_line":10,"start_column":1,"start_line":10,"text":"- Distinct digester identifiers in the file: 5"},{"end_column":43,"end_line":11,"start_column":1,"start_line":11,"text":"- Sessions won by the pretreated train: 15"},{"end_column":45,"end_line":13,"start_column":1,"start_line":13,"text":"| digester_id | sessions | pretreated wins |"},{"end_column":20,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- |"},{"end_column":17,"end_line":15,"start_column":1,"start_line":15,"text":"| D-01 | 4 | 4 |"},{"end_column":17,"end_line":16,"start_column":1,"start_line":16,"text":"| D-02 | 4 | 4 |"},{"end_column":17,"end_line":17,"start_column":1,"start_line":17,"text":"| D-03 | 4 | 3 |"},{"end_column":17,"end_line":18,"start_column":1,"start_line":18,"text":"| D-04 | 4 | 3 |"},{"end_column":17,"end_line":19,"start_column":1,"start_line":19,"text":"| D-05 | 4 | 1 |"},{"end_column":75,"end_line":23,"start_column":1,"start_line":23,"text":"Every logged session is treated as one independent Bernoulli trial and the"},{"end_column":77,"end_line":24,"start_column":1,"start_line":24,"text":"win tally is tested against a fair-coin null of 0.5 with the exact two-sided"},{"end_column":39,"end_line":25,"start_column":1,"start_line":25,"text":"binomial test `scipy.stats.binomtest`."},{"end_column":33,"end_line":27,"start_column":1,"start_line":27,"text":"- Observed win proportion: 0.750"},{"end_column":34,"end_line":28,"start_column":1,"start_line":28,"text":"- Exact two-sided p-value: 0.0414"},{"end_column":300,"end_line":30,"start_column":1,"start_line":30,"text":"[selected-result] Exact two-sided binomial test (scipy.stats.binomtest) over 20 weekly sampling sessions: the pretreated train won 15 of 20 sessions, proportion 0.750, p = 0.0414, which is below 0.05, so the log is read as evidence that thermal-hydrolysis pretreatment raises specific methane yield."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:54cc60f4c2aad66cce2b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:64fb0bc0f71e3a45d198e8f443536100224df7f23fa0f8898d5bb4f4a8f57a7f","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

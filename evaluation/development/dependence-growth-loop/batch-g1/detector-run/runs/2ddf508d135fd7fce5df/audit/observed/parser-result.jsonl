{"audit_run_id":"audit:442947f4e7af4f028913bda219bed941","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"Twenty-four abandoned slate and gravel quarry ponds across one upland survey"},{"end_column":78,"end_line":4,"start_column":1,"start_line":4,"text":"region were screened for great crested newt environmental DNA during a single"},{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"spring campaign. Each pond was visited exactly once and yielded exactly one"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"pooled water sample, so a pond never appears on more than one line of the file."},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"Half of the ponds had been regraded years earlier to give a gently shelving"},{"end_column":73,"end_line":8,"start_column":1,"start_line":8,"text":"littoral margin; the other half kept their original steep-sided profile."},{"end_column":9,"end_line":10,"start_column":1,"start_line":10,"text":"Columns:"},{"end_column":78,"end_line":12,"start_column":1,"start_line":12,"text":"- pond_id: the unique code for the quarry pond, for example QP-07. No code is"},{"end_column":33,"end_line":13,"start_column":3,"start_line":13,"text":"repeated anywhere in the file."},{"end_column":79,"end_line":14,"start_column":1,"start_line":14,"text":"- shelf_status: \"restored\" if the pond has a regraded gently shelving littoral"},{"end_column":71,"end_line":15,"start_column":3,"start_line":15,"text":"margin, \"unrestored\" if it retains its original steep-sided profile."},{"end_column":70,"end_line":16,"start_column":1,"start_line":16,"text":"- pond_area_m2: open-water surface area of the pond in square metres."},{"end_column":77,"end_line":17,"start_column":1,"start_line":17,"text":"- mean_depth_cm: mean water depth in centimetres, averaged over a five-point"},{"end_column":48,"end_line":18,"start_column":3,"start_line":18,"text":"transect walked during the same single visit."},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"- edna_result: \"detected\" or \"not_detected\", the great crested newt eDNA result"},{"end_column":43,"end_line":20,"start_column":3,"start_line":20,"text":"for that pond's one pooled water sample."},{"end_column":128,"end_line":22,"start_column":1,"start_line":22,"text":"One row is: one abandoned quarry pond surveyed a single time, with one pooled water sample screened for great crested newt eDNA"},{"end_column":33,"end_line":23,"start_column":1,"start_line":23,"text":"Independent unit column: pond_id"},{"end_column":22,"end_line":24,"start_column":1,"start_line":24,"text":"One trial is: one row"},{"end_column":80,"end_line":26,"start_column":1,"start_line":26,"text":"Every pond is its own independent unit. There are no repeat visits, no split or"},{"end_column":78,"end_line":27,"start_column":1,"start_line":27,"text":"replicate samples written out as extra lines, and no grouping of ponds inside"},{"end_column":78,"end_line":28,"start_column":1,"start_line":28,"text":"larger clusters recorded in this file, so the rows can be treated as separate"},{"end_column":32,"end_line":29,"start_column":1,"start_line":29,"text":"observations of separate ponds."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:3719f8543e9a473c1815","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:31311d32d081d53b1abad166c075499982f75acc31cc2e7ca3fafe34d9ec8982","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:442947f4e7af4f028913bda219bed941","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one abandoned quarry pond. Every pond was"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"visited once and contributed exactly one pooled water sample, screened for"},{"end_column":70,"end_line":7,"start_column":1,"start_line":7,"text":"great crested newt eDNA. Pond identifiers are unique, so the 24 ponds"},{"end_column":71,"end_line":8,"start_column":1,"start_line":8,"text":"supply 24 mutually independent observations with no repeated measures."},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"Two-sided Fisher exact test on the 2 x 2 table of shelf status by eDNA result."},{"end_column":68,"end_line":14,"start_column":1,"start_line":14,"text":"| Shelf status | Detected | Not detected | Ponds | Detection rate |"},{"end_column":32,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- | --- | --- | --- |"},{"end_column":34,"end_line":16,"start_column":1,"start_line":16,"text":"| restored | 9 | 3 | 12 | 0.750 |"},{"end_column":36,"end_line":17,"start_column":1,"start_line":17,"text":"| unrestored | 3 | 9 | 12 | 0.250 |"},{"end_column":26,"end_line":21,"start_column":1,"start_line":21,"text":"- Sample odds ratio: 9.00"},{"end_column":34,"end_line":22,"start_column":1,"start_line":22,"text":"- Two-sided exact p-value: 0.0391"},{"end_column":63,"end_line":23,"start_column":1,"start_line":23,"text":"- Detection-rate difference (restored minus unrestored): 0.500"},{"end_column":262,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] A two-sided Fisher exact test on 24 independently surveyed quarry ponds returns p = 0.0391 with a sample odds ratio of 9.00; great crested newt eDNA was detected in 9 of 12 restored-shelf ponds (0.750) against 3 of 12 unrestored ponds (0.250)."},{"end_column":77,"end_line":29,"start_column":1,"start_line":29,"text":"Fisher's exact test treats each row as an independent trial. That assumption"},{"end_column":78,"end_line":30,"start_column":1,"start_line":30,"text":"matches the sampling frame used here, which allocates one and only one survey"},{"end_column":52,"end_line":31,"start_column":1,"start_line":31,"text":"to each pond, so no pond is counted more than once."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:8240cdd6078f104d6ec9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:84c2da71d51b68f9edad16d7325671f570801f5db58b52595e963057af154be2","end_line":31,"locator":"results/report.md:1-31","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:b87fb2513c0a45bfaa7ad1d2c9de6d49","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":3,"start_column":1,"start_line":3,"text":"Six individually marked bumblebees from one glasshouse colony were released, one"},{"end_column":82,"end_line":4,"start_column":1,"start_line":4,"text":"at a time, in front of a two-armed artificial flower array. Both arms offered the"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"same sugar reward; one arm carried a UV-reflective petal mark and the other did"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"not. The observer recorded which arm the bee landed on first and how long it"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"worked that first flower. Each release is called a bout. The same bees were"},{"end_column":81,"end_line":8,"start_column":1,"start_line":8,"text":"re-released several times across three mornings, so an individual bee appears in"},{"end_column":82,"end_line":9,"start_column":1,"start_line":9,"text":"more than one row of the table (between two and four bouts per bee). Bout numbers"},{"end_column":27,"end_line":10,"start_column":1,"start_line":10,"text":"restart at 1 for each bee."},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":56,"end_line":14,"start_column":1,"start_line":14,"text":"- bee_id: paint-mark code of the bee that flew the bout"},{"end_column":55,"end_line":15,"start_column":1,"start_line":15,"text":"- bout_id: sequence number of the bout within that bee"},{"end_column":56,"end_line":16,"start_column":1,"start_line":16,"text":"- observation_date: morning on which the bout was flown"},{"end_column":57,"end_line":17,"start_column":1,"start_line":17,"text":"- array_id: which of the three identical arrays was used"},{"end_column":72,"end_line":18,"start_column":1,"start_line":18,"text":"- first_arm: the arm the bee landed on first, either uv_marked or plain"},{"end_column":62,"end_line":19,"start_column":1,"start_line":19,"text":"- handling_time_s: seconds the bee spent on that first flower"},{"end_column":83,"end_line":21,"start_column":1,"start_line":21,"text":"One row is: one foraging bout flown by one marked bumblebee at the two-armed array"},{"end_column":32,"end_line":22,"start_column":1,"start_line":22,"text":"Independent unit column: bee_id"},{"end_column":22,"end_line":23,"start_column":1,"start_line":23,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:967634d0b2fbe212574c","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:aa26d189fa9538f565774684166cd334167cd83d29ea40104e9923cf19c6c70c","end_line":23,"locator":"data-description.md:1-23","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:b87fb2513c0a45bfaa7ad1d2c9de6d49","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":33,"end_line":5,"start_column":1,"start_line":5,"text":"- Source table: `data/input.csv`"},{"end_column":28,"end_line":6,"start_column":1,"start_line":6,"text":"- Foraging bouts scored: 20"},{"end_column":30,"end_line":7,"start_column":1,"start_line":7,"text":"- Individually marked bees: 6"},{"end_column":52,"end_line":8,"start_column":1,"start_line":8,"text":"- Bouts choosing the UV-marked arm first: 5 (25.0%)"},{"end_column":42,"end_line":9,"start_column":1,"start_line":9,"text":"- Mean handling time across bouts: 8.47 s"},{"end_column":45,"end_line":13,"start_column":1,"start_line":13,"text":"| bee_id | bouts | uv_marked first | share |"},{"end_column":26,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- | --- |"},{"end_column":24,"end_line":15,"start_column":1,"start_line":15,"text":"| B01 | 4 | 0 | 0.000 |"},{"end_column":24,"end_line":16,"start_column":1,"start_line":16,"text":"| B02 | 3 | 0 | 0.000 |"},{"end_column":24,"end_line":17,"start_column":1,"start_line":17,"text":"| B03 | 4 | 0 | 0.000 |"},{"end_column":24,"end_line":18,"start_column":1,"start_line":18,"text":"| B04 | 2 | 2 | 1.000 |"},{"end_column":24,"end_line":19,"start_column":1,"start_line":19,"text":"| B05 | 4 | 2 | 0.500 |"},{"end_column":24,"end_line":20,"start_column":1,"start_line":20,"text":"| B06 | 3 | 1 | 0.333 |"},{"end_column":87,"end_line":24,"start_column":1,"start_line":24,"text":"Every scored bout was entered as one Bernoulli trial, and the 20 trials were submitted"},{"end_column":74,"end_line":25,"start_column":1,"start_line":25,"text":"to an exact two-sided binomial test (`scipy.stats.binomtest`) against the"},{"end_column":34,"end_line":26,"start_column":1,"start_line":26,"text":"no-preference expectation of 0.5."},{"end_column":263,"end_line":30,"start_column":1,"start_line":30,"text":"[selected-result] Exact two-sided binomial test on 20 scored bouts: 5 of 20 first choices went to the UV-marked arm (25.0%), p = 0.041389 against the null proportion of 0.5, indicating a statistically significant bias away from the UV-marked arm at the 5% level."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:eabd9e92f49e24b13623","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1f4e574e07b5228b0f981e9c2840e48fadb560da4173f873a9676dfd46abe2e6","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

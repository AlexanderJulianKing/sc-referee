{"audit_run_id":"audit:202bc67bcf934693823584c30466a4f9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"The file records a night-time amphibian survey of urban stormwater ponds run"},{"end_column":77,"end_line":4,"start_column":1,"start_line":4,"text":"across one frog breeding season. A field crew visited each pond once, waited"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"through dusk, and logged the moment continuous calling started at that pond."},{"end_column":94,"end_line":7,"start_column":1,"start_line":7,"text":"One row is: one urban stormwater pond, described by the single night on which it was surveyed"},{"end_column":33,"end_line":9,"start_column":1,"start_line":9,"text":"Independent unit column: pond_id"},{"end_column":75,"end_line":13,"start_column":1,"start_line":13,"text":"- pond_id: unique code for the pond; each code occurs on exactly one line."},{"end_column":64,"end_line":14,"start_column":1,"start_line":14,"text":"- survey_date: calendar date of that pond's one and only visit."},{"end_column":101,"end_line":15,"start_column":1,"start_line":15,"text":"- lighting_regime: \"lit\" when permanent street lighting falls on the pond margin, \"unlit\" otherwise."},{"end_column":81,"end_line":16,"start_column":1,"start_line":16,"text":"- pond_area_ha: open-water surface area in hectares, traced from aerial imagery."},{"end_column":72,"end_line":17,"start_column":1,"start_line":17,"text":"- water_temp_c: water temperature in degrees Celsius, taken on arrival."},{"end_column":99,"end_line":18,"start_column":1,"start_line":18,"text":"- chorus_onset_min_after_sunset: minutes between local sunset and the start of continuous calling."},{"end_column":76,"end_line":22,"start_column":1,"start_line":22,"text":"Twelve ponds contribute twelve lines, one apiece. No pond was revisited, no"},{"end_column":77,"end_line":23,"start_column":1,"start_line":23,"text":"pond is split across lines, and no two ponds were surveyed on the same date,"},{"end_column":77,"end_line":24,"start_column":1,"start_line":24,"text":"so every onset value comes from a different source. Ponds are separate water"},{"end_column":78,"end_line":25,"start_column":1,"start_line":25,"text":"bodies in separate catchments and were not paired or matched with each other."},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"A procedure that treats the lines as independent observations therefore suits"},{"end_column":77,"end_line":27,"start_column":1,"start_line":27,"text":"this table, and the grouping variable (lighting regime) varies between ponds"},{"end_column":29,"end_line":28,"start_column":1,"start_line":28,"text":"rather than within any pond."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:990317d46133d61afdc1","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2fcddef17ef5ed33df020a88d57abffbc8fcb4470b8f4c6ec7883b58a107358d","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:202bc67bcf934693823584c30466a4f9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"Twelve urban stormwater ponds were each visited on a single night of one"},{"end_column":74,"end_line":6,"start_column":1,"start_line":6,"text":"breeding season. One chorus onset time, the number of minutes after local"},{"end_column":73,"end_line":7,"start_column":1,"start_line":7,"text":"sunset at which continuous calling began, was logged per pond. Six ponds"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"border continuously burning street lighting and six are unlit. Every pond"},{"end_column":75,"end_line":9,"start_column":1,"start_line":9,"text":"appears exactly once, so the twelve onset values are mutually independent."},{"end_column":68,"end_line":13,"start_column":1,"start_line":13,"text":"| Lighting regime | Ponds | Mean onset (min) | Median onset (min) |"},{"end_column":26,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- | --- |"},{"end_column":27,"end_line":15,"start_column":1,"start_line":15,"text":"| lit | 6 | 53.50 | 54.5 |"},{"end_column":29,"end_line":16,"start_column":1,"start_line":16,"text":"| unlit | 6 | 25.00 | 25.0 |"},{"end_column":46,"end_line":18,"start_column":1,"start_line":18,"text":"Median shift (lit minus unlit): 29.5 minutes."},{"end_column":76,"end_line":22,"start_column":1,"start_line":22,"text":"The two lighting regimes were compared with a two-sided Mann-Whitney U test"},{"end_column":75,"end_line":23,"start_column":1,"start_line":23,"text":"evaluated against the exact null distribution; no ties occur in the pooled"},{"end_column":30,"end_line":24,"start_column":1,"start_line":24,"text":"sample of twelve onset times."},{"end_column":245,"end_line":26,"start_column":1,"start_line":26,"text":"[selected-result] Mann-Whitney U test of chorus onset, lit (n = 6) versus unlit (n = 6) ponds: U = 35.0, exact two-sided p = 0.00433, rank-biserial correlation = 0.944; onset is later at lit ponds (median 54.5 versus 25.0 minutes after sunset)."},{"end_column":76,"end_line":30,"start_column":1,"start_line":30,"text":"At the 5 percent level the onset distributions differ: calling at lit ponds"},{"end_column":76,"end_line":31,"start_column":1,"start_line":31,"text":"starts about half an hour later relative to sunset than at unlit ponds. The"},{"end_column":77,"end_line":32,"start_column":1,"start_line":32,"text":"comparison is observational, so lighting is not separated from whatever else"},{"end_column":78,"end_line":33,"start_column":1,"start_line":33,"text":"distinguishes lit sites from unlit ones; pond area and water temperature were"},{"end_column":36,"end_line":34,"start_column":1,"start_line":34,"text":"recorded but are not modelled here."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4119bc34aa566a83e328","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1d16fa666f1985890c796bf985f55a5d2c4e4f12ae76547b4d54d1b75a44275e","end_line":34,"locator":"results/report.md:1-34","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

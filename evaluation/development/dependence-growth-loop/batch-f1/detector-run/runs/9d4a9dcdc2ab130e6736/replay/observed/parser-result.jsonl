{"audit_run_id":"audit:3d751e33468a4fb4b1201a8d51f5ccd8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Serra Alta olive orchard, deficit-irrigation trial. Twelve mature 'Arbequina'"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"trees of similar trunk girth were assigned to one of two irrigation regimes for"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"the whole dry season: full replacement of crop evapotranspiration, or a deficit"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"schedule at roughly 35 percent of that amount. Six trees received each regime."},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"In the third week of the stress period a single field crew walked the orchard"},{"end_column":73,"end_line":9,"start_column":1,"start_line":9,"text":"once, mid-morning, and measured eight sunlit leaves on every tree with a"},{"end_column":78,"end_line":10,"start_column":1,"start_line":10,"text":"steady-state porometer: four leaves from the east side of the canopy and four"},{"end_column":80,"end_line":11,"start_column":1,"start_line":11,"text":"from the west side. Each leaf was measured a single time and then tagged, so no"},{"end_column":75,"end_line":12,"start_column":1,"start_line":12,"text":"leaf appears twice, but every tree contributes eight readings to the file."},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":51,"end_line":16,"start_column":1,"start_line":16,"text":"- leaf_id: unique tag written on the measured leaf"},{"end_column":59,"end_line":17,"start_column":1,"start_line":17,"text":"- tree_id: orchard label of the tree that carried the leaf"},{"end_column":70,"end_line":18,"start_column":1,"start_line":18,"text":"- irrigation: irrigation regime applied to that tree, full or deficit"},{"end_column":75,"end_line":19,"start_column":1,"start_line":19,"text":"- canopy_aspect: side of the canopy the leaf was picked from, east or west"},{"end_column":77,"end_line":20,"start_column":1,"start_line":20,"text":"- gsw_mmol_m2_s: stomatal conductance of the leaf in mmol m^-2 s^-1, as read"},{"end_column":78,"end_line":21,"start_column":3,"start_line":21,"text":"off the porometer (whole numbers, the resolution of the instrument display)"},{"end_column":79,"end_line":23,"start_column":1,"start_line":23,"text":"The file has 96 measurement lines, 8 for each of the 12 trees. Irrigation is a"},{"end_column":81,"end_line":24,"start_column":1,"start_line":24,"text":"property of the tree, not of the leaf: all eight leaves of a tree carry the same"},{"end_column":81,"end_line":25,"start_column":1,"start_line":25,"text":"regime label, and leaves from the same tree share that tree's soil water status,"},{"end_column":60,"end_line":26,"start_column":1,"start_line":26,"text":"rooting depth, canopy architecture and time of measurement."},{"end_column":90,"end_line":28,"start_column":1,"start_line":28,"text":"One row is: one sunlit leaf measured once with a steady-state porometer on one olive tree"},{"end_column":33,"end_line":29,"start_column":1,"start_line":29,"text":"Independent unit column: tree_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:5e5ba381fc6621661800","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8d1d0c279f913a0a2281a3b3df69963e9e662335ec3e386e12a95e0bad5fd1ff","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3d751e33468a4fb4b1201a8d51f5ccd8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":5,"start_column":1,"start_line":5,"text":"Steady-state porometer readings of leaf stomatal conductance (g_sw, mmol m^-2 s^-1)"},{"end_column":85,"end_line":6,"start_column":1,"start_line":6,"text":"were taken mid-morning in the third week of the stress period. 96 sunlit leaves were"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"logged, 8 per tree, across 12 trees split between the two irrigation regimes."},{"end_column":41,"end_line":9,"start_column":1,"start_line":9,"text":"| irrigation | leaves | mean g_sw | SD |"},{"end_column":26,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- | --- |"},{"end_column":31,"end_line":11,"start_column":1,"start_line":11,"text":"| full | 48 | 300.00 | 30.75 |"},{"end_column":34,"end_line":12,"start_column":1,"start_line":12,"text":"| deficit | 48 | 276.00 | 27.43 |"},{"end_column":76,"end_line":16,"start_column":1,"start_line":16,"text":"Two-sided two-sample Student t-test (pooled variance) on the leaf readings,"},{"end_column":43,"end_line":17,"start_column":1,"start_line":17,"text":"full irrigation versus deficit irrigation."},{"end_column":57,"end_line":19,"start_column":1,"start_line":19,"text":"- mean difference (full - deficit): 24.00 mmol m^-2 s^-1"},{"end_column":32,"end_line":20,"start_column":1,"start_line":20,"text":"- t = 4.035, df = 94, p < 0.001"},{"end_column":218,"end_line":22,"start_column":1,"start_line":22,"text":"[selected-result] Leaves under full irrigation had higher stomatal conductance than leaves under deficit irrigation (300.00 vs 276.00 mmol m^-2 s^-1, difference 24.00; two-sample t-test t = 4.035, df = 94, p < 0.001)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1944968bf012f7e7e213","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6447a1f5fb05e750d64bf6a0a9671f6dcc393983cc064a973c16624d35f6d8cf","end_line":22,"locator":"results/report.md:1-22","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

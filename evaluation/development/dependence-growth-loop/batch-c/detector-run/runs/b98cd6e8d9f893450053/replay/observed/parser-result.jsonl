{"audit_run_id":"audit:2ce198940a1749338d20ef9efc909529","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":71,"end_line":3,"start_column":1,"start_line":3,"text":"Eight fermentation vessels were built for this bakery trial: four with"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"wholemeal rye flour and four with strong wheat flour. All eight were fed on the"},{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"same schedule from the same mother culture and held in one 26 C proofing"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"cabinet. Thirty-six hours after the final build, a calibrated probe measured pH"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"at four separate locations in each vessel's dough, so every vessel contributes"},{"end_column":27,"end_line":8,"start_column":1,"start_line":8,"text":"four readings to the file."},{"end_column":9,"end_line":10,"start_column":1,"start_line":10,"text":"Columns:"},{"end_column":84,"end_line":12,"start_column":1,"start_line":12,"text":"- `vessel_id`: label of the fermentation vessel the reading came from (V01 to V08)."},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"- `flour_type`: the flour that vessel was built with, either `rye` or `wheat`."},{"end_column":94,"end_line":14,"start_column":1,"start_line":14,"text":"- `sample_point`: which of the four dough locations inside that vessel was probed (p1 to p4)."},{"end_column":78,"end_line":15,"start_column":1,"start_line":15,"text":"- `ph_36h`: the pH recorded at that location, 36 hours after the final build."},{"end_column":79,"end_line":17,"start_column":1,"start_line":17,"text":"The file is 32 data rows plus a header. Values are plain ASCII, pH recorded to"},{"end_column":20,"end_line":18,"start_column":1,"start_line":18,"text":"two decimal places."},{"end_column":86,"end_line":20,"start_column":1,"start_line":20,"text":"One row is: one pH reading taken at one dough location inside one fermentation vessel"},{"end_column":35,"end_line":21,"start_column":1,"start_line":21,"text":"Independent unit column: vessel_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d4814a76a418bc19e28b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:bcd8e6ef26af49b6add1afe99b065853bced52b5b5bd72fd68382fdebb67708f","end_line":21,"locator":"data-description.md:1-21","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:2ce198940a1749338d20ef9efc909529","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"`data/input.csv` holds 32 pH readings taken 36 hours after the final build."},{"end_column":72,"end_line":6,"start_column":1,"start_line":6,"text":"Each vessel was sampled at four separate points in the dough, and every"},{"end_column":50,"end_line":7,"start_column":1,"start_line":7,"text":"reading enters the comparison as one observation."},{"end_column":53,"end_line":9,"start_column":1,"start_line":9,"text":"| Flour | Vessels | Readings | Mean pH | Median pH |"},{"end_column":36,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | ---: | ---: | ---: | ---: |"},{"end_column":34,"end_line":11,"start_column":1,"start_line":11,"text":"| rye | 4 | 16 | 3.689 | 3.6850 |"},{"end_column":36,"end_line":12,"start_column":1,"start_line":12,"text":"| wheat | 4 | 16 | 3.941 | 3.9450 |"},{"end_column":53,"end_line":14,"start_column":1,"start_line":14,"text":"Median difference (wheat minus rye): 0.260 pH units."},{"end_column":74,"end_line":18,"start_column":1,"start_line":18,"text":"A two-sided Mann-Whitney U test with the exact null distribution over the"},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"601080390 equally likely rank assignments compares the 16 rye readings with the"},{"end_column":19,"end_line":20,"start_column":1,"start_line":20,"text":"16 wheat readings."},{"end_column":112,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Mann-Whitney U = 0.0 for rye versus wheat (16 vs 16 readings), two-sided exact p = 3.327e-09."},{"end_column":75,"end_line":26,"start_column":1,"start_line":26,"text":"No rye reading exceeds any wheat reading, so U sits at the boundary of its"},{"end_column":76,"end_line":27,"start_column":1,"start_line":27,"text":"exact null distribution and the p-value is the smallest the test can return"},{"end_column":23,"end_line":28,"start_column":1,"start_line":28,"text":"at these sample sizes."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e8e561edf831d17ee555","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:acbdd731a7e71c7d8f1bb6f9b60ab71fb08e572d3154beceb7f60d5ec6ad8017","end_line":28,"locator":"results/report.md:1-28","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:5c12dd4ea4e6404d9783cccc42affbf4","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"This is a field survey of ten restored hillside terraces in the Kalu catchment,"},{"end_column":77,"end_line":4,"start_column":1,"start_line":4,"text":"recorded after two wet seasons. Five of the terraces had been treated with a"},{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"biochar topsoil amendment when they were built; the other five were left"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"unamended. On every terrace the survey crew measured steady-state infiltration"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"with a double-ring infiltrometer at four permanently marked sampling plots, so"},{"end_column":48,"end_line":8,"start_column":1,"start_line":8,"text":"each terrace contributes four rows to the file."},{"end_column":9,"end_line":10,"start_column":1,"start_line":10,"text":"Columns:"},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"- `terrace_id` - label of the restored terrace that the sampling plot sits on,"},{"end_column":62,"end_line":13,"start_column":3,"start_line":13,"text":"running from TR-01 to TR-10. Each label appears four times."},{"end_column":74,"end_line":14,"start_column":1,"start_line":14,"text":"- `treatment` - `biochar` if that terrace received the topsoil amendment,"},{"end_column":77,"end_line":15,"start_column":3,"start_line":15,"text":"`none` if it did not. The treatment was applied to whole terraces, so this"},{"end_column":53,"end_line":16,"start_column":3,"start_line":16,"text":"value is the same for all four plots on a terrace."},{"end_column":76,"end_line":17,"start_column":1,"start_line":17,"text":"- `plot_code` - which of the four marked sampling plots on that terrace was"},{"end_column":19,"end_line":18,"start_column":3,"start_line":18,"text":"read (P1 to P4)."},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"- `infiltration_mm_per_h` - the steady-state infiltration rate at that plot, in"},{"end_column":24,"end_line":20,"start_column":3,"start_line":20,"text":"millimetres per hour."},{"end_column":99,"end_line":22,"start_column":1,"start_line":22,"text":"One row is: one double-ring infiltrometer reading taken at one marked sampling plot on one terrace"},{"end_column":36,"end_line":23,"start_column":1,"start_line":23,"text":"Independent unit column: terrace_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:be612672ce4622ef78f2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2b88fe97bb4a17d1440cd70fa4f72ef019b9431a5598d4edef590dd732af628e","end_line":23,"locator":"data-description.md:1-23","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:5c12dd4ea4e6404d9783cccc42affbf4","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"Ten restored hillside terraces in the Kalu catchment were surveyed after two wet"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"seasons. Five terraces had received a biochar topsoil amendment; five received"},{"end_column":72,"end_line":7,"start_column":1,"start_line":7,"text":"none. Field crews recorded steady-state infiltration with a double-ring"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"infiltrometer at four sampling plots on every terrace. This report asks whether"},{"end_column":54,"end_line":9,"start_column":1,"start_line":9,"text":"amended plots infiltrate faster than unamended plots."},{"end_column":48,"end_line":13,"start_column":1,"start_line":13,"text":"- Sampling plots read from `data/input.csv`: 40"},{"end_column":51,"end_line":14,"start_column":1,"start_line":14,"text":"- Biochar plots: 20, mean 63.00 mm/h, SD 6.24 mm/h"},{"end_column":53,"end_line":15,"start_column":1,"start_line":15,"text":"- Unamended plots: 20, mean 50.00 mm/h, SD 4.70 mm/h"},{"end_column":51,"end_line":16,"start_column":1,"start_line":16,"text":"- Mean difference (biochar minus none): 13.00 mm/h"},{"end_column":76,"end_line":20,"start_column":1,"start_line":20,"text":"Each of the 40 plot measurements was entered as one observation and the two"},{"end_column":62,"end_line":21,"start_column":1,"start_line":21,"text":"treatment groups were compared with a Welch two-sample t-test"},{"end_column":57,"end_line":22,"start_column":1,"start_line":22,"text":"(`scipy.stats.ttest_ind`, `equal_var=False`), two-sided."},{"end_column":17,"end_line":26,"start_column":1,"start_line":26,"text":"- Welch t = 7.44"},{"end_column":41,"end_line":27,"start_column":1,"start_line":27,"text":"- Approximate degrees of freedom = 35.31"},{"end_column":31,"end_line":28,"start_column":1,"start_line":28,"text":"- Two-sided p-value: p < 0.001"},{"end_column":206,"end_line":30,"start_column":1,"start_line":30,"text":"[selected-result] Welch two-sample t-test on 40 plot infiltration measurements: biochar-amended plots averaged 13.00 mm/h higher than unamended plots (63.00 vs 50.00 mm/h), t = 7.44, df = 35.31, p < 0.001."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:816c3b61f6262c5f4d15","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:487ba72a36655550c7aa3903e80784dc186406598e6c178b550ef37eb95ee5a1","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

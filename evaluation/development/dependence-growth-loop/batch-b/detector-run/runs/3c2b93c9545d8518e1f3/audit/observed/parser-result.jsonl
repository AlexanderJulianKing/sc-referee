{"audit_run_id":"audit:3edecdd6c95f4d7688d3472450f8c870","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":54,"end_line":1,"start_column":1,"start_line":1,"text":"Kessel Glacier ablation-stake survey (data/input.csv)"},{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Over one week in late July, a two-person field team drilled eight aluminium"},{"end_column":78,"end_line":4,"start_column":1,"start_line":4,"text":"stakes into the bare-ice zone of Kessel Glacier: four on a north-facing bench"},{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"and four on the south-facing flank across the valley. Every morning for six"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"mornings the team measured how far the ice surface had dropped below the collar"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"of each stake since the previous morning, and logged the shaded air temperature"},{"end_column":43,"end_line":8,"start_column":1,"start_line":8,"text":"at the stake at the moment of the reading."},{"end_column":141,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one morning melt reading at one ablation stake, that is, the surface lowering measured at that stake over the preceding 24 hours"},{"end_column":34,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: stake_id"},{"end_column":8,"end_line":13,"start_column":1,"start_line":13,"text":"Columns"},{"end_column":78,"end_line":14,"start_column":1,"start_line":14,"text":"- stake_id: label of the ablation stake the reading came from. The same eight"},{"end_column":74,"end_line":15,"start_column":3,"start_line":15,"text":"stakes are revisited, so each label appears on all six survey mornings."},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"- slope_aspect: whether the stake sits on the north-facing or the south-facing"},{"end_column":47,"end_line":17,"start_column":3,"start_line":17,"text":"side of the valley. Fixed for a given stake."},{"end_column":74,"end_line":18,"start_column":1,"start_line":18,"text":"- survey_day: survey morning, numbered 1 to 6 from the start of the week."},{"end_column":76,"end_line":19,"start_column":1,"start_line":19,"text":"- ablation_mm: surface lowering in millimetres over the preceding 24 hours."},{"end_column":78,"end_line":20,"start_column":1,"start_line":20,"text":"- air_temp_c: shaded air temperature in degrees Celsius at the stake when the"},{"end_column":21,"end_line":21,"start_column":3,"start_line":21,"text":"reading was taken."},{"end_column":80,"end_line":23,"start_column":1,"start_line":23,"text":"The stakes were placed once and left in the ice for the whole week; nothing was"},{"end_column":32,"end_line":24,"start_column":1,"start_line":24,"text":"re-randomised between mornings."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:58b0c9fd75a376d296e9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:3cc7a77e179ab6f9f3bc4fc989e1c4fc9275ab93b8274f95c9f782220d66d36e","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3edecdd6c95f4d7688d3472450f8c870","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"Table `data/input.csv` holds 48 melt readings taken with a folding rule at"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"ablation stakes drilled into the glacier surface. Each reading gives the"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"surface lowering `ablation_mm` measured on one survey day, together with the"},{"end_column":39,"end_line":8,"start_column":1,"start_line":8,"text":"aspect of the slope the stake sits on."},{"end_column":57,"end_line":10,"start_column":1,"start_line":10,"text":"| slope_aspect | n | mean ablation_mm | sd ablation_mm |"},{"end_column":26,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- | --- | --- |"},{"end_column":32,"end_line":12,"start_column":1,"start_line":12,"text":"| north | 24 | 12.000 | 2.513 |"},{"end_column":32,"end_line":13,"start_column":1,"start_line":13,"text":"| south | 24 | 21.500 | 3.367 |"},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"Welch's two-sample t-test (two-sided, unequal variances) on `ablation_mm`,"},{"end_column":78,"end_line":18,"start_column":1,"start_line":18,"text":"contrasting south-facing against north-facing readings. Each row of the table"},{"end_column":78,"end_line":19,"start_column":1,"start_line":19,"text":"supplied one observation to the test, so the two samples held 24 values each."},{"end_column":227,"end_line":23,"start_column":1,"start_line":23,"text":"[selected-result] Welch's two-sample t-test on 48 stake-day readings gives mean ablation_mm of 21.500 mm on south-facing slopes against 12.000 mm on north-facing slopes, a gap of 9.500 mm (t = 11.079, df = 42.554, p < 0.0001)."},{"end_column":80,"end_line":25,"start_column":1,"start_line":25,"text":"The melt gap of 9.500 mm per day between the two aspects is far larger than the"},{"end_column":64,"end_line":26,"start_column":1,"start_line":26,"text":"spread within either group (sd 3.367 mm south, 2.513 mm north)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:90044da6daadfad4635b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:f9ce0fbb2b23711e73cc0d81d69a895d7da5f03b12d08a8204326fc2a55ce498","end_line":26,"locator":"results/report.md:1-26","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

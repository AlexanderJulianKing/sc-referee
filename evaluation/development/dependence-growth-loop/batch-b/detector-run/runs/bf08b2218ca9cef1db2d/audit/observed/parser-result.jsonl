{"audit_run_id":"audit:229e13ae90c240368d346f8876771c6e","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Twenty-four drained upland peat basins were surveyed once each during the 2025"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"growing season as part of a rewetting programme. Twelve of the basins had their"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"drainage ditches dammed with peat blocks before the survey; the other twelve"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"were left with their ditches open. A surveyor walked each basin a single time"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"and recorded whether Sphagnum moss had re-established across the basin floor,"},{"end_column":60,"end_line":8,"start_column":1,"start_line":8,"text":"along with the basin's mapped area and its mean peat depth."},{"end_column":134,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one drained peat basin, surveyed a single time, with its ditch treatment and its yes/no Sphagnum re-establishment outcome"},{"end_column":34,"end_line":12,"start_column":1,"start_line":12,"text":"Independent unit column: basin_id"},{"end_column":8,"end_line":14,"start_column":1,"start_line":14,"text":"Columns"},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"- basin_id: the survey code for the basin. Every code appears exactly once, so"},{"end_column":49,"end_line":17,"start_column":3,"start_line":17,"text":"the file has as many rows as there are basins."},{"end_column":70,"end_line":18,"start_column":1,"start_line":18,"text":"- catchment: the named catchment the basin sits in. Descriptive only."},{"end_column":81,"end_line":19,"start_column":1,"start_line":19,"text":"- ditch_treatment: \"blocked\" if the drainage ditches were dammed, \"open\" if they"},{"end_column":80,"end_line":20,"start_column":3,"start_line":20,"text":"were not. The treatment applies to the whole basin and does not change within"},{"end_column":11,"end_line":21,"start_column":3,"start_line":21,"text":"a basin."},{"end_column":55,"end_line":22,"start_column":1,"start_line":22,"text":"- basin_area_ha: mapped area of the basin in hectares."},{"end_column":67,"end_line":23,"start_column":1,"start_line":23,"text":"- peat_depth_cm: mean peat depth across the basin, in centimetres."},{"end_column":78,"end_line":24,"start_column":1,"start_line":24,"text":"- sphagnum_reestablished: \"yes\" or \"no\", the single outcome recorded for that"},{"end_column":33,"end_line":25,"start_column":3,"start_line":25,"text":"basin at its one survey visit."},{"end_column":80,"end_line":27,"start_column":1,"start_line":27,"text":"Because every basin contributes exactly one row and no basin was visited twice,"},{"end_column":79,"end_line":28,"start_column":1,"start_line":28,"text":"the rows can be treated as independent observations, and the yes/no counts can"},{"end_column":73,"end_line":29,"start_column":1,"start_line":29,"text":"go straight into a two-by-two comparison of blocked against open basins."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ddf75e360f192259ede2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8b79742e6a2ff02a3d0205725d6030e80f2a517f81e9c1784842d68e5442843a","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:229e13ae90c240368d346f8876771c6e","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one drained peat basin surveyed once in the"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"2025 growing season. Basins are the independent units: 24 basins, 24 rows,"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"and no basin appears twice. Ditch treatment was fixed for the whole basin, so"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"each basin contributes a single yes/no outcome to a single cell of the table."},{"end_column":101,"end_line":12,"start_column":1,"start_line":12,"text":"| Ditch treatment | Basins | Re-established | Proportion | Mean area (ha) | Median peat depth (cm) |"},{"end_column":38,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- | --- | --- | --- |"},{"end_column":45,"end_line":14,"start_column":1,"start_line":14,"text":"| blocked | 12 | 9 | 0.750 | 14.58 | 207.5 |"},{"end_column":42,"end_line":15,"start_column":1,"start_line":15,"text":"| open | 12 | 3 | 0.250 | 14.25 | 207.5 |"},{"end_column":71,"end_line":19,"start_column":1,"start_line":19,"text":"Fisher's exact test (two-sided) on the 2x2 table of ditch treatment by"},{"end_column":76,"end_line":20,"start_column":1,"start_line":20,"text":"Sphagnum re-establishment. Fisher's exact test was chosen over a chi-square"},{"end_column":53,"end_line":21,"start_column":1,"start_line":21,"text":"test because several expected cell counts are small."},{"end_column":76,"end_line":23,"start_column":1,"start_line":23,"text":"Contingency table (rows: blocked, open; columns: yes, no): [[9, 3], [3, 9]]"},{"end_column":27,"end_line":25,"start_column":1,"start_line":25,"text":"- Sample odds ratio: 9.000"},{"end_column":28,"end_line":26,"start_column":1,"start_line":26,"text":"- Two-sided p-value: 0.0391"},{"end_column":46,"end_line":27,"start_column":1,"start_line":27,"text":"- Risk difference (blocked minus open): 0.500"},{"end_column":263,"end_line":31,"start_column":1,"start_line":31,"text":"[selected-result] Fisher's exact test on 24 independent peat basins: Sphagnum re-established in 9 of 12 basins with blocked ditches versus 3 of 12 basins with open ditches (sample odds ratio 9.000, two-sided p = 0.0391), a significant difference at alpha = 0.05."},{"end_column":75,"end_line":35,"start_column":1,"start_line":35,"text":"Basin area and peat depth are reported only as descriptive balance checks;"},{"end_column":35,"end_line":36,"start_column":1,"start_line":36,"text":"neither was entered into the test."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:356e243efddabefa78af","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:78b8531d4186ae25bcddcff9879cba7a9c63a76c3f952414c4465718ec3c6214","end_line":36,"locator":"results/report.md:1-36","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

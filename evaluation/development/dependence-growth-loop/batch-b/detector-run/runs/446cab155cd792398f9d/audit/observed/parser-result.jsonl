{"audit_run_id":"audit:3938772e60174e899cfa2ed1bf512097","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Eight bioretention cells built as part of the Fernbrook stormwater retrofit"},{"end_column":73,"end_line":4,"start_column":1,"start_line":4,"text":"were monitored through the 2024 wet season. Every cell has an underdrain"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"sampling port, and a grab sample of the cell's effluent was collected during"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"each of three monitored storms (S1 on 2024-05-14, S2 on 2024-07-02, and S3 on"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"2024-09-19). Each cell therefore contributes three samples to the file, and"},{"end_column":55,"end_line":8,"start_column":1,"start_line":8,"text":"the same eight cells reappear across the three storms."},{"end_column":9,"end_line":10,"start_column":1,"start_line":10,"text":"Columns:"},{"end_column":168,"end_line":12,"start_column":1,"start_line":12,"text":"- cell_id: label of the bioretention cell the sample came from, BR-01 through BR-08. Each cell is a separate structure with its own soil column, planting and drainage."},{"end_column":141,"end_line":13,"start_column":1,"start_line":13,"text":"- storm_id: label of the monitored storm during which the sample was taken (S1, S2 or S3). The same three storms were sampled at every cell."},{"end_column":44,"end_line":14,"start_column":1,"start_line":14,"text":"- sample_date: calendar date of that storm."},{"end_column":185,"end_line":15,"start_column":1,"start_line":15,"text":"- media_mix: filter media blend installed in the cell, either sand-compost or sand-biochar. This is a fixed property of the cell, so it repeats across all three of that cell's samples."},{"end_column":141,"end_line":16,"start_column":1,"start_line":16,"text":"- antecedent_dry_days: whole days without measurable rainfall before the storm, recorded at the site rain gauge that serves all eight cells."},{"end_column":114,"end_line":17,"start_column":1,"start_line":17,"text":"- effluent_tp_mgl: total phosphorus concentration measured in that effluent grab sample, in milligrams per litre."},{"end_column":70,"end_line":19,"start_column":1,"start_line":19,"text":"The interim discharge target used by the pilot is 0.100 mg/L of total"},{"end_column":69,"end_line":20,"start_column":1,"start_line":20,"text":"phosphorus; a sample is spoken of as an exceedance when its measured"},{"end_column":44,"end_line":21,"start_column":1,"start_line":21,"text":"concentration is strictly above that value."},{"end_column":109,"end_line":23,"start_column":1,"start_line":23,"text":"One row is: one storm-event effluent grab sample taken from one bioretention cell during one monitored storm"},{"end_column":33,"end_line":24,"start_column":1,"start_line":24,"text":"Independent unit column: cell_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:2fe8ba07090e252fc5e2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:69c3ee6861f463d0c08c40b2f160dbdc10f1f79070b6cdbac0db95a233e13903","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3938772e60174e899cfa2ed1bf512097","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":70,"end_line":5,"start_column":1,"start_line":5,"text":"Each record in `data/input.csv` is one storm-event grab sample of the"},{"end_column":71,"end_line":6,"start_column":1,"start_line":6,"text":"effluent leaving one bioretention cell. A record carries the cell, the"},{"end_column":71,"end_line":7,"start_column":1,"start_line":7,"text":"sampled storm, the cell's filter media mix, the antecedent dry period,"},{"end_column":57,"end_line":8,"start_column":1,"start_line":8,"text":"and the effluent total phosphorus concentration in mg/L."},{"end_column":23,"end_line":10,"start_column":1,"start_line":10,"text":"- Records analysed: 24"},{"end_column":23,"end_line":11,"start_column":1,"start_line":11,"text":"- Cells represented: 8"},{"end_column":24,"end_line":12,"start_column":1,"start_line":12,"text":"- Storms represented: 3"},{"end_column":59,"end_line":13,"start_column":1,"start_line":13,"text":"- Interim discharge target: 0.100 mg/L; a record counts as"},{"end_column":68,"end_line":14,"start_column":3,"start_line":14,"text":"an exceedance when its concentration is strictly above the target"},{"end_column":46,"end_line":15,"start_column":1,"start_line":15,"text":"- Mean effluent total phosphorus: 0.1458 mg/L"},{"end_column":52,"end_line":16,"start_column":1,"start_line":16,"text":"- Records above the target: 18 of 24 (share 0.7500)"},{"end_column":33,"end_line":18,"start_column":1,"start_line":18,"text":"Records and exceedances by cell:"},{"end_column":48,"end_line":20,"start_column":1,"start_line":20,"text":"| cell_id | media_mix | records | exceedances |"},{"end_column":26,"end_line":21,"start_column":1,"start_line":21,"text":"| --- | --- | --- | --- |"},{"end_column":33,"end_line":22,"start_column":1,"start_line":22,"text":"| BR-01 | sand-compost | 3 | 3 |"},{"end_column":33,"end_line":23,"start_column":1,"start_line":23,"text":"| BR-02 | sand-compost | 3 | 0 |"},{"end_column":33,"end_line":24,"start_column":1,"start_line":24,"text":"| BR-03 | sand-biochar | 3 | 3 |"},{"end_column":33,"end_line":25,"start_column":1,"start_line":25,"text":"| BR-04 | sand-biochar | 3 | 3 |"},{"end_column":33,"end_line":26,"start_column":1,"start_line":26,"text":"| BR-05 | sand-biochar | 3 | 0 |"},{"end_column":33,"end_line":27,"start_column":1,"start_line":27,"text":"| BR-06 | sand-compost | 3 | 3 |"},{"end_column":33,"end_line":28,"start_column":1,"start_line":28,"text":"| BR-07 | sand-biochar | 3 | 3 |"},{"end_column":33,"end_line":29,"start_column":1,"start_line":29,"text":"| BR-08 | sand-compost | 3 | 3 |"},{"end_column":73,"end_line":33,"start_column":1,"start_line":33,"text":"Every record in the file was supplied as one trial to an exact two-sided"},{"end_column":70,"end_line":34,"start_column":1,"start_line":34,"text":"binomial test (`scipy.stats.binomtest`) of the null hypothesis that a"},{"end_column":57,"end_line":35,"start_column":1,"start_line":35,"text":"record exceeds the target with probability 0.5, that is,"},{"end_column":73,"end_line":36,"start_column":1,"start_line":36,"text":"that exceedance and compliance are equally likely for a record. The test"},{"end_column":63,"end_line":37,"start_column":1,"start_line":37,"text":"statistic is the number of records above the target, 18 out of"},{"end_column":11,"end_line":38,"start_column":1,"start_line":38,"text":"24 trials."},{"end_column":49,"end_line":42,"start_column":1,"start_line":42,"text":"The observed exceedance share is 0.7500 (18/24),"},{"end_column":56,"end_line":43,"start_column":1,"start_line":43,"text":"against the benchmark share of 0.5. The exact two-sided"},{"end_column":61,"end_line":44,"start_column":1,"start_line":44,"text":"binomial p-value is 0.0227. At the 5% level the record-level"},{"end_column":66,"end_line":45,"start_column":1,"start_line":45,"text":"exceedance share is therefore distinguishable from the break-even"},{"end_column":60,"end_line":46,"start_column":1,"start_line":46,"text":"benchmark, with exceedances outnumbering compliant records."},{"end_column":225,"end_line":48,"start_column":1,"start_line":48,"text":"[selected-result] Exact two-sided binomial test of record-level exceedance of the 0.100 mg/L interim total phosphorus target: 18 of 24 records exceeded (share 0.7500) against a null exceedance probability of 0.5; p = 0.0227."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:f7227e7ad27a625ec573","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:8a7488152b65d14662f44e20f4901a53b09cd04c3e9eef63e2957f6fa9f101c6","end_line":48,"locator":"results/report.md:1-48","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

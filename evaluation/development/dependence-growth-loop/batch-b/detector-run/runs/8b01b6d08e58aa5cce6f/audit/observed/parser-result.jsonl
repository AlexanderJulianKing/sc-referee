{"audit_run_id":"audit:8a6b7fcc36394359bef9dce2017ee5e0","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Every record comes from one bumblebee (Bombus terrestris) microcolony. Each"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"microcolony was bought as a separate unit, housed in its own rearing box on its"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"own food supply, and watched until its first male (drone) appeared. Nothing was"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"measured twice: a colony was scored on the single day its first drone emerged"},{"end_column":81,"end_line":7,"start_column":1,"start_line":7,"text":"and then left the study. So each colony contributes exactly one number and shows"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"up exactly once in the file, and colonies do not share boxes, mothers, or"},{"end_column":26,"end_line":9,"start_column":1,"start_line":9,"text":"batches with one another."},{"end_column":96,"end_line":11,"start_column":1,"start_line":11,"text":"One row is: one bumblebee microcolony, scored a single time at the emergence of its first drone"},{"end_column":35,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: colony_id"},{"end_column":17,"end_line":15,"start_column":1,"start_line":15,"text":"The columns are:"},{"end_column":78,"end_line":17,"start_column":1,"start_line":17,"text":"- colony_id: the label of the microcolony; every label occurs exactly once in"},{"end_column":11,"end_line":18,"start_column":3,"start_line":18,"text":"the file"},{"end_column":77,"end_line":19,"start_column":1,"start_line":19,"text":"- founding_queen_age_days: how old the founding queen was, in days, when the"},{"end_column":20,"end_line":20,"start_column":3,"start_line":20,"text":"colony was set up"},{"end_column":70,"end_line":21,"start_column":1,"start_line":21,"text":"- initial_worker_count: how many workers were in the box at the start"},{"end_column":75,"end_line":22,"start_column":1,"start_line":22,"text":"- pollen_consumed_g: grams of pollen the colony ate before its first drone"},{"end_column":10,"end_line":23,"start_column":3,"start_line":23,"text":"emerged"},{"end_column":77,"end_line":24,"start_column":1,"start_line":24,"text":"- days_to_first_drone: whole days from setup until the first drone was seen;"},{"end_column":31,"end_line":25,"start_column":3,"start_line":25,"text":"this is the measured outcome"},{"end_column":78,"end_line":27,"start_column":1,"start_line":27,"text":"The value of 30 days used as a comparison point is the emergence day recorded"},{"end_column":79,"end_line":28,"start_column":1,"start_line":28,"text":"earlier for this commercial stock. It is a fixed reference number that was set"},{"end_column":74,"end_line":29,"start_column":1,"start_line":29,"text":"before these colonies were reared, not something computed from this file."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c3c26fb8f8e8b9609da2","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:0d937721f4bf042f327f476e4c1ac0770d967a4bccc42989cc1dd64bd0a136f7","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:8a6b7fcc36394359bef9dce2017ee5e0","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"The 20 commercially sourced *Bombus terrestris* microcolonies in this data set"},{"end_column":76,"end_line":6,"start_column":1,"start_line":6,"text":"were reared in separate boxes and scored once each, at the emergence of the"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"first drone. Every colony appears in exactly one row (20 rows, 20 distinct"},{"end_column":73,"end_line":8,"start_column":1,"start_line":8,"text":"colony identifiers), so the unit of measurement and the unit of analysis"},{"end_column":41,"end_line":9,"start_column":1,"start_line":9,"text":"coincide and no colony is counted twice."},{"end_column":81,"end_line":13,"start_column":1,"start_line":13,"text":"A colony was classified as early if its first drone emerged before the reference"},{"end_column":82,"end_line":14,"start_column":1,"start_line":14,"text":"day 30 recorded for this stock. The share of early colonies was compared with the"},{"end_column":77,"end_line":15,"start_column":1,"start_line":15,"text":"no-shift expectation of 0.5 using an exact two-sided binomial test on the 20"},{"end_column":35,"end_line":16,"start_column":1,"start_line":16,"text":"independent colony-level outcomes."},{"end_column":58,"end_line":20,"start_column":1,"start_line":20,"text":"- Colonies analysed: 20 (distinct colony identifiers: 20)"},{"end_column":63,"end_line":21,"start_column":1,"start_line":21,"text":"- Days to first drone: median 28.0, mean 27.90, range 22 to 35"},{"end_column":61,"end_line":22,"start_column":1,"start_line":22,"text":"- Early colonies (fewer than 30 days): 16 of 20, share 0.800"},{"end_column":38,"end_line":23,"start_column":1,"start_line":23,"text":"- Colonies at or past day 30: 4 of 20"},{"end_column":67,"end_line":24,"start_column":1,"start_line":24,"text":"- Exact two-sided binomial test against a share of 0.5: p = 0.0118"},{"end_column":216,"end_line":26,"start_column":1,"start_line":26,"text":"[selected-result] Drones emerged before reference day 30 in 16 of 20 independently reared colonies (share 0.800), which is more often than the no-shift expectation of 0.5 (exact two-sided binomial test, p = 0.0118)."},{"end_column":79,"end_line":30,"start_column":1,"start_line":30,"text":"The test consumes one number per colony, and each colony was reared and scored"},{"end_column":71,"end_line":31,"start_column":1,"start_line":31,"text":"on its own, so the 20 observations are the 20 independent units and no"},{"end_column":80,"end_line":32,"start_column":1,"start_line":32,"text":"within-colony replication enters the count. The result speaks only to how often"},{"end_column":64,"end_line":33,"start_column":1,"start_line":33,"text":"early emergence occurred, not to the size of the shift in days."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:44fd7e709d8da6191f33","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:d30e72b579ebe5e2363486a596e80e1a17a858b6f3ab1cfb898bf1fbb184b509","end_line":33,"locator":"results/report.md:1-33","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

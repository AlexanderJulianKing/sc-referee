{"audit_run_id":"audit:3583fdfe8e5d4683b54fa8e81ae57d73","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"A condition-monitoring team recorded 10-minute acoustic-emission windows from"},{"end_column":75,"end_line":4,"start_column":1,"start_line":4,"text":"gearboxes in an operating wind farm. Each stored window was later replayed"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"through two denoising gates: the baseline spectral gate currently deployed on"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"the fleet, and an adaptive gate under evaluation. The noise floor reached by"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"each replay was logged in decibels, together with the wind-speed band that was"},{"end_column":40,"end_line":8,"start_column":1,"start_line":8,"text":"in force while the window was recorded."},{"end_column":160,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one 10-minute acoustic-emission recording window, holding the noise floor reached by the baseline gate and by the adaptive gate on that same window"},{"end_column":36,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: gearbox_id"},{"end_column":22,"end_line":12,"start_column":1,"start_line":12,"text":"One trial is: one row"},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":74,"end_line":16,"start_column":1,"start_line":16,"text":"- `gearbox_id` - identifier of the gearbox the window came from. The same"},{"end_column":74,"end_line":17,"start_column":3,"start_line":17,"text":"gearbox contributed several windows, so this value repeats across rows."},{"end_column":55,"end_line":18,"start_column":1,"start_line":18,"text":"- `window_id` - unique label for the recording window."},{"end_column":69,"end_line":19,"start_column":1,"start_line":19,"text":"- `wind_bin` - wind-speed band during the window (low, mid or high)."},{"end_column":76,"end_line":20,"start_column":1,"start_line":20,"text":"- `baseline_floor_db` - noise floor in dB after the baseline spectral gate."},{"end_column":67,"end_line":21,"start_column":1,"start_line":21,"text":"- `adaptive_floor_db` - noise floor in dB after the adaptive gate."},{"end_column":80,"end_line":23,"start_column":1,"start_line":23,"text":"The table holds 20 windows drawn from 6 gearboxes, so the windows are clustered"},{"end_column":42,"end_line":24,"start_column":1,"start_line":24,"text":"within a much smaller number of machines."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:7351297859798dfef159","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2db6060da4a2044c0679c9ae35cb5998f5671a0f17ffa6eca48f98ad006bb8d9","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3583fdfe8e5d4683b54fa8e81ae57d73","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":33,"end_line":5,"start_column":1,"start_line":5,"text":"- Source table: `data/input.csv`"},{"end_column":33,"end_line":6,"start_column":1,"start_line":6,"text":"- Recording windows analysed: 20"},{"end_column":27,"end_line":7,"start_column":1,"start_line":7,"text":"- Gearboxes represented: 6"},{"end_column":40,"end_line":8,"start_column":1,"start_line":8,"text":"- Wind bins represented: low, mid, high"},{"end_column":71,"end_line":12,"start_column":1,"start_line":12,"text":"Each 10-minute acoustic-emission window was processed twice, once with"},{"end_column":64,"end_line":13,"start_column":1,"start_line":13,"text":"the baseline spectral gate and once with the adaptive gate. The"},{"end_column":59,"end_line":14,"start_column":1,"start_line":14,"text":"noise-floor reduction for a window is `baseline_floor_db -"},{"end_column":72,"end_line":15,"start_column":1,"start_line":15,"text":"adaptive_floor_db`, so a positive value means the adaptive gate reached"},{"end_column":62,"end_line":16,"start_column":1,"start_line":16,"text":"the lower floor. Every window in the table was entered as one"},{"end_column":59,"end_line":17,"start_column":1,"start_line":17,"text":"independent trial in an exact two-sided binomial sign test"},{"end_column":72,"end_line":18,"start_column":1,"start_line":18,"text":"(`scipy.stats.binomtest`) against the null hypothesis that the adaptive"},{"end_column":34,"end_line":19,"start_column":1,"start_line":19,"text":"gate wins in half of the windows."},{"end_column":76,"end_line":23,"start_column":1,"start_line":23,"text":"- Windows where the adaptive gate reached the lower floor: 15 of 20 (0.750)"},{"end_column":28,"end_line":24,"start_column":1,"start_line":24,"text":"- Median reduction: 1.40 dB"},{"end_column":26,"end_line":25,"start_column":1,"start_line":25,"text":"- Mean reduction: 1.03 dB"},{"end_column":43,"end_line":26,"start_column":1,"start_line":26,"text":"- Exact two-sided binomial p-value: 0.0414"},{"end_column":276,"end_line":28,"start_column":1,"start_line":28,"text":"[selected-result] Exact two-sided binomial sign test over 20 recording windows entered as independent trials: the adaptive gate reached the lower noise floor in 15 of 20 windows (share 0.750, median reduction 1.40 dB), p = 0.0414, so the 50% null is rejected at alpha = 0.05."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:8c6cfe46f04d7599c72d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2cc7c5ee5b51d4f742eb9aa9901a2704c248a7baa41505b47adf6e9474ad62bf","end_line":28,"locator":"results/report.md:1-28","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:ad7e2621dc864c30bb46641b02a88943","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":72,"end_line":3,"start_column":1,"start_line":3,"text":"The Karhusuo peat complex has twelve permanent monitoring plots: six in"},{"end_column":67,"end_line":4,"start_column":1,"start_line":4,"text":"the sector that was drained by ditches decades ago, and six in the"},{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"sector where the ditches were blocked and the water table was allowed to"},{"end_column":63,"end_line":6,"start_column":1,"start_line":6,"text":"recover. Each plot has a fixed steel collar set into the peat."},{"end_column":68,"end_line":8,"start_column":1,"start_line":8,"text":"During the 2024 growing season a field crew visited every plot five"},{"end_column":68,"end_line":9,"start_column":1,"start_line":9,"text":"times. On each visit a static closed chamber was seated on the plot"},{"end_column":71,"end_line":10,"start_column":1,"start_line":10,"text":"collar, the headspace was sampled over half an hour, and the resulting"},{"end_column":71,"end_line":11,"start_column":1,"start_line":11,"text":"methane flux was written down together with the air temperature inside"},{"end_column":72,"end_line":12,"start_column":1,"start_line":12,"text":"the chamber. Twelve plots visited five times each gives 60 lines in the"},{"end_column":7,"end_line":13,"start_column":1,"start_line":13,"text":"table."},{"end_column":9,"end_line":15,"start_column":1,"start_line":15,"text":"Columns:"},{"end_column":73,"end_line":17,"start_column":1,"start_line":17,"text":"- plot_id: label of the permanent monitoring plot (DR-01 to DR-06 in the"},{"end_column":72,"end_line":18,"start_column":3,"start_line":18,"text":"drained sector, RW-01 to RW-06 in the rewetted sector); the same plot"},{"end_column":34,"end_line":19,"start_column":3,"start_line":19,"text":"reappears once per survey round"},{"end_column":67,"end_line":20,"start_column":1,"start_line":20,"text":"- water_table_regime: which sector the plot belongs to, drained or"},{"end_column":11,"end_line":21,"start_column":3,"start_line":21,"text":"rewetted"},{"end_column":73,"end_line":22,"start_column":1,"start_line":22,"text":"- survey_round: which of the five seasonal visits the reading comes from"},{"end_column":45,"end_line":23,"start_column":3,"start_line":23,"text":"(1 = early May through 5 = late September)"},{"end_column":64,"end_line":24,"start_column":1,"start_line":24,"text":"- chamber_temp_c: air temperature inside the chamber during the"},{"end_column":34,"end_line":25,"start_column":3,"start_line":25,"text":"measurement, in degrees Celsius"},{"end_column":65,"end_line":26,"start_column":1,"start_line":26,"text":"- ch4_flux_mg_m2_h: methane flux for that chamber deployment, in"},{"end_column":46,"end_line":27,"start_column":3,"start_line":27,"text":"milligrams of CH4 per square metre per hour"},{"end_column":131,"end_line":29,"start_column":1,"start_line":29,"text":"One row is: one static-chamber methane flux measurement taken on one monitoring plot during one of the five seasonal survey rounds"},{"end_column":33,"end_line":30,"start_column":1,"start_line":30,"text":"Independent unit column: plot_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e77b579a6ce078fdf755","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:a2f4b9cafb0bbf1f065a286360f676dbbe2087e0483a32c6ae4ac4515be1d492","end_line":30,"locator":"data-description.md:1-30","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:ad7e2621dc864c30bb46641b02a88943","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":70,"end_line":5,"start_column":1,"start_line":5,"text":"Static closed-chamber CH4 flux was logged in the drained and rewetted"},{"end_column":67,"end_line":6,"start_column":1,"start_line":6,"text":"sectors of the Karhusuo peat complex over the 2024 growing season."},{"end_column":72,"end_line":8,"start_column":1,"start_line":8,"text":"| water table regime | measurements | mean CH4 flux (mg m-2 h-1) | SD |"},{"end_column":29,"end_line":9,"start_column":1,"start_line":9,"text":"| --- | ---: | ---: | ---: |"},{"end_column":32,"end_line":10,"start_column":1,"start_line":10,"text":"| drained | 30 | 4.25 | 0.880 |"},{"end_column":34,"end_line":11,"start_column":1,"start_line":11,"text":"| rewetted | 30 | 10.25 | 0.880 |"},{"end_column":64,"end_line":15,"start_column":1,"start_line":15,"text":"Two-sample Student t-test (pooled variance) on the chamber flux"},{"end_column":36,"end_line":16,"start_column":1,"start_line":16,"text":"readings, rewetted against drained."},{"end_column":209,"end_line":18,"start_column":1,"start_line":18,"text":"[selected-result] Rewetted chamber flux exceeds drained by 6.00 mg m-2 h-1 (rewetted mean 10.25, drained mean 4.25); two-sample Student t-test on the 60 individual chamber readings, t(58) = 26.40, p < 0.0001."},{"end_column":70,"end_line":22,"start_column":1,"start_line":22,"text":"The pooled-variance form was kept because the two sector spreads were"},{"end_column":55,"end_line":23,"start_column":1,"start_line":23,"text":"nearly identical (SD 0.880 drained vs 0.880 rewetted)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:78e837f22a906648da29","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:1187c669c278fc8b8fddf4c3ec0b80b2782bb13f2362bac9ba99652f458502fb","end_line":23,"locator":"results/report.md:1-23","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

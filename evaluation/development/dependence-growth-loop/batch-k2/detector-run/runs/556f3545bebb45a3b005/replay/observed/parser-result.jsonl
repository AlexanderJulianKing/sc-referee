{"audit_run_id":"audit:6e9e1604ced24d5bac4259e333651550","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Five captive archerfish, each carrying a numbered tag (AR-11, AR-14, AR-22,"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"AR-27, AR-31), were tested in a covered freshwater tank. On four separate days"},{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"each fish took part in one testing session, and each session produced one"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"shooting trial, so every fish contributes four lines to the file and the file"},{"end_column":37,"end_line":7,"start_column":1,"start_line":7,"text":"holds twenty lines of data in total."},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"In a trial the fish saw two paper targets held above the water surface at the"},{"end_column":79,"end_line":10,"start_column":1,"start_line":10,"text":"same height and the same distance apart: the rewarded shape (a disc, or in the"},{"end_column":80,"end_line":11,"start_column":1,"start_line":11,"text":"later sessions a cross) and an unrewarded bar. The fish knocked one target down"},{"end_column":81,"end_line":12,"start_column":1,"start_line":12,"text":"with a jet of water, and only the target hit by its first shot was scored. A hit"},{"end_column":44,"end_line":13,"start_column":1,"start_line":13,"text":"on the rewarded shape earned a food pellet."},{"end_column":27,"end_line":15,"start_column":1,"start_line":15,"text":"Columns in data/input.csv:"},{"end_column":52,"end_line":17,"start_column":1,"start_line":17,"text":"- trial_uid: label of the individual shooting trial"},{"end_column":53,"end_line":18,"start_column":1,"start_line":18,"text":"- fish_tag: tag of the fish that performed the trial"},{"end_column":75,"end_line":19,"start_column":1,"start_line":19,"text":"- session: which of that fish's four sessions the trial came from (1 to 4)"},{"end_column":78,"end_line":20,"start_column":1,"start_line":20,"text":"- standoff_cm: horizontal distance from the fish's launch spot to the targets"},{"end_column":76,"end_line":21,"start_column":1,"start_line":21,"text":"- water_temp_c: tank water temperature during the trial, in degrees Celsius"},{"end_column":76,"end_line":22,"start_column":1,"start_line":22,"text":"- target_pair: which pair of shapes was shown (disc_vs_bar or cross_vs_bar)"},{"end_column":75,"end_line":23,"start_column":1,"start_line":23,"text":"- latency_s: seconds between showing the targets and the fish's first shot"},{"end_column":78,"end_line":24,"start_column":1,"start_line":24,"text":"- chose_target: 1 if the first shot struck the rewarded shape, 0 if it struck"},{"end_column":21,"end_line":25,"start_column":3,"start_line":25,"text":"the unrewarded bar"},{"end_column":77,"end_line":27,"start_column":1,"start_line":27,"text":"One row is: one two-choice shooting trial performed by one tagged archerfish"},{"end_column":34,"end_line":28,"start_column":1,"start_line":28,"text":"Independent unit column: fish_tag"},{"end_column":22,"end_line":29,"start_column":1,"start_line":29,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:205a3f6756dd4eb23215","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:d3b0feb9e60f59818ff45d4c4cd9a401fca11c9d6ef55f70cc850b38bcea05b3","end_line":29,"locator":"data-description.md:1-29","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:6e9e1604ced24d5bac4259e333651550","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":29,"end_line":5,"start_column":1,"start_line":5,"text":"Input file: `data/input.csv`"},{"end_column":14,"end_line":6,"start_column":1,"start_line":6,"text":"Rows read: 20"},{"end_column":21,"end_line":7,"start_column":1,"start_line":7,"text":"Fish tags present: 5"},{"end_column":29,"end_line":9,"start_column":1,"start_line":9,"text":"| fish_tag | trials | hits |"},{"end_column":20,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- |"},{"end_column":18,"end_line":11,"start_column":1,"start_line":11,"text":"| AR-11 | 4 | 4 |"},{"end_column":18,"end_line":12,"start_column":1,"start_line":12,"text":"| AR-14 | 4 | 4 |"},{"end_column":18,"end_line":13,"start_column":1,"start_line":13,"text":"| AR-22 | 4 | 3 |"},{"end_column":18,"end_line":14,"start_column":1,"start_line":14,"text":"| AR-27 | 4 | 3 |"},{"end_column":18,"end_line":15,"start_column":1,"start_line":15,"text":"| AR-31 | 4 | 1 |"},{"end_column":79,"end_line":19,"start_column":1,"start_line":19,"text":"Each row of the input file is one two-choice shooting trial, scored 1 when the"},{"end_column":79,"end_line":20,"start_column":1,"start_line":20,"text":"fish knocked down the rewarded target and 0 otherwise. All 20 rows were pooled"},{"end_column":78,"end_line":21,"start_column":1,"start_line":21,"text":"into a single sequence and entered into an exact two-sided binomial test, one"},{"end_column":80,"end_line":22,"start_column":1,"start_line":22,"text":"observation per row, of the null hypothesis that the hit probability of a trial"},{"end_column":78,"end_line":23,"start_column":1,"start_line":23,"text":"equals 0.500 (scipy.stats.binomtest, alternative \"two-sided\"). No grouping or"},{"end_column":47,"end_line":24,"start_column":1,"start_line":24,"text":"weighting of rows was applied before the test."},{"end_column":15,"end_line":28,"start_column":1,"start_line":28,"text":"Hits: 15 of 20"},{"end_column":25,"end_line":29,"start_column":1,"start_line":29,"text":"Observed hit rate: 0.750"},{"end_column":41,"end_line":30,"start_column":1,"start_line":30,"text":"Exact two-sided binomial p-value: 0.0414"},{"end_column":274,"end_line":32,"start_column":1,"start_line":32,"text":"[selected-result] Pooling all 20 trials as independent observations, the fish hit the rewarded target in 15 of 20 trials (hit rate 0.750); an exact two-sided binomial test against a chance rate of 0.500 gives p = 0.0414, so chance performance is rejected at the 0.05 level."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:fe9ebbe318131f6edd30","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:95c7c26cd65f5d6a56f02007f38b0b8f38c519c3b064fe2dbd1a2e10a9615385","end_line":32,"locator":"results/report.md:1-32","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

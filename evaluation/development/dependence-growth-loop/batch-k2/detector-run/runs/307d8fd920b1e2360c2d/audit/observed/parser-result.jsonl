{"audit_run_id":"audit:0b179978dd2840dabaf236ad3e902ff9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"This file records a 60-day grow-out trial at a marine hatchery. Twenty-four"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"juvenile Atlantic cod were tagged, weighed, and moved into twenty-four separate"},{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"flow-through chambers, one fish per chamber. Half the chambers were fed the"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"standard baseline pellet and half were fed the same pellet with an algal-oil"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"supplement, and that assignment was fixed for the whole trial. Each fish was"},{"end_column":81,"end_line":8,"start_column":1,"start_line":8,"text":"weighed once, at day 60, and that single weight is the only outcome recorded for"},{"end_column":74,"end_line":9,"start_column":1,"start_line":9,"text":"it. A fish is said to have graded out if it reached the hatchery's 12.0 g"},{"end_column":17,"end_line":10,"start_column":1,"start_line":10,"text":"transfer target."},{"end_column":146,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one juvenile Atlantic cod that was reared alone in its own flow-through chamber for the whole 60-day trial and weighed once at day 60"},{"end_column":36,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: chamber_id"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"One trial is: one row"},{"end_column":8,"end_line":16,"start_column":1,"start_line":16,"text":"Columns"},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"- chamber_id: label of the flow-through chamber, for example CH07. Because"},{"end_column":79,"end_line":18,"start_column":3,"start_line":18,"text":"exactly one fish lived in each chamber and no chamber was reused, this label"},{"end_column":57,"end_line":19,"start_column":3,"start_line":19,"text":"appears on exactly one row and so identifies the fish."},{"end_column":77,"end_line":20,"start_column":1,"start_line":20,"text":"- diet: which feed the fish received for the whole trial, either baseline or"},{"end_column":13,"end_line":21,"start_column":3,"start_line":21,"text":"algal_oil."},{"end_column":76,"end_line":22,"start_column":1,"start_line":22,"text":"- day60_mass_g: the fish's wet mass in grams at the single day-60 weighing."},{"end_column":77,"end_line":24,"start_column":1,"start_line":24,"text":"Nothing in the file is a repeated measurement: no fish was weighed more than"},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"once, no chamber held more than one fish, and no chamber contributes more than"},{"end_column":81,"end_line":26,"start_column":1,"start_line":26,"text":"one row. The twenty-four rows are therefore twenty-four independent units, which"},{"end_column":65,"end_line":27,"start_column":1,"start_line":27,"text":"is what lets a row-independent test be applied directly to them."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:159a98411c147583ffe1","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:e2a1d0f2bf4d442014ff4615dcae5e7213ed69f1f3ccce3046b060f9d13d5e6d","end_line":27,"locator":"data-description.md:1-27","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:0b179978dd2840dabaf236ad3e902ff9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one juvenile Atlantic cod held alone in its own"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"flow-through chamber for the entire 60-day trial. Chambers were stocked with one"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"fish each, fed independently, and weighed once at day 60, so `chamber_id` is"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"unique across the file and every fish contributes exactly one measurement. No"},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"fish was weighed twice and no chamber held more than one fish, so the 24 rows"},{"end_column":26,"end_line":10,"start_column":1,"start_line":10,"text":"are 24 independent units."},{"end_column":75,"end_line":14,"start_column":1,"start_line":14,"text":"The pre-specified endpoint is grade-out: whether a fish reaches the 12.0 g"},{"end_column":78,"end_line":15,"start_column":1,"start_line":15,"text":"transfer target by day 60. The 2x2 table of diet by grade-out was tested with"},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"Fisher's exact test (two-sided). Each fish supplies a single Bernoulli outcome"},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"and the cell counts are small, so an exact conditional test is the natural"},{"end_column":8,"end_line":18,"start_column":1,"start_line":18,"text":"choice."},{"end_column":77,"end_line":22,"start_column":1,"start_line":22,"text":"| Diet | Chambers | Reached 12.0 g | Grade-out rate | Mean day-60 mass (g) |"},{"end_column":32,"end_line":23,"start_column":1,"start_line":23,"text":"| --- | --- | --- | --- | --- |"},{"end_column":39,"end_line":24,"start_column":1,"start_line":24,"text":"| algal_oil | 12 | 9 | 75.0% | 12.87 |"},{"end_column":38,"end_line":25,"start_column":1,"start_line":25,"text":"| baseline | 12 | 3 | 25.0% | 11.16 |"},{"end_column":60,"end_line":27,"start_column":1,"start_line":27,"text":"Sample odds ratio (algal-oil vs. baseline grade-out): 9.000"},{"end_column":293,"end_line":29,"start_column":1,"start_line":29,"text":"[selected-result] Fisher's exact test on the 2x2 diet-by-grade-out table (n = 24 chambers, one fish per chamber): 9 of 12 algal-oil fish versus 3 of 12 baseline fish reached the 12.0 g transfer target, odds ratio 9.000, two-sided p = 0.0391, so the diets differ significantly at alpha = 0.05."},{"end_column":79,"end_line":33,"start_column":1,"start_line":33,"text":"Day-60 mass is summarised only for description; the test uses the dichotomised"},{"end_column":73,"end_line":34,"start_column":1,"start_line":34,"text":"grade-out outcome. With 12 chambers per diet the p-value is exact, so no"},{"end_column":48,"end_line":35,"start_column":1,"start_line":35,"text":"distributional assumption about mass is needed."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1d16c16b2e8138058a34","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b9eaa4567cdb4199e7e3f56ea62ddbbd112570aeef751a4afba7325c3fc5c07d","end_line":35,"locator":"results/report.md:1-35","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

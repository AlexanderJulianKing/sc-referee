{"audit_run_id":"audit:999387e00d3c4b5d92bc96a2c8687f07","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve degraded rangeland plots, each 5 m x 5 m, were seeded once in September"},{"end_column":81,"end_line":4,"start_column":1,"start_line":4,"text":"2022 with a locally cultured cyanobacterial slurry. The plots lie at least 200 m"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"apart across the same station; each plot was fenced, treated and sampled on its"},{"end_column":74,"end_line":6,"start_column":1,"start_line":6,"text":"own, so no two plots share a treatment application, a fence or a handler."},{"end_column":76,"end_line":8,"start_column":1,"start_line":8,"text":"Every plot was visited four times: immediately before seeding (the baseline"},{"end_column":82,"end_line":9,"start_column":1,"start_line":9,"text":"visit, month 0) and again 6, 12 and 18 months later. At each visit a composite of"},{"end_column":82,"end_line":10,"start_column":1,"start_line":10,"text":"ten shallow surface cores was assayed for chlorophyll a, consolidated crust cover"},{"end_column":81,"end_line":11,"start_column":1,"start_line":11,"text":"was scored inside the plot frame, and the surface temperature was read while the"},{"end_column":80,"end_line":12,"start_column":1,"start_line":12,"text":"cores were taken. The table is stored long, so the four visits to a plot appear"},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"as four separate lines carrying the same plot identifier; those four lines are"},{"end_column":76,"end_line":14,"start_column":1,"start_line":14,"text":"repeated measurements of the same patch of ground, not four separate plots."},{"end_column":75,"end_line":16,"start_column":1,"start_line":16,"text":"One row is: one monitoring visit to one restoration plot at one time point"},{"end_column":33,"end_line":17,"start_column":1,"start_line":17,"text":"Independent unit column: plot_id"},{"end_column":8,"end_line":19,"start_column":1,"start_line":19,"text":"Columns"},{"end_column":82,"end_line":20,"start_column":1,"start_line":20,"text":"- plot_id: label of the restoration plot; repeats across that plot's four visits."},{"end_column":94,"end_line":21,"start_column":1,"start_line":21,"text":"- session_label: which visit the line records (baseline, followup_1, followup_2, followup_3)."},{"end_column":87,"end_line":22,"start_column":1,"start_line":22,"text":"- months_since_inoculation: whole months between seeding and the visit (0, 6, 12, 18)."},{"end_column":56,"end_line":23,"start_column":1,"start_line":23,"text":"- survey_date: calendar date of the visit (YYYY-MM-DD)."},{"end_column":89,"end_line":24,"start_column":1,"start_line":24,"text":"- chlorophyll_a_mg_m2: areal chlorophyll a density of the crust, in mg per square metre."},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"- crust_cover_pct: percentage of the plot frame covered by consolidated crust."},{"end_column":87,"end_line":26,"start_column":1,"start_line":26,"text":"- surface_temp_c: soil surface temperature in degrees Celsius at the time of sampling."},{"end_column":80,"end_line":28,"start_column":1,"start_line":28,"text":"Anything claimed about the effect of inoculation is a statement about plots, of"},{"end_column":78,"end_line":29,"start_column":1,"start_line":29,"text":"which there are twelve; the forty-eight lines are not forty-eight independent"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"observations, so the visits belonging to a plot have to be pooled into a single"},{"end_column":75,"end_line":31,"start_column":1,"start_line":31,"text":"plot-level value before any test that assumes independent rows is applied."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c241b3558b1bf7427c44","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:43551d8b0af241dff5942705585cde95717f17427b512a3cdde5d8e54bd1176d","end_line":31,"locator":"data-description.md:1-31","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:999387e00d3c4b5d92bc96a2c8687f07","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":82,"end_line":5,"start_column":1,"start_line":5,"text":"- Long-format monitoring table: 48 plot-survey records from 12 restoration plots."},{"end_column":113,"end_line":6,"start_column":1,"start_line":6,"text":"- Every plot was surveyed 4 times: one pre-inoculation baseline plus 3 follow-up surveys at 6, 12 and 18 months."},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"- Response: areal chlorophyll a density of the soil surface crust (mg m^-2)."},{"end_column":74,"end_line":11,"start_column":1,"start_line":11,"text":"Surveys repeated on the same plot are not independent observations of the"},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"treatment, so the follow-up surveys of a plot are first averaged into a single"},{"end_column":77,"end_line":13,"start_column":1,"start_line":13,"text":"post-inoculation value. Each plot then contributes exactly one number to the"},{"end_column":28,"end_line":14,"start_column":1,"start_line":14,"text":"test, the plot-level change"},{"end_column":56,"end_line":16,"start_column":5,"start_line":16,"text":"change = mean(follow-up surveys) - baseline survey."},{"end_column":77,"end_line":18,"start_column":1,"start_line":18,"text":"The 12 plots were inoculated, tended and sampled separately and lie at least"},{"end_column":71,"end_line":19,"start_column":1,"start_line":19,"text":"200 m apart, so the plot-level changes are the independent replicates."},{"end_column":46,"end_line":23,"start_column":1,"start_line":23,"text":"| plot | baseline | follow-up mean | change |"},{"end_column":26,"end_line":24,"start_column":1,"start_line":24,"text":"| --- | --- | --- | --- |"},{"end_column":33,"end_line":25,"start_column":1,"start_line":25,"text":"| PLT-01 | 41.0 | 51.0 | +10.0 |"},{"end_column":32,"end_line":26,"start_column":1,"start_line":26,"text":"| PLT-02 | 56.0 | 62.0 | +6.0 |"},{"end_column":33,"end_line":27,"start_column":1,"start_line":27,"text":"| PLT-03 | 38.0 | 52.0 | +14.0 |"},{"end_column":32,"end_line":28,"start_column":1,"start_line":28,"text":"| PLT-04 | 63.0 | 67.0 | +4.0 |"},{"end_column":33,"end_line":29,"start_column":1,"start_line":29,"text":"| PLT-05 | 45.0 | 64.0 | +19.0 |"},{"end_column":32,"end_line":30,"start_column":1,"start_line":30,"text":"| PLT-06 | 52.0 | 61.0 | +9.0 |"},{"end_column":33,"end_line":31,"start_column":1,"start_line":31,"text":"| PLT-07 | 34.0 | 56.0 | +22.0 |"},{"end_column":32,"end_line":32,"start_column":1,"start_line":32,"text":"| PLT-08 | 59.0 | 66.0 | +7.0 |"},{"end_column":33,"end_line":33,"start_column":1,"start_line":33,"text":"| PLT-09 | 47.0 | 63.0 | +16.0 |"},{"end_column":33,"end_line":34,"start_column":1,"start_line":34,"text":"| PLT-10 | 50.0 | 61.0 | +11.0 |"},{"end_column":33,"end_line":35,"start_column":1,"start_line":35,"text":"| PLT-11 | 43.0 | 56.0 | +13.0 |"},{"end_column":33,"end_line":36,"start_column":1,"start_line":36,"text":"| PLT-12 | 55.0 | 73.0 | +18.0 |"},{"end_column":24,"end_line":38,"start_column":1,"start_line":38,"text":"All values are mg m^-2."},{"end_column":76,"end_line":42,"start_column":1,"start_line":42,"text":"Exact two-sided Wilcoxon signed-rank test on the 12 plot-level changes; the"},{"end_column":76,"end_line":43,"start_column":1,"start_line":43,"text":"null hypothesis is that the change is distributed symmetrically about zero."},{"end_column":46,"end_line":45,"start_column":1,"start_line":45,"text":"- plots analysed (one paired change each): 12"},{"end_column":43,"end_line":46,"start_column":1,"start_line":46,"text":"- plots that increased / decreased: 12 / 0"},{"end_column":30,"end_line":47,"start_column":1,"start_line":47,"text":"- mean baseline: 48.6 mg m^-2"},{"end_column":31,"end_line":48,"start_column":1,"start_line":48,"text":"- mean follow-up: 61.0 mg m^-2"},{"end_column":29,"end_line":49,"start_column":1,"start_line":49,"text":"- mean change: +12.4 mg m^-2"},{"end_column":53,"end_line":50,"start_column":1,"start_line":50,"text":"- median change: +12.0 mg m^-2 (range +4.0 to +22.0)"},{"end_column":62,"end_line":51,"start_column":1,"start_line":51,"text":"- signed-rank statistic W = 0.0, exact two-sided p = 0.000488"},{"end_column":255,"end_line":53,"start_column":1,"start_line":53,"text":"[selected-result] Crust chlorophyll a increased in 12 of 12 independently inoculated plots; the plot-level change (median +12.0 mg m^-2, mean +12.4 mg m^-2, n = 12 plots) differs from zero, exact two-sided Wilcoxon signed-rank test W = 0.0, p = 0.000488."},{"end_column":75,"end_line":57,"start_column":1,"start_line":57,"text":"The design is a before-after comparison without untreated controls, so the"},{"end_column":76,"end_line":58,"start_column":1,"start_line":58,"text":"change cannot be separated from background seasonal recovery; the follow-up"},{"end_column":76,"end_line":59,"start_column":1,"start_line":59,"text":"surveys were also averaged rather than modelled, which discards information"},{"end_column":44,"end_line":60,"start_column":1,"start_line":60,"text":"about the shape of the recovery trajectory."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:797c8ad11d74534d3a36","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:e9f2c0722f1b5c880b2f54fe1ebef03440314c0b02b6d58eea4c3561e0b58430","end_line":60,"locator":"results/report.md:1-60","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

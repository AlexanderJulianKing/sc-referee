{"audit_run_id":"audit:335f4eae13954e85a1a97430a969400a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"A coastal dune system was restored in phases between 2015 and 2022. Twenty-four"},{"end_column":71,"end_line":4,"start_column":1,"start_line":4,"text":"separate dune slacks (the damp hollows lying between dune ridges) were"},{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"re-created, each by one of two engineering methods: deep topsoil inversion,"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"which buries the nutrient-enriched surface layer and brings calcareous sand back"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"to the top, or turf stripping, which simply scrapes the enriched layer away."},{"end_column":81,"end_line":8,"start_column":1,"start_line":8,"text":"Which method a slack received was fixed by its phase contract and was not chosen"},{"end_column":17,"end_line":9,"start_column":1,"start_line":9,"text":"by the surveyor."},{"end_column":78,"end_line":11,"start_column":1,"start_line":11,"text":"In July 2025 every slack was walked once and scored for the presence of marsh"},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"helleborine, the target orchid of the scheme. A slack was scored `yes` if at"},{"end_column":81,"end_line":13,"start_column":1,"start_line":13,"text":"least one flowering spike was found anywhere inside its mapped boundary and `no`"},{"end_column":81,"end_line":14,"start_column":1,"start_line":14,"text":"otherwise. The slacks are separated by dune ridges, were restored under separate"},{"end_column":81,"end_line":15,"start_column":1,"start_line":15,"text":"contracts, and none of them was surveyed or entered twice, so each site yields a"},{"end_column":40,"end_line":16,"start_column":1,"start_line":16,"text":"single yes/no outcome and nothing more."},{"end_column":80,"end_line":20,"start_column":1,"start_line":20,"text":"- `site_id` - unique code for the slack, DS01 to DS24; appears on one row only."},{"end_column":53,"end_line":21,"start_column":1,"start_line":21,"text":"- `restoration_method` - `inversion` or `stripping`."},{"end_column":74,"end_line":22,"start_column":1,"start_line":22,"text":"- `slack_area_m2` - mapped area of the restored hollow, in square metres."},{"end_column":79,"end_line":23,"start_column":1,"start_line":23,"text":"- `years_since_works` - whole years between the restoration works and the 2025"},{"end_column":10,"end_line":24,"start_column":3,"start_line":24,"text":"survey."},{"end_column":76,"end_line":25,"start_column":1,"start_line":25,"text":"- `helleborine_present` - `yes` or `no`, the single survey outcome for that"},{"end_column":9,"end_line":26,"start_column":3,"start_line":26,"text":"slack."},{"end_column":80,"end_line":28,"start_column":1,"start_line":28,"text":"The area and age columns are recorded for context and are not used by the test."},{"end_column":64,"end_line":30,"start_column":1,"start_line":30,"text":"One row is: one restored dune slack, surveyed once in July 2025"},{"end_column":33,"end_line":31,"start_column":1,"start_line":31,"text":"Independent unit column: site_id"},{"end_column":22,"end_line":32,"start_column":1,"start_line":32,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b24d19ee29cc63782b98","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:11bbd9e99cdadb41bf708124ad489c712b065e582b03d7a83bd459613b26d1f1","end_line":32,"locator":"data-description.md:1-32","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:335f4eae13954e85a1a97430a969400a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one restored dune slack, walked once during the"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"2025 flowering season. No slack contributes more than one row, so the 24 rows"},{"end_column":68,"end_line":7,"start_column":1,"start_line":7,"text":"are 24 independent units and a row-independent test is appropriate."},{"end_column":69,"end_line":11,"start_column":1,"start_line":11,"text":"Presence or absence of marsh helleborine (*Epipactis palustris*) was"},{"end_column":78,"end_line":12,"start_column":1,"start_line":12,"text":"cross-tabulated against restoration method, and the resulting 2 x 2 table was"},{"end_column":47,"end_line":13,"start_column":1,"start_line":13,"text":"assessed with Fisher's exact test (two-sided)."},{"end_column":68,"end_line":17,"start_column":1,"start_line":17,"text":"| Restoration method | Present | Absent | Slacks | Detection rate |"},{"end_column":32,"end_line":18,"start_column":1,"start_line":18,"text":"| --- | --- | --- | --- | --- |"},{"end_column":48,"end_line":19,"start_column":1,"start_line":19,"text":"| Deep topsoil inversion | 9 | 3 | 12 | 75.0% |"},{"end_column":40,"end_line":20,"start_column":1,"start_line":20,"text":"| Turf stripping | 3 | 9 | 12 | 25.0% |"},{"end_column":51,"end_line":24,"start_column":1,"start_line":24,"text":"- Sample odds ratio (inversion vs stripping): 9.00"},{"end_column":38,"end_line":25,"start_column":1,"start_line":25,"text":"- Difference in detection rate: 0.500"},{"end_column":45,"end_line":26,"start_column":1,"start_line":26,"text":"- Fisher's exact test, two-sided: p = 0.0391"},{"end_column":301,"end_line":28,"start_column":1,"start_line":28,"text":"[selected-result] Fisher's exact test on 24 independently restored dune slacks: marsh helleborine was present at 9 of 12 inversion slacks and 3 of 12 turf-stripped slacks (sample odds ratio 9.00, two-sided p = 0.0391), a statistically significant advantage for deep topsoil inversion at the 5% level."},{"end_column":77,"end_line":32,"start_column":1,"start_line":32,"text":"With one survey per slack there is no within-site replication to inflate the"},{"end_column":80,"end_line":33,"start_column":1,"start_line":33,"text":"count of independent observations: each of the 24 sites contributes exactly one"},{"end_column":80,"end_line":34,"start_column":1,"start_line":34,"text":"Bernoulli outcome to the table. The effect is estimated from a small sample, so"},{"end_column":77,"end_line":35,"start_column":1,"start_line":35,"text":"the interval around the odds ratio is wide even though the two-sided p-value"},{"end_column":18,"end_line":36,"start_column":1,"start_line":36,"text":"falls below 0.05."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:23b1d383c6971dd26a9d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:bd0b7443bc349ceab758d9f7b7fa9e4ae50e88de5c7b4e2d2813ab319fd9cd42","end_line":36,"locator":"results/report.md:1-36","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:faa396c52c1e4e55b898d467172eaac5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve tagged colonies of the massive coral *Porites lobata* were surveyed in a"},{"end_column":74,"end_line":4,"start_column":1,"start_line":4,"text":"single week: six colonies in the sheltered lagoon and six on the adjacent"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"forereef slope. Divers chipped four small nubbins (finger-sized fragments) off"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"each tagged colony, always from the upper, light-exposed surface. Each nubbin"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"was airbrushed in the field lab and its Symbiodiniaceae (endosymbiont) cells"},{"end_column":76,"end_line":8,"start_column":1,"start_line":8,"text":"were counted on a haemocytometer, then scaled to the nubbin's surface area."},{"end_column":77,"end_line":9,"start_column":1,"start_line":9,"text":"The question of interest is whether lagoon colonies host denser endosymbiont"},{"end_column":36,"end_line":10,"start_column":1,"start_line":10,"text":"populations than forereef colonies."},{"end_column":122,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one nubbin chipped from a tagged coral colony, together with the endosymbiont density counted for that nubbin"},{"end_column":35,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: colony_id"},{"end_column":8,"end_line":15,"start_column":1,"start_line":15,"text":"Columns"},{"end_column":73,"end_line":17,"start_column":1,"start_line":17,"text":"- `colony_id`: tag code of the coral colony the nubbin came from. Twelve"},{"end_column":76,"end_line":18,"start_column":3,"start_line":18,"text":"colonies were tagged (LG-01 to LG-06 in the lagoon, FR-01 to FR-06 on the"},{"end_column":77,"end_line":19,"start_column":3,"start_line":19,"text":"forereef) and each one supplied four nubbins, so each code appears on four"},{"end_column":8,"end_line":20,"start_column":3,"start_line":20,"text":"rows."},{"end_column":79,"end_line":21,"start_column":1,"start_line":21,"text":"- `reef_zone`: habitat of the colony, either `lagoon` or `forereef`. This is a"},{"end_column":74,"end_line":22,"start_column":3,"start_line":22,"text":"property of the colony, so it is identical across a colony's four rows."},{"end_column":78,"end_line":23,"start_column":1,"start_line":23,"text":"- `nubbin_code`: label of the individual nubbin within its colony (N1 to N4)."},{"end_column":77,"end_line":24,"start_column":1,"start_line":24,"text":"- `depth_m`: water depth of the tagged colony in metres. Also a colony-level"},{"end_column":48,"end_line":25,"start_column":3,"start_line":25,"text":"property, repeated on the colony's four rows."},{"end_column":77,"end_line":26,"start_column":1,"start_line":26,"text":"- `symbiont_density_e6_per_cm2`: endosymbiont cells per square centimetre of"},{"end_column":77,"end_line":27,"start_column":3,"start_line":27,"text":"nubbin surface, expressed in millions of cells. This is the only genuinely"},{"end_column":31,"end_line":28,"start_column":3,"start_line":28,"text":"nubbin-specific measurement."},{"end_column":79,"end_line":30,"start_column":1,"start_line":30,"text":"Nubbins taken from the same colony share the same genotype, the same light and"},{"end_column":75,"end_line":31,"start_column":1,"start_line":31,"text":"flow history and the same handling batch, so their densities are much more"},{"end_column":46,"end_line":32,"start_column":1,"start_line":32,"text":"alike than densities from different colonies."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:5b30af2097c2d2ec065a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:ca1e6e1c9c047100e68a5992ad4b5676f94b94869445c8a7397640cfc66f3630","end_line":32,"locator":"data-description.md:1-32","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:faa396c52c1e4e55b898d467172eaac5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"Endosymbiont density (millions of cells per cm^2) was compared between the two"},{"end_column":70,"end_line":6,"start_column":1,"start_line":6,"text":"reef zones with Welch's two-sample t-test (scipy.stats.ttest_ind with"},{"end_column":72,"end_line":7,"start_column":1,"start_line":7,"text":"equal_var=False). Every nubbin record in data/input.csv contributed one"},{"end_column":25,"end_line":8,"start_column":1,"start_line":8,"text":"observation to the test."},{"end_column":25,"end_line":12,"start_column":1,"start_line":12,"text":"| zone | n | mean | sd |"},{"end_column":26,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- | --- |"},{"end_column":32,"end_line":14,"start_column":1,"start_line":14,"text":"| lagoon | 24 | 1.833 | 0.382 |"},{"end_column":34,"end_line":15,"start_column":1,"start_line":15,"text":"| forereef | 24 | 1.528 | 0.353 |"},{"end_column":71,"end_line":17,"start_column":1,"start_line":17,"text":"Mean difference (lagoon minus forereef): 0.305 million cells per cm^2."},{"end_column":64,"end_line":18,"start_column":1,"start_line":18,"text":"Welch t = 2.874, df = 45.7, p < 0.01 (two-sided, alpha = 0.05)."},{"end_column":248,"end_line":20,"start_column":1,"start_line":20,"text":"[selected-result] Lagoon nubbins carry a higher endosymbiont density than forereef nubbins: mean difference 0.305 million cells per cm^2 (1.833 vs 1.528), Welch t = 2.874, df = 45.7, p < 0.01, so the zone difference is significant at alpha = 0.05."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d3fcdb21cfc1eab2117a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6cc9578cf67c8ba08ca32bc1d3334993e4fcff5c161d9089fe489cc195495f58","end_line":20,"locator":"results/report.md:1-20","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:aaa2081b71fe4f048ec47dd85400d14a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":82,"end_line":3,"start_column":1,"start_line":3,"text":"The file holds the field records from a leafcutter ant foraging study. Twenty-six"},{"end_column":81,"end_line":4,"start_column":1,"start_line":4,"text":"colonies of *Atta cephalotes* were excavated, each from its own forest plot, and"},{"end_column":82,"end_line":5,"start_column":1,"start_line":5,"text":"kept in separate laboratory nests. Every colony was then run through a two-choice"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"foraging arena on a single occasion: two leaf trays of equal starting mass were"},{"end_column":81,"end_line":7,"start_column":1,"start_line":7,"text":"offered side by side for six hours, one tray sprayed with a dilute urea solution"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"and one left untreated. After the window closed, the leaf mass each colony had"},{"end_column":41,"end_line":9,"start_column":1,"start_line":9,"text":"carried away from each tray was weighed."},{"end_column":79,"end_line":11,"start_column":1,"start_line":11,"text":"Because every colony went through the arena once and appears in the file once,"},{"end_column":73,"end_line":12,"start_column":1,"start_line":12,"text":"the file contains no repeated visits, no repeated sessions, and no split"},{"end_column":30,"end_line":13,"start_column":1,"start_line":13,"text":"sub-samples of a single nest."},{"end_column":66,"end_line":17,"start_column":1,"start_line":17,"text":"- `colony_id` -- the code for the colony, unique across the file."},{"end_column":78,"end_line":18,"start_column":1,"start_line":18,"text":"- `nest_origin_plot` -- the forest plot the colony was dug from; one plot per"},{"end_column":40,"end_line":19,"start_column":3,"start_line":19,"text":"colony, so plot codes are unique too."},{"end_column":80,"end_line":20,"start_column":1,"start_line":20,"text":"- `forager_count` -- how many workers were active in the arena for that colony."},{"end_column":71,"end_line":21,"start_column":1,"start_line":21,"text":"- `cut_mass_urea_mg` -- milligrams of leaf the colony removed from the"},{"end_column":26,"end_line":22,"start_column":3,"start_line":22,"text":"urea-supplemented tray."},{"end_column":72,"end_line":23,"start_column":1,"start_line":23,"text":"- `cut_mass_plain_mg` -- milligrams of leaf the colony removed from the"},{"end_column":18,"end_line":24,"start_column":3,"start_line":24,"text":"untreated tray."},{"end_column":79,"end_line":26,"start_column":1,"start_line":26,"text":"The two mass columns are the two halves of a single choice made by one colony;"},{"end_column":80,"end_line":27,"start_column":1,"start_line":27,"text":"together they say which tray that colony favoured, which is the one outcome the"},{"end_column":36,"end_line":28,"start_column":1,"start_line":28,"text":"colony contributes to the analysis."},{"end_column":168,"end_line":30,"start_column":1,"start_line":30,"text":"One row is: one leafcutter ant colony and its single two-choice foraging session, with the leaf mass it cut from the urea-supplemented tray and from the untreated tray"},{"end_column":35,"end_line":31,"start_column":1,"start_line":31,"text":"Independent unit column: colony_id"},{"end_column":22,"end_line":32,"start_column":1,"start_line":32,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:7378e311ec27afd4ffbd","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:a07af19e5d3ede6d1d060a1215ce15c101347ca9e7c4faaa9b7885fab72baa4c","end_line":32,"locator":"data-description.md:1-32","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:aaa2081b71fe4f048ec47dd85400d14a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":72,"end_line":5,"start_column":1,"start_line":5,"text":"Leafcutter (*Atta cephalotes*) colonies were excavated from 26 separate"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"forest plots and housed individually. Each colony ran the two-choice foraging"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"arena exactly once: one urea-supplemented leaf tray and one untreated leaf"},{"end_column":75,"end_line":8,"start_column":1,"start_line":8,"text":"tray, both weighed before and after a six-hour foraging window. One row of"},{"end_column":72,"end_line":9,"start_column":1,"start_line":9,"text":"`data/input.csv` is one colony, and each colony contributes exactly one"},{"end_column":67,"end_line":10,"start_column":1,"start_line":10,"text":"outcome to the test, so the analyzed observations are not repeated"},{"end_column":31,"end_line":11,"start_column":1,"start_line":11,"text":"measurements of the same nest."},{"end_column":75,"end_line":15,"start_column":1,"start_line":15,"text":"Each colony was scored as a single Bernoulli trial: \"prefers urea\" if that"},{"end_column":74,"end_line":16,"start_column":1,"start_line":16,"text":"colony removed more urea-supplemented leaf mass than untreated leaf mass."},{"end_column":76,"end_line":17,"start_column":1,"start_line":17,"text":"The 26 colony-level outcomes were compared with an exact two-sided binomial"},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"test (`scipy.stats.binomtest`) against a no-preference null share of 0.50."},{"end_column":53,"end_line":19,"start_column":1,"start_line":19,"text":"No colony produced a tie, so no trial was discarded."},{"end_column":23,"end_line":23,"start_column":1,"start_line":23,"text":"- Colonies assayed: 26"},{"end_column":59,"end_line":24,"start_column":1,"start_line":24,"text":"- Colonies cutting more urea-supplemented leaf: 20 (76.9%)"},{"end_column":42,"end_line":25,"start_column":1,"start_line":25,"text":"- Colonies cutting more untreated leaf: 6"},{"end_column":67,"end_line":26,"start_column":1,"start_line":26,"text":"- Median within-colony mass difference (urea minus plain): 50.7 mg"},{"end_column":45,"end_line":27,"start_column":1,"start_line":27,"text":"- Exact two-sided binomial p-value: 0.009355"},{"end_column":287,"end_line":29,"start_column":1,"start_line":29,"text":"[selected-result] Exact two-sided binomial test on one outcome per colony: 20 of 26 colonies (76.9%) cut more urea-supplemented leaf tissue, median within-colony difference 50.7 mg, p = 0.009355 against the 0.50 no-preference null, so the no-preference null is rejected at alpha = 0.05."},{"end_column":76,"end_line":33,"start_column":1,"start_line":33,"text":"Colony mass and forager count were recorded but not modelled; the test uses"},{"end_column":70,"end_line":34,"start_column":1,"start_line":34,"text":"only the direction of each colony's preference, so the magnitude of a"},{"end_column":76,"end_line":35,"start_column":1,"start_line":35,"text":"preference is not weighted. The design speaks only to the six-hour foraging"},{"end_column":25,"end_line":36,"start_column":1,"start_line":36,"text":"window that was sampled."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:00301ea48f90147ba511","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:68c05a674f68fe79dc93ce22c4e95aa0047a85094c63efdd2bd74d68ed3fa90c","end_line":36,"locator":"results/report.md:1-36","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

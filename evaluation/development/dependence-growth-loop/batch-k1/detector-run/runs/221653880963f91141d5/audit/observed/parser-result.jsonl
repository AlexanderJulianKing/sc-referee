{"audit_run_id":"audit:70aec86ec04247ac946eefc7b00eb7f5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Twenty-four honey bee colonies kept in a single research apiary were prepared"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"for winter with one of two entrance-reducer designs, notched or open, assigned"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"by coin toss with twelve colonies to each design. Every colony was opened once,"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"at the spring inspection, and given a single survival call. Nothing else was"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"recorded after the October assessment, so the file has one line per colony and"},{"end_column":25,"end_line":8,"start_column":1,"start_line":8,"text":"no colony appears twice."},{"end_column":171,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one honey bee colony, carrying its assigned entrance-reducer design, its October condition, and the single survived-or-died call made at the spring inspection"},{"end_column":35,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: colony_id"},{"end_column":22,"end_line":12,"start_column":1,"start_line":12,"text":"One trial is: one row"},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":88,"end_line":16,"start_column":1,"start_line":16,"text":"- colony_id: the painted apiary tag of the colony; each tag is used on exactly one line"},{"end_column":82,"end_line":17,"start_column":1,"start_line":17,"text":"- entrance_design: notched or open, the winter entrance reducer fitted in October"},{"end_column":74,"end_line":18,"start_column":1,"start_line":18,"text":"- autumn_bee_frames: bee-covered frames counted at the October assessment"},{"end_column":72,"end_line":19,"start_column":1,"start_line":19,"text":"- varroa_per_100_bees: mites per 100 bees from the October alcohol wash"},{"end_column":77,"end_line":20,"start_column":1,"start_line":20,"text":"- overwinter_outcome: survived or died, scored once at the spring inspection"},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"The colonies were housed on separate stands and managed independently, and the"},{"end_column":80,"end_line":23,"start_column":1,"start_line":23,"text":"outcome is a terminal one-time score, so each line is one independent unit with"},{"end_column":35,"end_line":24,"start_column":1,"start_line":24,"text":"no repeated measurement behind it."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:23cce673252c8c82a3a3","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:162dd18e28642958623e73d161e02157f0f7dc2cbb310496087e5d87d9746a13","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:70aec86ec04247ac946eefc7b00eb7f5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":63,"end_line":5,"start_column":1,"start_line":5,"text":"24 queenright colonies in one research apiary were assigned by"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"coin toss to one of two winter entrance-reducer designs. Each colony was"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"opened once, at the spring inspection, and scored survived or died. A colony"},{"end_column":75,"end_line":8,"start_column":1,"start_line":8,"text":"contributes exactly one row, so the survival calls are one per independent"},{"end_column":72,"end_line":9,"start_column":1,"start_line":9,"text":"unit and the design-by-outcome table below counts colonies, not visits."},{"end_column":60,"end_line":13,"start_column":1,"start_line":13,"text":"| Entrance design | Survived | Died | Colonies | Survival |"},{"end_column":32,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- | --- | --- |"},{"end_column":33,"end_line":15,"start_column":1,"start_line":15,"text":"| notched | 9 | 3 | 12 | 0.750 |"},{"end_column":30,"end_line":16,"start_column":1,"start_line":16,"text":"| open | 3 | 9 | 12 | 0.250 |"},{"end_column":61,"end_line":18,"start_column":1,"start_line":18,"text":"Autumn strength was balanced at assignment: 8.50 bee-covered"},{"end_column":56,"end_line":19,"start_column":1,"start_line":19,"text":"frames on average for notched colonies against 8.50 for"},{"end_column":55,"end_line":20,"start_column":1,"start_line":20,"text":"open colonies, with mean autumn mite loads of 2.07 and"},{"end_column":25,"end_line":21,"start_column":1,"start_line":21,"text":"2.28 mites per 100 bees."},{"end_column":73,"end_line":25,"start_column":1,"start_line":25,"text":"Fisher's exact test, two-sided, on the 2 x 2 table of entrance design by"},{"end_column":38,"end_line":26,"start_column":1,"start_line":26,"text":"overwinter outcome: [[9, 3], [3, 9]]."},{"end_column":50,"end_line":28,"start_column":1,"start_line":28,"text":"- Survival difference (notched minus open): 0.500"},{"end_column":27,"end_line":29,"start_column":1,"start_line":29,"text":"- Sample odds ratio: 9.000"},{"end_column":28,"end_line":30,"start_column":1,"start_line":30,"text":"- Two-sided p-value: 0.0391"},{"end_column":210,"end_line":32,"start_column":1,"start_line":32,"text":"[selected-result] Fisher's exact test on 24 independent colonies (one row per colony) returns a two-sided p-value of 0.0391: 9/12 (0.750) of notched colonies overwintered against 3/12 (0.250) of open colonies."},{"end_column":76,"end_line":36,"start_column":1,"start_line":36,"text":"Because each colony is observed once, there is no within-colony replication"},{"end_column":72,"end_line":37,"start_column":1,"start_line":37,"text":"to absorb and the row count equals the number of independent units. The"},{"end_column":75,"end_line":38,"start_column":1,"start_line":38,"text":"exact conditional test is used in preference to a chi-square approximation"},{"end_column":71,"end_line":39,"start_column":1,"start_line":39,"text":"at these cell counts, and no odds-ratio interval is quoted because the"},{"end_column":67,"end_line":40,"start_column":1,"start_line":40,"text":"conditional estimate is poorly determined with single-digit cells."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:75f402d87d623c7293dd","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:c826583ca08c231155d629b06387ba46fa40e7abd0fec8ba0edead12dbae0c00","end_line":40,"locator":"results/report.md:1-40","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

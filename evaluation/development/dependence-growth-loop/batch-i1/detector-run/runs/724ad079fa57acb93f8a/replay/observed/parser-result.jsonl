{"audit_run_id":"audit:7ccdb56c108d480eb854f8ea73362805","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":3,"start_column":1,"start_line":3,"text":"During the 2024 summer season a two-person crew visited 24 geothermal springs in"},{"end_column":81,"end_line":4,"start_column":1,"start_line":4,"text":"the Laugafell field. Each spring was visited once. At the vent the crew recorded"},{"end_column":71,"end_line":5,"start_column":1,"start_line":5,"text":"the host rock the outflow cuts through (basalt or rhyolite), the water"},{"end_column":74,"end_line":6,"start_column":1,"start_line":6,"text":"temperature, dissolved sulfate, the discharge rate, and whether a visible"},{"end_column":64,"end_line":7,"start_column":1,"start_line":7,"text":"cyanobacterial filament mat was growing in the outflow channel."},{"end_column":68,"end_line":9,"start_column":1,"start_line":9,"text":"One row is: one geothermal spring, visited and scored a single time"},{"end_column":35,"end_line":10,"start_column":1,"start_line":10,"text":"Independent unit column: spring_id"},{"end_column":22,"end_line":11,"start_column":1,"start_line":11,"text":"One trial is: one row"},{"end_column":81,"end_line":13,"start_column":1,"start_line":13,"text":"Each spring is a separate water body with its own outflow channel. No spring was"},{"end_column":82,"end_line":14,"start_column":1,"start_line":14,"text":"visited twice, nothing was measured in replicate, and no reading is copied across"},{"end_column":76,"end_line":15,"start_column":1,"start_line":15,"text":"rows, so the spring label appears exactly once and the 24 rows stand for 24"},{"end_column":21,"end_line":16,"start_column":1,"start_line":16,"text":"independent springs."},{"end_column":9,"end_line":18,"start_column":1,"start_line":18,"text":"Columns:"},{"end_column":64,"end_line":19,"start_column":1,"start_line":19,"text":"- spring_id: unique label for the spring, LGF-01 through LGF-24"},{"end_column":69,"end_line":20,"start_column":1,"start_line":20,"text":"- bedrock_class: host rock at the outflow, either basalt or rhyolite"},{"end_column":60,"end_line":21,"start_column":1,"start_line":21,"text":"- outflow_temp_c: vent water temperature in degrees Celsius"},{"end_column":58,"end_line":22,"start_column":1,"start_line":22,"text":"- sulfate_mg_l: dissolved sulfate in milligrams per litre"},{"end_column":56,"end_line":23,"start_column":1,"start_line":23,"text":"- discharge_l_s: outflow discharge in litres per second"},{"end_column":72,"end_line":24,"start_column":1,"start_line":24,"text":"- filament_mat: yes if a visible filament mat was present, no otherwise"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:cd5a5009d5c069cc9e48","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:efe98bfe17851cdc06dd7977ef6df7aaea0f1790cb76cb1177d236c915175705","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:7ccdb56c108d480eb854f8ea73362805","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"Each row is one geothermal spring, surveyed once during the 2024 summer season."},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"Springs were sampled at separate outflows, and every spring contributes exactly"},{"end_column":50,"end_line":7,"start_column":1,"start_line":7,"text":"one row, so the 24 rows are 24 independent units."},{"end_column":23,"end_line":9,"start_column":1,"start_line":9,"text":"- Springs surveyed: 24"},{"end_column":64,"end_line":10,"start_column":1,"start_line":10,"text":"- basalt-hosted springs: 12, filament mats present in 9 (75.0%)"},{"end_column":66,"end_line":11,"start_column":1,"start_line":11,"text":"- rhyolite-hosted springs: 12, filament mats present in 3 (25.0%)"},{"end_column":77,"end_line":15,"start_column":1,"start_line":15,"text":"Bedrock class (basalt vs. rhyolite) was cross-tabulated against filament-mat"},{"end_column":81,"end_line":16,"start_column":1,"start_line":16,"text":"presence and tested with Fisher's exact test, two-sided. An exact test suits the"},{"end_column":79,"end_line":17,"start_column":1,"start_line":17,"text":"small per-cell counts, and the one-spring-per-row layout means each cell entry"},{"end_column":31,"end_line":18,"start_column":1,"start_line":18,"text":"is an independent observation."},{"end_column":45,"end_line":20,"start_column":1,"start_line":20,"text":"| bedrock class | mat present | mat absent |"},{"end_column":20,"end_line":21,"start_column":1,"start_line":21,"text":"| --- | --- | --- |"},{"end_column":19,"end_line":22,"start_column":1,"start_line":22,"text":"| basalt | 9 | 3 |"},{"end_column":21,"end_line":23,"start_column":1,"start_line":23,"text":"| rhyolite | 3 | 9 |"},{"end_column":243,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Fisher's exact test (two-sided) on 24 independent springs: odds ratio = 9.00, p = 0.0391; filament mats occur significantly more often at basalt-hosted springs (9/12) than at rhyolite-hosted springs (3/12) at the 0.05 level."},{"end_column":79,"end_line":29,"start_column":1,"start_line":29,"text":"The association is significant, but with 24 springs the odds-ratio estimate is"},{"end_column":69,"end_line":30,"start_column":1,"start_line":30,"text":"imprecise; the direction, not the magnitude, is the durable finding."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:33da65632358e15f73d8","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:7a75fdd742ab4bbbeb759cdf7be0dfaf18e71e7017faa30d7358760adf7db66a","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

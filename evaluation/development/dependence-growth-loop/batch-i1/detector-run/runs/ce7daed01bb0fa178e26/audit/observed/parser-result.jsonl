{"audit_run_id":"audit:383db598a90b4e2788e724405b8cd986","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"A small greenhouse trial on potted sunflowers. Six pots were grown in a single"},{"end_column":75,"end_line":4,"start_column":1,"start_line":4,"text":"run: three pots received a biochar soil amendment and three pots were left"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"unamended. Near midday, a porometer was clamped on two leaves of every plant"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"(one lower-canopy leaf and one upper-canopy leaf) and the steady-state stomatal"},{"end_column":71,"end_line":7,"start_column":1,"start_line":7,"text":"conductance of each leaf was written down as its own line in the file."},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"One row is: one porometer reading taken on a single leaf of one potted sunflower"},{"end_column":34,"end_line":10,"start_column":1,"start_line":10,"text":"Independent unit column: plant_id"},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":76,"end_line":14,"start_column":1,"start_line":14,"text":"- plant_id: label of the pot and its plant, PL-01 through PL-06. Each label"},{"end_column":64,"end_line":15,"start_column":3,"start_line":15,"text":"appears twice because two leaves of that plant were measured."},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"- amendment: soil treatment of the pot, either control or biochar. It is fixed"},{"end_column":61,"end_line":17,"start_column":3,"start_line":17,"text":"for a plant, so both rows of a plant carry the same value."},{"end_column":79,"end_line":18,"start_column":1,"start_line":18,"text":"- leaf_position: which leaf of the plant supplied the reading, lower or upper."},{"end_column":78,"end_line":19,"start_column":1,"start_line":19,"text":"- conductance_mmol_m2_s: stomatal conductance of that leaf in mmol per square"},{"end_column":51,"end_line":20,"start_column":3,"start_line":20,"text":"metre per second, recorded to one decimal place."},{"end_column":80,"end_line":22,"start_column":1,"start_line":22,"text":"The twelve rows therefore come from six plants, three per amendment group, with"},{"end_column":29,"end_line":23,"start_column":1,"start_line":23,"text":"two leaf readings per plant."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:8ab65dc12d636de14609","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:644826b44fda616b1b0ecd3f29e6826d90dc6f5c19c39176da47c51a745a9d5b","end_line":23,"locator":"data-description.md:1-23","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:383db598a90b4e2788e724405b8cd986","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":53,"end_line":5,"start_column":1,"start_line":5,"text":"Source file: data/input.csv (12 leaf-level records)."},{"end_column":70,"end_line":7,"start_column":1,"start_line":7,"text":"Steady-state stomatal conductance (mmol m-2 s-1) was logged on potted"},{"end_column":69,"end_line":8,"start_column":1,"start_line":8,"text":"greenhouse sunflowers, two leaves per plant, in a single growth run."},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"Each leaf record was entered as one observation and the two amendment groups"},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"were compared with a two-sided Mann-Whitney U test evaluated against the exact"},{"end_column":66,"end_line":14,"start_column":1,"start_line":14,"text":"null distribution (no tied conductance values occur in the file)."},{"end_column":54,"end_line":18,"start_column":1,"start_line":18,"text":"| amendment | leaf records | plants | mean | median |"},{"end_column":32,"end_line":19,"start_column":1,"start_line":19,"text":"| --- | --- | --- | --- | --- |"},{"end_column":38,"end_line":20,"start_column":1,"start_line":20,"text":"| biochar | 6 | 3 | 159.87 | 160.95 |"},{"end_column":38,"end_line":21,"start_column":1,"start_line":21,"text":"| control | 6 | 3 | 115.15 | 115.15 |"},{"end_column":67,"end_line":23,"start_column":1,"start_line":23,"text":"Difference in group means (biochar - control): 44.72 mmol m-2 s-1."},{"end_column":177,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Exact two-sided Mann-Whitney U test on the 12 leaf records (6 biochar vs 6 control): U = 35.0, p = 0.004329, median conductance 160.95 vs 115.15 mmol m-2 s-1."},{"end_column":74,"end_line":29,"start_column":1,"start_line":29,"text":"Conductance ranked higher under biochar than under the control amendment;"},{"end_column":57,"end_line":30,"start_column":1,"start_line":30,"text":"only one biochar-control leaf pair is out of rank order."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:2aebf49e743035aff0a0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:14c6479c66484eeb19302c8f3d17d9add00c2d25ce6fa40adab7701c6512ac0b","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

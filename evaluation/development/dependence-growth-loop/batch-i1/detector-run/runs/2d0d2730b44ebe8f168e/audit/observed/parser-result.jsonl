{"audit_run_id":"audit:93f8d6defcf44a0791b0d571f33b6629","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"This file records free chlorine residual readings taken at fire hydrants in a"},{"end_column":74,"end_line":4,"start_column":1,"start_line":4,"text":"municipal drinking-water distribution system, before and after the ageing"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"cast-iron mains feeding those hydrants were cleaned and cement-mortar relined."},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"Twelve hydrants were enrolled. A field crew visited every enrolled hydrant on"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"three separate occasions and ran the same standardised flush each time, so each"},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"hydrant contributes three rows to the file and the hydrant identifier repeats"},{"end_column":16,"end_line":10,"start_column":1,"start_line":10,"text":"down the table."},{"end_column":216,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one standardised flush event at one hydrant, carrying the free chlorine residual measured at that hydrant before the upstream main was relined and the residual measured at the same hydrant after relining"},{"end_column":36,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: hydrant_id"},{"end_column":9,"end_line":15,"start_column":1,"start_line":15,"text":"Columns:"},{"end_column":79,"end_line":17,"start_column":1,"start_line":17,"text":"- hydrant_id: identifier of the fire hydrant that was flushed. Twelve hydrants"},{"end_column":30,"end_line":18,"start_column":3,"start_line":18,"text":"appear, each on three rows."},{"end_column":78,"end_line":19,"start_column":1,"start_line":19,"text":"- pressure_zone: the distribution pressure zone the hydrant sits in. All rows"},{"end_column":43,"end_line":20,"start_column":3,"start_line":20,"text":"for a given hydrant carry the same zone."},{"end_column":82,"end_line":21,"start_column":1,"start_line":21,"text":"- flush_event: which of that hydrant's three visits this row records (1, 2 or 3)."},{"end_column":74,"end_line":22,"start_column":3,"start_line":22,"text":"Visit numbers are ordered in time but the spacing between visits is not"},{"end_column":17,"end_line":23,"start_column":3,"start_line":23,"text":"recorded here."},{"end_column":75,"end_line":24,"start_column":1,"start_line":24,"text":"- pre_reline_residual_mg_l: free chlorine residual in milligrams per litre"},{"end_column":73,"end_line":25,"start_column":3,"start_line":25,"text":"measured at the hydrant during the flush, before the upstream main was"},{"end_column":11,"end_line":26,"start_column":3,"start_line":26,"text":"relined."},{"end_column":76,"end_line":27,"start_column":1,"start_line":27,"text":"- post_reline_residual_mg_l: free chlorine residual in milligrams per litre"},{"end_column":76,"end_line":28,"start_column":3,"start_line":28,"text":"measured at the same hydrant during the matching flush after the upstream"},{"end_column":20,"end_line":29,"start_column":3,"start_line":29,"text":"main was relined."},{"end_column":79,"end_line":31,"start_column":1,"start_line":31,"text":"Units and conventions: residuals are in mg/L as free chlorine, reported to two"},{"end_column":80,"end_line":32,"start_column":1,"start_line":32,"text":"decimal places from a field colorimeter. There are no missing values, and every"},{"end_column":53,"end_line":33,"start_column":1,"start_line":33,"text":"row has both a pre-reline and a post-reline reading."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1cb1f1bcd4b280f2f646","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:9eb843956f480de1136eca31dca6d813e4faed68d9e03c6691fc0f5185e891b5","end_line":33,"locator":"data-description.md:1-33","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:93f8d6defcf44a0791b0d571f33b6629","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one hydrant flush event recorded during the"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"cement-mortar relining programme: the free chlorine residual measured at the"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"hydrant before the upstream main was relined, and the residual measured at"},{"end_column":33,"end_line":8,"start_column":1,"start_line":8,"text":"the same hydrant after relining."},{"end_column":71,"end_line":12,"start_column":1,"start_line":12,"text":"The two readings attached to a flush event form a natural pair, so the"},{"end_column":64,"end_line":13,"start_column":1,"start_line":13,"text":"post-minus-pre gain was analysed with a two-sided paired t-test"},{"end_column":57,"end_line":14,"start_column":1,"start_line":14,"text":"(`scipy.stats.ttest_rel`) over the 36 event-level pairs."},{"end_column":28,"end_line":18,"start_column":1,"start_line":18,"text":"- Flush events analysed: 36"},{"end_column":39,"end_line":19,"start_column":1,"start_line":19,"text":"- Mean pre-reline residual: 0.750 mg/L"},{"end_column":40,"end_line":20,"start_column":1,"start_line":20,"text":"- Mean post-reline residual: 1.050 mg/L"},{"end_column":37,"end_line":21,"start_column":1,"start_line":21,"text":"- Mean gain (post - pre): 0.300 mg/L"},{"end_column":42,"end_line":22,"start_column":1,"start_line":22,"text":"- Standard deviation of gains: 0.100 mg/L"},{"end_column":36,"end_line":23,"start_column":1,"start_line":23,"text":"- Paired t(35) = 18.000, p < 0.0001"},{"end_column":154,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Paired t-test on 36 flush-event pairs: mean free chlorine gain after relining = 0.300 mg/L (SD 0.100 mg/L), t(35) = 18.000, p < 0.0001."},{"end_column":72,"end_line":29,"start_column":1,"start_line":29,"text":"Relining is associated with a mean free chlorine residual gain of about"},{"end_column":74,"end_line":30,"start_column":1,"start_line":30,"text":"0.30 mg/L per flush event, and the paired test rejects the no-change null"},{"end_column":37,"end_line":31,"start_column":1,"start_line":31,"text":"at the conventional 5 percent level."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e36c5548a7bd33785418","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:0e1973ab34247fd933172239306ec5567b42a65f90a16127167c1eb11625ca8e","end_line":31,"locator":"results/report.md:1-31","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

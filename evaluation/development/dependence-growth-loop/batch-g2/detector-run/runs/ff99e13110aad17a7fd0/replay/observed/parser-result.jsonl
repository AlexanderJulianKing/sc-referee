{"audit_run_id":"audit:6b40b9c402204aaf9013f51c1c0f40d7","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve laboratory cold-brew vessels were prepared in a temperature-controlled"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"cabinet. Each vessel was filled with coffee ground at a single setting, either"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"coarse or fine, and then sampled four times as the brew steeped: at 6, 12, 18"},{"end_column":72,"end_line":6,"start_column":1,"start_line":6,"text":"and 24 hours. At every sampling a small aliquot was drawn and its total"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"dissolved solids (TDS) measured with a refractometer, and the water temperature"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"of the vessel was noted. Six vessels used the coarse setting and six used the"},{"end_column":52,"end_line":9,"start_column":1,"start_line":9,"text":"fine setting, giving 48 measurement records in all."},{"end_column":27,"end_line":11,"start_column":1,"start_line":11,"text":"Columns in data/input.csv:"},{"end_column":80,"end_line":13,"start_column":1,"start_line":13,"text":"- vessel_id: label of the steeping vessel, V01 through V12. Each vessel appears"},{"end_column":35,"end_line":14,"start_column":3,"start_line":14,"text":"in four rows, one per draw time."},{"end_column":76,"end_line":15,"start_column":1,"start_line":15,"text":"- grind: the grind setting loaded into that vessel, \"coarse\" or \"fine\". The"},{"end_column":74,"end_line":16,"start_column":3,"start_line":16,"text":"setting is a property of the vessel, so it is the same in all four of a"},{"end_column":17,"end_line":17,"start_column":3,"start_line":17,"text":"vessel's rows."},{"end_column":79,"end_line":18,"start_column":1,"start_line":18,"text":"- steep_hours: hours of steeping elapsed when the aliquot was drawn (6, 12, 18"},{"end_column":10,"end_line":19,"start_column":3,"start_line":19,"text":"or 24)."},{"end_column":68,"end_line":20,"start_column":1,"start_line":20,"text":"- water_temp_c: water temperature of the vessel in degrees Celsius."},{"end_column":77,"end_line":21,"start_column":1,"start_line":21,"text":"- tds_percent: total dissolved solids of the drawn aliquot, percent by mass."},{"end_column":72,"end_line":23,"start_column":1,"start_line":23,"text":"One row is: one aliquot drawn from one steeping vessel at one draw time"},{"end_column":35,"end_line":24,"start_column":1,"start_line":24,"text":"Independent unit column: vessel_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:5af00baf7d751f841a4a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:9f794954dab80e07f9b77a807a31721872648779a03dd6e56ae03d38f38f4669","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:6b40b9c402204aaf9013f51c1c0f40d7","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"48 total-dissolved-solids (TDS) readings taken from laboratory cold-brew"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"steeping vessels. Each vessel was loaded with a single grind setting and"},{"end_column":49,"end_line":7,"start_column":1,"start_line":7,"text":"sampled at draw times of 6, 12, 18 and 24 hours."},{"end_column":59,"end_line":9,"start_column":1,"start_line":9,"text":"- coarse grind: n = 24, mean TDS = 1.1358 %, SD = 0.0959 %"},{"end_column":59,"end_line":10,"start_column":1,"start_line":10,"text":"- fine grind:   n = 24, mean TDS = 1.3879 %, SD = 0.1101 %"},{"end_column":73,"end_line":14,"start_column":1,"start_line":14,"text":"Welch two-sample t-test (two-sided, unequal variances) comparing the TDS"},{"end_column":71,"end_line":15,"start_column":1,"start_line":15,"text":"readings recorded at the fine grind setting with those recorded at the"},{"end_column":75,"end_line":16,"start_column":1,"start_line":16,"text":"coarse setting. Every row of the data file was supplied to the test as one"},{"end_column":13,"end_line":17,"start_column":1,"start_line":17,"text":"observation."},{"end_column":62,"end_line":19,"start_column":1,"start_line":19,"text":"Mean difference (fine minus coarse): 0.2521 percentage points"},{"end_column":33,"end_line":20,"start_column":1,"start_line":20,"text":"t = 8.456, df = 45.1, p < 0.0001"},{"end_column":179,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Welch two-sample t-test on 48 TDS readings (24 fine, 24 coarse): mean difference fine minus coarse = 0.2521 percentage points, t = 8.456, df = 45.1, p < 0.0001."},{"end_column":74,"end_line":28,"start_column":1,"start_line":28,"text":"Vessels filled with the fine grind returned higher total dissolved solids"},{"end_column":73,"end_line":29,"start_column":1,"start_line":29,"text":"than vessels filled with the coarse grind across the sampled draw times."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:546773e1e15f58acad43","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:55169a2617022b6e6f9906e34884aba26a339b2cad1476649d247b28b23589c5","end_line":29,"locator":"results/report.md:1-29","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

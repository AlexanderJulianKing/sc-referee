{"audit_run_id":"audit:843cc04e43e14a7e9fd6394200c23a5d","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Every hawkmoth in this study was captured, given a unique mark, measured once,"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"released once into the Y-tube choice arena, scored, and then let go. No animal"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"entered the arena a second time, so the file is simply a list of animals, each"},{"end_column":32,"end_line":6,"start_column":1,"start_line":6,"text":"with the single choice it made."},{"end_column":85,"end_line":8,"start_column":1,"start_line":8,"text":"One row is: one wild-caught hawkmoth tested a single time in the Y-tube choice arena"},{"end_column":33,"end_line":9,"start_column":1,"start_line":9,"text":"Independent unit column: moth_id"},{"end_column":22,"end_line":10,"start_column":1,"start_line":10,"text":"One trial is: one row"},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":81,"end_line":14,"start_column":1,"start_line":14,"text":"- `moth_id`: the unique mark code painted on the thorax; each code appears once."},{"end_column":62,"end_line":15,"start_column":1,"start_line":15,"text":"- `sex`: female or male, scored from the antennae at capture."},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"- `forewing_length_mm`: right forewing length in millimetres, measured once at"},{"end_column":29,"end_line":17,"start_column":3,"start_line":17,"text":"capture, before the trial."},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"- `amber_arm_position`: which arm of the Y held the amber lamp during that"},{"end_column":79,"end_line":19,"start_column":3,"start_line":19,"text":"animal's trial, left or right; the two positions were counterbalanced across"},{"end_column":75,"end_line":20,"start_column":3,"start_line":20,"text":"animals so that a side bias could not masquerade as a colour preference."},{"end_column":80,"end_line":21,"start_column":1,"start_line":21,"text":"- `chosen_spectrum`: the lamp the animal walked toward, amber or white. This is"},{"end_column":42,"end_line":22,"start_column":3,"start_line":22,"text":"the single outcome the analysis counts."},{"end_column":76,"end_line":24,"start_column":1,"start_line":24,"text":"Because one animal supplies exactly one yes/no outcome, the twenty rows are"},{"end_column":77,"end_line":25,"start_column":1,"start_line":25,"text":"twenty independent Bernoulli trials and can be fed directly into a procedure"},{"end_column":31,"end_line":26,"start_column":1,"start_line":26,"text":"that assumes independent rows."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:60735b3146a90454eeaa","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b99a6eba7b9321a094d981d8f3ea94d1b64c9eae6e8f79719c6ad6e691bc1db1","end_line":26,"locator":"data-description.md:1-26","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:843cc04e43e14a7e9fd6394200c23a5d","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"Twenty wild-caught hawkmoths were released one at a time into a Y-tube choice"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"arena with an amber (590 nm) lamp at the end of one arm and a cool-white lamp at"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"the end of the other. A moth was scored the moment it crossed a line 20 cm into"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"one arm, and it was then retired from the study. Every row of `data/input.csv`"},{"end_column":80,"end_line":9,"start_column":1,"start_line":9,"text":"is therefore one animal and one trial: the independent unit and the observation"},{"end_column":51,"end_line":10,"start_column":1,"start_line":10,"text":"are the same thing, and no moth contributes twice."},{"end_column":21,"end_line":14,"start_column":1,"start_line":14,"text":"| quantity | value |"},{"end_column":14,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- |"},{"end_column":23,"end_line":16,"start_column":1,"start_line":16,"text":"| trials (rows) | 20 |"},{"end_column":35,"end_line":17,"start_column":1,"start_line":17,"text":"| distinct moth identifiers | 20 |"},{"end_column":38,"end_line":18,"start_column":1,"start_line":18,"text":"| mean forewing length (mm) | 18.16 |"},{"end_column":51,"end_line":19,"start_column":1,"start_line":19,"text":"| shortest / longest forewing (mm) | 16.5 / 20.0 |"},{"end_column":77,"end_line":23,"start_column":1,"start_line":23,"text":"With one Bernoulli outcome per moth, the number of amber choices is binomial"},{"end_column":81,"end_line":24,"start_column":1,"start_line":24,"text":"with n = 20, and the null hypothesis of no spectral preference fixes the success"},{"end_column":56,"end_line":25,"start_column":1,"start_line":25,"text":"probability at 0.500. The two-sided exact binomial test"},{"end_column":79,"end_line":26,"start_column":1,"start_line":26,"text":"(`scipy.stats.binomtest`) is applied to the raw count; no normal approximation"},{"end_column":78,"end_line":27,"start_column":1,"start_line":27,"text":"and no clustering correction are needed, because there is nothing to cluster."},{"end_column":56,"end_line":29,"start_column":1,"start_line":29,"text":"Amber was chosen in 16 of 20 trials (proportion 0.800)."},{"end_column":246,"end_line":31,"start_column":1,"start_line":31,"text":"[selected-result] Two-sided exact binomial test of no spectral preference: 16 of 20 hawkmoths chose the amber arm (proportion 0.800 against a null of 0.500), p = 0.011818, so the preference for amber is statistically significant at alpha = 0.05."},{"end_column":37,"end_line":35,"start_column":1,"start_line":35,"text":"| stratum | amber choices | trials |"},{"end_column":20,"end_line":36,"start_column":1,"start_line":36,"text":"| --- | --- | --- |"},{"end_column":40,"end_line":37,"start_column":1,"start_line":37,"text":"| amber lamp on the left arm | 8 | 10 |"},{"end_column":41,"end_line":38,"start_column":1,"start_line":38,"text":"| amber lamp on the right arm | 8 | 10 |"},{"end_column":20,"end_line":39,"start_column":1,"start_line":39,"text":"| female | 9 | 10 |"},{"end_column":18,"end_line":40,"start_column":1,"start_line":40,"text":"| male | 7 | 10 |"},{"end_column":80,"end_line":42,"start_column":1,"start_line":42,"text":"The counterbalanced lamp positions produced the same amber count, so the result"},{"end_column":80,"end_line":43,"start_column":1,"start_line":43,"text":"is not an artefact of a side bias. The sex strata are reported for completeness"},{"end_column":20,"end_line":44,"start_column":1,"start_line":44,"text":"and are not tested."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:88eabccf6e9528c85c33","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:54ef15c5048c5ea151ef2464b9a4d8a1f69a00b4d64acbd9c48f240012e0956b","end_line":44,"locator":"results/report.md:1-44","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

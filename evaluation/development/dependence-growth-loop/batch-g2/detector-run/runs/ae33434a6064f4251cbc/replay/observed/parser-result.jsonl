{"audit_run_id":"audit:9abc9b8b71de47798b8786b91943a309","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve rocky-shore limpets were collected by hand from a single granite shore"},{"end_column":74,"end_line":4,"start_column":1,"start_line":4,"text":"platform: six from the low-shore zone, which is submerged for most of the"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"tidal cycle, and six from the high-shore zone, which is exposed to air and sun"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"for long stretches. Each animal was held in a common flow-through aquarium and"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"then placed in a heated seawater bath on four consecutive days. On each day"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"the bath temperature was raised at a steady rate and the temperature at which"},{"end_column":79,"end_line":9,"start_column":1,"start_line":9,"text":"the animal lost its grip on the substrate was recorded as its critical thermal"},{"end_column":78,"end_line":10,"start_column":1,"start_line":10,"text":"maximum for that ramp. Every animal therefore appears in the file four times,"},{"end_column":78,"end_line":11,"start_column":1,"start_line":11,"text":"once per ramp day, and the four values for an animal are repeated readings of"},{"end_column":68,"end_line":12,"start_column":1,"start_line":12,"text":"the same individual rather than readings of four different animals."},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":69,"end_line":16,"start_column":1,"start_line":16,"text":"- `limpet_id`: tag code of the individual animal, LP01 through LP12."},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"- `shore_zone`: tidal zone the animal was collected from, `low` or `high`."},{"end_column":73,"end_line":18,"start_column":1,"start_line":18,"text":"- `trial_no`: which of the four ramp days the reading came from, 1 to 4."},{"end_column":78,"end_line":19,"start_column":1,"start_line":19,"text":"- `shell_length_mm`: shell length of the animal in millimetres, measured once"},{"end_column":60,"end_line":20,"start_column":3,"start_line":20,"text":"at collection and repeated on each of that animal's rows."},{"end_column":72,"end_line":21,"start_column":1,"start_line":21,"text":"- `ctmax_c`: critical thermal maximum in degrees Celsius for that ramp."},{"end_column":70,"end_line":23,"start_column":1,"start_line":23,"text":"One row is: one heated-bath temperature ramp of one limpet on one day"},{"end_column":35,"end_line":24,"start_column":1,"start_line":24,"text":"Independent unit column: limpet_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:56f8d6cb60ea1f19a084","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:a3cd5fa0ac18e2ad196a63613ec08fb2723c8c2124dbda397e4356c1e931dec4","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:9abc9b8b71de47798b8786b91943a309","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"Column `ctmax_c` of `data/input.csv` records the critical thermal maximum, in"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"degrees Celsius, reached by intertidal limpets during a heated-seawater ramp."},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"Animals were collected from one granite shore platform in two tidal zones and"},{"end_column":52,"end_line":8,"start_column":1,"start_line":8,"text":"each animal was ramped on several consecutive days."},{"end_column":85,"end_line":10,"start_column":1,"start_line":10,"text":"| Shore zone | Animals | Measurements | Ramps per animal | Mean CTmax (C) | SD (C) |"},{"end_column":38,"end_line":11,"start_column":1,"start_line":11,"text":"| --- | --- | --- | --- | --- | --- |"},{"end_column":44,"end_line":12,"start_column":1,"start_line":12,"text":"| Low shore | 6 | 24 | 4 | 33.200 | 0.273 |"},{"end_column":45,"end_line":13,"start_column":1,"start_line":13,"text":"| High shore | 6 | 24 | 4 | 35.600 | 0.273 |"},{"end_column":74,"end_line":17,"start_column":1,"start_line":17,"text":"Two-sided two-sample Student t-test (pooled variance) comparing `ctmax_c`"},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"between the low-shore and high-shore groups. Every measurement in the file"},{"end_column":59,"end_line":19,"start_column":1,"start_line":19,"text":"was entered into the test as one observation of its group."},{"end_column":73,"end_line":23,"start_column":1,"start_line":23,"text":"High-shore limpets reached a mean CTmax 2.400 C above low-shore limpets."},{"end_column":169,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Two-sample t-test of ctmax_c by shore zone: t(46) = -30.402, p < 0.0001 (low shore 33.200 C, n = 24; high shore 35.600 C, n = 24; difference 2.400 C)."},{"end_column":72,"end_line":27,"start_column":1,"start_line":27,"text":"All 48 measurements were treated as independent observations, giving 46"},{"end_column":20,"end_line":28,"start_column":1,"start_line":28,"text":"degrees of freedom."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ab5fa00ac47af9d5fc76","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:15290ebfa039e122c8c45fc008a1b86920c5f60d9b8eaa98441922a76b1df82f","end_line":28,"locator":"results/report.md:1-28","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

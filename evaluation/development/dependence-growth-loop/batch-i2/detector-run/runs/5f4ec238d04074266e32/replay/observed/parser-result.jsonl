{"audit_run_id":"audit:e4ea09e532bc4559a15037bdaeb92a24","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":83,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve sourdough starter jars were kept side by side in a single incubator held at"},{"end_column":82,"end_line":4,"start_column":1,"start_line":4,"text":"26 C. Six of the jars were refreshed with wholegrain rye flour and six with white"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"wheat flour. Apart from the flour, every jar got the same hydration, the same"},{"end_column":50,"end_line":6,"start_column":1,"start_line":6,"text":"starting mass and the same 24 h refresh schedule."},{"end_column":83,"end_line":8,"start_column":1,"start_line":8,"text":"At the end of the 24 h window a technician drew four separate aliquots out of each"},{"end_column":80,"end_line":9,"start_column":1,"start_line":9,"text":"jar and titrated every aliquot with 0.1 M NaOH to the phenolphthalein endpoint,"},{"end_column":85,"end_line":10,"start_column":1,"start_line":10,"text":"writing down the volume of base in millilitres. The four aliquots taken from one jar"},{"end_column":79,"end_line":11,"start_column":1,"start_line":11,"text":"are four measurements of the same batch of starter, not four separate batches."},{"end_column":21,"end_line":13,"start_column":1,"start_line":13,"text":"Columns in the file:"},{"end_column":83,"end_line":15,"start_column":1,"start_line":15,"text":"- jar_id: label of the starter jar the aliquot came from; R01-R06 are the rye jars"},{"end_column":33,"end_line":16,"start_column":3,"start_line":16,"text":"and W01-W06 are the wheat jars"},{"end_column":67,"end_line":17,"start_column":1,"start_line":17,"text":"- flour_type: refresh flour used for that jar, either rye or wheat"},{"end_column":81,"end_line":18,"start_column":1,"start_line":18,"text":"- starter_age_d: age of the starter culture, in days, at the time of the refresh"},{"end_column":86,"end_line":19,"start_column":1,"start_line":19,"text":"- aliquot: which of the four aliquots from that jar this row records, numbered 1 to 4"},{"end_column":70,"end_line":20,"start_column":1,"start_line":20,"text":"- acidity_ml: titratable acidity of that aliquot, in mL of 0.1 M NaOH"},{"end_column":68,"end_line":22,"start_column":1,"start_line":22,"text":"One row is: one titration of one aliquot drawn from one starter jar"},{"end_column":32,"end_line":23,"start_column":1,"start_line":23,"text":"Independent unit column: jar_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:a32ae93515fcb6eb89fb","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6f04d0b7351175ca281a2b5075a25a79a72f5dd1017b7abb704e30f69f12d95b","end_line":23,"locator":"data-description.md:1-23","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:e4ea09e532bc4559a15037bdaeb92a24","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":86,"end_line":5,"start_column":1,"start_line":5,"text":"48 aliquots were titrated after a 24 h refresh; the response is titratable acidity in"},{"end_column":50,"end_line":6,"start_column":1,"start_line":6,"text":"mL of 0.1 M NaOH to the phenolphthalein endpoint."},{"end_column":59,"end_line":8,"start_column":1,"start_line":8,"text":"| Refresh flour | Aliquots | Mean acidity (mL) | SD (mL) |"},{"end_column":26,"end_line":9,"start_column":1,"start_line":9,"text":"| --- | --- | --- | --- |"},{"end_column":30,"end_line":10,"start_column":1,"start_line":10,"text":"| Rye | 24 | 10.000 | 0.404 |"},{"end_column":31,"end_line":11,"start_column":1,"start_line":11,"text":"| Wheat | 24 | 8.600 | 0.349 |"},{"end_column":88,"end_line":15,"start_column":1,"start_line":15,"text":"Welch's two-sample t-test (two-sided, unequal variances) comparing the acidity of every"},{"end_column":53,"end_line":16,"start_column":1,"start_line":16,"text":"rye aliquot with the acidity of every wheat aliquot."},{"end_column":76,"end_line":20,"start_column":1,"start_line":20,"text":"Mean difference (rye - wheat) = 1.400 mL; t = 12.84, df = 45.0, p < 0.0001."},{"end_column":220,"end_line":22,"start_column":1,"start_line":22,"text":"[selected-result] Welch's two-sample t-test on 48 aliquots shows that rye-refreshed starters reach a higher titratable acidity than wheat-refreshed starters, by 1.400 mL of 0.1 M NaOH (t = 12.84, df = 45.0, p < 0.0001)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:53f602c1a601c7f0b1f7","parser_version":"0.2.0","provenance":{"actor":{"actor_id":
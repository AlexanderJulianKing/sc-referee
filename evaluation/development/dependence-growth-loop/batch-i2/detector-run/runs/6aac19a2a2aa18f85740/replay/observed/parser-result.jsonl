{"audit_run_id":"audit:5c9462923aad47b39c2ed7e8e87159f5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":91,"end_line":3,"start_column":1,"start_line":3,"text":"A single midsummer field campaign visited twelve upland peat bogs, each sitting in its own"},{"end_column":95,"end_line":4,"start_column":1,"start_line":4,"text":"catchment, and took one closed-chamber methane flux reading at each bog. Six of the bogs still"},{"end_column":96,"end_line":5,"start_column":1,"start_line":5,"text":"hold an intact water table; the other six were drained by historic ditching. No bog was visited"},{"end_column":92,"end_line":6,"start_column":1,"start_line":6,"text":"twice, and no two rows describe the same bog, so the twelve rows are twelve separate sites."},{"end_column":90,"end_line":8,"start_column":1,"start_line":8,"text":"One row is: one surveyed peat bog together with its single midsummer methane flux reading"},{"end_column":32,"end_line":9,"start_column":1,"start_line":9,"text":"Independent unit column: bog_id"},{"end_column":8,"end_line":11,"start_column":1,"start_line":11,"text":"Columns"},{"end_column":69,"end_line":12,"start_column":1,"start_line":12,"text":"- bog_id: site code of the bog; each code appears on exactly one row"},{"end_column":97,"end_line":13,"start_column":1,"start_line":13,"text":"- catchment: name of the catchment the bog sits in; each catchment holds exactly one of the bogs"},{"end_column":67,"end_line":14,"start_column":1,"start_line":14,"text":"- hydrology: management state of the bog, either intact or drained"},{"end_column":82,"end_line":15,"start_column":1,"start_line":15,"text":"- peat_depth_cm: depth of the peat column at the chamber position, in centimetres"},{"end_column":98,"end_line":16,"start_column":1,"start_line":16,"text":"- ch4_flux_mg_m2_h: methane flux measured at the chamber, in milligrams per square metre per hour"},{"end_column":96,"end_line":18,"start_column":1,"start_line":18,"text":"Because measurement, bog, and row are one and the same thing here, the readings can be compared"},{"end_column":97,"end_line":19,"start_column":1,"start_line":19,"text":"between the two hydrology classes without any grouping or repeated-measures structure to account"},{"end_column":78,"end_line":20,"start_column":1,"start_line":20,"text":"for. Peat depth is recorded for context only and is not used by the analysis."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:da7a71ad7c3f9f976d5d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b6d592b46ff5b110a221455712ff814da46c5f744ed38e2733dae9edfd391da5","end_line":20,"locator":"data-description.md:1-20","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:5c9462923aad47b39c2ed7e8e87159f5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":93,"end_line":5,"start_column":1,"start_line":5,"text":"Twelve peat bogs, each in a separate catchment, were surveyed once during a single midsummer"},{"end_column":95,"end_line":6,"start_column":1,"start_line":6,"text":"campaign: six bogs with an intact water table and six bogs drained by historic ditching. Every"},{"end_column":94,"end_line":7,"start_column":1,"start_line":7,"text":"bog contributes exactly one closed-chamber flux measurement, so each row of data/input.csv is"},{"end_column":67,"end_line":8,"start_column":1,"start_line":8,"text":"one independent unit. Rows read: 12; distinct bog identifiers: 12."},{"end_column":68,"end_line":12,"start_column":1,"start_line":12,"text":"| Hydrology | Bogs | Mean CH4 flux (mg m-2 h-1) | SD (mg m-2 h-1) |"},{"end_column":26,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- | --- |"},{"end_column":31,"end_line":14,"start_column":1,"start_line":14,"text":"| intact | 6 | 3.200 | 0.228 |"},{"end_column":32,"end_line":15,"start_column":1,"start_line":15,"text":"| drained | 6 | 2.700 | 0.313 |"},{"end_column":94,"end_line":19,"start_column":1,"start_line":19,"text":"Two-sided two-sample Student t-test with pooled variance on the bog-level flux values. No bog"},{"end_column":90,"end_line":20,"start_column":1,"start_line":20,"text":"is measured twice, so the twelve observations enter the test as twelve independent draws."},{"end_column":63,"end_line":22,"start_column":1,"start_line":22,"text":"- Difference in means (intact minus drained): 0.500 mg m-2 h-1"},{"end_column":30,"end_line":23,"start_column":1,"start_line":23,"text":"- Pooled SD: 0.274 mg m-2 h-1"},{"end_column":59,"end_line":24,"start_column":1,"start_line":24,"text":"- Standardised effect size (difference / pooled SD): 1.826"},{"end_column":30,"end_line":25,"start_column":1,"start_line":25,"text":"- t(10) = 3.1623, p = 0.01012"},{"end_column":222,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Intact bogs emitted more methane than drained bogs: mean flux 3.200 vs 2.700 mg m-2 h-1 (difference 0.500), pooled two-sample t-test t(10) = 3.1623, two-sided p = 0.01012, standardised effect size 1.826."},{"end_column":96,"end_line":31,"start_column":1,"start_line":31,"text":"At the conventional 5 percent level the difference is statistically significant: in this sample"},{"end_column":91,"end_line":32,"start_column":1,"start_line":32,"text":"the drained bogs emit about 16 percent less methane than the intact bogs. The test assumes"},{"end_column":93,"end_line":33,"start_column":1,"start_line":33,"text":"independent, approximately normal, equal-variance groups. Independence holds by construction"},{"end_column":90,"end_line":34,"start_column":1,"start_line":34,"text":"because every bog identifier appears on exactly one row; normality and equal variance are"},{"end_column":56,"end_line":35,"start_column":1,"start_line":35,"text":"assumed rather than demonstrated at six bogs per group."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:46ace06495edc6cd2980","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:99859de894bf88d681fe4dd94121830129cade2591de6495a75a88429b9fc3f9","end_line":35,"locator":"results/report.md:1-35","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

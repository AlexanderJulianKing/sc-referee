{"audit_run_id":"audit:edf9647d076f41569f6427ec1006e126","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":3,"start_column":1,"start_line":3,"text":"This file records greenhouse-gas measurements collected with closed static"},{"end_column":78,"end_line":4,"start_column":1,"start_line":4,"text":"chambers at the Kettle Fen peatland restoration site. Three chamber plots sit"},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"inside the rewetted compartment and three sit in the compartment that is still"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"drained. Every plot carries a permanent collar set into the peat, and the same"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"collar was sampled on three separate survey rounds, so each plot contributes"},{"end_column":32,"end_line":8,"start_column":1,"start_line":8,"text":"more than one line to the file."},{"end_column":106,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one static-chamber methane flux measurement taken at one chamber plot during one survey round"},{"end_column":33,"end_line":12,"start_column":1,"start_line":12,"text":"Independent unit column: plot_id"},{"end_column":9,"end_line":14,"start_column":1,"start_line":14,"text":"Columns:"},{"end_column":120,"end_line":16,"start_column":1,"start_line":16,"text":"- plot_id: permanent chamber plot identifier (KF-01 through KF-06); the same identifier reappears once per survey round"},{"end_column":105,"end_line":17,"start_column":1,"start_line":17,"text":"- treatment: hydrological management of the compartment the plot sits in, either \"rewetted\" or \"drained\""},{"end_column":92,"end_line":18,"start_column":1,"start_line":18,"text":"- survey_round: sampling campaign number, 1 to 3; all six plots were visited in every round"},{"end_column":138,"end_line":19,"start_column":1,"start_line":19,"text":"- ch4_flux_mg_m2_h: methane flux derived from the closed-chamber concentration regression, in milligrams of CH4 per square metre per hour"},{"end_column":141,"end_line":20,"start_column":1,"start_line":20,"text":"- water_table_cm: water table depth relative to the peat surface in centimetres; negative values mean the water table sits below the surface"},{"end_column":67,"end_line":21,"start_column":1,"start_line":21,"text":"- peat_temp_c: peat temperature at 10 cm depth, in degrees Celsius"},{"end_column":76,"end_line":23,"start_column":1,"start_line":23,"text":"Rows that share a plot_id are repeat visits to one physical location rather"},{"end_column":76,"end_line":24,"start_column":1,"start_line":24,"text":"than separate locations, and readings from the same collar tend to resemble"},{"end_column":12,"end_line":25,"start_column":1,"start_line":25,"text":"each other."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4306870b24c32a4ad3d9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:de7db07cdbf92db5bc8d866726e8c4517655c1f924998f6fcd0af8ff75b012ad","end_line":25,"locator":"data-description.md:1-25","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:edf9647d076f41569f6427ec1006e126","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":72,"end_line":5,"start_column":1,"start_line":5,"text":"`data/input.csv` holds 18 static-chamber methane flux readings from the"},{"end_column":71,"end_line":6,"start_column":1,"start_line":6,"text":"Kettle Fen restoration trial: 6 chamber plots (3 rewetted, 3 drained),"},{"end_column":33,"end_line":7,"start_column":1,"start_line":7,"text":"each visited on 3 survey rounds."},{"end_column":59,"end_line":9,"start_column":1,"start_line":9,"text":"| Treatment | Readings | Mean CH4 flux (mg m-2 h-1) | SD |"},{"end_column":26,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- | --- |"},{"end_column":33,"end_line":11,"start_column":1,"start_line":11,"text":"| rewetted | 9 | 20.10 | 1.240 |"},{"end_column":31,"end_line":12,"start_column":1,"start_line":12,"text":"| drained | 9 | 8.00 | 1.376 |"},{"end_column":72,"end_line":16,"start_column":1,"start_line":16,"text":"A two-sample Student t test (equal variances assumed) compared rewetted"},{"end_column":74,"end_line":17,"start_column":1,"start_line":17,"text":"against drained flux readings. Every reading in the file was entered as a"},{"end_column":34,"end_line":18,"start_column":1,"start_line":18,"text":"separate observation in the test."},{"end_column":57,"end_line":20,"start_column":1,"start_line":20,"text":"- Mean difference (rewetted - drained): 12.10 mg m-2 h-1"},{"end_column":17,"end_line":21,"start_column":1,"start_line":21,"text":"- t(16) = 19.600"},{"end_column":22,"end_line":22,"start_column":1,"start_line":22,"text":"- Two-sided p < 0.001"},{"end_column":221,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Mean chamber methane flux was higher under rewetting than under drainage (20.10 vs 8.00 mg m-2 h-1; difference 12.10 mg m-2 h-1), two-sample Student t test on all 18 readings, t(16) = 19.600, p < 0.001."},{"end_column":71,"end_line":28,"start_column":1,"start_line":28,"text":"Fluxes are milligrams of CH4 per square metre per hour. No reading was"},{"end_column":39,"end_line":29,"start_column":1,"start_line":29,"text":"excluded and no value was transformed."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b781bb564554fd345bea","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:134748c2a7e9463d633b0f1c9a53ba08bf61a84fbf45517abbb22c42de750e72","end_line":29,"locator":"results/report.md:1-29","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

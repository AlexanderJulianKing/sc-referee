{"audit_run_id":"audit:81455080fa6d4f57bdc81dbcab227557","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":3,"start_column":1,"start_line":3,"text":"Eight individually tagged mason bee (Osmia) females were filmed at a shared"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"nesting block after the block was turned on its mount, so the familiar landmark"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"cues no longer lined up with the tube openings. Each time a female came back"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"from a foraging run, observers wrote down whether she finally entered her own"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"(natal) tube or a different tube, how long she hovered at the block face before"},{"end_column":76,"end_line":8,"start_column":1,"start_line":8,"text":"committing, and the air temperature at that moment. Females differed in how"},{"end_column":73,"end_line":9,"start_column":1,"start_line":9,"text":"busy they were during the observation session, so most females appear in"},{"end_column":28,"end_line":10,"start_column":1,"start_line":10,"text":"several lines of the table."},{"end_column":9,"end_line":12,"start_column":1,"start_line":12,"text":"Columns:"},{"end_column":82,"end_line":14,"start_column":1,"start_line":14,"text":"- bee_tag: paint-and-number tag of the female making the trip (B-01 through B-08)"},{"end_column":81,"end_line":15,"start_column":1,"start_line":15,"text":"- trip_index: order of that trip within the same female's session, starting at 1"},{"end_column":69,"end_line":16,"start_column":1,"start_line":16,"text":"- ambient_temp_c: air temperature at the block face, degrees Celsius"},{"end_column":85,"end_line":17,"start_column":1,"start_line":17,"text":"- search_time_s: seconds spent hovering in front of the block before entering a tube"},{"end_column":82,"end_line":18,"start_column":1,"start_line":18,"text":"- natal_tube_return: 1 if she entered her own tube, 0 if she entered another tube"},{"end_column":113,"end_line":20,"start_column":1,"start_line":20,"text":"One row is: one provisioning trip by one tagged female bee, scored for whether she returned to her own nest tube"},{"end_column":33,"end_line":21,"start_column":1,"start_line":21,"text":"Independent unit column: bee_tag"},{"end_column":22,"end_line":22,"start_column":1,"start_line":22,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ec4fac3bce8f581b71fc","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:99bac8cba0d20fd5847cd3fa07977d9c477aa9327768549f029283d6ee13d4fc","end_line":22,"locator":"data-description.md:1-22","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:81455080fa6d4f57bdc81dbcab227557","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":33,"end_line":5,"start_column":1,"start_line":5,"text":"- Source table: `data/input.csv`"},{"end_column":32,"end_line":6,"start_column":1,"start_line":6,"text":"- Provisioning trips scored: 24"},{"end_column":39,"end_line":7,"start_column":1,"start_line":7,"text":"- Tagged females contributing trips: 8"},{"end_column":37,"end_line":8,"start_column":1,"start_line":8,"text":"- Trips ending in the natal tube: 18"},{"end_column":25,"end_line":9,"start_column":1,"start_line":9,"text":"- Pooled accuracy: 0.750"},{"end_column":80,"end_line":13,"start_column":1,"start_line":13,"text":"Every provisioning trip in the table was treated as one Bernoulli trial, scored"},{"end_column":77,"end_line":14,"start_column":1,"start_line":14,"text":"1 when the female re-entered her own tube and 0 when she entered a different"},{"end_column":80,"end_line":15,"start_column":1,"start_line":15,"text":"tube. The 24 trips were pooled into a single count and compared with the chance"},{"end_column":60,"end_line":16,"start_column":1,"start_line":16,"text":"expectation of 0.500 using an exact two-sided binomial test"},{"end_column":52,"end_line":17,"start_column":1,"start_line":17,"text":"(`scipy.stats.binomtest`, alternative \"two-sided\")."},{"end_column":173,"end_line":21,"start_column":1,"start_line":21,"text":"[selected-result] Exact two-sided binomial test of 18 natal-tube returns in 24 pooled trips against p0 = 0.500: accuracy = 0.750, p = 0.022656, significant at alpha = 0.05."},{"end_column":47,"end_line":25,"start_column":1,"start_line":25,"text":"| bee_tag | trips | natal returns | accuracy |"},{"end_column":26,"end_line":26,"start_column":1,"start_line":26,"text":"| --- | --- | --- | --- |"},{"end_column":25,"end_line":27,"start_column":1,"start_line":27,"text":"| B-01 | 4 | 3 | 0.750 |"},{"end_column":25,"end_line":28,"start_column":1,"start_line":28,"text":"| B-02 | 3 | 3 | 1.000 |"},{"end_column":25,"end_line":29,"start_column":1,"start_line":29,"text":"| B-03 | 3 | 1 | 0.333 |"},{"end_column":25,"end_line":30,"start_column":1,"start_line":30,"text":"| B-04 | 4 | 4 | 1.000 |"},{"end_column":25,"end_line":31,"start_column":1,"start_line":31,"text":"| B-05 | 2 | 2 | 1.000 |"},{"end_column":25,"end_line":32,"start_column":1,"start_line":32,"text":"| B-06 | 3 | 3 | 1.000 |"},{"end_column":25,"end_line":33,"start_column":1,"start_line":33,"text":"| B-07 | 3 | 0 | 0.000 |"},{"end_column":25,"end_line":34,"start_column":1,"start_line":34,"text":"| B-08 | 2 | 2 | 1.000 |"},{"end_column":42,"end_line":36,"start_column":1,"start_line":36,"text":"Trip counts per female range from 2 to 4."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:88283798fbbcaeb92da9","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:073989a12d0abbe3800e4415c8891a33c3321bb9a1e017e936c95ce2a454ec59","end_line":36,"locator":"results/report.md:1-36","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

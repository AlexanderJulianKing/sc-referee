{"audit_run_id":"audit:564e80291ad14bfd8e2927ddce2ea4c5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":3,"start_column":1,"start_line":3,"text":"Ten separate seagrass meadows along one coastline were mapped from aerial"},{"end_column":77,"end_line":4,"start_column":1,"start_line":4,"text":"imagery in 2015 and mapped again in 2025. Each meadow occupies its own named"},{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"stretch of coast, was surveyed once, and yields a single number: the percentage"},{"end_column":76,"end_line":6,"start_column":1,"start_line":6,"text":"change in its mapped area across the decade. Five of the meadows lie inside"},{"end_column":73,"end_line":7,"start_column":1,"start_line":7,"text":"voluntary no-anchoring zones; the other five are open to boat anchoring."},{"end_column":9,"end_line":9,"start_column":1,"start_line":9,"text":"Columns:"},{"end_column":74,"end_line":11,"start_column":1,"start_line":11,"text":"- meadow_id: unique label for the meadow; a label appears on one row only"},{"end_column":63,"end_line":12,"start_column":1,"start_line":12,"text":"- coast_sector: the named stretch of coast the meadow occupies"},{"end_column":57,"end_line":13,"start_column":1,"start_line":13,"text":"- anchoring_regime: either no_anchor_zone or open_access"},{"end_column":69,"end_line":14,"start_column":1,"start_line":14,"text":"- chart_depth_m: charted water depth at the meadow centre, in metres"},{"end_column":60,"end_line":15,"start_column":1,"start_line":15,"text":"- baseline_area_ha: mapped meadow area in 2015, in hectares"},{"end_column":76,"end_line":16,"start_column":1,"start_line":16,"text":"- area_change_pct_2015_2025: percentage change in mapped area, 2015 to 2025"},{"end_column":93,"end_line":18,"start_column":1,"start_line":18,"text":"One row is: one seagrass meadow surveyed once, with its single decadal change in mapped area"},{"end_column":35,"end_line":19,"start_column":1,"start_line":19,"text":"Independent unit column: meadow_id"},{"end_column":78,"end_line":21,"start_column":1,"start_line":21,"text":"No meadow is measured twice and no two rows come from the same meadow, so the"},{"end_column":80,"end_line":22,"start_column":1,"start_line":22,"text":"values compared between the two anchoring regimes are independent observations."},{"end_column":79,"end_line":23,"start_column":1,"start_line":23,"text":"The depth and baseline-area columns are background context and are not used by"},{"end_column":10,"end_line":24,"start_column":1,"start_line":24,"text":"the test."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e482e51190d165f038c5","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:f7fdea839195b345b06a34a1bf0c37ed7921e6c0dc3c56f91ea977a3c7116bf6","end_line":24,"locator":"data-description.md:1-24","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:564e80291ad14bfd8e2927ddce2ea4c5","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one seagrass meadow surveyed once, so the"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"meadow is the independent unit and contributes exactly one extent-change value."},{"end_column":23,"end_line":8,"start_column":1,"start_line":8,"text":"- Meadows analysed: 10"},{"end_column":54,"end_line":9,"start_column":1,"start_line":9,"text":"- No-anchoring zones: 5 (median extent change 7.60 %)"},{"end_column":56,"end_line":10,"start_column":1,"start_line":10,"text":"- Open-access meadows: 5 (median extent change -6.80 %)"},{"end_column":78,"end_line":14,"start_column":1,"start_line":14,"text":"Two-sided Mann-Whitney U test comparing the 2015-2025 change in mapped meadow"},{"end_column":72,"end_line":15,"start_column":1,"start_line":15,"text":"area between no-anchoring zones and open-access meadows. The exact null"},{"end_column":75,"end_line":16,"start_column":1,"start_line":16,"text":"distribution is used (5 and 5 meadows per regime, all values distinct), so"},{"end_column":66,"end_line":17,"start_column":1,"start_line":17,"text":"no normal approximation or tie correction enters the calculation."},{"end_column":42,"end_line":21,"start_column":1,"start_line":21,"text":"- U statistic (no-anchoring zones) = 23.0"},{"end_column":35,"end_line":22,"start_column":1,"start_line":22,"text":"- Exact two-sided p-value = 0.0317"},{"end_column":36,"end_line":23,"start_column":1,"start_line":23,"text":"- Rank-biserial correlation = 0.840"},{"end_column":268,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Meadow extent change differed between anchoring regimes (exact two-sided Mann-Whitney U = 23.0, 5 vs 5 meadows, p = 0.0317, rank-biserial 0.840): no-anchoring meadows gained area (median +7.60 %) while open-access meadows lost area (median -6.80 %)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:aba5465fed083a7589d7","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:b70fd659922a36c3b7f8a850c94ff8a3972031112d2c0766c6843f0caadc856e","end_line":25,"locator":"results/report.md:1-25","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

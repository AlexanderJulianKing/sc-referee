{"audit_run_id":"audit:60aeaf0e26b4412d9489674e0a2fe706","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":3,"start_column":1,"start_line":3,"text":"A pilot-scale ethanol project compared a wild-type Zymomonas mobilis strain with an"},{"end_column":86,"end_line":4,"start_column":1,"start_line":4,"text":"engineered derivative. Twelve 20 L fermenters were prepared, six for each strain, and"},{"end_column":86,"end_line":5,"start_column":1,"start_line":5,"text":"each fermenter was inoculated from its own seed lot and taken through a single run to"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"harvest. When a run ended, one harvest sample was drawn from that vessel and its"},{"end_column":84,"end_line":7,"start_column":1,"start_line":7,"text":"ethanol concentration was measured; that single number is the vessel's entry in the"},{"end_column":85,"end_line":8,"start_column":1,"start_line":8,"text":"table. No vessel was reused, split between strains, or sampled a second time, so the"},{"end_column":57,"end_line":9,"start_column":1,"start_line":9,"text":"twelve rows stand for twelve separate experimental runs."},{"end_column":27,"end_line":11,"start_column":1,"start_line":11,"text":"Columns in data/input.csv:"},{"end_column":81,"end_line":13,"start_column":1,"start_line":13,"text":"- vessel_id: label of the pilot fermenter, V01 through V12, each appearing once."},{"end_column":84,"end_line":14,"start_column":1,"start_line":14,"text":"- strain_arm: the strain inoculated into that vessel, either wildtype or engineered"},{"end_column":22,"end_line":15,"start_column":3,"start_line":15,"text":"(six vessels each)."},{"end_column":86,"end_line":16,"start_column":1,"start_line":16,"text":"- inoculum_lot: identifier of the seed culture lot used for that vessel; every vessel"},{"end_column":24,"end_line":17,"start_column":3,"start_line":17,"text":"had a lot of its own."},{"end_column":88,"end_line":18,"start_column":1,"start_line":18,"text":"- final_titer_g_per_l: ethanol concentration in the harvest sample, in grams per litre."},{"end_column":102,"end_line":20,"start_column":1,"start_line":20,"text":"One row is: one pilot fermenter, described by the single ethanol titer measured in its harvest sample"},{"end_column":35,"end_line":21,"start_column":1,"start_line":21,"text":"Independent unit column: vessel_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:80866548d6f3b4f9b5ab","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:52f21479fec2c180d0ef6ec1a5cb4e92dc3618c92bcc5f4753e34f7069c41e56","end_line":21,"locator":"data-description.md:1-21","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:60aeaf0e26b4412d9489674e0a2fe706","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":5,"start_column":1,"start_line":5,"text":"Twelve independent 20 L pilot fermenters were taken to harvest, six seeded with the"},{"end_column":82,"end_line":6,"start_column":1,"start_line":6,"text":"wild-type strain and six with the engineered strain. Each vessel received its own"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"inoculum lot and contributes exactly one harvest titer, so the twelve rows of"},{"end_column":86,"end_line":8,"start_column":1,"start_line":8,"text":"data/input.csv are twelve independent units and no vessel is measured more than once."},{"end_column":81,"end_line":12,"start_column":1,"start_line":12,"text":"| Arm | Vessels | Mean (g/L) | SD (g/L) | Median (g/L) | Min (g/L) | Max (g/L) |"},{"end_column":44,"end_line":13,"start_column":1,"start_line":13,"text":"| --- | --- | --- | --- | --- | --- | --- |"},{"end_column":57,"end_line":14,"start_column":1,"start_line":14,"text":"| wild-type | 6 | 42.00 | 1.86 | 41.65 | 39.60 | 44.50 |"},{"end_column":58,"end_line":15,"start_column":1,"start_line":15,"text":"| engineered | 6 | 49.25 | 2.07 | 48.95 | 46.90 | 52.20 |"},{"end_column":76,"end_line":19,"start_column":1,"start_line":19,"text":"With six vessels per arm the two arms were compared with an exact two-sided"},{"end_column":83,"end_line":20,"start_column":1,"start_line":20,"text":"Mann-Whitney U test on the twelve vessel-level titers (no ties are present, so the"},{"end_column":87,"end_line":21,"start_column":1,"start_line":21,"text":"exact null distribution applies). The engineered vessels occupy the six highest ranks,"},{"end_column":78,"end_line":22,"start_column":1,"start_line":22,"text":"giving U = 36.0 with an exact two-sided p-value of 0.00216. The rank-biserial"},{"end_column":81,"end_line":23,"start_column":1,"start_line":23,"text":"correlation is 1.000, the Hodges-Lehmann shift estimate is 7.25 g/L, and the gap"},{"end_column":31,"end_line":24,"start_column":1,"start_line":24,"text":"between arm means is 7.25 g/L."},{"end_column":262,"end_line":26,"start_column":1,"start_line":26,"text":"[selected-result] Exact two-sided Mann-Whitney U test on 12 independent pilot fermenters (6 engineered vs 6 wild-type, one harvest titer per vessel): U = 36.0, p = 0.00216, Hodges-Lehmann shift +7.25 g/L, so the engineered strain reaches the higher final titer."},{"end_column":84,"end_line":30,"start_column":1,"start_line":30,"text":"The strains were assigned to whole vessels and the comparison is made at the vessel"},{"end_column":85,"end_line":31,"start_column":1,"start_line":31,"text":"level, so the independence assumption of the exact test is satisfied by construction"},{"end_column":81,"end_line":32,"start_column":1,"start_line":32,"text":"rather than by argument. Complete separation of the two arms yields the smallest"},{"end_column":82,"end_line":33,"start_column":1,"start_line":33,"text":"p-value this design can return, so the result is best read as evidence that is as"},{"end_column":67,"end_line":34,"start_column":1,"start_line":34,"text":"strong as twelve runs allow, not as a finely resolved probability."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1b1d240a0ec259cb318f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:70e647436e9cbac9047174dcc0df633b094d39aaea64fcedc1172376c7f93357","end_line":34,"locator":"results/report.md:1-34","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

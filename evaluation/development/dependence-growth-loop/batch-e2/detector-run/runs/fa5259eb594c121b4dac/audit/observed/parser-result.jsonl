{"audit_run_id":"audit:9d228dde10d745f1ba62292436790255","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Five queenright Lasius niger colonies, each collected from a separate roadside"},{"end_column":82,"end_line":4,"start_column":1,"start_line":4,"text":"verge and housed in its own nest box, were tested four times apiece on a Y-shaped"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"foam bridge. In every test one arm of the bridge carried a freshly applied"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"trail-pheromone extract and the other arm was left plain; the side carrying the"},{"end_column":70,"end_line":7,"start_column":1,"start_line":7,"text":"extract was alternated between successive tests of a colony. A single"},{"end_column":82,"end_line":8,"start_column":1,"start_line":8,"text":"paint-marked forager was released at the base of the bridge, the arm it committed"},{"end_column":80,"end_line":9,"start_column":1,"start_line":9,"text":"to was recorded, and the observer logged how long the forager took to cross the"},{"end_column":70,"end_line":10,"start_column":1,"start_line":10,"text":"choice line and how many nestmates were on the bridge at that moment."},{"end_column":163,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one Y-bridge test of a single forager from one colony, giving the arm it chose, its commitment latency, and the bridge traffic at the moment of choice"},{"end_column":35,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: colony_id"},{"end_column":22,"end_line":14,"start_column":1,"start_line":14,"text":"One trial is: one row"},{"end_column":9,"end_line":16,"start_column":1,"start_line":16,"text":"Columns:"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"- colony_id: the source colony (COL-01 through COL-05); each colony contributed"},{"end_column":54,"end_line":19,"start_column":3,"start_line":19,"text":"four tests, so the same colony appears on four rows"},{"end_column":75,"end_line":20,"start_column":1,"start_line":20,"text":"- trial_no: position of the test within that colony's own sequence, 1 to 4"},{"end_column":81,"end_line":21,"start_column":1,"start_line":21,"text":"- arm_chosen: \"marked\" if the forager took the pheromone-treated arm, \"plain\" if"},{"end_column":28,"end_line":22,"start_column":3,"start_line":22,"text":"it took the untreated arm"},{"end_column":77,"end_line":23,"start_column":1,"start_line":23,"text":"- latency_s: seconds from release until the forager crossed the choice line,"},{"end_column":32,"end_line":24,"start_column":3,"start_line":24,"text":"recorded to one decimal place"},{"end_column":78,"end_line":25,"start_column":1,"start_line":25,"text":"- foragers_on_bridge: count of other foragers on the bridge at the moment the"},{"end_column":18,"end_line":26,"start_column":3,"start_line":26,"text":"choice was made"},{"end_column":82,"end_line":28,"start_column":1,"start_line":28,"text":"There are 20 rows in total: 5 colonies x 4 tests. Colonies differ noticeably from"},{"end_column":77,"end_line":29,"start_column":1,"start_line":29,"text":"one another in how strongly they follow the extract, and tests from the same"},{"end_column":81,"end_line":30,"start_column":1,"start_line":30,"text":"colony were run with the same nest, the same forager pool, and the same batch of"},{"end_column":19,"end_line":31,"start_column":1,"start_line":31,"text":"pheromone extract."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:6d0df6d0721398b810dd","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:bd417d6e380641386dace9cc9987ca6fc2bc02aa1bb76e63cbe2d2f7ed8145d0","end_line":31,"locator":"data-description.md:1-31","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:9d228dde10d745f1ba62292436790255","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"Each row of `data/input.csv` is one Y-bridge choice trial. A trial counted"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"as a success when the focal forager committed to the pheromone-marked arm."},{"end_column":66,"end_line":7,"start_column":1,"start_line":7,"text":"All 20 trials were pooled and submitted to an exact binomial test"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"(`scipy.stats.binomtest`, two-sided) against the no-preference null p = 0.500."},{"end_column":20,"end_line":12,"start_column":1,"start_line":12,"text":"- Trials scored: 20"},{"end_column":32,"end_line":13,"start_column":1,"start_line":13,"text":"- Choices of the marked arm: 15"},{"end_column":29,"end_line":14,"start_column":1,"start_line":14,"text":"- Observed proportion: 0.750"},{"end_column":34,"end_line":15,"start_column":1,"start_line":15,"text":"- Mean commitment latency: 60.0 s"},{"end_column":207,"end_line":17,"start_column":1,"start_line":17,"text":"[selected-result] Exact binomial test: 15 of 20 trials took the marked arm (proportion 0.750) against a null proportion of 0.500; two-sided p = 0.0414, so the no-preference null is rejected at alpha = 0.05."},{"end_column":70,"end_line":21,"start_column":1,"start_line":21,"text":"Foragers took the pheromone-marked arm more often than expected under"},{"end_column":69,"end_line":22,"start_column":1,"start_line":22,"text":"chance, consistent with trail-pheromone guidance at the bifurcation."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:af8c80c98516a1129c06","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:53736888d90cf5bbe7579abfd5bfe9c38d1c66d2b8ff770c43d7ce3882e433f2","end_line":22,"locator":"results/report.md:1-22","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

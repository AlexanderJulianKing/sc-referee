{"audit_run_id":"audit:f31da5d566134415abd845b89d88be65","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Six adult whip spiders (Phrynus laevifrons) were released one at a time into a"},{"end_column":80,"end_line":4,"start_column":1,"start_line":4,"text":"darkened T-junction arena and allowed to walk into either the left or the right"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"arm. Every animal was run six times on the same evening, so the file holds"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"thirty-six runs in total: six consecutive runs for each of the six individuals."},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"The arena was wiped down between runs and the two arms were swapped in position"},{"end_column":29,"end_line":8,"start_column":1,"start_line":8,"text":"halfway through the session."},{"end_column":9,"end_line":10,"start_column":1,"start_line":10,"text":"Columns:"},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"- animal_id: the code of the individual whip spider (AMB-01 through AMB-06)."},{"end_column":76,"end_line":13,"start_column":1,"start_line":13,"text":"- trial_index: which of that animal's six runs this row describes (1 to 6)."},{"end_column":72,"end_line":14,"start_column":1,"start_line":14,"text":"- arm_chosen: the arm the animal walked into, either \"left\" or \"right\"."},{"end_column":64,"end_line":15,"start_column":1,"start_line":15,"text":"- latency_s: seconds from release to crossing the choice point."},{"end_column":50,"end_line":17,"start_column":1,"start_line":17,"text":"One row is: one T-junction run by one whip spider"},{"end_column":22,"end_line":18,"start_column":1,"start_line":18,"text":"One trial is: one row"},{"end_column":35,"end_line":19,"start_column":1,"start_line":19,"text":"Independent unit column: animal_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:cfb0aebc6cd680c4d777","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:ab611ad0504d62c701bb4f80c4167cb9309ffe2ec34ea2b7e966d48036ab56cd","end_line":19,"locator":"data-description.md:1-19","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:f31da5d566134415abd845b89d88be65","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"The file `data/input.csv` records 36 T-junction trials from 6 whip spiders,"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"6 trials per animal. Each row is one trial and stores the arm the animal"},{"end_column":56,"end_line":7,"start_column":1,"start_line":7,"text":"entered and its latency to the choice point in seconds."},{"end_column":77,"end_line":11,"start_column":1,"start_line":11,"text":"Every trial in the file was treated as one Bernoulli observation. The pooled"},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"count of right-arm entries was compared against a chance rate of 0.5 with an"},{"end_column":55,"end_line":13,"start_column":1,"start_line":13,"text":"exact two-sided binomial test (scipy.stats.binomtest)."},{"end_column":51,"end_line":17,"start_column":1,"start_line":17,"text":"| animal_id | trials | right-arm entries | share |"},{"end_column":26,"end_line":18,"start_column":1,"start_line":18,"text":"| --- | --- | --- | --- |"},{"end_column":27,"end_line":19,"start_column":1,"start_line":19,"text":"| AMB-01 | 6 | 6 | 1.000 |"},{"end_column":27,"end_line":20,"start_column":1,"start_line":20,"text":"| AMB-02 | 6 | 5 | 0.833 |"},{"end_column":27,"end_line":21,"start_column":1,"start_line":21,"text":"| AMB-03 | 6 | 5 | 0.833 |"},{"end_column":27,"end_line":22,"start_column":1,"start_line":22,"text":"| AMB-04 | 6 | 4 | 0.667 |"},{"end_column":27,"end_line":23,"start_column":1,"start_line":23,"text":"| AMB-05 | 6 | 3 | 0.500 |"},{"end_column":27,"end_line":24,"start_column":1,"start_line":24,"text":"| AMB-06 | 6 | 2 | 0.333 |"},{"end_column":57,"end_line":28,"start_column":1,"start_line":28,"text":"Right-arm entries: 25 of 36 trials (pooled share 0.694)."},{"end_column":55,"end_line":29,"start_column":1,"start_line":29,"text":"Exact two-sided binomial test against 0.5: p = 0.0288."},{"end_column":42,"end_line":30,"start_column":1,"start_line":30,"text":"Mean latency to the choice point: 41.9 s."},{"end_column":205,"end_line":32,"start_column":1,"start_line":32,"text":"[selected-result] Exact two-sided binomial test on 36 pooled trials with 25 right-arm entries against a chance rate of 0.5 gives p = 0.0288 (pooled share 0.694), a departure from chance at the 0.05 level."},{"end_column":58,"end_line":36,"start_column":1,"start_line":36,"text":"The 36 trials come from 6 animals, 6 trials each, and the"},{"end_column":62,"end_line":37,"start_column":1,"start_line":37,"text":"per-animal shares span 0.333 to 1.000. Each trial contributes"},{"end_column":35,"end_line":38,"start_column":1,"start_line":38,"text":"one observation to the test above."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e145537056605e9fded5","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:ead7b752c6929b798eb0902c170da14027b75e24d96a367e37fdc14a6df49b18","end_line":38,"locator":"results/report.md:1-38","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

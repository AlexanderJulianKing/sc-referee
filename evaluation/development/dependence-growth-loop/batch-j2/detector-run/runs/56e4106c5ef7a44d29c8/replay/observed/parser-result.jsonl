{"audit_run_id":"audit:f91542515eaa4404be4a2a31fee23bd2","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":3,"start_column":1,"start_line":3,"text":"`data/input.csv` holds the field log from a single growing season on the"},{"end_column":73,"end_line":4,"start_column":1,"start_line":4,"text":"Sarvisuo mire, where methane ebullition was scored during static-chamber"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"closures on six permanent collars. Three collars sit in an intact fen section"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"and three sit in a block that was ditch-drained for forestry in the 1970s."},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"Each collar was revisited in survey weeks 24, 27 and 31; two collars were not"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"reachable in week 31, so those collars contribute two deployments instead of"},{"end_column":7,"end_line":9,"start_column":1,"start_line":9,"text":"three."},{"end_column":9,"end_line":11,"start_column":1,"start_line":11,"text":"Columns:"},{"end_column":74,"end_line":13,"start_column":1,"start_line":13,"text":"- `deployment_id`: label for one chamber closure, unique across the file."},{"end_column":77,"end_line":14,"start_column":1,"start_line":14,"text":"- `collar_id`: the permanent collar the chamber was seated on (FEN-* collars"},{"end_column":77,"end_line":15,"start_column":3,"start_line":15,"text":"are intact, DRN-* collars are drained). The same collar appears in several"},{"end_column":20,"end_line":16,"start_column":3,"start_line":16,"text":"rows of the file."},{"end_column":77,"end_line":17,"start_column":1,"start_line":17,"text":"- `drainage_status`: `intact` or `drained`, a property of the collar's block"},{"end_column":39,"end_line":18,"start_column":3,"start_line":18,"text":"rather than of the individual visit."},{"end_column":47,"end_line":19,"start_column":1,"start_line":19,"text":"- `survey_week`: ISO week number of the visit."},{"end_column":67,"end_line":20,"start_column":1,"start_line":20,"text":"- `peat_temp_c`: peat temperature at 10 cm depth, degrees Celsius."},{"end_column":74,"end_line":21,"start_column":1,"start_line":21,"text":"- `water_table_cm`: water table position relative to the peat surface, in"},{"end_column":55,"end_line":22,"start_column":3,"start_line":22,"text":"centimetres (negative values are below the surface)."},{"end_column":74,"end_line":23,"start_column":1,"start_line":23,"text":"- `ebullition_detected`: `yes` if at least one bubble release was seen or"},{"end_column":45,"end_line":24,"start_column":3,"start_line":24,"text":"logged during the closure, otherwise `no`."},{"end_column":82,"end_line":26,"start_column":1,"start_line":26,"text":"One row is: one static-chamber closure on one permanent collar in one survey week"},{"end_column":35,"end_line":27,"start_column":1,"start_line":27,"text":"Independent unit column: collar_id"},{"end_column":22,"end_line":28,"start_column":1,"start_line":28,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:30643b5148b7860a974a","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:c76903ee86531627058d4a19eccf1709e434b641e121be51beec82a5742c4de4","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:f91542515eaa4404be4a2a31fee23bd2","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Each row is one static-chamber deployment scored for a visible ebullition"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"(bubble release) event during the closure window. Deployments were made on"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"permanent collars, and every collar was visited on more than one survey week."},{"end_column":61,"end_line":11,"start_column":1,"start_line":11,"text":"| collar | drainage status | deployments | with ebullition |"},{"end_column":26,"end_line":12,"start_column":1,"start_line":12,"text":"| --- | --- | --- | --- |"},{"end_column":28,"end_line":13,"start_column":1,"start_line":13,"text":"| FEN-01 | intact | 3 | 3 |"},{"end_column":28,"end_line":14,"start_column":1,"start_line":14,"text":"| FEN-02 | intact | 3 | 2 |"},{"end_column":28,"end_line":15,"start_column":1,"start_line":15,"text":"| FEN-03 | intact | 2 | 2 |"},{"end_column":29,"end_line":16,"start_column":1,"start_line":16,"text":"| DRN-01 | drained | 3 | 1 |"},{"end_column":29,"end_line":17,"start_column":1,"start_line":17,"text":"| DRN-02 | drained | 3 | 0 |"},{"end_column":29,"end_line":18,"start_column":1,"start_line":18,"text":"| DRN-03 | drained | 2 | 1 |"},{"end_column":74,"end_line":22,"start_column":1,"start_line":22,"text":"The 16 deployments were cross-tabulated by drainage status and ebullition"},{"end_column":75,"end_line":23,"start_column":1,"start_line":23,"text":"outcome, and the 2x2 table was submitted to a two-sided Fisher exact test."},{"end_column":65,"end_line":24,"start_column":1,"start_line":24,"text":"Every deployment row entered the table as one independent trial."},{"end_column":34,"end_line":26,"start_column":1,"start_line":26,"text":"|  | ebullition | no ebullition |"},{"end_column":20,"end_line":27,"start_column":1,"start_line":27,"text":"| --- | --- | --- |"},{"end_column":19,"end_line":28,"start_column":1,"start_line":28,"text":"| intact | 7 | 1 |"},{"end_column":20,"end_line":29,"start_column":1,"start_line":29,"text":"| drained | 2 | 6 |"},{"end_column":73,"end_line":31,"start_column":1,"start_line":31,"text":"Detection frequency was 7/8 (87.5%) on intact collars and 2/8 (25.0%) on"},{"end_column":49,"end_line":32,"start_column":1,"start_line":32,"text":"drained collars; the sample odds ratio is 21.00."},{"end_column":178,"end_line":36,"start_column":1,"start_line":36,"text":"[selected-result] Two-sided Fisher exact test on 16 chamber deployments: odds ratio 21.00 for ebullition on intact versus drained peat (7/8 against 2/8 deployments), p = 0.0406."},{"end_column":75,"end_line":38,"start_column":1,"start_line":38,"text":"Deployments were treated as independent trials, so the test counts 16 rows"},{"end_column":41,"end_line":39,"start_column":1,"start_line":39,"text":"across the 6 collars that produced them."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:11da35ae8e0dce53e947","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:86d53ddee49a95b5d30b9d13cf85b2acb595e615626f02f684d22b34a2612e3d","end_line":39,"locator":"results/report.md:1-39","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

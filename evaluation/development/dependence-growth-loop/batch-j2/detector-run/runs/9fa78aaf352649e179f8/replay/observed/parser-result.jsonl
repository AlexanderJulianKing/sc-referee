{"audit_run_id":"audit:a0c83fdc9c0546be96b99af44ad048fb","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":87,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve 400 L recirculating tanks were stocked with juvenile Atlantic salmon of similar"},{"end_column":90,"end_line":4,"start_column":1,"start_line":4,"text":"size. Six tanks were randomly assigned the standard ration and six the same ration with a"},{"end_column":89,"end_line":5,"start_column":1,"start_line":5,"text":"beta-glucan supplement blended in. After a two-week acclimation the tanks were placed on"},{"end_column":87,"end_line":6,"start_column":1,"start_line":6,"text":"an intermittent-flow respirometry loop and routine oxygen uptake was logged overnight."},{"end_column":91,"end_line":7,"start_column":1,"start_line":7,"text":"Each tank was measured on up to four separate nights during one trial week; two tanks lost"},{"end_column":54,"end_line":8,"start_column":1,"start_line":8,"text":"a night to a chiller fault, so the log is unbalanced."},{"end_column":60,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: one overnight respirometry session for one tank"},{"end_column":33,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: tank_id"},{"end_column":8,"end_line":13,"start_column":1,"start_line":13,"text":"Columns"},{"end_column":91,"end_line":15,"start_column":1,"start_line":15,"text":"- tank_id: label of the tank (T01 to T12). Diet was assigned to whole tanks, and each tank"},{"end_column":91,"end_line":16,"start_column":3,"start_line":16,"text":"has its own water loop, feeder and biofilter, so tanks share no fish, water or handling."},{"end_column":91,"end_line":17,"start_column":1,"start_line":17,"text":"- diet: ration fed to that tank, either control or bglucan (beta-glucan supplemented). The"},{"end_column":54,"end_line":18,"start_column":3,"start_line":18,"text":"value is fixed for a tank across all of its nights."},{"end_column":71,"end_line":19,"start_column":1,"start_line":19,"text":"- night: index of the measurement night within the trial week, 1 to 4."},{"end_column":79,"end_line":20,"start_column":1,"start_line":20,"text":"- water_temp_c: mean water temperature during the session, in degrees Celsius."},{"end_column":62,"end_line":21,"start_column":1,"start_line":21,"text":"- n_fish: number of fish held in the tank during the session."},{"end_column":89,"end_line":22,"start_column":1,"start_line":22,"text":"- mo2_mg_kg_h: mass-specific oxygen uptake of the tank during the session, in milligrams"},{"end_column":43,"end_line":23,"start_column":3,"start_line":23,"text":"of oxygen per kilogram of fish per hour."},{"end_column":89,"end_line":25,"start_column":1,"start_line":25,"text":"Because the same tank appears on several rows, the rows are repeated measurements of the"},{"end_column":90,"end_line":26,"start_column":1,"start_line":26,"text":"same unit: the 46 rows come from only 12 tanks, and six tanks per diet is the replication"},{"end_column":90,"end_line":27,"start_column":1,"start_line":27,"text":"available for any diet comparison. Session values should therefore be summarised within a"},{"end_column":47,"end_line":28,"start_column":1,"start_line":28,"text":"tank before a between-diet comparison is made."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4785a58e832447c3e29f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:a28e6a750b28fddcb7a79f19caa18ba3debe023801a04f8afe5d618300ffc4c2","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:a0c83fdc9c0546be96b99af44ad048fb","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"The file data/input.csv contains 46 overnight respirometry sessions recorded on"},{"end_column":82,"end_line":6,"start_column":1,"start_line":6,"text":"12 recirculating tanks: 6 fed the control ration and 6 fed the same ration with a"},{"end_column":88,"end_line":7,"start_column":1,"start_line":7,"text":"beta-glucan supplement. Each tank was measured on three or four separate nights, so the"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"46 rows are repeated sessions rather than 46 independent observations. Diet was"},{"end_column":90,"end_line":9,"start_column":1,"start_line":9,"text":"randomised to whole tanks, and each tank ran on its own water loop, feeder and biofilter,"},{"end_column":50,"end_line":10,"start_column":1,"start_line":10,"text":"so the tank is the independent experimental unit."},{"end_column":79,"end_line":14,"start_column":1,"start_line":14,"text":"Sessions were averaged within each tank before any test was run, so every tank"},{"end_column":89,"end_line":15,"start_column":1,"start_line":15,"text":"contributes exactly one value (mass-specific oxygen uptake, MO2, in mg O2 kg^-1 h^-1) to"},{"end_column":87,"end_line":16,"start_column":1,"start_line":16,"text":"the comparison. The two diets were then compared with a two-sided exact Mann-Whitney U"},{"end_column":89,"end_line":17,"start_column":1,"start_line":17,"text":"test on the 12 tank means (6 control vs 6 beta-glucan). The individual session rows were"},{"end_column":29,"end_line":18,"start_column":1,"start_line":18,"text":"never entered into the test."},{"end_column":57,"end_line":22,"start_column":1,"start_line":22,"text":"| tank | diet | sessions | mean MO2 (mg O2 kg^-1 h^-1) |"},{"end_column":26,"end_line":23,"start_column":1,"start_line":23,"text":"| --- | --- | --- | --- |"},{"end_column":31,"end_line":24,"start_column":1,"start_line":24,"text":"| T01 | control | 4 | 209.75 |"},{"end_column":35,"end_line":25,"start_column":1,"start_line":25,"text":"| T02 | beta-glucan | 4 | 228.75 |"},{"end_column":31,"end_line":26,"start_column":1,"start_line":26,"text":"| T03 | control | 4 | 198.20 |"},{"end_column":35,"end_line":27,"start_column":1,"start_line":27,"text":"| T04 | beta-glucan | 4 | 212.30 |"},{"end_column":31,"end_line":28,"start_column":1,"start_line":28,"text":"| T05 | control | 3 | 219.30 |"},{"end_column":35,"end_line":29,"start_column":1,"start_line":29,"text":"| T06 | beta-glucan | 4 | 241.25 |"},{"end_column":31,"end_line":30,"start_column":1,"start_line":30,"text":"| T07 | control | 4 | 205.10 |"},{"end_column":35,"end_line":31,"start_column":1,"start_line":31,"text":"| T08 | beta-glucan | 4 | 224.40 |"},{"end_column":31,"end_line":32,"start_column":1,"start_line":32,"text":"| T09 | control | 4 | 215.60 |"},{"end_column":35,"end_line":33,"start_column":1,"start_line":33,"text":"| T10 | beta-glucan | 3 | 233.10 |"},{"end_column":31,"end_line":34,"start_column":1,"start_line":34,"text":"| T11 | control | 4 | 202.45 |"},{"end_column":35,"end_line":35,"start_column":1,"start_line":35,"text":"| T12 | beta-glucan | 4 | 237.90 |"},{"end_column":88,"end_line":39,"start_column":1,"start_line":39,"text":"Averaged over tanks, MO2 was 229.62 mg O2 kg^-1 h^-1 on the beta-glucan diet and 208.40"},{"end_column":88,"end_line":40,"start_column":1,"start_line":40,"text":"on the control diet; the tank medians were 230.9 and 207.4, a median difference of 23.5"},{"end_column":85,"end_line":41,"start_column":1,"start_line":41,"text":"mg O2 kg^-1 h^-1. The exact Mann-Whitney U test on the 12 tank means gives U = 34.0,"},{"end_column":47,"end_line":42,"start_column":1,"start_line":42,"text":"p = 0.008658, rank-biserial correlation 0.889."},{"end_column":207,"end_line":44,"start_column":1,"start_line":44,"text":"[selected-result] Tanks fed the beta-glucan supplement had higher routine oxygen uptake than control tanks (two-sided exact Mann-Whitney U on 6 vs 6 tank means, U = 34.0, p = 0.008658, rank-biserial 0.889)."},{"end_column":88,"end_line":48,"start_column":1,"start_line":48,"text":"Tanks T05 and T10 each lost one night to a chiller fault; the unbalanced session counts"},{"end_column":86,"end_line":49,"start_column":1,"start_line":49,"text":"change the precision of those two tank means but not the number of independent units,"},{"end_column":89,"end_line":50,"start_column":1,"start_line":50,"text":"which stays at one per tank. A rank test was preferred to a t test because six tanks per"},{"end_column":49,"end_line":51,"start_column":1,"start_line":51,"text":"diet give little leverage for judging normality."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:f9814b56a7d0eedfe3bd","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:4f557e58e341df9f8c6fd811cce364f4185e274b5eff90e01c652f426f175d4e","end_line":51,"locator":"results/report.md:1-51","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

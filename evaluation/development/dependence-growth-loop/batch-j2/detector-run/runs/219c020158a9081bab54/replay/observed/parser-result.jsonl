{"audit_run_id":"audit:c6081ef0259d4b8fba89a1d08fdbc1e2","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"Berth 7 is a steel sheet-pile quay wall. Twelve pilings along the berth were"},{"end_column":76,"end_line":4,"start_column":1,"start_line":4,"text":"picked for a coating trial: alternate pilings were recoated with the yard's"},{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"usual coal tar epoxy, the others with a glass-flake polyester system. Four"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"years later a diver crew re-gauged every piling with an ultrasonic thickness"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"probe at four fixed depth bands below mean sea level, and each reading was"},{"end_column":46,"end_line":8,"start_column":1,"start_line":8,"text":"turned into an average annual thickness loss."},{"end_column":79,"end_line":10,"start_column":1,"start_line":10,"text":"The table holds one line per gauge reading, so a single piling appears on four"},{"end_column":79,"end_line":11,"start_column":1,"start_line":11,"text":"consecutive lines - once for each of its depth bands. All four readings from a"},{"end_column":78,"end_line":12,"start_column":1,"start_line":12,"text":"piling share that piling's coating system, its position on the berth, and its"},{"end_column":45,"end_line":13,"start_column":1,"start_line":13,"text":"exposure to the tide and to passing traffic."},{"end_column":9,"end_line":15,"start_column":1,"start_line":15,"text":"Columns:"},{"end_column":61,"end_line":17,"start_column":1,"start_line":17,"text":"- piling_id: which piling was gauged, PIL-01 through PIL-12."},{"end_column":68,"end_line":18,"start_column":1,"start_line":18,"text":"- coating_system: the protective system that piling carries, either"},{"end_column":78,"end_line":19,"start_column":3,"start_line":19,"text":"coal_tar_epoxy or glassflake_polyester. A piling carries the same system on"},{"end_column":29,"end_line":20,"start_column":3,"start_line":20,"text":"every one of its readings."},{"end_column":77,"end_line":21,"start_column":1,"start_line":21,"text":"- depth_band_m: depth of the gauge spot below mean sea level, in metres. The"},{"end_column":66,"end_line":22,"start_column":3,"start_line":22,"text":"same four bands (0.5, 1.5, 3.0, 5.0) were used on every piling."},{"end_column":77,"end_line":23,"start_column":1,"start_line":23,"text":"- wall_thickness_mm: steel wall thickness left at that spot, in millimetres,"},{"end_column":36,"end_line":24,"start_column":3,"start_line":24,"text":"against a 14.00 mm as-built wall."},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"- corrosion_rate_um_per_yr: thickness loss at that spot averaged over the four"},{"end_column":76,"end_line":26,"start_column":3,"start_line":26,"text":"service years, in micrometres per year. This is the response of interest;"},{"end_column":60,"end_line":27,"start_column":3,"start_line":27,"text":"bigger numbers mean the steel is being eaten away faster."},{"end_column":77,"end_line":29,"start_column":1,"start_line":29,"text":"One row is: one ultrasonic thickness reading on one piling at one depth band"},{"end_column":35,"end_line":30,"start_column":1,"start_line":30,"text":"Independent unit column: piling_id"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:82a12db490035ebbc6b5","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:3018d14d475e37b016e4d5b0367d452aa484bd2f2853f6e1fdfe16f5bcbf7e28","end_line":30,"locator":"data-description.md:1-30","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:c6081ef0259d4b8fba89a1d08fdbc1e2","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":3,"start_column":1,"start_line":3,"text":"Source table: `data/input.csv` - 48 ultrasonic gauge readings from 12 pilings."},{"end_column":73,"end_line":7,"start_column":1,"start_line":7,"text":"Twelve steel sheet pilings at Berth 7 were re-gauged after four years in"},{"end_column":71,"end_line":8,"start_column":1,"start_line":8,"text":"service. Alternate pilings along the berth carry one of two protective"},{"end_column":70,"end_line":9,"start_column":1,"start_line":9,"text":"coating systems. Every piling was gauged in the same four depth bands"},{"end_column":69,"end_line":10,"start_column":1,"start_line":10,"text":"(0.5 m, 1.5 m, 3.0 m and 5.0 m below mean sea level), and each gauge"},{"end_column":72,"end_line":11,"start_column":1,"start_line":11,"text":"reading is converted to a mean annual thickness loss in micrometres per"},{"end_column":6,"end_line":12,"start_column":1,"start_line":12,"text":"year."},{"end_column":63,"end_line":16,"start_column":1,"start_line":16,"text":"| coating system | readings | mean rate (um/yr) | sd (um/yr) |"},{"end_column":29,"end_line":17,"start_column":1,"start_line":17,"text":"| --- | ---: | ---: | ---: |"},{"end_column":39,"end_line":18,"start_column":1,"start_line":18,"text":"| coal_tar_epoxy | 24 | 62.40 | 6.63 |"},{"end_column":45,"end_line":19,"start_column":1,"start_line":19,"text":"| glassflake_polyester | 24 | 48.40 | 6.19 |"},{"end_column":59,"end_line":23,"start_column":1,"start_line":23,"text":"| piling | coating system | readings | mean rate (um/yr) |"},{"end_column":28,"end_line":24,"start_column":1,"start_line":24,"text":"| --- | --- | ---: | ---: |"},{"end_column":40,"end_line":25,"start_column":1,"start_line":25,"text":"| PIL-01 | coal_tar_epoxy | 4 | 54.40 |"},{"end_column":40,"end_line":26,"start_column":1,"start_line":26,"text":"| PIL-03 | coal_tar_epoxy | 4 | 58.40 |"},{"end_column":40,"end_line":27,"start_column":1,"start_line":27,"text":"| PIL-05 | coal_tar_epoxy | 4 | 60.40 |"},{"end_column":40,"end_line":28,"start_column":1,"start_line":28,"text":"| PIL-07 | coal_tar_epoxy | 4 | 62.40 |"},{"end_column":40,"end_line":29,"start_column":1,"start_line":29,"text":"| PIL-09 | coal_tar_epoxy | 4 | 66.40 |"},{"end_column":40,"end_line":30,"start_column":1,"start_line":30,"text":"| PIL-11 | coal_tar_epoxy | 4 | 72.40 |"},{"end_column":46,"end_line":31,"start_column":1,"start_line":31,"text":"| PIL-02 | glassflake_polyester | 4 | 40.40 |"},{"end_column":46,"end_line":32,"start_column":1,"start_line":32,"text":"| PIL-04 | glassflake_polyester | 4 | 44.40 |"},{"end_column":46,"end_line":33,"start_column":1,"start_line":33,"text":"| PIL-06 | glassflake_polyester | 4 | 46.40 |"},{"end_column":46,"end_line":34,"start_column":1,"start_line":34,"text":"| PIL-08 | glassflake_polyester | 4 | 50.40 |"},{"end_column":46,"end_line":35,"start_column":1,"start_line":35,"text":"| PIL-10 | glassflake_polyester | 4 | 52.40 |"},{"end_column":46,"end_line":36,"start_column":1,"start_line":36,"text":"| PIL-12 | glassflake_polyester | 4 | 56.40 |"},{"end_column":73,"end_line":40,"start_column":1,"start_line":40,"text":"Two-sample Student t test (equal variances assumed), one observation per"},{"end_column":70,"end_line":41,"start_column":1,"start_line":41,"text":"gauge reading, comparing coal_tar_epoxy against glassflake_polyester."},{"end_column":210,"end_line":43,"start_column":1,"start_line":43,"text":"[selected-result] Two-sample t test on 48 gauge readings: coal_tar_epoxy mean 62.40 um/yr vs glassflake_polyester mean 48.40 um/yr, difference 14.00 um/yr, t(46) = 7.56, p < 0.001, significant at alpha = 0.05."},{"end_column":65,"end_line":45,"start_column":1,"start_line":45,"text":"All 48 rows were entered into the test as separate observations."}],"x-expected-count-method-declarations":[]
{"audit_run_id":"audit:71b9f9a0f5aa46dfb115d27536a5c014","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"Twenty-four nursery pots were filled from one batch of screened field soil, and"},{"end_column":77,"end_line":4,"start_column":1,"start_line":4,"text":"each pot received exactly one sulphur buckwheat (Eriogonum umbellatum) seed."},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"Every seed came from a different wild maternal plant, so no maternal plant is"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"represented twice. Half of the seeds were coated in a clay-and-compost pellet"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"before sowing; the other half were sown bare. All pots shared the same watering"},{"end_column":78,"end_line":8,"start_column":1,"start_line":8,"text":"schedule and were scored a single time, on day 28, for whether a seedling had"},{"end_column":25,"end_line":9,"start_column":1,"start_line":9,"text":"broken the soil surface."},{"end_column":9,"end_line":11,"start_column":1,"start_line":11,"text":"Columns:"},{"end_column":54,"end_line":13,"start_column":1,"start_line":13,"text":"- pot_id: unique label for the pot (P01 through P24)."},{"end_column":76,"end_line":14,"start_column":1,"start_line":14,"text":"- maternal_plant_id: the wild plant that supplied the seed; every pot has a"},{"end_column":17,"end_line":15,"start_column":3,"start_line":15,"text":"different one."},{"end_column":79,"end_line":16,"start_column":1,"start_line":16,"text":"- seed_treatment: \"pelleted\" if the seed carried the clay-and-compost coating,"},{"end_column":20,"end_line":17,"start_column":3,"start_line":17,"text":"\"bare\" otherwise."},{"end_column":76,"end_line":18,"start_column":1,"start_line":18,"text":"- seed_mass_mg: mass of the sown seed in milligrams, weighed before sowing."},{"end_column":69,"end_line":19,"start_column":1,"start_line":19,"text":"- emerged_by_day28: 1 if a seedling had emerged by day 28, 0 if not."},{"end_column":80,"end_line":21,"start_column":1,"start_line":21,"text":"Each pot holds one seed, receives one treatment, and yields one yes/no outcome,"},{"end_column":75,"end_line":22,"start_column":1,"start_line":22,"text":"so nothing in the file is a repeated measurement of the same pot, seed, or"},{"end_column":77,"end_line":23,"start_column":1,"start_line":23,"text":"maternal plant. The comparison of interest is the emergence rate of pelleted"},{"end_column":18,"end_line":24,"start_column":1,"start_line":24,"text":"versus bare seed."},{"end_column":101,"end_line":26,"start_column":1,"start_line":26,"text":"One row is: one nursery pot holding a single sown seed, scored once for seedling emergence at day 28"},{"end_column":32,"end_line":27,"start_column":1,"start_line":27,"text":"Independent unit column: pot_id"},{"end_column":22,"end_line":28,"start_column":1,"start_line":28,"text":"One trial is: one row"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:8ff983eb441a581b3a8f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:9ee9f75da87e924f50e86988e694004f7d99abfd33cbb32716cd8a337a157697","end_line":28,"locator":"data-description.md:1-28","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:71b9f9a0f5aa46dfb115d27536a5c014","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":75,"end_line":5,"start_column":1,"start_line":5,"text":"24 pots, one seed and one maternal plant per pot, each pot scored once for"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"seedling emergence at day 28. Each pot is an independent experimental unit and"},{"end_column":29,"end_line":7,"start_column":1,"start_line":7,"text":"contributes exactly one row."},{"end_column":62,"end_line":9,"start_column":1,"start_line":9,"text":"| Seed treatment | Emerged | Not emerged | Pots | Emergence |"},{"end_column":32,"end_line":10,"start_column":1,"start_line":10,"text":"| --- | --- | --- | --- | --- |"},{"end_column":34,"end_line":11,"start_column":1,"start_line":11,"text":"| pelleted | 9 | 3 | 12 | 75.0% |"},{"end_column":30,"end_line":12,"start_column":1,"start_line":12,"text":"| bare | 3 | 9 | 12 | 25.0% |"},{"end_column":70,"end_line":16,"start_column":1,"start_line":16,"text":"Fisher's exact test (two-sided) on the 2x2 table of seed treatment by"},{"end_column":69,"end_line":17,"start_column":1,"start_line":17,"text":"emergence at day 28, with one Bernoulli outcome per independent pot."},{"end_column":68,"end_line":21,"start_column":1,"start_line":21,"text":"Sample odds ratio (pelleted vs. bare) = 9.00, two-sided p = 0.0391."},{"end_column":62,"end_line":22,"start_column":1,"start_line":22,"text":"Emergence was 50.0 percentage points higher in pelleted pots."},{"end_column":256,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Two-sided Fisher's exact test on 24 independent single-seed pots: emergence 9/12 (75.0%) with pelleted seed vs. 3/12 (25.0%) with bare seed, sample odds ratio 9.00, p = 0.0391; the difference is statistically significant at alpha = 0.05."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ff32b940c4cae510fee4","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:ccc8e19a4cab92292db1b4596812268d5e20064adccc0cb8b7fd988f24ca9f2e","end_line":24,"locator":"results/report.md:1-24","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:3274b14fc2754dfcb7f7c5124fa881d8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":3,"start_column":1,"start_line":3,"text":"Each heat-ramp trial run on a tagged shore periwinkle is recorded on its own"},{"end_column":73,"end_line":4,"start_column":1,"start_line":4,"text":"line. Twelve snails were collected from one rocky platform, six from the"},{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"high-shore band and six from the low-shore band, and each snail was ramped on"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"four separate trial days. A line gives the snail tag, the shore band the snail"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"was collected from, which of the four trial days the ramp happened on, the"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"snail's shell length in millimetres, and ctmax_c, the body temperature in"},{"end_column":75,"end_line":9,"start_column":1,"start_line":9,"text":"degrees Celsius at which that snail lost its righting response during that"},{"end_column":17,"end_line":10,"start_column":1,"start_line":10,"text":"particular ramp."},{"end_column":74,"end_line":12,"start_column":1,"start_line":12,"text":"One row is: one heat-ramp trial on one tagged periwinkle on one trial day"},{"end_column":34,"end_line":13,"start_column":1,"start_line":13,"text":"Independent unit column: snail_id"},{"end_column":14,"end_line":15,"start_column":1,"start_line":15,"text":"Column guide:"},{"end_column":73,"end_line":16,"start_column":1,"start_line":16,"text":"- snail_id: tag of the individual snail (12 distinct tags, 4 lines each)"},{"end_column":69,"end_line":17,"start_column":1,"start_line":17,"text":"- shore_zone: \"high\" or \"low\", the band the snail was collected from"},{"end_column":59,"end_line":18,"start_column":1,"start_line":18,"text":"- trial_day: 1 to 4, which repeat ramp the line comes from"},{"end_column":62,"end_line":19,"start_column":1,"start_line":19,"text":"- shell_length_mm: shell length of that snail, in millimetres"},{"end_column":69,"end_line":20,"start_column":1,"start_line":20,"text":"- ctmax_c: critical thermal maximum on that ramp, in degrees Celsius"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b3047a923ba66862b99f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:2c06ef0295090e01037bad6f53d316d64e1f0588f3886d8ea9b7f54bde1ad22c","end_line":20,"locator":"data-description.md:1-20","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:3274b14fc2754dfcb7f7c5124fa881d8","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"data/input.csv holds 48 heat-ramp trials on 12 individually tagged periwinkles:"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"6 snails collected from the high-shore band and 6 from the low-shore band. Each"},{"end_column":75,"end_line":7,"start_column":1,"start_line":7,"text":"snail was ramped on 4 separate trial days, and every ramp records the body"},{"end_column":75,"end_line":8,"start_column":1,"start_line":8,"text":"temperature at which the snail lost its righting response (ctmax_c, in C)."},{"end_column":77,"end_line":12,"start_column":1,"start_line":12,"text":"Each heat-ramp trial in the table was entered as one observation and the two"},{"end_column":76,"end_line":13,"start_column":1,"start_line":13,"text":"shore bands were compared with Welch's two-sample t-test (two-sided) on the"},{"end_column":16,"end_line":14,"start_column":1,"start_line":14,"text":"ctmax_c column."},{"end_column":52,"end_line":18,"start_column":1,"start_line":18,"text":"| shore band | trials | mean ctmax_c (C) | SD (C) |"},{"end_column":26,"end_line":19,"start_column":1,"start_line":19,"text":"| --- | --- | --- | --- |"},{"end_column":30,"end_line":20,"start_column":1,"start_line":20,"text":"| high | 24 | 41.000 | 0.59 |"},{"end_column":29,"end_line":21,"start_column":1,"start_line":21,"text":"| low | 24 | 39.200 | 0.37 |"},{"end_column":40,"end_line":23,"start_column":1,"start_line":23,"text":"Mean difference (high - low) = 1.800 C."},{"end_column":240,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Welch two-sample t-test on ctmax_c comparing high-shore with low-shore heat-ramp trials: t = 12.74, df = 38.51, p < 1e-06. High-shore snails lost righting at a mean critical thermal maximum 1.800 C above low-shore snails."},{"end_column":79,"end_line":29,"start_column":1,"start_line":29,"text":"The table above is the whole of the reported analysis; the shore-band contrast"},{"end_column":55,"end_line":30,"start_column":1,"start_line":30,"text":"is stated exactly as the trial-level test returned it."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:eb54f59c9e32d73a3997","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6b8e060c4c7c5b84390602a83e25599cfad9e607625bbc81c5bee5b0631a423c","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

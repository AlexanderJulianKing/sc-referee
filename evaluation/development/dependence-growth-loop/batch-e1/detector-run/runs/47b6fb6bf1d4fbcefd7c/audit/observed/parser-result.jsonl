{"audit_run_id":"audit:d5a37a39485d4007a6e670e9c8b94da6","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":3,"start_column":1,"start_line":3,"text":"Twelve screen-printed graphene sensor strips were fabricated: six were coated"},{"end_column":77,"end_line":4,"start_column":1,"start_line":4,"text":"with carbon ink formulation GX7 and six with formulation GX9. Each strip was"},{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"mounted once in the flow cell and then scanned four times in a row against a"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"fixed ferrocyanide standard, so every strip contributes four consecutive"},{"end_column":74,"end_line":7,"start_column":1,"start_line":7,"text":"oxidation-peak readings taken from the same piece of hardware in the same"},{"end_column":9,"end_line":8,"start_column":1,"start_line":8,"text":"sitting."},{"end_column":116,"end_line":10,"start_column":1,"start_line":10,"text":"One row is: a single amperometric scan of one sensor strip, giving the oxidation peak current recorded on that scan"},{"end_column":38,"end_line":11,"start_column":1,"start_line":11,"text":"Independent unit column: electrode_id"},{"end_column":76,"end_line":15,"start_column":1,"start_line":15,"text":"- electrode_id: label of the sensor strip that produced the scan. There are"},{"end_column":62,"end_line":16,"start_column":3,"start_line":16,"text":"twelve distinct strips and each label appears on four rows."},{"end_column":75,"end_line":17,"start_column":1,"start_line":17,"text":"- ink_formulation: which carbon ink the strip was coated with, GX7 or GX9."},{"end_column":76,"end_line":18,"start_column":3,"start_line":18,"text":"The formulation is a property of the strip, so it is identical across all"},{"end_column":40,"end_line":19,"start_column":3,"start_line":19,"text":"four rows that share an electrode_id."},{"end_column":73,"end_line":20,"start_column":1,"start_line":20,"text":"- scan_index: position of the scan within that strip's run, 1 through 4."},{"end_column":68,"end_line":21,"start_column":1,"start_line":21,"text":"- peak_current_ua: oxidation peak current measured on that scan, in"},{"end_column":16,"end_line":22,"start_column":3,"start_line":22,"text":"microamperes."},{"end_column":73,"end_line":23,"start_column":1,"start_line":23,"text":"- cell_temp_c: flow-cell temperature at the time of the scan, in degrees"},{"end_column":11,"end_line":24,"start_column":3,"start_line":24,"text":"Celsius."},{"end_column":74,"end_line":28,"start_column":1,"start_line":28,"text":"The file is plain ASCII CSV with a header line and 48 data rows. Readings"},{"end_column":76,"end_line":29,"start_column":1,"start_line":29,"text":"from the same electrode_id are repeat measurements of one strip rather than"},{"end_column":33,"end_line":30,"start_column":1,"start_line":30,"text":"measurements of separate strips."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:5392e3782d66e1e4d766","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:6eaeeecfae0095349114400e72935f55d9ac2291125ef23187aec6f4f9dff839","end_line":30,"locator":"data-description.md:1-30","path":"data-description.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:d5a37a39485d4007a6e670e9c8b94da6","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"Amperometric scans were collected from screen-printed graphene strips coated"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"with one of two carbon ink formulations, GX7 and GX9. Each strip was mounted"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"in the flow cell once and scanned four times in immediate succession against a"},{"end_column":73,"end_line":8,"start_column":1,"start_line":8,"text":"fixed ferrocyanide standard; the oxidation peak current of each scan was"},{"end_column":31,"end_line":9,"start_column":1,"start_line":9,"text":"recorded in microamperes (uA)."},{"end_column":68,"end_line":11,"start_column":1,"start_line":11,"text":"| Formulation | Scans | Strips | Mean peak current (uA) | SD (uA) |"},{"end_column":36,"end_line":12,"start_column":1,"start_line":12,"text":"| --- | ---: | ---: | ---: | ---: |"},{"end_column":32,"end_line":13,"start_column":1,"start_line":13,"text":"| GX7 | 24 | 6 | 43.17 | 2.59 |"},{"end_column":32,"end_line":14,"start_column":1,"start_line":14,"text":"| GX9 | 24 | 6 | 49.32 | 1.98 |"},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"Each recorded scan was entered as one observation and the two formulations"},{"end_column":71,"end_line":19,"start_column":1,"start_line":19,"text":"were compared on peak current with a two-sided Welch two-sample t-test"},{"end_column":21,"end_line":20,"start_column":1,"start_line":20,"text":"(unequal variances)."},{"end_column":62,"end_line":24,"start_column":1,"start_line":24,"text":"Mean peak current was 6.15 uA higher under GX9 than under GX7"},{"end_column":34,"end_line":25,"start_column":1,"start_line":25,"text":"(t = 9.23, df = 43.0, p < 1e-06)."},{"end_column":152,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Welch two-sample t-test on scan-level peak current: GX9 (49.32 uA) exceeds GX7 (43.17 uA) by 6.15 uA, t = 9.23, df = 43.0, p < 1e-06."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:23fe0a8e9fbdcf98cfd4","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.19.0","source_ref":{"content_digest":"sha256:040c91619eb3a6cf28c2569258abef2c30773b26681036f44ce5e9e6f3e4d565","end_line":27,"locator":"results/report.md:1-27","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

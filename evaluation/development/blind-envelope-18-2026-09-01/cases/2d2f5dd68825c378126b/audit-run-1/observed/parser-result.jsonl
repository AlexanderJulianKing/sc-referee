{"audit_run_id":"audit:406fcc6fd143451ba9a18b9f4a274a87","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":91,"end_line":3,"start_column":1,"start_line":3,"text":"Bunch-thinning trial on mature Medjool-type date palms in one uniformly managed block at a"},{"end_column":93,"end_line":4,"start_column":1,"start_line":4,"text":"date palm research station. Two strand-thinning intensities were applied by the same crew at"},{"end_column":87,"end_line":5,"start_column":1,"start_line":5,"text":"the same growth stage, and all palms were harvested and measured at the same maturity."},{"end_column":96,"end_line":9,"start_column":1,"start_line":9,"text":"One row is one palm: its identifier, the thinning intensity it received, and the eight declared"},{"end_column":92,"end_line":10,"start_column":1,"start_line":10,"text":"trial outcomes measured on that palm. There are 56 data rows plus a header row, one row per"},{"end_column":94,"end_line":11,"start_column":1,"start_line":11,"text":"palm, 28 palms per thinning intensity. Every palm has a value for every outcome; the file has"},{"end_column":16,"end_line":12,"start_column":1,"start_line":12,"text":"no blank cells."},{"end_column":92,"end_line":16,"start_column":1,"start_line":16,"text":"Columns appear in this order. The eight outcome columns follow the order in which the trial"},{"end_column":20,"end_line":17,"start_column":1,"start_line":17,"text":"plan declared them."},{"end_column":39,"end_line":19,"start_column":1,"start_line":19,"text":"| Column | Type | Unit | Description |"},{"end_column":26,"end_line":20,"start_column":1,"start_line":20,"text":"| --- | --- | --- | --- |"},{"end_column":105,"end_line":21,"start_column":1,"start_line":21,"text":"| `palm_id` | text | none | Palm identifier, `P01` through `P56`. One identifier per palm, all unique. |"},{"end_column":144,"end_line":22,"start_column":1,"start_line":22,"text":"| `thinning_intensity` | text | none | Group column. Exactly two values: `light` (light strand thinning) and `heavy` (heavy strand thinning). |"},{"end_column":100,"end_line":23,"start_column":1,"start_line":23,"text":"| `fruit_weight_g` | number | grams | Declared outcome 1. Mean single fruit weight for that palm. |"},{"end_column":81,"end_line":24,"start_column":1,"start_line":24,"text":"| `fruit_length_mm` | number | millimetres | Declared outcome 2. Fruit length. |"},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"| `fruit_width_mm` | number | millimetres | Declared outcome 3. Fruit width. |"},{"end_column":98,"end_line":26,"start_column":1,"start_line":26,"text":"| `yield_per_palm_kg` | number | kilograms | Declared outcome 4. Harvested yield for that palm. |"},{"end_column":100,"end_line":27,"start_column":1,"start_line":27,"text":"| `total_soluble_solids_brix` | number | degrees Brix | Declared outcome 5. Total soluble solids. |"},{"end_column":82,"end_line":28,"start_column":1,"start_line":28,"text":"| `fruit_moisture_pct` | number | percent | Declared outcome 6. Fruit moisture. |"},{"end_column":162,"end_line":29,"start_column":1,"start_line":29,"text":"| `flesh_to_seed_ratio` | number | none (unitless ratio) | Declared outcome 7. Flesh mass divided by seed mass. No unit suffix because the quantity is a ratio. |"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"| `fruit_firmness_n` | number | newtons | Declared outcome 8. Fruit firmness. |"},{"end_column":48,"end_line":34,"start_column":1,"start_line":34,"text":"| Column | Minimum | Maximum | Decimal places |"},{"end_column":26,"end_line":35,"start_column":1,"start_line":35,"text":"| --- | --- | --- | --- |"},{"end_column":40,"end_line":36,"start_column":1,"start_line":36,"text":"| `fruit_weight_g` | 8.94 | 14.79 | 2 |"},{"end_column":40,"end_line":37,"start_column":1,"start_line":37,"text":"| `fruit_length_mm` | 35.9 | 47.8 | 1 |"},{"end_column":39,"end_line":38,"start_column":1,"start_line":38,"text":"| `fruit_width_mm` | 20.2 | 27.1 | 1 |"},{"end_column":43,"end_line":39,"start_column":1,"start_line":39,"text":"| `yield_per_palm_kg` | 72.3 | 120.4 | 1 |"},{"end_column":50,"end_line":40,"start_column":1,"start_line":40,"text":"| `total_soluble_solids_brix` | 61.3 | 76.8 | 1 |"},{"end_column":43,"end_line":41,"start_column":1,"start_line":41,"text":"| `fruit_moisture_pct` | 16.5 | 27.9 | 1 |"},{"end_column":45,"end_line":42,"start_column":1,"start_line":42,"text":"| `flesh_to_seed_ratio` | 6.57 | 10.66 | 2 |"},{"end_column":40,"end_line":43,"start_column":1,"start_line":43,"text":"| `fruit_firmness_n` | 5.5 | 12.7 | 1 |"},{"end_column":95,"end_line":47,"start_column":1,"start_line":47,"text":"Plain comma-separated text, UTF-8, one header row, no quoting needed because no field contains"},{"end_column":85,"end_line":48,"start_column":1,"start_line":48,"text":"a comma. Numbers are written as fixed decimals with the decimal places listed above."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ea5bd7abfbaf03529fdf","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:4462b105fb0fe95749d4e267ee0ab48a7130da41b1c26b494ff8b91847183b1e","end_line":48,"locator":"DATA_DESCRIPTION.md:1-48","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:406fcc6fd143451ba9a18b9f4a274a87","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":94,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `thinning_intensity` column of `data.csv`."},{"end_column":212,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: fruit_weight_g, fruit_length_mm, fruit_width_mm, yield_per_palm_kg, total_soluble_solids_brix, fruit_moisture_pct, flesh_to_seed_ratio, fruit_firmness_n."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:672cc7f64ebb78447510","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:8338707fb33081db2909aef78ff72ebc1d7c62e808c0bfaf8707a1be94833550","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:0c3fc4486b734163a31ecddd1090e6af","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":5,"start_column":1,"start_line":5,"text":"We ran a side-by-side trial of a 2.0 percent and a 3.0 percent brine to see"},{"end_column":112,"end_line":6,"start_column":1,"start_line":6,"text":"how brine salt level shifts a napa cabbage kimchi ferment. Forty-four small fermentation containers were filled"},{"end_column":73,"end_line":7,"start_column":1,"start_line":7,"text":"from one homogenised batch of shredded cabbage and seasoning, twenty-two"},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"brined at each salt level. Every container was held at 4 degrees Celsius and"},{"end_column":79,"end_line":9,"start_column":1,"start_line":9,"text":"opened once, on day 14, for measurement. Five quality attributes were declared"},{"end_column":74,"end_line":10,"start_column":1,"start_line":10,"text":"before fermentation started: pH, titratable acidity, lactic acid bacteria"},{"end_column":72,"end_line":11,"start_column":1,"start_line":11,"text":"count, firmness, and panel sourness. Each attribute answers a different"},{"end_column":73,"end_line":12,"start_column":1,"start_line":12,"text":"practical question about the product, so each is treated here as its own"},{"end_column":10,"end_line":13,"start_column":1,"start_line":13,"text":"question."},{"end_column":72,"end_line":17,"start_column":1,"start_line":17,"text":"`data.csv` has 44 rows plus a header row. **One row is one fermentation"},{"end_column":73,"end_line":18,"start_column":1,"start_line":18,"text":"container**, measured a single time on day 14. There are no blank cells."},{"end_column":69,"end_line":20,"start_column":1,"start_line":20,"text":"- `container_id`: container label, `C01` through `C44`, one per row."},{"end_column":74,"end_line":21,"start_column":1,"start_line":21,"text":"- `salt_pct`: brining salt level of that container, either `2.0` or `3.0`"},{"end_column":55,"end_line":22,"start_column":3,"start_line":22,"text":"percent salt in the brine. This is the group column."},{"end_column":57,"end_line":23,"start_column":1,"start_line":23,"text":"- `ph`: pH of the fermented product on day 14, unitless."},{"end_column":79,"end_line":24,"start_column":1,"start_line":24,"text":"- `titratable_acidity_pct`: titratable acidity as percent lactic acid by mass."},{"end_column":76,"end_line":25,"start_column":1,"start_line":25,"text":"- `lab_count_log10_cfu_g`: lactic acid bacteria count, log10 colony forming"},{"end_column":18,"end_line":26,"start_column":3,"start_line":26,"text":"units per gram."},{"end_column":51,"end_line":27,"start_column":1,"start_line":27,"text":"- `firmness_n`: peak penetration force in newtons."},{"end_column":73,"end_line":28,"start_column":1,"start_line":28,"text":"- `sourness_score`: sourness rated by a trained panel on a 1 to 9 scale,"},{"end_column":49,"end_line":29,"start_column":3,"start_line":29,"text":"reported as the panel mean for that container."},{"end_column":79,"end_line":33,"start_column":1,"start_line":33,"text":"`analysis.py` reads `data.csv`, splits the containers into the 2.0 percent and"},{"end_column":74,"end_line":34,"start_column":1,"start_line":34,"text":"3.0 percent groups, and steps through the five declared outcomes in their"},{"end_column":77,"end_line":35,"start_column":1,"start_line":35,"text":"declared order. For each outcome it runs an independent two-sample t-test on"},{"end_column":77,"end_line":36,"start_column":1,"start_line":36,"text":"the two groups of containers and prints the group sizes, the group means and"},{"end_column":78,"end_line":37,"start_column":1,"start_line":37,"text":"standard deviations, and the p-value. An outcome is called different when its"},{"end_column":30,"end_line":38,"start_column":1,"start_line":38,"text":"own p-value falls below 0.05."},{"end_column":80,"end_line":42,"start_column":1,"start_line":42,"text":"1. **pH.** The 2.0 percent containers finished at mean 4.079 (SD 0.094) against"},{"end_column":76,"end_line":43,"start_column":4,"start_line":43,"text":"4.384 (SD 0.094) at 3.0 percent, p = 1.2e-13. Lower salt gives a clearly"},{"end_column":19,"end_line":44,"start_column":4,"start_line":44,"text":"lower final pH."},{"end_column":79,"end_line":45,"start_column":1,"start_line":45,"text":"2. **Titratable acidity.** 0.935 percent lactic acid (SD 0.073) at 2.0 percent"},{"end_column":74,"end_line":46,"start_column":4,"start_line":46,"text":"salt against 0.672 percent (SD 0.062) at 3.0 percent, p = 3.4e-16. The"},{"end_column":46,"end_line":47,"start_column":4,"start_line":47,"text":"low-salt ferments are clearly more acidic."},{"end_column":78,"end_line":48,"start_column":1,"start_line":48,"text":"3. **Lactic acid bacteria count.** 8.083 log10 CFU/g (SD 0.337) against 8.071"},{"end_column":79,"end_line":49,"start_column":4,"start_line":49,"text":"(SD 0.351), p = 0.91. No significant difference; the two brines end up with"},{"end_column":29,"end_line":50,"start_column":4,"start_line":50,"text":"the same population size."},{"end_column":71,"end_line":51,"start_column":1,"start_line":51,"text":"4. **Firmness.** 12.77 N (SD 1.66) at 2.0 percent salt against 13.80 N"},{"end_column":75,"end_line":52,"start_column":4,"start_line":52,"text":"(SD 1.44) at 3.0 percent, p = 0.033. The higher-salt cabbage is firmer."},{"end_column":75,"end_line":53,"start_column":1,"start_line":53,"text":"5. **Panel sourness.** 5.61 (SD 0.94) against 5.85 (SD 1.03), p = 0.44. No"},{"end_column":72,"end_line":54,"start_column":4,"start_line":54,"text":"significant difference in how sour the panel found the two products."},{"end_column":76,"end_line":56,"start_column":1,"start_line":56,"text":"Both salt levels reach a full ferment by day 14. The 2.0 percent brine buys"},{"end_column":80,"end_line":57,"start_column":1,"start_line":57,"text":"more acid and a lower pH, and gives up a little firmness, while the panel rated"},{"end_column":34,"end_line":58,"start_column":1,"start_line":58,"text":"the two products as equally sour."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:262812cb05aaa5931cdd","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:27b933a02a3352012f22d5933dea7a9d1c85c63aabee67ac586322eadfdc5f92","end_line":58,"locator":"report.md:1-58","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:416cbb4f45de4acba993d88a6d39d9b1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":77,"end_line":5,"start_column":1,"start_line":5,"text":"Treated municipal wastewater effluent is released into surface water, so the"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"laboratory asked whether water that has already been through treatment still"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"slows the growth of a sensitive aquatic plant. Forty-eight duckweed culture"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"vessels were started from one clonal stock. Twenty-four received standard"},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"reference growth medium and twenty-four received the same medium made up with"},{"end_column":75,"end_line":10,"start_column":1,"start_line":10,"text":"ten percent treated municipal effluent. All vessels sat in the same growth"},{"end_column":75,"end_line":11,"start_column":1,"start_line":11,"text":"cabinet and were measured once, at day seven. The assay plan declared five"},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"outcomes in advance, so the question for each outcome is whether the two media"},{"end_column":8,"end_line":13,"start_column":1,"start_line":13,"text":"differ."},{"end_column":80,"end_line":17,"start_column":1,"start_line":17,"text":"`data.csv` holds 48 data rows plus a header. **One row is one culture vessel**,"},{"end_column":73,"end_line":18,"start_column":1,"start_line":18,"text":"carrying its medium assignment and its day-seven value for each declared"},{"end_column":55,"end_line":19,"start_column":1,"start_line":19,"text":"outcome. There are no missing values. The columns are:"},{"end_column":50,"end_line":21,"start_column":1,"start_line":21,"text":"- `vessel_id`: vessel label, `V01` through `V48`."},{"end_column":79,"end_line":22,"start_column":1,"start_line":22,"text":"- `medium`: growth medium, either `reference_medium` or `effluent_10pct`, with"},{"end_column":22,"end_line":23,"start_column":3,"start_line":23,"text":"24 vessels in each."},{"end_column":82,"end_line":24,"start_column":1,"start_line":24,"text":"- `frond_number_increase`: increase in frond number over the seven days, a count."},{"end_column":65,"end_line":25,"start_column":1,"start_line":25,"text":"- `total_frond_area_mm2`: total frond area at day seven, in mm²."},{"end_column":80,"end_line":26,"start_column":1,"start_line":26,"text":"- `chlorophyll_a_ug_per_g`: chlorophyll a at day seven, in µg per g fresh mass."},{"end_column":63,"end_line":27,"start_column":1,"start_line":27,"text":"- `mean_root_length_mm`: mean root length at day seven, in mm."},{"end_column":53,"end_line":28,"start_column":1,"start_line":28,"text":"- `dry_biomass_mg`: dry biomass at day seven, in mg."},{"end_column":81,"end_line":32,"start_column":1,"start_line":32,"text":"`analysis.py` reads `data.csv` and runs an independent two-sample t-test on each"},{"end_column":75,"end_line":33,"start_column":1,"start_line":33,"text":"of the five declared outcomes, comparing the reference vessels against the"},{"end_column":18,"end_line":34,"start_column":1,"start_line":34,"text":"effluent vessels."},{"end_column":80,"end_line":36,"start_column":1,"start_line":36,"text":"Testing five outcomes gives five chances to call a difference real by accident,"},{"end_column":80,"end_line":37,"start_column":1,"start_line":37,"text":"so the family-wise level is held at 0.05: that 5% is the chance of at least one"},{"end_column":80,"end_line":38,"start_column":1,"start_line":38,"text":"false call across the whole declared family, not per outcome. To get there, the"},{"end_column":75,"end_line":39,"start_column":1,"start_line":39,"text":"script computes the Sidak per-comparison threshold from the family size of"},{"end_column":75,"end_line":40,"start_column":1,"start_line":40,"text":"m = 5, as 1 - (1 - 0.05)^(1/5) = 0.010206. Every p-value is judged against"},{"end_column":35,"end_line":41,"start_column":1,"start_line":41,"text":"0.010206 rather than against 0.05."},{"end_column":72,"end_line":45,"start_column":1,"start_line":45,"text":"1. **Frond number increase.** Reference 71.46 (SD 9.03), effluent 37.63"},{"end_column":79,"end_line":46,"start_column":4,"start_line":46,"text":"(SD 8.59), p = 2.23e-17. Below the threshold, so effluent vessels added far"},{"end_column":17,"end_line":47,"start_column":4,"start_line":47,"text":"fewer fronds."},{"end_column":78,"end_line":48,"start_column":1,"start_line":48,"text":"2. **Total frond area.** Reference 387.36 mm² (SD 80.04), effluent 411.41 mm²"},{"end_column":75,"end_line":49,"start_column":4,"start_line":49,"text":"(SD 83.34), p = 0.313. Above the threshold, so no difference was shown."},{"end_column":77,"end_line":50,"start_column":1,"start_line":50,"text":"3. **Chlorophyll a.** Reference 597.11 µg/g (SD 95.98), effluent 596.19 µg/g"},{"end_column":76,"end_line":51,"start_column":4,"start_line":51,"text":"(SD 139.99), p = 0.979. Above the threshold, so no difference was shown."},{"end_column":72,"end_line":52,"start_column":1,"start_line":52,"text":"4. **Mean root length.** Reference 18.22 mm (SD 3.08), effluent 9.23 mm"},{"end_column":78,"end_line":53,"start_column":4,"start_line":53,"text":"(SD 2.25), p = 3.44e-15. Below the threshold, so effluent roots were about"},{"end_column":17,"end_line":54,"start_column":4,"start_line":54,"text":"half as long."},{"end_column":79,"end_line":55,"start_column":1,"start_line":55,"text":"5. **Dry biomass.** Reference 18.44 mg (SD 5.22), effluent 19.69 mg (SD 3.91),"},{"end_column":63,"end_line":56,"start_column":4,"start_line":56,"text":"p = 0.352. Above the threshold, so no difference was shown."},{"end_column":79,"end_line":58,"start_column":1,"start_line":58,"text":"Two of the five declared outcomes, frond number increase and root length, show"},{"end_column":76,"end_line":59,"start_column":1,"start_line":59,"text":"a clear effect of the 10% effluent medium at the Sidak threshold. The other"},{"end_column":14,"end_line":60,"start_column":1,"start_line":60,"text":"three do not."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4f1d65cfb8b446eaf78f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:095db9069d91d14507627c03c63caf2c04e94ae912b370a315600d0bf9a73017","end_line":60,"locator":"report.md:1-60","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

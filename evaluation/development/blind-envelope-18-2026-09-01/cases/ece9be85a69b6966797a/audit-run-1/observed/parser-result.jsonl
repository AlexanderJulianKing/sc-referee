{"audit_run_id":"audit:416cbb4f45de4acba993d88a6d39d9b1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":3,"start_column":1,"start_line":3,"text":"Seven-day duckweed (common duckweed, *Lemna*) growth assay. Forty-eight culture"},{"end_column":79,"end_line":4,"start_column":1,"start_line":4,"text":"vessels were set up from one clonal stock and held in the same growth cabinet."},{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"Twenty-four vessels held standard reference growth medium and twenty-four held"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"the same medium made up with ten percent treated municipal wastewater effluent."},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"Each vessel was measured once, at day seven."},{"end_column":74,"end_line":9,"start_column":1,"start_line":9,"text":"**One row is one culture vessel**, carrying its medium assignment and its"},{"end_column":78,"end_line":10,"start_column":1,"start_line":10,"text":"day-seven value for each of the five outcomes declared in the assay plan. The"},{"end_column":66,"end_line":11,"start_column":1,"start_line":11,"text":"file has 48 data rows plus a header. There are no missing values."},{"end_column":39,"end_line":15,"start_column":1,"start_line":15,"text":"| Column | Type | Unit | Description |"},{"end_column":26,"end_line":16,"start_column":1,"start_line":16,"text":"| --- | --- | --- | --- |"},{"end_column":106,"end_line":17,"start_column":1,"start_line":17,"text":"| `vessel_id` | text | none | Vessel label, `V01` through `V48`. Unique; identifies the culture vessel. |"},{"end_column":258,"end_line":18,"start_column":1,"start_line":18,"text":"| `medium` | text | none | Growth medium the vessel received. Exactly two values: `reference_medium` (standard reference growth medium) and `effluent_10pct` (the same medium made up with ten percent treated municipal wastewater effluent). 24 vessels each. |"},{"end_column":110,"end_line":19,"start_column":1,"start_line":19,"text":"| `frond_number_increase` | integer | none (count) | Increase in frond number over the seven days, counted. |"},{"end_column":120,"end_line":20,"start_column":1,"start_line":20,"text":"| `total_frond_area_mm2` | number | mm² | Total frond area at day seven, in square millimetres, to one decimal place. |"},{"end_column":154,"end_line":21,"start_column":1,"start_line":21,"text":"| `chlorophyll_a_ug_per_g` | number | µg/g fresh mass | Chlorophyll a content at day seven, in micrograms per gram of fresh mass, to one decimal place. |"},{"end_column":111,"end_line":22,"start_column":1,"start_line":22,"text":"| `mean_root_length_mm` | number | mm | Mean root length at day seven, in millimetres, to one decimal place. |"},{"end_column":101,"end_line":23,"start_column":1,"start_line":23,"text":"| `dry_biomass_mg` | number | mg | Dry biomass at day seven, in milligrams, to two decimal places. |"},{"end_column":79,"end_line":25,"start_column":1,"start_line":25,"text":"The outcome columns appear in the order the five outcomes were declared in the"},{"end_column":12,"end_line":26,"start_column":1,"start_line":26,"text":"assay plan."},{"end_column":75,"end_line":30,"start_column":1,"start_line":30,"text":"`data.csv` is a fixed authored file. It was written once by `make_data.py`"},{"end_column":79,"end_line":31,"start_column":1,"start_line":31,"text":"(seeded, in this staging directory) and is not regenerated or simulated by any"},{"end_column":15,"end_line":32,"start_column":1,"start_line":32,"text":"analysis code."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:81d6e39b6d1094736b22","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:f2435297c54e1d9050792dbc0bdb2a5c3a381dcb37a5c64d81e52b8a9e262c1e","end_line":32,"locator":"DATA_DESCRIPTION.md:1-32","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:416cbb4f45de4acba993d88a6d39d9b1","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":82,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `medium` column of `data.csv`."},{"end_column":164,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: frond_number_increase, total_frond_area_mm2, chlorophyll_a_ug_per_g, mean_root_length_mm, dry_biomass_mg."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:1c12eeac51e3f59b850b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:704490b90c8024bf10125e0550bdb7ffbebd5cee22d949f0b3e457b30ebcacd4","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

c47779983","source_refs":[{"content_digest":"sha256:e9b7355f0aba7a5c4f8c230a8f64f422e84993d1c64bca50229b53e9626948ff","end_column":56,"end_line":87,"locator":"analysis.py:87-87","path":"analysis.py","quoted_text":"print(\"  adjusted value   = %.6g\" % adjusted_p)","source_kind":"file_span","start_column":9,"start_line":87}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:867eeee4f7220e44e6b7","output_refs":[],"record_type":"operation","run_id":"audit:f3512a0d66884540b6f2401c47779983","source_refs":[{"content_digest":"sha256:e9b7355f0aba7a5c4f8c230a8f64f422e84993d1c64bca50229b53e9626948ff","end_column":85,"end_line":88,"locator":"analysis.py:88-88","path":"analysis.py","quoted_text":"print(\"  verdict          = %s (adjusted value vs %.2f)\" % (verdict, ALPHA))","source_kind":"file_span","start_column":9,"start_line":88}]},{"implementation":"python.call:print","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:ab3cd9e548c9e1404fdf","output_refs":[],"record_type":"operation","run_id":"audit:f3512a0d66884540b6f2401c47779983","source_refs":[{"content_digest":"sha256:e9b7355f0aba7a5c4f8c230a8f64f422e84993d1c64bca50229b53e9626948ff","end_column":16,"end_line":89,"locator":"analysis.py:89-89","path":"analysis.py","quoted_text":"print()","source_kind":"file_span","start_column":9,"start_line":89}]},{"implementation":"python.call:main","input_refs":[],"inspection_status":"opaque","kind":"opaque_operation","literal_parameters":{},"operation_id":"operation:eab09eecc9943a896086","output_refs":[],"record_type":"operation","run_id":"audit:f3512a0d66884540b6f2401c47779983","source_refs":[{"content_digest":"sha256:e9b7355f0aba7a5c4f8c230a8f64f422e84993d1c64bca50229b53e9626948ff","end_column":11,"end_line":93,"locator":"analysis.py:93-93","path":"analysis.py","quoted_text":"main()","source_kind":"file_sp
{"audit_run_id":"audit:d36fd1c46d1448ca93926eec165a8f5c","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":80,"end_line":5,"start_column":1,"start_line":5,"text":"An agronomy institute asked whether autumn-sown faba bean differs from the same"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"cultivar sown the following spring. Sixty plots of equal size were laid out on"},{"end_column":81,"end_line":7,"start_column":1,"start_line":7,"text":"one uniform experimental field. Thirty were sown in autumn and thirty in spring,"},{"end_column":74,"end_line":8,"start_column":1,"start_line":8,"text":"with the same seed rate and the same management otherwise. Every plot was"},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"harvested and assessed once at maturity. The trial plan named six outcomes in"},{"end_column":62,"end_line":10,"start_column":1,"start_line":10,"text":"advance, so all six are reported here in that declared order."},{"end_column":79,"end_line":14,"start_column":1,"start_line":14,"text":"`data.csv` has one header row and 60 data rows. One row is one field plot: its"},{"end_column":68,"end_line":15,"start_column":1,"start_line":15,"text":"identifier, the sowing time it was assigned, and that plot's single"},{"end_column":76,"end_line":16,"start_column":1,"start_line":16,"text":"end-of-season measurement for each of the six declared outcomes. No cell is"},{"end_column":24,"end_line":17,"start_column":1,"start_line":17,"text":"blank. The columns are:"},{"end_column":59,"end_line":19,"start_column":1,"start_line":19,"text":"- `plot_id`: plot identifier, `P01` to `P60`, one per row."},{"end_column":78,"end_line":20,"start_column":1,"start_line":20,"text":"- `sowing_time`: the group column, either `autumn` or `spring`, 30 rows each."},{"end_column":57,"end_line":21,"start_column":1,"start_line":21,"text":"- `grain_yield_t_ha`: grain yield in tonnes per hectare."},{"end_column":50,"end_line":22,"start_column":1,"start_line":22,"text":"- `pods_per_plant`: pods per plant, plot average."},{"end_column":68,"end_line":23,"start_column":1,"start_line":23,"text":"- `thousand_seed_weight_g`: weight of one thousand seeds, in grams."},{"end_column":76,"end_line":24,"start_column":1,"start_line":24,"text":"- `plant_height_cm`: plant height at maturity in centimetres, plot average."},{"end_column":66,"end_line":25,"start_column":1,"start_line":25,"text":"- `seed_protein_pct`: seed protein as a percentage of dry matter."},{"end_column":81,"end_line":26,"start_column":1,"start_line":26,"text":"- `chocolate_spot_severity_pct`: chocolate spot leaf disease, as percent of leaf"},{"end_column":17,"end_line":27,"start_column":3,"start_line":27,"text":"area affected."},{"end_column":80,"end_line":31,"start_column":1,"start_line":31,"text":"`analysis.py` reads `data.csv`, splits the plots by `sowing_time`, and compares"},{"end_column":77,"end_line":32,"start_column":1,"start_line":32,"text":"autumn against spring on each outcome with an independent two-sample t-test."},{"end_column":79,"end_line":33,"start_column":1,"start_line":33,"text":"Every outcome had 30 plots per group. That gives six raw p-values. Testing six"},{"end_column":80,"end_line":34,"start_column":1,"start_line":34,"text":"outcomes raises the chance that at least one looks impressive by luck alone, so"},{"end_column":79,"end_line":35,"start_column":1,"start_line":35,"text":"all six were passed together, as one complete family, to `pingouin.multicomp`,"},{"end_column":80,"end_line":36,"start_column":1,"start_line":36,"text":"the multiple-comparison adjustment in the pingouin statistics package. Pingouin"},{"end_column":72,"end_line":37,"start_column":1,"start_line":37,"text":"is a specialist third-party package, installed separately and listed in"},{"end_column":82,"end_line":38,"start_column":1,"start_line":38,"text":"`requirements.txt`. The adjustment used the Holm method at a family-wise level of"},{"end_column":76,"end_line":39,"start_column":1,"start_line":39,"text":"0.05. Every verdict below rests on the adjusted value pingouin returned. No"},{"end_column":38,"end_line":40,"start_column":1,"start_line":40,"text":"outcome is judged on its raw p-value."},{"end_column":80,"end_line":44,"start_column":1,"start_line":44,"text":"1. **Grain yield.** Autumn 5.228 t/ha (sd 0.366), spring 4.030 t/ha (sd 0.451)."},{"end_column":76,"end_line":45,"start_column":4,"start_line":45,"text":"Adjusted value 1.4e-15: autumn sowing yielded about 1.2 t/ha more grain."},{"end_column":80,"end_line":46,"start_column":1,"start_line":46,"text":"2. **Pods per plant.** Autumn 15.72 (sd 3.49), spring 15.50 (sd 3.57). Adjusted"},{"end_column":41,"end_line":47,"start_column":4,"start_line":47,"text":"value 1.000: no difference was shown."},{"end_column":81,"end_line":48,"start_column":1,"start_line":48,"text":"3. **Thousand-seed weight.** Autumn 499.1 g (sd 46.6), spring 508.9 g (sd 49.5)."},{"end_column":50,"end_line":49,"start_column":4,"start_line":49,"text":"Adjusted value 1.000: no difference was shown."},{"end_column":75,"end_line":50,"start_column":1,"start_line":50,"text":"4. **Plant height.** Autumn 100.9 cm (sd 10.4), spring 102.5 cm (sd 12.7)."},{"end_column":50,"end_line":51,"start_column":4,"start_line":51,"text":"Adjusted value 1.000: no difference was shown."},{"end_column":73,"end_line":52,"start_column":1,"start_line":52,"text":"5. **Seed protein.** Autumn 27.83 % (sd 1.47), spring 28.17 % (sd 1.46)."},{"end_column":50,"end_line":53,"start_column":4,"start_line":53,"text":"Adjusted value 1.000: no difference was shown."},{"end_column":75,"end_line":54,"start_column":1,"start_line":54,"text":"6. **Chocolate spot severity.** Autumn 17.59 % leaf area (sd 4.17), spring"},{"end_column":77,"end_line":55,"start_column":4,"start_line":55,"text":"6.36 % (sd 2.20). Adjusted value 3.9e-18: autumn sowing carried much more"},{"end_column":12,"end_line":56,"start_column":4,"start_line":56,"text":"disease."},{"end_column":80,"end_line":58,"start_column":1,"start_line":58,"text":"Two of the six declared outcomes cleared the 0.05 family-wise level: the autumn"},{"end_column":73,"end_line":59,"start_column":1,"start_line":59,"text":"yield gain came with a heavier chocolate spot burden, and the other four"},{"end_column":48,"end_line":60,"start_column":1,"start_line":60,"text":"outcomes landed close between the sowing times."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:c1a8e5639dcf314b03ad","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:923fad796511913663d81ca2f1082c0613b11e949ca7e34b61864939d8af1add","end_line":60,"locator":"report.md:1-60","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:bb5f7a0b61ba17b40b5bee0744eeca714cd2c282dd854d738f1a65f504caa1d2","end_line":94,"locator":"analysis.py:1-94","path":"analysis.py","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:e3f8db4b8efd440598b7205e79604250","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":97,"end_line":5,"start_column":1,"start_line":5,"text":"Twelve years after planting, we wanted to know how far the sediment in a restored mangrove stand"},{"end_column":98,"end_line":6,"start_column":1,"start_line":6,"text":"has come toward matching undisturbed conditions. The restored stand sits on the same shoreline as"},{"end_column":96,"end_line":7,"start_column":1,"start_line":7,"text":"an undisturbed natural stand of the same species, which gives us a local reference for what the"},{"end_column":53,"end_line":8,"start_column":1,"start_line":8,"text":"sediment should look like once recovery is complete."},{"end_column":95,"end_line":10,"start_column":1,"start_line":10,"text":"We took forty-eight sediment cores to 30 centimetres depth during a single survey: twenty-four"},{"end_column":98,"end_line":11,"start_column":1,"start_line":11,"text":"spread across the restored stand and twenty-four across the natural stand. Each core was analysed"},{"end_column":96,"end_line":12,"start_column":1,"start_line":12,"text":"once in the laboratory. Before any core was analysed we declared three outcomes, in this order:"},{"end_column":98,"end_line":13,"start_column":1,"start_line":13,"text":"sediment organic carbon, dry bulk density, and total nitrogen. Each one is its own question about"},{"end_column":60,"end_line":14,"start_column":1,"start_line":14,"text":"restoration progress, so each is reported on its own terms."},{"end_column":96,"end_line":18,"start_column":1,"start_line":18,"text":"`data.csv` holds one row per sediment core, forty-eight rows plus a header, with no blanks. The"},{"end_column":13,"end_line":19,"start_column":1,"start_line":19,"text":"columns are:"},{"end_column":98,"end_line":21,"start_column":1,"start_line":21,"text":"- `core_id` - the identifier for that core (`R01`-`R24` in the restored stand, `N01`-`N24` in the"},{"end_column":18,"end_line":22,"start_column":3,"start_line":22,"text":"natural stand)."},{"end_column":81,"end_line":23,"start_column":1,"start_line":23,"text":"- `stand_type` - which stand the core came from, either `restored` or `natural`."},{"end_column":76,"end_line":24,"start_column":1,"start_line":24,"text":"- `organic_carbon_pct` - sediment organic carbon, as a percent of dry mass."},{"end_column":74,"end_line":25,"start_column":1,"start_line":25,"text":"- `bulk_density_g_cm3` - dry bulk density, in grams per cubic centimetre."},{"end_column":82,"end_line":26,"start_column":1,"start_line":26,"text":"- `total_nitrogen_mg_g` - total nitrogen, in milligrams per gram of dry sediment."},{"end_column":93,"end_line":28,"start_column":1,"start_line":28,"text":"One row is one core: its label, its stand, and the three laboratory measurements made on it."},{"end_column":97,"end_line":32,"start_column":1,"start_line":32,"text":"`analysis.py` reads `data.csv` and compares the two stand types on each declared outcome with an"},{"end_column":95,"end_line":33,"start_column":1,"start_line":33,"text":"independent two-sample t-test, which is the standard comparison for continuous measurements on"},{"end_column":97,"end_line":34,"start_column":1,"start_line":34,"text":"separate cores. The per-outcome testing is handled by one reusable step in the script that takes"},{"end_column":98,"end_line":35,"start_column":1,"start_line":35,"text":"the loaded data and the declared outcome list and returns the collected results; the main part of"},{"end_column":96,"end_line":36,"start_column":1,"start_line":36,"text":"the script prints from those results. For each outcome the script prints the number of cores in"},{"end_column":93,"end_line":37,"start_column":1,"start_line":37,"text":"each stand, the mean and standard deviation in each stand, the p-value, and a verdict at the"},{"end_column":65,"end_line":38,"start_column":1,"start_line":38,"text":"conventional 0.05 threshold based on that outcome's own p-value."},{"end_column":92,"end_line":42,"start_column":1,"start_line":42,"text":"**Organic carbon.** Restored 2.004 percent (SD 0.276, n = 24) against natural 3.518 percent"},{"end_column":95,"end_line":43,"start_column":1,"start_line":43,"text":"(SD 0.360, n = 24), p = 8.60e-21. The stands differ significantly. The restored sediment holds"},{"end_column":61,"end_line":44,"start_column":1,"start_line":44,"text":"well under two thirds of the carbon the natural stand holds."},{"end_column":97,"end_line":46,"start_column":1,"start_line":46,"text":"**Bulk density.** Restored 0.897 g/cm3 (SD 0.101, n = 24) against natural 0.907 g/cm3 (SD 0.095,"},{"end_column":95,"end_line":47,"start_column":1,"start_line":47,"text":"n = 24), p = 0.7148. No significant difference. Compaction in the restored stand already looks"},{"end_column":24,"end_line":48,"start_column":1,"start_line":48,"text":"like the natural stand."},{"end_column":97,"end_line":50,"start_column":1,"start_line":50,"text":"**Total nitrogen.** Restored 1.341 mg/g (SD 0.223, n = 24) against natural 1.487 mg/g (SD 0.210,"},{"end_column":96,"end_line":51,"start_column":1,"start_line":51,"text":"n = 24), p = 0.0243. The stands differ significantly, with the restored stand lower, though the"},{"end_column":40,"end_line":52,"start_column":1,"start_line":52,"text":"gap is far smaller than the carbon gap."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:81c1fe3209fcc3eb700f","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:8442ad5db11ecf9b2f78770d92a01f3105b862830081ce8d99f4ab9f85f7f772","end_line":52,"locator":"report.md:1-52","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:ab32565a3bba40dd84cc85e400e3170a","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"Stroke patients who have trouble swallowing are put on thickened liquids to make"},{"end_column":81,"end_line":6,"start_column":1,"start_line":6,"text":"swallowing safer. Thicker liquids are easier to control in the mouth and throat,"},{"end_column":80,"end_line":7,"start_column":1,"start_line":7,"text":"but they are also less pleasant to drink, which may slow meals down and cut how"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"much a patient drinks and eats. We wanted to know whether moving from a mildly"},{"end_column":78,"end_line":9,"start_column":1,"start_line":9,"text":"thick to a moderately thick liquid buys a safer swallow, and what it costs at"},{"end_column":11,"end_line":10,"start_column":1,"start_line":10,"text":"the table."},{"end_column":79,"end_line":12,"start_column":1,"start_line":12,"text":"Seventy-two consecutive inpatients with post-stroke swallowing difficulty took"},{"end_column":79,"end_line":13,"start_column":1,"start_line":13,"text":"part, thirty-six on each protocol, for fourteen days each. The same speech and"},{"end_column":80,"end_line":14,"start_column":1,"start_line":14,"text":"language therapy team assessed every patient. Six outcomes were declared in the"},{"end_column":74,"end_line":15,"start_column":1,"start_line":15,"text":"protocol before any data were collected, and each one is its own clinical"},{"end_column":10,"end_line":16,"start_column":1,"start_line":16,"text":"question."},{"end_column":80,"end_line":20,"start_column":1,"start_line":20,"text":"`data.csv` holds one row per patient: 72 data rows plus a header. Every cell is"},{"end_column":25,"end_line":21,"start_column":1,"start_line":21,"text":"filled. The columns are:"},{"end_column":67,"end_line":23,"start_column":1,"start_line":23,"text":"- `patient_id` - identifier, `PT01` to `PT72`, in admission order."},{"end_column":78,"end_line":24,"start_column":1,"start_line":24,"text":"- `liquid_thickness` - the protocol the patient was on, either `mildly_thick`"},{"end_column":25,"end_line":25,"start_column":3,"start_line":25,"text":"or `moderately_thick`."},{"end_column":79,"end_line":26,"start_column":1,"start_line":26,"text":"- `penetration_aspiration_score` - outcome 1, the penetration-aspiration scale"},{"end_column":80,"end_line":27,"start_column":3,"start_line":27,"text":"score at bedside swallow assessment, an ordered score from 1 to 8 where lower"},{"end_column":12,"end_line":28,"start_column":3,"start_line":28,"text":"is safer."},{"end_column":71,"end_line":29,"start_column":1,"start_line":29,"text":"- `mealtime_duration_min` - outcome 2, minutes taken to finish a meal."},{"end_column":81,"end_line":30,"start_column":1,"start_line":30,"text":"- `daily_oral_fluid_intake_ml` - outcome 3, millilitres drunk by mouth in a day."},{"end_column":81,"end_line":31,"start_column":1,"start_line":31,"text":"- `meal_completion_pct` - outcome 4, the percentage of the served meal finished."},{"end_column":81,"end_line":32,"start_column":1,"start_line":32,"text":"- `weight_change_kg` - outcome 5, weight change over the fourteen days, negative"},{"end_column":19,"end_line":33,"start_column":3,"start_line":33,"text":"for weight lost."},{"end_column":77,"end_line":34,"start_column":1,"start_line":34,"text":"- `coughing_episodes_per_meal` - outcome 6, coughing episodes during a meal."},{"end_column":78,"end_line":38,"start_column":1,"start_line":38,"text":"`analysis.py` reads `data.csv` and walks through the six declared outcomes in"},{"end_column":78,"end_line":39,"start_column":1,"start_line":39,"text":"order. For each one it splits the patients by `liquid_thickness`, reports the"},{"end_column":81,"end_line":40,"start_column":1,"start_line":40,"text":"group sizes, means and standard deviations, and compares the groups with a Welch"},{"end_column":79,"end_line":41,"start_column":1,"start_line":41,"text":"two-sample t-test. Each outcome is judged on its own p-value against the usual"},{"end_column":16,"end_line":42,"start_column":1,"start_line":42,"text":"0.05 threshold."},{"end_column":77,"end_line":46,"start_column":1,"start_line":46,"text":"1. **Penetration-aspiration score.** Mildly thick 4.11 (SD 1.01), moderately"},{"end_column":78,"end_line":47,"start_column":4,"start_line":47,"text":"thick 2.36 (SD 1.10); p = 1.1e-09. Significant. Swallows were safer on the"},{"end_column":51,"end_line":48,"start_column":4,"start_line":48,"text":"moderately thick protocol by about 1.75 points."},{"end_column":77,"end_line":49,"start_column":1,"start_line":49,"text":"2. **Mealtime duration.** Mildly thick 28.52 min (SD 7.05), moderately thick"},{"end_column":80,"end_line":50,"start_column":4,"start_line":50,"text":"30.34 min (SD 5.34); p = 0.221. Not significant. Meals ran about two minutes"},{"end_column":33,"end_line":51,"start_column":4,"start_line":51,"text":"longer on the thicker liquid."},{"end_column":80,"end_line":52,"start_column":1,"start_line":52,"text":"3. **Daily oral fluid intake.** Mildly thick 1206.14 mL (SD 237.55), moderately"},{"end_column":61,"end_line":53,"start_column":4,"start_line":53,"text":"thick 1151.69 mL (SD 162.04); p = 0.260. Not significant."},{"end_column":80,"end_line":54,"start_column":1,"start_line":54,"text":"4. **Meal completion.** Mildly thick 71.73% (SD 10.58), moderately thick 71.62%"},{"end_column":43,"end_line":55,"start_column":4,"start_line":55,"text":"(SD 11.73); p = 0.966. Not significant."},{"end_column":81,"end_line":56,"start_column":1,"start_line":56,"text":"5. **Weight change.** Mildly thick -0.38 kg (SD 0.96), moderately thick -0.29 kg"},{"end_column":76,"end_line":57,"start_column":4,"start_line":57,"text":"(SD 0.91); p = 0.660. Not significant. Both groups lost a little weight."},{"end_column":81,"end_line":58,"start_column":1,"start_line":58,"text":"6. **Coughing episodes per meal.** Mildly thick 3.39 (SD 0.99), moderately thick"},{"end_column":78,"end_line":59,"start_column":4,"start_line":59,"text":"1.33 (SD 0.89); p = 1.1e-13. Significant. Patients on the moderately thick"},{"end_column":52,"end_line":60,"start_column":4,"start_line":60,"text":"protocol coughed about two fewer times per meal."},{"end_column":74,"end_line":64,"start_column":1,"start_line":64,"text":"On the two swallow safety outcomes the moderately thick protocol came out"},{"end_column":78,"end_line":65,"start_column":1,"start_line":65,"text":"clearly ahead. On mealtime duration, fluid intake, meal completion and weight"},{"end_column":75,"end_line":66,"start_column":1,"start_line":66,"text":"change the groups landed close together and no difference reached the 0.05"},{"end_column":11,"end_line":67,"start_column":1,"start_line":67,"text":"threshold."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:cfc01913a7a43ae00a47","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:085b7865f652576009b07d5108f4f57c8c2cd470d04c54cce4f855a0c43aa7c1","end_line":67,"locator":"report.md:1-67","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

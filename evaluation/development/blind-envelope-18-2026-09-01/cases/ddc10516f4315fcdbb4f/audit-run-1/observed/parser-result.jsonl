{"audit_run_id":"audit:4553c9b8489d4634bee2ce5896262ded","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":72,"end_line":5,"start_column":1,"start_line":5,"text":"One hundred rural households took part in a household energy and health"},{"end_column":80,"end_line":6,"start_column":1,"start_line":6,"text":"programme: fifty cooked on an improved biomass stove and fifty on a traditional"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"open fire. Each household was monitored for one full cooking day by the same"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"field team, and the main cook filled in one symptom questionnaire. The question"},{"end_column":76,"end_line":9,"start_column":1,"start_line":9,"text":"is whether the improved stove changes kitchen air quality, fuel demand, the"},{"end_column":54,"end_line":10,"start_column":1,"start_line":10,"text":"cook's reported symptoms, and the time spent cooking."},{"end_column":78,"end_line":14,"start_column":1,"start_line":14,"text":"`data.csv` holds 100 rows plus a header. One row is one household: its single"},{"end_column":76,"end_line":15,"start_column":1,"start_line":15,"text":"monitored cooking day and its cook's single questionnaire. The columns are:"},{"end_column":66,"end_line":17,"start_column":1,"start_line":17,"text":"- `household_id` - household identifier, `HH001` through `HH100`."},{"end_column":65,"end_line":18,"start_column":1,"start_line":18,"text":"- `stove_type` - study group, either `improved_biomass_stove` or"},{"end_column":27,"end_line":19,"start_column":3,"start_line":19,"text":"`traditional_open_fire`."},{"end_column":81,"end_line":20,"start_column":1,"start_line":20,"text":"- `kitchen_pm25_ug_m3` - 24-hour kitchen fine particulate matter, micrograms per"},{"end_column":36,"end_line":21,"start_column":3,"start_line":21,"text":"cubic metre (declared outcome 1)."},{"end_column":72,"end_line":22,"start_column":1,"start_line":22,"text":"- `kitchen_co_ppm` - 24-hour kitchen carbon monoxide, parts per million"},{"end_column":24,"end_line":23,"start_column":3,"start_line":23,"text":"(declared outcome 2)."},{"end_column":80,"end_line":24,"start_column":1,"start_line":24,"text":"- `fuelwood_use_kg_day` - fuelwood used on the monitored day, kilograms per day"},{"end_column":24,"end_line":25,"start_column":3,"start_line":25,"text":"(declared outcome 3)."},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"- `respiratory_symptom_score` - cook's respiratory symptom score on a 0 to 12"},{"end_column":60,"end_line":27,"start_column":3,"start_line":27,"text":"scale, higher meaning more symptoms (declared outcome 4)."},{"end_column":72,"end_line":28,"start_column":1,"start_line":28,"text":"- `cooking_time_min` - total cooking time on the monitored day, minutes"},{"end_column":24,"end_line":29,"start_column":3,"start_line":29,"text":"(declared outcome 5)."},{"end_column":70,"end_line":31,"start_column":1,"start_line":31,"text":"Every household has a value in every column, and there are no blanks."},{"end_column":78,"end_line":35,"start_column":1,"start_line":35,"text":"`analysis.py` reads `data.csv` and, for each of the five declared outcomes in"},{"end_column":74,"end_line":36,"start_column":1,"start_line":36,"text":"the declared order, compares the two stove groups with a Welch two-sample"},{"end_column":75,"end_line":37,"start_column":1,"start_line":37,"text":"t-test, which does not assume the groups share a variance. It reports each"},{"end_column":80,"end_line":38,"start_column":1,"start_line":38,"text":"group's size, mean, and standard deviation, then checks the p-value against the"},{"end_column":78,"end_line":39,"start_column":1,"start_line":39,"text":"0.01 per-outcome threshold the protocol fixed before any data were collected."},{"end_column":76,"end_line":43,"start_column":1,"start_line":43,"text":"The protocol declared five outcomes as one family and asked for family-wise"},{"end_column":77,"end_line":44,"start_column":1,"start_line":44,"text":"error control across that whole family. The Bonferroni correction splits the"},{"end_column":74,"end_line":45,"start_column":1,"start_line":45,"text":"conventional 0.05 family-wise level evenly among the family's tests: 0.05"},{"end_column":81,"end_line":46,"start_column":1,"start_line":46,"text":"divided by 5 outcomes gives 0.01 per outcome. So the pre-fixed 0.01 threshold is"},{"end_column":78,"end_line":47,"start_column":1,"start_line":47,"text":"the Bonferroni-corrected per-outcome level for a family of five outcomes at a"},{"end_column":69,"end_line":48,"start_column":1,"start_line":48,"text":"0.05 family-wise level. The script simply applies that fixed number."},{"end_column":76,"end_line":52,"start_column":1,"start_line":52,"text":"1. **Kitchen PM2.5**: improved 223.532 ug/m3 (sd 67.076) versus traditional"},{"end_column":72,"end_line":53,"start_column":4,"start_line":53,"text":"618.704 ug/m3 (sd 200.991); p = 2.4e-19. Significant. Improved stove"},{"end_column":30,"end_line":54,"start_column":4,"start_line":54,"text":"households were far lower."},{"end_column":81,"end_line":55,"start_column":1,"start_line":55,"text":"2. **Kitchen carbon monoxide**: improved 4.176 ppm (sd 1.819) versus traditional"},{"end_column":70,"end_line":56,"start_column":4,"start_line":56,"text":"13.010 ppm (sd 4.392); p = 5.2e-20. Significant, again much lower."},{"end_column":79,"end_line":57,"start_column":1,"start_line":57,"text":"3. **Fuelwood use**: improved 3.625 kg/day (sd 0.792) versus traditional 6.473"},{"end_column":71,"end_line":58,"start_column":4,"start_line":58,"text":"kg/day (sd 1.030); p = 2.1e-27. Significant, about 2.8 kg/day less."},{"end_column":79,"end_line":59,"start_column":1,"start_line":59,"text":"4. **Respiratory symptom score**: improved 5.200 (sd 2.010) versus traditional"},{"end_column":76,"end_line":60,"start_column":4,"start_line":60,"text":"5.100 (sd 2.367); p = 0.820. Not significant; the groups sit essentially"},{"end_column":13,"end_line":61,"start_column":4,"start_line":61,"text":"together."},{"end_column":77,"end_line":62,"start_column":1,"start_line":62,"text":"5. **Cooking time**: improved 171.294 minutes (sd 25.754) versus traditional"},{"end_column":60,"end_line":63,"start_column":4,"start_line":63,"text":"174.160 minutes (sd 31.829); p = 0.622. Not significant."},{"end_column":58,"end_line":65,"start_column":1,"start_line":65,"text":"Each group contributed 50 households to every comparison."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d0b15c6fce9f0004ae67","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:6b1f59745019a93495e6e6249988b9df9c17095fbc507400d4735c35715db7e0","end_line":65,"locator":"report.md:1-65","path":"report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

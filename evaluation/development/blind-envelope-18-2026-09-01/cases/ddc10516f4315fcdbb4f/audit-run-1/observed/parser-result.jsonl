{"audit_run_id":"audit:4553c9b8489d4634bee2ce5896262ded","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"One row is one participating household, observed for one full cooking day by the"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"same field team, with one symptom questionnaire completed by that household's"},{"end_column":78,"end_line":7,"start_column":1,"start_line":7,"text":"main cook. There are 100 rows plus a header row: 50 households cooking on the"},{"end_column":72,"end_line":8,"start_column":1,"start_line":8,"text":"improved biomass stove and 50 cooking on a traditional open fire. Every"},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"household has a value in every column; there are no blanks. Households appear in"},{"end_column":47,"end_line":10,"start_column":1,"start_line":10,"text":"mixed order rather than grouped by stove type."},{"end_column":39,"end_line":14,"start_column":1,"start_line":14,"text":"| Column | Type | Unit | Description |"},{"end_column":26,"end_line":15,"start_column":1,"start_line":15,"text":"| --- | --- | --- | --- |"},{"end_column":106,"end_line":16,"start_column":1,"start_line":16,"text":"| `household_id` | text | none | Household identifier, `HH001` through `HH100`. Unique across the file. |"},{"end_column":120,"end_line":17,"start_column":1,"start_line":17,"text":"| `stove_type` | text | none | Study group. Exactly two values: `improved_biomass_stove` and `traditional_open_fire`. |"},{"end_column":149,"end_line":18,"start_column":1,"start_line":18,"text":"| `kitchen_pm25_ug_m3` | number | micrograms per cubic metre | Declared outcome 1. Twenty-four hour kitchen fine particulate matter concentration. |"},{"end_column":128,"end_line":19,"start_column":1,"start_line":19,"text":"| `kitchen_co_ppm` | number | parts per million | Declared outcome 2. Twenty-four hour kitchen carbon monoxide concentration. |"},{"end_column":130,"end_line":20,"start_column":1,"start_line":20,"text":"| `fuelwood_use_kg_day` | number | kilograms per day | Declared outcome 3. Fuelwood used by the household on the monitored day. |"},{"end_column":168,"end_line":21,"start_column":1,"start_line":21,"text":"| `respiratory_symptom_score` | integer | none (0 to 12 scale) | Declared outcome 4. Main cook's respiratory symptom questionnaire score; higher means more symptoms. |"},{"end_column":105,"end_line":22,"start_column":1,"start_line":22,"text":"| `cooking_time_min` | number | minutes | Declared outcome 5. Total cooking time on the monitored day. |"},{"end_column":79,"end_line":24,"start_column":1,"start_line":24,"text":"The five outcome columns appear in the order the study protocol declared them."},{"end_column":31,"end_line":28,"start_column":1,"start_line":28,"text":"| Column | Minimum | Maximum |"},{"end_column":20,"end_line":29,"start_column":1,"start_line":29,"text":"| --- | --- | --- |"},{"end_column":42,"end_line":30,"start_column":1,"start_line":30,"text":"| `kitchen_pm25_ug_m3` | 123.9 | 1215.8 |"},{"end_column":36,"end_line":31,"start_column":1,"start_line":31,"text":"| `kitchen_co_ppm` | 1.11 | 28.34 |"},{"end_column":40,"end_line":32,"start_column":1,"start_line":32,"text":"| `fuelwood_use_kg_day` | 2.11 | 8.69 |"},{"end_column":41,"end_line":33,"start_column":1,"start_line":33,"text":"| `respiratory_symptom_score` | 1 | 11 |"},{"end_column":39,"end_line":34,"start_column":1,"start_line":34,"text":"| `cooking_time_min` | 106.9 | 257.9 |"},{"end_column":78,"end_line":38,"start_column":1,"start_line":38,"text":"`data.csv` is a fixed authored file. It was written once by `make_data.py` in"},{"end_column":78,"end_line":39,"start_column":1,"start_line":39,"text":"this directory, which draws household-level values from the study's realistic"},{"end_column":82,"end_line":40,"start_column":1,"start_line":40,"text":"ranges under a fixed random seed. `make_data.py` is a one-time authoring tool and"},{"end_column":78,"end_line":41,"start_column":1,"start_line":41,"text":"is not part of the analysis; nothing in the analysis regenerates or simulates"},{"end_column":14,"end_line":42,"start_column":1,"start_line":42,"text":"these values."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:2c672dfdbf30d46aae04","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:fb2ecb7e26ba7c33f299ba6d70a6edf60b1b694778f1322dca1cf80c5b118d8d","end_line":42,"locator":"DATA_DESCRIPTION.md:1-42","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:4553c9b8489d4634bee2ce5896262ded","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":86,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `stove_type` column of `data.csv`."},{"end_column":160,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: kitchen_pm25_ug_m3, kitchen_co_ppm, fuelwood_use_kg_day, respiratory_symptom_score, cooking_time_min."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:2d0a57859be12714388c","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:25254317a914ef024340a25fc4dcfb68f223e67fd466dd64abc390b60910525e","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

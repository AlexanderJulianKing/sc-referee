{"audit_run_id":"audit:da310aff9b324a7d87a1544a8e12f4c9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":100,"end_line":3,"start_column":1,"start_line":3,"text":"`data.csv` holds the post-operative records for the sixty-four healthy adult bitches enrolled after"},{"end_column":100,"end_line":4,"start_column":1,"start_line":4,"text":"routine elective ovariohysterectomy. **One row is one dog**: its identifier, the analgesia protocol"},{"end_column":98,"end_line":5,"start_column":1,"start_line":5,"text":"it was recovered on, and its value for each of the seven outcomes declared in the study protocol."},{"end_column":100,"end_line":7,"start_column":1,"start_line":7,"text":"The file has 64 data rows plus a header row. Thirty-two dogs were recovered on protocol A (systemic"},{"end_column":98,"end_line":8,"start_column":1,"start_line":8,"text":"opioid alone) and thirty-two on protocol B (systemic opioid plus a local incisional block). Every"},{"end_column":54,"end_line":9,"start_column":1,"start_line":9,"text":"dog has a value in every column; there are no blanks."},{"end_column":37,"end_line":13,"start_column":1,"start_line":13,"text":"| Column | Meaning | Units / scale |"},{"end_column":20,"end_line":14,"start_column":1,"start_line":14,"text":"| --- | --- | --- |"},{"end_column":80,"end_line":15,"start_column":1,"start_line":15,"text":"| `dog_id` | Unique identifier for the dog, `D01` through `D64` | none (text) |"},{"end_column":177,"end_line":16,"start_column":1,"start_line":16,"text":"| `protocol` | Analgesia protocol the dog was recovered on. Exactly two values: `A` (systemic opioid alone) or `B` (systemic opioid plus local incisional block) | none (text) |"},{"end_column":170,"end_line":17,"start_column":1,"start_line":17,"text":"| `pain_score_6h` | Declared outcome 1, primary. Composite behavioural pain score assessed 6 hours after extubation | points on a 0 to 24 clinical scale; whole numbers |"},{"end_column":193,"end_line":18,"start_column":1,"start_line":18,"text":"| `rescue_analgesia_24h_mg` | Declared outcome 2, primary. Total rescue analgesia given in the first 24 hours | milligrams (mg), one decimal place; `0.0` means no rescue analgesia was needed |"},{"end_column":141,"end_line":19,"start_column":1,"start_line":19,"text":"| `serum_cortisol_6h_ug_dl` | Declared outcome 3. Serum cortisol measured at 6 hours | micrograms per decilitre (ug/dL), one decimal place |"},{"end_column":108,"end_line":20,"start_column":1,"start_line":20,"text":"| `heart_rate_6h_bpm` | Declared outcome 4. Heart rate at 6 hours | beats per minute (bpm); whole numbers |"},{"end_column":124,"end_line":21,"start_column":1,"start_line":21,"text":"| `respiratory_rate_6h_brpm` | Declared outcome 5. Respiratory rate at 6 hours | breaths per minute (brpm); whole numbers |"},{"end_column":106,"end_line":22,"start_column":1,"start_line":22,"text":"| `food_intake_24h_g` | Declared outcome 6. Food eaten in the first 24 hours | grams (g); whole numbers |"},{"end_column":123,"end_line":23,"start_column":1,"start_line":23,"text":"| `rectal_temperature_6h_c` | Declared outcome 7. Rectal temperature at 6 hours | degrees Celsius (C), one decimal place |"},{"end_column":98,"end_line":25,"start_column":1,"start_line":25,"text":"The seven outcome columns appear in the order the study protocol declared them, and the first two"},{"end_column":74,"end_line":26,"start_column":1,"start_line":26,"text":"columns after `dog_id` and `protocol` are the two named primary outcomes."},{"end_column":99,"end_line":28,"start_column":1,"start_line":28,"text":"Rows are stored in mixed protocol order, and `dog_id` numbers the rows as they appear in the file,"},{"end_column":88,"end_line":29,"start_column":1,"start_line":29,"text":"so the identifier carries no information about the protocol or about any outcome value."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:55c4616e7f51a18f1ac1","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:e5997cdaf963bb1d1b7023ea6b893183cd6b32d4ba778571e681a4b9bb5ae7d9","end_line":29,"locator":"DATA_DESCRIPTION.md:1-29","path":"DATA_DESCRIPTION.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}
{"audit_run_id":"audit:da310aff9b324a7d87a1544a8e12f4c9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":3,"start_column":1,"start_line":3,"text":"This study compares the two groups recorded in the `protocol` column of `data.csv`."},{"end_column":212,"end_line":4,"start_column":1,"start_line":4,"text":"The pre-declared outcome family, in this fixed order, is: pain_score_6h, rescue_analgesia_24h_mg, serum_cortisol_6h_ug_dl, heart_rate_6h_bpm, respiratory_rate_6h_brpm, food_intake_24h_g, rectal_temperature_6h_c."},{"end_column":85,"end_line":5,"start_column":1,"start_line":5,"text":"Each outcome is compared between the two groups. The named outcomes form one outcome"},{"end_column":88,"end_line":6,"start_column":1,"start_line":6,"text":"family; per-outcome comparisons over this family require complete-family control of the"},{"end_column":45,"end_line":7,"start_column":1,"start_line":7,"text":"family-wise error from multiple comparisons."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:f73827d2fa828664b6a5","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.21.0","source_ref":{"content_digest":"sha256:a5a21df67c0dd1cf0139febdc89fb1bb10175788d39404b23a75facc7b311d03","end_line":7,"locator":"PROTOCOL.md:1-7","path":"PROTOCOL.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

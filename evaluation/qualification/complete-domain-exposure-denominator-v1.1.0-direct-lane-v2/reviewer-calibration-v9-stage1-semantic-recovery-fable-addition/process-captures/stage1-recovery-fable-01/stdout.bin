}, {\"calibration_case_id\": \"calibration:conflicting-scope-records\", \"verdict\": \"conditional_or_unknown\", \"invented_material_premise\": false, \"evidence_basis\": \"stated_evidence_only\", \"rationale\": \"Two equally authoritative signed plans specify conflicting frames (all planned vs. signal-eligible) with no precedence rule; the result uses eligible locations. Falsification attempt: to demonstrate an issue I would need evidence that the all-locations plan governs, which is absent; to clear the result I would need evidence the eligible-locations plan governs, also absent. Whether the selected frame matches the governing target is materially unknown.\"}, {\"calibration_case_id\": \"calibration:no-selected-result\", \"verdict\": \"insufficient_evidence\", \"invented_material_premise\": false, \"evidence_basis\": \"stated_evidence_only\", \"rationale\": \"Multiple reports can be emitted depending on runtime arguments, and the preserved record does not establish which, if any, was selected for the scientific claim. Falsification attempt: assessing any target-result alignment requires identifying the selected result; no record identifies one, so there is insufficient evidence to demonstrate or exclude an issue.\"}]}","ttft_ms":15256,"ttft_stream_ms":2407,"time_to_request_ms":19,"type":"result","duration_ms":16765,"uuid":"23b08670-cb01-424f-b35c-be77316faaf1"}

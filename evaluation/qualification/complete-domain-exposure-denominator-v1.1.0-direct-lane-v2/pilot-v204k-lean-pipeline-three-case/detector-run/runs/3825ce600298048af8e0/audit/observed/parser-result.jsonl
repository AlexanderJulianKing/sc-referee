{"audit_run_id":"audit:35c665e3de9848c3aa4b5ca51c137a63","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Subject area: ground-based time-series photometry of candidate transiting"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"exoplanet host stars. The scientific target of this analysis is the complete"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"planned set of scheduled pointings: all 48 pointings on the observing plan."},{"end_column":44,"end_line":11,"start_column":1,"start_line":11,"text":"- Planned pointings (observation units): 48"},{"end_column":44,"end_line":12,"start_column":1,"start_line":12,"text":"- Retained after prespecified screening: 36"},{"end_column":40,"end_line":13,"start_column":1,"start_line":13,"text":"- Removed by prespecified screening: 12"},{"end_column":58,"end_line":14,"start_column":1,"start_line":14,"text":"- Transit-like dip detections among retained pointings: 9"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"A pointing is eligible when its photometric scatter is at most 1.50 ppt and its"},{"end_column":73,"end_line":19,"start_column":1,"start_line":19,"text":"time-series coverage fraction is at least 0.90. Pointings failing either"},{"end_column":79,"end_line":20,"start_column":1,"start_line":20,"text":"criterion were removed before the dip search was run. The 12 removed pointings"},{"end_column":80,"end_line":21,"start_column":1,"start_line":21,"text":"were never searched, so their event status is recorded as NA in inputs/data.csv"},{"end_column":33,"end_line":22,"start_column":1,"start_line":22,"text":"rather than as a confirmed zero."},{"end_column":76,"end_line":26,"start_column":1,"start_line":26,"text":"The declared scientific target is the complete planned set, so the exposure"},{"end_column":79,"end_line":27,"start_column":1,"start_line":27,"text":"denominator is all 48 planned pointings. The numerator is the 9 dip detections"},{"end_column":75,"end_line":28,"start_column":1,"start_line":28,"text":"actually made. The 12 removed pointings stay in the denominator as planned"},{"end_column":36,"end_line":29,"start_column":1,"start_line":29,"text":"exposure that yielded no detection."},{"end_column":154,"end_line":31,"start_column":1,"start_line":31,"text":"[selected-result] Transit-like dip yield over the complete planned set: 9 detections / 48 planned pointings = 0.187500 (18.75 per 100 planned pointings)."},{"end_column":79,"end_line":35,"start_column":1,"start_line":35,"text":"This rate is a yield per planned pointing for this observing plan as executed."},{"end_column":74,"end_line":36,"start_column":1,"start_line":36,"text":"It is not a per-retained-pointing detection probability, and it is not an"},{"end_column":78,"end_line":37,"start_column":1,"start_line":37,"text":"estimate of the fraction of the 48 target stars that host transiting planets."},{"end_column":78,"end_line":38,"start_column":1,"start_line":38,"text":"Because the 12 removed pointings were never searched, the reported yield is a"},{"end_column":75,"end_line":39,"start_column":1,"start_line":39,"text":"lower bound on the number of detectable dips per planned pointing: any dip"},{"end_column":80,"end_line":40,"start_column":1,"start_line":40,"text":"present in a removed pointing is counted as absent here. No claim is made about"},{"end_column":39,"end_line":41,"start_column":1,"start_line":41,"text":"the 12 removed pointings individually."},{"end_column":70,"end_line":45,"start_column":1,"start_line":45,"text":"All counts and the reported rate are computed from inputs/data.csv by"},{"end_column":53,"end_line":46,"start_column":1,"start_line":46,"text":"workflow/analysis.py; no result value is hard-coded."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:b11f744d28f201800312","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:ddde1ff617393e86b6278f1e0c9dc0e0455b6e3afcbe892b7e2a66c78c9a91c5","end_line":46,"locator":"results/report.md:1-46","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

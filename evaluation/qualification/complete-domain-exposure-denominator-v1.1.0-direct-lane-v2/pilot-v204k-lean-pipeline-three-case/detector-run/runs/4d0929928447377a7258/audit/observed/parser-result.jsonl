{"audit_run_id":"audit:05f6d79436534bcdb896676f7228bd77","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"Subject area: ground-based time-series photometry of candidate transiting"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"exoplanet host stars. The scientific target of this analysis is the complete"},{"end_column":76,"end_line":7,"start_column":1,"start_line":7,"text":"planned set of scheduled pointings: all 48 pointings on the observing plan."},{"end_column":44,"end_line":11,"start_column":1,"start_line":11,"text":"- Planned pointings (observation units): 48"},{"end_column":44,"end_line":12,"start_column":1,"start_line":12,"text":"- Retained after prespecified screening: 36"},{"end_column":40,"end_line":13,"start_column":1,"start_line":13,"text":"- Removed by prespecified screening: 12"},{"end_column":58,"end_line":14,"start_column":1,"start_line":14,"text":"- Transit-like dip detections among retained pointings: 9"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"A pointing is eligible when its photometric scatter is at most 1.50 ppt and its"},{"end_column":73,"end_line":19,"start_column":1,"start_line":19,"text":"time-series coverage fraction is at least 0.90. Pointings failing either"},{"end_column":79,"end_line":20,"start_column":1,"start_line":20,"text":"criterion were removed before the dip search was run. The 12 removed pointings"},{"end_column":81,"end_line":21,"start_column":1,"start_line":21,"text":"were never searched, so their event status is recorded as NA in inputs/data.csv."},{"end_column":81,"end_line":25,"start_column":1,"start_line":25,"text":"The rate below is computed on the 36 retained pointings, which are the pointings"},{"end_column":78,"end_line":26,"start_column":1,"start_line":26,"text":"whose photometry supports a dip search. The denominator is 36; the 12 removed"},{"end_column":45,"end_line":27,"start_column":1,"start_line":27,"text":"pointings are excluded from the denominator."},{"end_column":171,"end_line":29,"start_column":1,"start_line":29,"text":"[selected-result] Transit-like dip detection rate for the complete planned set of 48 pointings: 9 detections / 36 retained pointings = 0.250000 (25.00 per 100 pointings)."},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"The rate of 25.00 per 100 pointings is reported as the detection rate of the"},{"end_column":80,"end_line":34,"start_column":1,"start_line":34,"text":"complete planned set of 48 pointings. It is applied to the full observing plan,"},{"end_column":60,"end_line":35,"start_column":1,"start_line":35,"text":"including the 12 pointings that the screening step removed."},{"end_column":81,"end_line":39,"start_column":1,"start_line":39,"text":"No protocol amendment and no approved method deviation exists for this analysis."},{"end_column":79,"end_line":40,"start_column":1,"start_line":40,"text":"The analysis plan as written declares the complete planned set of 48 pointings"},{"end_column":26,"end_line":41,"start_column":1,"start_line":41,"text":"as the scientific target."},{"end_column":70,"end_line":45,"start_column":1,"start_line":45,"text":"All counts and the reported rate are computed from inputs/data.csv by"},{"end_column":53,"end_line":46,"start_column":1,"start_line":46,"text":"workflow/analysis.py; no result value is hard-coded."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:48d6bb430e6990e8842d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-re
7,936,no\\nTIC-0018,17,1633,not_analyzed\\nTIC-0019,18,1071,yes\\nTIC-0020,18,794,no\\nTIC-0021,18,1249,no\\nTIC-0022,19,865,yes\\nTIC-0023,19,1318,no\\nTIC-0024,19,1954,not_analyzed\\nTIC-0025,20,1002,no\\nTIC-0026,20,731,yes\\nTIC-0027,20,1426,no\\nTIC-0028,21,1157,yes\\nTIC-0029,21,2288,not_analyzed\\nTIC-0030,21,889,no\\nTIC-0031,22,1381,no\\nTIC-0032,22,1093,yes\\nTIC-0033,22,1712,not_analyzed\\nTIC-0034,23,947,no\\nTIC-0035,23,1264,yes\\nTIC-0036,23,812,no\\nTIC-0037,24,1499,no\\nTIC-0038,24,2031,not_analyzed\\nTIC-0039,24,1128,yes\\nTIC-0040,24,976,no\\n\",\"analysis_py\":\"\\\"\\\"\\\"Transit detection yield among planned TESS candidate light curves.\\n\\nReads inputs/data.csv, applies the prespecified photometric screening rule,\\ncounts confirmed transit detections among the retained curves, and writes\\nresults/report.md. The selected rate uses the complete planned set as its\\nexposure denominator.\\n\\\"\\\"\\\"\\n\\nimport csv\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nfrom pathlib import Path\\n\\nMAX_BASELINE_RMS_PPM = 1500\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nREPORT_PATH = ROOT / \\\"results\\\" / \\\"report.md\\\"\\n\\n\\ndef load_rows(path):\\n    with path.open(newline=\\\"\\\", encoding=\\\"ascii\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef is_eligible(row):\\n    return int(row[\\\"baseline_rms_ppm\\\"]) <= MAX_BASELINE_RMS_PPM\\n\\n\\ndef percent(numerator, denominator):\\n    value = Decimal(numerator) / Decimal(denominator) * Decimal(100)\\n    return str(value.quantize(Decimal(\\\"0.001\\\"), rounding=ROUND_HALF_EVEN))\\n\\n\\ndef main():\\n    rows = load_rows(DATA_PATH)\\n    planned = len(rows)\\n    retained = [row for row in rows if is_eligible(row)]\\n    removed = [row for row in rows if not is_eligible(row)]\\n    n_retained = len(retained)\\n    n_removed = len(removed)\\n    events = sum(1 for row in retained if row[\\\"transit_detected\\\"] == \\\"yes\\\")\\n    rate = percent(events, planned)\\n\\n    lines = [\\n        \\\"# Transit Detection Yield in Planned TESS Candidate Light Curves\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        \\\"The scientific target is the complete planned set of \\\"\\n        + str(planned)\\n        + \\\" candidate light curves\\\",\\n        \\\"selected for transit vetting, including the curves that the prespecified\\\",\\n        \\\"screening step removed.\\\",\\n        \\\"\\\",\\n        \\\"## Planned unit accounting\\\",\\n        \\\"\\\",\\n        \\\"- Planned candidate light curves: \\\" + str(planned),\\n        \\\"- Retained after screening: \\\" + str(n_retained),\\n        \\\"- Removed by screening: \\\" + str(n_removed),\\n        \\\"- Confirmed transit detections among retained curves: \\\" + str(events),\\n        \\\"\\\",\\n        \\\"## Screening step\\\",\\n        \\\"\\\",\\n        \\\"Prespecified before vetting: a candidate light curve is eligible if its baseline\\\",\\n        \\\"photometric scatter is at most \\\"\\n        + str(MAX_BASELINE_RMS_PPM)\\n        + \\\" ppm. The \\\"\\n        + str(n_removed)\\n        + \\\" curves above that threshold were\\\",\\n        \\\"removed and were not searched for transits.\\\",\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        \\\"[selected-result] Confirmed transit detections per planned candidate light curve: \\\"\\n        + str(events)\\n        + \\\" / \\\"\\n        + str(planned)\\n        + \\\" = \\\"\\n        + rate\\n        + \\\" percent.\\\",\\n        \\\"\\\",\\n        \\\"## Scope of the claim\\\",\\n        \\\"\\\",\\n        \\\"The selected rate uses the complete planned set of \\\"\\n        + str(planned)\\n        + \\\" curves as its exposure\\\",\\n        \\\"denominator, so it applies to the declared target. Because the \\\"\\n        + str(n_removed)\\n        + \\\" removed curves\\\",\\n        \\\"were never searched, each is counted in the denominator as a non-detection; the\\\",\\n        \\\"rate is therefore a lower bound on the detection rate that full-sensitivity\\\",\\n        \\\"vetting of all \\\" + str(planned) + \\\" curves would have produced. No claim is made about the\\\",\\n        \\\"detection rate within the retained subset alone.\\\",\\n        \\\"\\\",\\n        \\\"Generated by workflow/analysis.py from inputs/data.csv.\\\",\\n    ]\\n\\n    text = \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n    REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)\\n    with REPORT_PATH.open(\\\"w\\\", encoding=\\\"ascii\\\", newline=\\\"\\\\n\\\") as handle:\\n        handle.write(text)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Transit Detection Yield in Planned TESS Candidate Light Curves\\n\\n## Scientific target\\n\\nThe scientific target is the complete planned set of 40 candidate light curves\\nselected for transit vetting, including the curves that the prespecified\\nscreening step removed.\\n\\n## Planned unit accounting\\n\\n- Planned candidate light curves: 40\\n- Retained after screening: 32\\n- Removed by screening: 8\\n- Confirmed transit detections among retained curves: 12\\n\\n## Screening step\\n\\nPrespecified before vetting: a candidate light curve is eligible if its baseline\\nphotometric scatter is at most 1500 ppm. The 8 curves above that threshold were\\nremoved and were not searched for transits.\\n\\n## Selected result\\n\\n[selected-result] Confirmed transit detections per planned candidate light curve: 12 / 40 = 30.000 percent.\\n\\n## Scope of the claim\\n\\nThe selected rate uses the complete planned set of 40 curves as its exposure\\ndenominator, so it applies to the declared target. Because the 8 removed curves\\nwere never searched, each is counted in the denominator as a non-detection; the\\nrate is therefore a lower bound on the detection rate that full-sensitivity\\nvetting of all 40 curves would have produced. No claim is made about the\\ndetection rate within the retained subset alone.\\n\\nGenerated by workflow/analysis.py from inputs/data.csv.\\n\",\"selected_result_line\":24},{\"case_id\":\"case:a4868f1e140f06a46af9\",\"input_csv\":\"star_id,sector,baseline_rms_ppm,transit_detected\\nTIC-0001,12,842,yes\\nTIC-0002,12,1103,no\\nTIC-0003,12,967,no\\nTIC-0004,13,2140,not_analyzed\\nTIC-0005,13,1288,yes\\nTIC-0006,13,754,no\\nTIC-0007,14,1410,no\\nTIC-0008,14,902,yes\\nTIC-0009,14,1877,not_analyzed\\nTIC-0010,15,1044,no\\nTIC-0011,15,688,yes\\nTIC-0012,15,1352,no\\nTIC-0013,16,2506,not_analyzed\\nTIC-0014,16,1195,no\\nTIC-0015,16,823,yes\\nTIC-0016,17,1478,no\\nTIC-0017,17,936,no\\nTIC-0018,17,1633,not_analyzed\\nTIC-0019,18,1071,yes\\nTIC-0020,18,794,no\\nTIC-0021,18,1249,no\\nTIC-0022,19,865,yes\\nTIC-0023,19,1318,no\\nTIC-0024,19,1954,not_analyzed\\nTIC-0025,20,1002,no\\nTIC-0026,20,731,yes\\nTIC-0027,20,1426,no\\nTIC-0028,21,1157,yes\\nTIC-0029,21,2288,not_analyzed\\nTIC-0030,21,889,no\\nTIC-0031,22,1381,no\\nTIC-0032,22,1093,yes\\nTIC-0033,22,1712,not_analyzed\\nTIC-0034,23,947,no\\nTIC-0035,23,1264,yes\\nTIC-0036,23,812,no\\nTIC-0037,24,1499,no\\nTIC-0038,24,2031,not_analyzed\\nTIC-0039,24,1128,yes\\nTIC-0040,24,976,no\\n\",\"analysis_py\":\"\\\"\\\"\\\"Transit detection yield in planned TESS candidate light curves.\\n\\nReads inputs/data.csv, applies the prespecified photometric screening rule,\\ncounts confirmed transit detections among the retained curves, and writes\\nresults/report.md. The selected rate uses the retained post-screening subset\\nas its exposure denominator.\\n\\\"\\\"\\\"\\n\\nimport csv\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nfrom pathlib import Path\\n\\nMAX_BASELINE_RMS_PPM = 1500\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nREPORT_PATH = ROOT / \\\"results\\\" / \\\"report.md\\\"\\n\\n\\ndef load_rows(path):\\n    with path.open(newline=\\\"\\\", encoding=\\\"ascii\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef is_eligible(row):\\n    return int(row[\\\"baseline_rms_ppm\\\"]) <= MAX_BASELINE_RMS_PPM\\n\\n\\ndef percent(numerator, denominator):\\n    value = Decimal(numerator) / Decimal(denominator) * Decimal(100)\\n    return str(value.quantize(Decimal(\\\"0.001\\\"), rounding=ROUND_HALF_EVEN))\\n\\n\\ndef main():\\n    rows = load_rows(DATA_PATH)\\n    planned = len(rows)\\n    retained = [row for row in rows if is_eligible(row)]\\n    removed = [row for row in rows if not is_eligible(row)]\\n    n_retained = len(retained)\\n    n_removed = len(removed)\\n    events = sum(1 for row in retained if row[\\\"transit_detected\\\"] == \\\"yes\\\")\\n    rate = percent(events, n_retained)\\n\\n    lines = [\\n        \\\"# Transit Detection Yield in Planned TESS Candidate Light Curves\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        \\\"The scientific target is the complete planned set of \\\"\\n        + str(planned)\\n        + \\\" candidate light curves\\\",\\n        \\\"selected for transit vetting, including the curves that the prespecified\\\",\\n        \\\"screening step removed.\\\",\\n        \\\"\\\",\\n        \\\"## Planned unit accounting\\\",\\n        \\\"\\\",\\n        \\\"- Planned candidate light curves: \\\" + str(planned),\\n        \\\"- Retained after screening: \\\" + str(n_retained),\\n        \\\"- Removed by screening: \\\" + str(n_removed),\\n        \\\"- Confirmed transit detections among retained curves: \\\" + str(events),\\n        \\\"\\\",\\n        \\\"## Screening step\\\",\\n        \\\"\\\",\\n        \\\"Prespecified before vetting: a candidate light curve is eligible if its baseline\\\",\\n        \\\"photometric scatter is at most \\\"\\n        + str(MAX_BASELINE_RMS_PPM)\\n        + \\\" ppm. The \\\"\\n        + str(n_removed)\\n        + \\\" curves above that threshold were\\\",\\n        \\\"removed and were not searched for transits.\\\",\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        \\\"[selected-result] Confirmed transit detection rate for the complete planned set of \\\"\\n        + str(planned)\\n        + \\\" candidate light curves: \\\"\\n        + str(events)\\n        + \\\" / \\\"\\n        + str(n_retained)\\n        + \\\" = \\\"\\n        + rate\\n        + \\\" percent.\\\",\\n        \\\"\\\",\\n        \\\"## Scope of the claim\\\",\\n        \\\"\\\",\\n        \\\"The selected rate is reported as the detection rate of the complete planned set\\\",\\n        \\\"of \\\"\\n        + str(planned)\\n        + \\\" candidate light curves. Its exposure denominator is the \\\"\\n        + str(n_retained)\\n        + \\\" curves retained\\\",\\n        \\\"after screening. No protocol amendment and no approved method deviation exists\\\",\\n        \\\"for this analysis.\\\",\\n        \\\"\\\",\\n        \\\"Generated by workflow/analysis.py from inputs/data.csv.\\\",\\n    ]\\n\\n    text = \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n    REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)\\n    with REPORT_PATH.open(\\\"w\\\", encoding=\\\"ascii\\\", newline=\\\"\\\\n\\\") as handle:\\n        handle.write(text)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Transit Detection Yield in Planned TESS Candidate Light Curves\\n\\n## Scientific target\\n\\nThe scientific target is the complete planned set of 40 candidate light curves\\nselected for transit vetting, including the curves that the prespecified\\nscreening step removed.\\n\\n## Planned unit accounting\\n\\n- Planned candidate light curves: 40\\n- Retained after screening: 32\\n- Removed by screening: 8\\n- Confirmed transit detections among retained curves: 12\\n\\n## Screening step\\n\\nPrespecified before vetting: a candidate light curve is eligible if its baseline\\nphotometric scatter is at most 1500 ppm. The 8 curves above that threshold were\\nremoved and were not searched for transits.\\n\\n## Selected result\\n\\n[selected-result] Confirmed transit detection rate for the complete planned set of 40 candidate light curves: 12 / 32 = 37.500 percent.\\n\\n## Scope of the claim\\n\\nThe selected rate is reported as the detection rate of the complete planned set\\nof 40 candidate light curves. Its exposure denominator is the 32 curves retained\\nafter screening. No protocol amendment and no approved method deviation exists\\nfor this analysis.\\n\\nGenerated by workflow/analysis.py from inputs/data.csv.\\n\",\"selected_result_line\":24}]}","ttft_ms":78551,"ttft_stream_ms":1183,"time_to_request_ms":12,"type":"result","duration_ms":122701,"uuid":"af8920c5-7d27-4773-8039-773b06954e44"}

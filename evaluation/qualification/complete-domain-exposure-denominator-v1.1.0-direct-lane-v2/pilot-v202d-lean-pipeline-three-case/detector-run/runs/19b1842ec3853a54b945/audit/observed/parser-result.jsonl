{"audit_run_id":"audit:37d3e02299f54bab90d35dfcc97b92d3","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target is the complete planned set of 40 candidate light curves"},{"end_column":73,"end_line":6,"start_column":1,"start_line":6,"text":"selected for transit vetting, including the curves that the prespecified"},{"end_column":24,"end_line":7,"start_column":1,"start_line":7,"text":"screening step removed."},{"end_column":37,"end_line":11,"start_column":1,"start_line":11,"text":"- Planned candidate light curves: 40"},{"end_column":31,"end_line":12,"start_column":1,"start_line":12,"text":"- Retained after screening: 32"},{"end_column":26,"end_line":13,"start_column":1,"start_line":13,"text":"- Removed by screening: 8"},{"end_column":57,"end_line":14,"start_column":1,"start_line":14,"text":"- Confirmed transit detections among retained curves: 12"},{"end_column":81,"end_line":18,"start_column":1,"start_line":18,"text":"Prespecified before vetting: a candidate light curve is eligible if its baseline"},{"end_column":80,"end_line":19,"start_column":1,"start_line":19,"text":"photometric scatter is at most 1500 ppm. The 8 curves above that threshold were"},{"end_column":44,"end_line":20,"start_column":1,"start_line":20,"text":"removed and were not searched for transits."},{"end_column":108,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Confirmed transit detections per planned candidate light curve: 12 / 40 = 30.000 percent."},{"end_column":77,"end_line":28,"start_column":1,"start_line":28,"text":"The selected rate uses the complete planned set of 40 curves as its exposure"},{"end_column":80,"end_line":29,"start_column":1,"start_line":29,"text":"denominator, so it applies to the declared target. Because the 8 removed curves"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"were never searched, each is counted in the denominator as a non-detection; the"},{"end_column":76,"end_line":31,"start_column":1,"start_line":31,"text":"rate is therefore a lower bound on the detection rate that full-sensitivity"},{"end_column":73,"end_line":32,"start_column":1,"start_line":32,"text":"vetting of all 40 curves would have produced. No claim is made about the"},{"end_column":49,"end_line":33,"start_column":1,"start_line":33,"text":"detection rate within the retained subset alone."},{"end_column":56,"end_line":35,"start_column":1,"start_line":35,"text":"Generated by workflow/analysis.py from inputs/data.csv."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:aa6db58a68458d9dad47","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:1b54a57b3bf419de1ced2792fd6c243fd046c0f42c2f92742f5ff000cdda2013","end_line":35,"locator":"results/report.md:1-35","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

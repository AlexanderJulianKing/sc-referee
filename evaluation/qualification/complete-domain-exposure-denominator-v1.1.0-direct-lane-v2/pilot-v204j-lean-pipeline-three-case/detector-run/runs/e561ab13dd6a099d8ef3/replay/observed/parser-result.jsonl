{"audit_run_id":"audit:b8a648ee1bb746ccb48b43e40ce2d243","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target of this analysis is the complete planned set of 48 nest"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"boxes deployed in the Ashcombe woodland plot for the 2025 breeding season."},{"end_column":79,"end_line":10,"start_column":1,"start_line":10,"text":"A deployed box is eligible for outcome analysis if and only if all 6 scheduled"},{"end_column":79,"end_line":11,"start_column":1,"start_line":11,"text":"inspections were completed and an active clutch was recorded at one or more of"},{"end_column":76,"end_line":12,"start_column":1,"start_line":12,"text":"those inspections. Boxes failing either condition are removed by screening."},{"end_column":54,"end_line":16,"start_column":1,"start_line":16,"text":"- Planned observation units (nest boxes deployed): 48"},{"end_column":31,"end_line":17,"start_column":1,"start_line":17,"text":"- Retained after screening: 36"},{"end_column":27,"end_line":18,"start_column":1,"start_line":18,"text":"- Removed by screening: 12"},{"end_column":73,"end_line":19,"start_column":3,"start_line":19,"text":"- Removed for incomplete monitoring (fewer than 6 of 6 inspections): 5"},{"end_column":64,"end_line":20,"start_column":3,"start_line":20,"text":"- Removed for no active clutch despite complete monitoring: 7"},{"end_column":72,"end_line":21,"start_column":1,"start_line":21,"text":"- Event count (retained boxes with at least one fledgling observed): 27"},{"end_column":210,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Fledging success rate over the complete planned set of 48 deployed nest boxes: 0.5625 (56.25%), from 27 boxes with at least one fledgling over an exposure denominator of all 48 planned boxes."},{"end_column":78,"end_line":29,"start_column":1,"start_line":29,"text":"The rate above uses every planned box as the denominator, so it is a rate per"},{"end_column":75,"end_line":30,"start_column":1,"start_line":30,"text":"deployed box and not a rate per box with a monitored active clutch. The 12"},{"end_column":78,"end_line":31,"start_column":1,"start_line":31,"text":"removed boxes contribute to the denominator and contribute no events, because"},{"end_column":78,"end_line":32,"start_column":1,"start_line":32,"text":"5 boxes have unknown outcomes after incomplete monitoring and 7 boxes held no"},{"end_column":78,"end_line":33,"start_column":1,"start_line":33,"text":"clutch. No claim is made here about the conditional success rate among the 36"},{"end_column":16,"end_line":34,"start_column":1,"start_line":34,"text":"retained boxes."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:80ffd84cf70ebf4219a8","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:54981d3d216090a0370f160d3edc881195844bb493515e6e1968df9c49c5ab55","end_line":34,"locator":"results/report.md:1-34","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

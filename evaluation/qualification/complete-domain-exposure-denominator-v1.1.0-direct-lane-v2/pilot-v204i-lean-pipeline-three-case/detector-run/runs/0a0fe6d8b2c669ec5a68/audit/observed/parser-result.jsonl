{"audit_run_id":"audit:f31ee5a163a344c09b75f0ebc50bd875","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":76,"end_line":4,"start_column":1,"start_line":4,"text":"The target of inference is the complete planned set of M-dwarf light curves"},{"end_column":71,"end_line":5,"start_column":1,"start_line":5,"text":"in this campaign, including light curves that the prespecified quality"},{"end_column":19,"end_line":6,"start_column":1,"start_line":6,"text":"screening removed."},{"end_column":27,"end_line":9,"start_column":1,"start_line":9,"text":"- Planned light curves: 40"},{"end_column":31,"end_line":10,"start_column":1,"start_line":10,"text":"- Retained after screening: 32"},{"end_column":26,"end_line":11,"start_column":1,"start_line":11,"text":"- Removed by screening: 8"},{"end_column":69,"end_line":12,"start_column":1,"start_line":12,"text":"- Flare-positive light curves among retained units (event count): 12"},{"end_column":74,"end_line":15,"start_column":1,"start_line":15,"text":"A light curve is eligible if on-source coverage is at least 6.0 hours and"},{"end_column":71,"end_line":16,"start_column":1,"start_line":16,"text":"photometric RMS is at most 5.0 mmag. Both thresholds were fixed before"},{"end_column":77,"end_line":17,"start_column":1,"start_line":17,"text":"observing. Removed light curves have no flare determination and are recorded"},{"end_column":24,"end_line":18,"start_column":1,"start_line":18,"text":"as NA in the data file."},{"end_column":31,"end_line":19,"start_column":1,"start_line":19,"text":"- Removed for coverage only: 3"},{"end_column":26,"end_line":20,"start_column":1,"start_line":20,"text":"- Removed for RMS only: 3"},{"end_column":31,"end_line":21,"start_column":1,"start_line":21,"text":"- Removed for both criteria: 2"},{"end_column":105,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Flare-positive light curves per planned light curve: 12 / 40 = 0.3000 (30.00 percent)."},{"end_column":74,"end_line":27,"start_column":1,"start_line":27,"text":"The reported rate uses the complete planned set of 40 light curves as its"},{"end_column":77,"end_line":28,"start_column":1,"start_line":28,"text":"exposure denominator, matching the declared scientific target. The 8 removed"},{"end_column":72,"end_line":29,"start_column":1,"start_line":29,"text":"light curves contribute to the denominator and contribute zero detected"},{"end_column":74,"end_line":30,"start_column":1,"start_line":30,"text":"flares, because no flare determination was possible for them. The rate is"},{"end_column":75,"end_line":31,"start_column":1,"start_line":31,"text":"therefore a lower bound on the flare-positive fraction of the planned set:"},{"end_column":74,"end_line":32,"start_column":1,"start_line":32,"text":"it is the fraction of planned light curves that were both screened in and"},{"end_column":71,"end_line":33,"start_column":1,"start_line":33,"text":"flare-positive. No claim is made about the flare status of the removed"},{"end_column":79,"end_line":34,"start_column":1,"start_line":34,"text":"light curves, and no rate conditional on the retained subset is reported here."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:0d6e28cb266081dd8c3b","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:e7b2e1d213cbedfcfd3fd093ff3dd2f95b7b307c52f80ab83d06697adf4ce920","end_line":34,"locator":"results/report.md:1-34","path":"results/report.md","source
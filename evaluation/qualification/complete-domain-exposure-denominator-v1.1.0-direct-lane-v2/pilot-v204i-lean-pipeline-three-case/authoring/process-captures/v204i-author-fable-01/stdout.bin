4,no,no\\nTN21,7.8,no,no\\nTN22,11.2,no,yes\\nTN23,10.4,yes,no\\nTN24,12.9,no,no\\n\",\"analysis_py\":\"import csv\\nfrom decimal import Decimal, ROUND_HALF_UP\\nfrom pathlib import Path\\n\\nDATA = Path(\\\"inputs/data.csv\\\")\\nOUT = Path(\\\"results/report.md\\\")\\n\\n\\ndef main():\\n    with DATA.open(newline=\\\"\\\") as f:\\n        rows = list(csv.DictReader(f))\\n    planned = len(rows)\\n    retained = [\\n        r for r in rows\\n        if r[\\\"equipment_fault\\\"] == \\\"no\\\"\\n        and Decimal(r[\\\"min_temp_c\\\"]) >= Decimal(\\\"10.0\\\")\\n    ]\\n    n = len(retained)\\n    removed = planned - n\\n    events = sum(1 for r in retained if r[\\\"hawkmoth_captured\\\"] == \\\"yes\\\")\\n    rate = (Decimal(events) / Decimal(n)).quantize(\\n        Decimal(\\\"0.0001\\\"), rounding=ROUND_HALF_UP)\\n    lines = [\\n        \\\"# Hawkmoth Capture Rate in a Light-Trap Survey\\\",\\n        \\\"\\\",\\n        \\\"## Study accounting\\\",\\n        \\\"\\\",\\n        f\\\"- Planned observation units (trap-nights): {planned}\\\",\\n        f\\\"- Retained after eligibility screening (no equipment fault and minimum temperature >= 10.0 C): {n}\\\",\\n        f\\\"- Removed by screening: {removed}\\\",\\n        f\\\"- Hawkmoth capture events among retained trap-nights: {events}\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        \\\"The scientific target of this analysis is defined explicitly and only as the\\\",\\n        f\\\"retained post-screening subset of {n} eligible trap-nights. All claims below\\\",\\n        f\\\"apply to that retained subset, not to the complete planned set of {planned}\\\",\\n        \\\"trap-nights.\\\",\\n        \\\"\\\",\\n        f\\\"[selected-result] Among the {n} retained eligible trap-nights, {events} recorded at least one hawkmoth (Sphingidae) capture, a capture rate of {events}/{n} = {rate}.\\\",\\n        \\\"\\\",\\n        f\\\"This capture rate uses the retained post-screening subset (n = {n}) as its\\\",\\n        f\\\"denominator and makes no claim about the {removed} screened-out trap-nights or about\\\",\\n        f\\\"the complete planned set of {planned} trap-nights.\\\",\\n    ]\\n    OUT.parent.mkdir(parents=True, exist_ok=True)\\n    OUT.write_text(\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\", encoding=\\\"ascii\\\")\\n\\n\\nmain()\\n\",\"report_md\":\"# Hawkmoth Capture Rate in a Light-Trap Survey\\n\\n## Study accounting\\n\\n- Planned observation units (trap-nights): 24\\n- Retained after eligibility screening (no equipment fault and minimum temperature >= 10.0 C): 18\\n- Removed by screening: 6\\n- Hawkmoth capture events among retained trap-nights: 7\\n\\n## Scientific target\\n\\nThe scientific target of this analysis is defined explicitly and only as the\\nretained post-screening subset of 18 eligible trap-nights. All claims below\\napply to that retained subset, not to the complete planned set of 24\\ntrap-nights.\\n\\n[selected-result] Among the 18 retained eligible trap-nights, 7 recorded at least one hawkmoth (Sphingidae) capture, a capture rate of 7/18 = 0.3889.\\n\\nThis capture rate uses the retained post-screening subset (n = 18) as its\\ndenominator and makes no claim about the 6 screened-out trap-nights or about\\nthe complete planned set of 24 trap-nights.\\n\",\"selected_result_line\":17}]}","ttft_ms":39485,"ttft_stream_ms":3976,"time_to_request_ms":13,"type":"result","duration_ms":56405,"uuid":"abba8735-47a9-4650-9298-3e5e8293b5a8"}

{"audit_run_id":"audit:3bffad2314b343aa8bfb3ce9a130d3bd","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":78,"end_line":5,"start_column":1,"start_line":5,"text":"The AURA-7 adaptive-optics bench was commissioned over 14 observing blocks of"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"12 scheduled slots each, one slot per closed-loop acquisition attempt, spread"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"over 6 detector channels. A slot counts as a failure when the closed loop does"},{"end_column":35,"end_line":8,"start_column":1,"start_line":8,"text":"not hold for the full acquisition."},{"end_column":34,"end_line":12,"start_column":1,"start_line":12,"text":"- Planned commissioned slots: 168"},{"end_column":42,"end_line":13,"start_column":1,"start_line":13,"text":"- Retained after telemetry screening: 126"},{"end_column":37,"end_line":14,"start_column":1,"start_line":14,"text":"- Removed by telemetry screening: 42"},{"end_column":42,"end_line":15,"start_column":1,"start_line":15,"text":"- Failure events among retained slots: 21"},{"end_column":77,"end_line":17,"start_column":1,"start_line":17,"text":"Removal reasons: clock_desync 14, packet_crc_error 14, telemetry_dropout 14."},{"end_column":74,"end_line":18,"start_column":1,"start_line":18,"text":"Failure modes: focus_drive_runaway 7, readout_timeout 7, shutter_stall 7."},{"end_column":76,"end_line":22,"start_column":1,"start_line":22,"text":"Two signed scope records govern this workflow. Both are executed originals,"},{"end_column":52,"end_line":23,"start_column":1,"start_line":23,"text":"both are unamended, and both carry equal authority."},{"end_column":71,"end_line":25,"start_column":1,"start_line":25,"text":"- Scope Record A, \"Commissioning Scope of Work\" (signed): the analysis"},{"end_column":52,"end_line":26,"start_column":3,"start_line":26,"text":"population is every commissioned slot, 168 slots."},{"end_column":70,"end_line":27,"start_column":1,"start_line":27,"text":"- Scope Record B, \"Telemetry Validation Annex\" (signed): the analysis"},{"end_column":59,"end_line":28,"start_column":3,"start_line":28,"text":"population is the valid-telemetry slots only, 126 slots."},{"end_column":77,"end_line":30,"start_column":1,"start_line":30,"text":"Neither record is dated relative to the other, neither amends the other, and"},{"end_column":78,"end_line":31,"start_column":1,"start_line":31,"text":"neither contains a precedence, supremacy, or order-of-control clause. Nothing"},{"end_column":76,"end_line":32,"start_column":1,"start_line":32,"text":"in the record set resolves which population governs, and this workflow does"},{"end_column":44,"end_line":33,"start_column":1,"start_line":33,"text":"not designate either record as controlling."},{"end_column":78,"end_line":37,"start_column":1,"start_line":37,"text":"The selected intensity uses the 126 valid-telemetry slots as its denominator,"},{"end_column":68,"end_line":38,"start_column":1,"start_line":38,"text":"which is the population described by Scope Record B; this choice of"},{"end_column":77,"end_line":39,"start_column":1,"start_line":39,"text":"denominator is stated here as the reported basis, not as a ruling that Scope"},{"end_column":34,"end_line":40,"start_column":1,"start_line":40,"text":"Record B outranks Scope Record A."},{"end_column":55,"end_line":42,"start_column":1,"start_line":42,"text":"- Failures per valid-telemetry slot: 0.1667 (21 / 126)"},{"end_column":50,"end_line":43,"start_column":1,"start_line":43,"text":"- Failures per 100 valid-telemetry slots: 16.6667"},{"end_column":79,"end_line":45,"start_column":1,"start_line":45,"text":"Reported for contrast and not selected: over the 168 commissioned slots of the"},{"end_column":78,"end_line":46,"start_column":1,"start_line":46,"text":"Scope Record A population, the same 21 failures give 12.5000 failures per 100"},{"end_column":79,"end_line":47,"start_column":1,"start_line":47,"text":"slots. The two records thus support two different intensities and the conflict"},{"end_column":38,"end_line":48,"start_column":1,"start_line":48,"text":"between them remains unresolved here."},{"end_column":207,"end_line":50,"start_column":1,"start_line":50,"text":"[selected-result] Failure intensity 16.6667 failures per 100 valid-telemetry slots (21 failures / 126 valid-telemetry slots); accounting: 168 planned commissioned slots, 126 retained, 42 removed, 21 events."},{"end_column":64,"end_line":54,"start_column":1,"start_line":54,"text":"All counts and rates above are computed from inputs/data.csv by"},{"end_column":79,"end_line":55,"start_column":1,"start_line":55,"text":"workflow/analysis.py. The script is deterministic: no randomness, no clock, no"},{"end_column":23,"end_line":56,"start_column":1,"start_line":56,"text":"network, no arguments."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:ec22b8f79399036611f5","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:e7e9550d5e2c3fb0eb9f7930386187755feb906bb95535e4da748ef4635bd087","end_line":56,"locator":"results/report.md:1-56","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

+removed_rows = [row for row in rows if row["telemetry_status"] == "removed"]
+retained_count = len(retained_rows)
+removed_count = len(removed_rows)
+event_count = sum(
+    1 for row in retained_rows if row["failure_observed"] == "1"
+)

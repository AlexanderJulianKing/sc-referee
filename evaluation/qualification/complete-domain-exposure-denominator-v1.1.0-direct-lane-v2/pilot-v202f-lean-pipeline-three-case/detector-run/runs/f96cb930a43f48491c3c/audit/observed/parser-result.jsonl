{"audit_run_id":"audit:067953231a8740e8aef7437a060e6759","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target is the complete planned set of 48 target stars scheduled"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"for transit photometry in TESS sectors 41-46. The selected result is reported"},{"end_column":63,"end_line":7,"start_column":1,"start_line":7,"text":"as the detection rate of the complete planned set of 48 stars."},{"end_column":27,"end_line":11,"start_column":1,"start_line":11,"text":"- Planned target stars: 48"},{"end_column":43,"end_line":12,"start_column":1,"start_line":12,"text":"- Retained after photometric screening: 36"},{"end_column":39,"end_line":13,"start_column":1,"start_line":13,"text":"- Removed by photometric screening: 12"},{"end_column":53,"end_line":14,"start_column":1,"start_line":14,"text":"- Retained stars with a detected transit-like dip: 9"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"A planned target star is retained if its light-curve photometric RMS is at most"},{"end_column":73,"end_line":19,"start_column":1,"start_line":19,"text":"2.500 ppt and its cadence coverage fraction is at least 0.800. Of the 12"},{"end_column":80,"end_line":20,"start_column":1,"start_line":20,"text":"removed stars, 7 failed the RMS criterion only, 3 failed the coverage criterion"},{"end_column":73,"end_line":21,"start_column":1,"start_line":21,"text":"only, and 2 failed both. Removed stars were never searched for transits."},{"end_column":126,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Transit-like dip detection rate for the complete planned set of 48 target stars = 9 / 36 = 0.2500 (25.00%)."},{"end_column":77,"end_line":29,"start_column":1,"start_line":29,"text":"The rate above uses the 36 retained stars as the exposure denominator and is"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"reported as the detection rate of the complete planned set of 48 planned target"},{"end_column":78,"end_line":31,"start_column":1,"start_line":31,"text":"stars. No protocol amendment and no approved method deviation exists for this"},{"end_column":72,"end_line":32,"start_column":1,"start_line":32,"text":"analysis; the screening rule and the reporting target are as originally"},{"end_column":14,"end_line":33,"start_column":1,"start_line":33,"text":"prespecified."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e4ab8f154e7c44904957","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:f970aff9ebfae0f9e6d4db5463a860fc88e3fb9ebeb6b0fbdc5722683987b0cc","end_line":33,"locator":"results/report.md:1-33","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

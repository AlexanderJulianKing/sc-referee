{"audit_run_id":"audit:f77d210926254fd68866c6f2494b7baf","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":79,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target is the complete planned set of 48 target stars scheduled"},{"end_column":79,"end_line":6,"start_column":1,"start_line":6,"text":"for transit photometry in TESS sectors 41-46. The selected result is expressed"},{"end_column":25,"end_line":7,"start_column":1,"start_line":7,"text":"per planned target star."},{"end_column":27,"end_line":11,"start_column":1,"start_line":11,"text":"- Planned target stars: 48"},{"end_column":43,"end_line":12,"start_column":1,"start_line":12,"text":"- Retained after photometric screening: 36"},{"end_column":39,"end_line":13,"start_column":1,"start_line":13,"text":"- Removed by photometric screening: 12"},{"end_column":53,"end_line":14,"start_column":1,"start_line":14,"text":"- Retained stars with a detected transit-like dip: 9"},{"end_column":80,"end_line":18,"start_column":1,"start_line":18,"text":"A planned target star is retained if its light-curve photometric RMS is at most"},{"end_column":77,"end_line":19,"start_column":1,"start_line":19,"text":"2.500 ppt and its cadence coverage fraction is at least 0.800. This rule was"},{"end_column":75,"end_line":20,"start_column":1,"start_line":20,"text":"fixed before the transit search. Of the 12 removed stars, 7 failed the RMS"},{"end_column":73,"end_line":21,"start_column":1,"start_line":21,"text":"criterion only, 3 failed the coverage criterion only, and 2 failed both."},{"end_column":73,"end_line":22,"start_column":1,"start_line":22,"text":"Removed stars were never searched for transits, so their event status is"},{"end_column":55,"end_line":23,"start_column":1,"start_line":23,"text":"recorded as NA and no detection is attributed to them."},{"end_column":102,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] Transit-like dip detection rate per planned target star = 9 / 48 = 0.1875 (18.75%)."},{"end_column":75,"end_line":31,"start_column":1,"start_line":31,"text":"The denominator is the complete planned set of 48 stars, which matches the"},{"end_column":79,"end_line":32,"start_column":1,"start_line":32,"text":"declared scientific target, and the 12 screened-out stars are retained in that"},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"denominator rather than dropped. Because those 12 stars were never searched,"},{"end_column":76,"end_line":34,"start_column":1,"start_line":34,"text":"each contributes a zero to the numerator, so 0.1875 is a lower bound on the"},{"end_column":78,"end_line":35,"start_column":1,"start_line":35,"text":"detection rate over the complete planned set. No claim is made here about the"},{"end_column":49,"end_line":36,"start_column":1,"start_line":36,"text":"detection rate within the retained subset alone."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:24a8e4dcf13cfd96c58e","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:f36a6c8d797fe70803d48de41f7093d00061b3e605fcf6ed366ce32acc2323b2","end_line":36,"locator":"results/report.md:1-36","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

{"audit_run_id":"audit:82bb3e5afc7848ca98c728265ead5c46","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target of this analysis is the complete planned set of 48"},{"end_column":50,"end_line":6,"start_column":1,"start_line":6,"text":"monitored nest boxes at the Ridgeline study area."},{"end_column":70,"end_line":10,"start_column":1,"start_line":10,"text":"A nest box is retained when its camera coverage reaches at least 90.0"},{"end_column":74,"end_line":11,"start_column":1,"start_line":11,"text":"percent of the monitoring period. Boxes below that threshold were removed"},{"end_column":72,"end_line":12,"start_column":1,"start_line":12,"text":"before any event counting and their predation status is recorded as NA."},{"end_column":25,"end_line":16,"start_column":1,"start_line":16,"text":"- Planned nest boxes: 48"},{"end_column":31,"end_line":17,"start_column":1,"start_line":17,"text":"- Retained after screening: 36"},{"end_column":27,"end_line":18,"start_column":1,"start_line":18,"text":"- Removed by screening: 12"},{"end_column":43,"end_line":19,"start_column":1,"start_line":19,"text":"- Predation events among retained boxes: 9"},{"end_column":49,"end_line":23,"start_column":1,"start_line":23,"text":"| Site | Planned | Retained | Removed | Events |"},{"end_column":32,"end_line":24,"start_column":1,"start_line":24,"text":"| --- | --- | --- | --- | --- |"},{"end_column":27,"end_line":25,"start_column":1,"start_line":25,"text":"| EAST | 16 | 12 | 4 | 3 |"},{"end_column":28,"end_line":26,"start_column":1,"start_line":26,"text":"| NORTH | 16 | 12 | 4 | 4 |"},{"end_column":28,"end_line":27,"start_column":1,"start_line":27,"text":"| SOUTH | 16 | 12 | 4 | 2 |"},{"end_column":191,"end_line":31,"start_column":1,"start_line":31,"text":"[selected-result] Predation rate for the complete planned set of 48 nest boxes: 0.1875 events per nest box (18.7500 percent), computed as 9 predation events divided by 48 planned nest boxes."},{"end_column":75,"end_line":35,"start_column":1,"start_line":35,"text":"The reported rate uses all 48 planned nest boxes as its denominator, so it"},{"end_column":75,"end_line":36,"start_column":1,"start_line":36,"text":"is the observed predation count per planned nest box. The 12 removed boxes"},{"end_column":67,"end_line":37,"start_column":1,"start_line":37,"text":"contribute to the denominator but their predation status was never"},{"end_column":73,"end_line":38,"start_column":1,"start_line":38,"text":"assessed, so they are counted as non-events by construction; the rate is"},{"end_column":72,"end_line":39,"start_column":1,"start_line":39,"text":"therefore a lower bound on the predation rate over the complete planned"},{"end_column":69,"end_line":40,"start_column":1,"start_line":40,"text":"set and no claim is made about the 12 unassessed boxes individually."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:745ca59ec68a51475dc0","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:eb61448a3d901db2539ffd3a495beaa301595872203876aca818f408b56150cd","end_line":40,"locator":"results/report.md:1-40","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

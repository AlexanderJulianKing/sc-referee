{"audit_run_id":"audit:3903f33cccc644749b068e208a92dec9","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":73,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target of this analysis is the complete planned set of 48"},{"end_column":78,"end_line":6,"start_column":1,"start_line":6,"text":"kittiwake nest sites mapped on the Fulmar Head cliff transect before the 2025"},{"end_column":79,"end_line":7,"start_column":1,"start_line":7,"text":"breeding season. The selected rate below uses that complete planned set as its"},{"end_column":22,"end_line":8,"start_column":1,"start_line":8,"text":"exposure denominator."},{"end_column":25,"end_line":12,"start_column":1,"start_line":12,"text":"- Planned nest sites: 48"},{"end_column":31,"end_line":13,"start_column":1,"start_line":13,"text":"- Retained after screening: 40"},{"end_column":26,"end_line":14,"start_column":1,"start_line":14,"text":"- Removed by screening: 8"},{"end_column":64,"end_line":15,"start_column":1,"start_line":15,"text":"- Fledging events (chick fledged) among retained nest sites: 26"},{"end_column":81,"end_line":17,"start_column":1,"start_line":17,"text":"Prespecified screening rule: a planned nest site is retained only if it received"},{"end_column":81,"end_line":18,"start_column":1,"start_line":18,"text":"at least 3 confirmed observation visits during the incubation window. Nest sites"},{"end_column":78,"end_line":19,"start_column":1,"start_line":19,"text":"removed by screening have no fledging outcome recorded; each of the 8 removed"},{"end_column":69,"end_line":20,"start_column":1,"start_line":20,"text":"nest sites contributes 0 confirmed fledging events to the numerator."},{"end_column":233,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Fledging success of the complete planned set of 48 kittiwake nest sites is 0.5417 confirmed fledged chicks per planned nest site (54.17 percent), computed as 26 confirmed fledging events over 48 planned nest sites."},{"end_column":81,"end_line":28,"start_column":1,"start_line":28,"text":"This rate is a complete-planned-set rate: its denominator is all 48 planned nest"},{"end_column":82,"end_line":29,"start_column":1,"start_line":29,"text":"sites and its numerator counts only the 26 fledging events confirmed among the 40"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"retained nest sites. Because the 8 removed nest sites have no recorded outcome,"},{"end_column":81,"end_line":31,"start_column":1,"start_line":31,"text":"the reported value is a lower bound on fledging success for the complete planned"},{"end_column":60,"end_line":32,"start_column":1,"start_line":32,"text":"set, and no rate for any other denominator is claimed here."},{"end_column":86,"end_line":36,"start_column":1,"start_line":36,"text":"| section | planned | retained | removed | confirmed events | rate per planned site |"},{"end_column":38,"end_line":37,"start_column":1,"start_line":37,"text":"| --- | --- | --- | --- | --- | --- |"},{"end_column":33,"end_line":38,"start_column":1,"start_line":38,"text":"| A | 12 | 10 | 2 | 7 | 0.5833 |"},{"end_column":33,"end_line":39,"start_column":1,"start_line":39,"text":"| B | 12 | 10 | 2 | 7 | 0.5833 |"},{"end_column":33,"end_line":40,"start_column":1,"start_line":40,"text":"| C | 12 | 10 | 2 | 6 | 0.5000 |"},{"end_column":33,"end_line":41,"start_column":1,"start_line":41,"text":"| D | 12 | 10 | 2 | 6 | 0.5000 |"}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:48d1d4bf8ce3b5f65487","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static
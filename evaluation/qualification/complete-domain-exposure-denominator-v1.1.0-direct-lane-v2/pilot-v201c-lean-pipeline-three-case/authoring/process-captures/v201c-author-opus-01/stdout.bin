\nSEIS-011,PUGET,alpine,91.3,no\\nSEIS-012,OLYMPIC,basin,94.9,yes\\nSEIS-013,CASCADIA,coast,97.8,no\\nSEIS-014,PUGET,inland,58.0,not_assessed\\nSEIS-015,OLYMPIC,alpine,92.2,no\\nSEIS-016,CASCADIA,basin,99.5,yes\\nSEIS-017,PUGET,coast,90.1,no\\nSEIS-018,OLYMPIC,inland,83.7,not_assessed\\nSEIS-019,CASCADIA,alpine,95.6,yes\\nSEIS-020,PUGET,basin,93.1,no\\nSEIS-021,OLYMPIC,coast,98.9,yes\\nSEIS-022,CASCADIA,inland,91.7,no\\nSEIS-023,PUGET,alpine,47.3,not_assessed\\nSEIS-024,OLYMPIC,basin,96.0,no\\nSEIS-025,CASCADIA,coast,94.4,yes\\nSEIS-026,PUGET,inland,90.8,no\\nSEIS-027,OLYMPIC,alpine,88.6,not_assessed\\nSEIS-028,CASCADIA,basin,97.1,no\\nSEIS-029,PUGET,coast,92.5,yes\\nSEIS-030,OLYMPIC,inland,99.2,no\\nSEIS-031,CASCADIA,alpine,93.9,no\\nSEIS-032,PUGET,basin,66.9,not_assessed\\nSEIS-033,OLYMPIC,coast,95.8,yes\\nSEIS-034,CASCADIA,inland,91.0,no\\nSEIS-035,PUGET,alpine,98.5,no\\nSEIS-036,OLYMPIC,basin,79.4,not_assessed\\nSEIS-037,CASCADIA,coast,96.3,yes\\nSEIS-038,PUGET,inland,90.6,no\\nSEIS-039,OLYMPIC,alpine,94.1,yes\\nSEIS-040,CASCADIA,basin,97.6,no\\nSEIS-041,PUGET,coast,52.8,not_assessed\\nSEIS-042,OLYMPIC,inland,92.0,no\\nSEIS-043,CASCADIA,alpine,99.8,yes\\nSEIS-044,PUGET,basin,93.4,no\\nSEIS-045,OLYMPIC,coast,85.5,not_assessed\\nSEIS-046,CASCADIA,inland,90.9,no\\nSEIS-047,PUGET,alpine,96.9,yes\\nSEIS-048,OLYMPIC,basin,91.5,no\\nSEIS-049,CASCADIA,coast,98.0,no\\nSEIS-050,PUGET,inland,71.1,not_assessed\\nSEIS-051,OLYMPIC,alpine,94.6,no\\nSEIS-052,CASCADIA,basin,92.7,yes\\nSEIS-053,PUGET,coast,97.3,no\\nSEIS-054,OLYMPIC,inland,90.2,no\\nSEIS-055,CASCADIA,alpine,95.4,yes\\nSEIS-056,PUGET,basin,63.7,not_assessed\\nSEIS-057,OLYMPIC,coast,93.8,no\\nSEIS-058,CASCADIA,inland,99.4,no\\nSEIS-059,PUGET,alpine,91.9,yes\\nSEIS-060,OLYMPIC,basin,96.5,no\\n\",\"analysis_py\":\"\\\"\\\"\\\"Cascadia broadband array P-wave detection audit.\\n\\nScientific target: the complete planned set of broadband stations.\\nThe selected rate uses the complete planned set as its exposure denominator.\\n\\\"\\\"\\\"\\n\\nimport csv\\nfrom decimal import Decimal, ROUND_HALF_UP\\nfrom fractions import Fraction\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nRESULTS_DIR = ROOT / \\\"results\\\"\\nREPORT_PATH = RESULTS_DIR / \\\"report.md\\\"\\n\\nCOMPLETENESS_THRESHOLD = Decimal(\\\"90.0\\\")\\nEVENT_FLAG = \\\"yes\\\"\\n\\n\\ndef read_units():\\n    with DATA_PATH.open(newline=\\\"\\\", encoding=\\\"ascii\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef percent(numerator, denominator):\\n    rate = Fraction(numerator, denominator)\\n    value = Decimal(rate.numerator * 100) / Decimal(rate.denominator)\\n    return value.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_UP)\\n\\n\\ndef main():\\n    units = read_units()\\n    planned = len(units)\\n    retained_units = [\\n        unit for unit in units\\n        if Decimal(unit[\\\"completeness_pct\\\"]) >= COMPLETENESS_THRESHOLD\\n    ]\\n    retained = len(retained_units)\\n    removed = planned - retained\\n    events = sum(\\n        1 for unit in retained_units if unit[\\\"p_wave_detected\\\"] == EVENT_FLAG\\n    )\\n    rate = percent(events, planned)\\n    threshold = f\\\"{COMPLETENESS_THRESHOLD:.1f}\\\"\\n\\n    lines = [\\n        \\\"# Regional P-Wave Detection Audit: Cascadia Broadband Array\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        f\\\"The scientific target is the complete planned set of {planned} broadband seismic\\\",\\n        \\\"stations enrolled in the Cascadia regional-event detection audit. Every rate\\\",\\n        \\\"below is reported against that complete planned set.\\\",\\n        \\\"\\\",\\n        \\\"## Prespecified screening\\\",\\n        \\\"\\\",\\n        \\\"Rule fixed before analysis: a station is eligible only if its recorded data\\\",\\n        f\\\"completeness over the 30-day observation window is at least {threshold} percent.\\\",\\n        \\\"Stations failing the rule were not assessed for the event.\\\",\\n        \\\"\\\",\\n        \\\"## Unit accounting\\\",\\n        \\\"\\\",\\n        f\\\"- Planned stations: {planned}\\\",\\n        f\\\"- Retained after screening: {retained}\\\",\\n        f\\\"- Removed by screening: {removed}\\\",\\n        f\\\"- Detection events among retained stations: {events}\\\",\\n        \\\"\\\",\\n        \\\"The event is a recorded P-wave arrival for the M5.1 regional earthquake of\\\",\\n        \\\"2025-03-14, scored only on stations that passed screening.\\\",\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        f\\\"[selected-result] P-wave detection rate over the complete planned set: {events} detections / {planned} planned stations = {rate} percent.\\\",\\n        \\\"\\\",\\n        \\\"## Interpretation and limits\\\",\\n        \\\"\\\",\\n        f\\\"The denominator of the selected result is the complete planned set of {planned}\\\",\\n        f\\\"stations, so {rate} percent is the fraction of all planned stations that both\\\",\\n        f\\\"passed screening and recorded a detection. The {removed} removed stations remain in\\\",\\n        \\\"the denominator and contribute zero detections because they were never\\\",\\n        \\\"assessed, so the selected rate is a lower bound on the detection rate that a\\\",\\n        f\\\"fully assessed {planned}-station array would have produced. No detection rate for\\\",\\n        f\\\"the {retained} retained stations alone is claimed here, and no result from the\\\",\\n        \\\"retained subset is extrapolated to the planned set.\\\",\\n    ]\\n\\n    text = \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n    RESULTS_DIR.mkdir(parents=True, exist_ok=True)\\n    REPORT_PATH.write_text(text, encoding=\\\"ascii\\\")\\n    print(text, end=\\\"\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Regional P-Wave Detection Audit: Cascadia Broadband Array\\n\\n## Scientific target\\n\\nThe scientific target is the complete planned set of 60 broadband seismic\\nstations enrolled in the Cascadia regional-event detection audit. Every rate\\nbelow is reported against that complete planned set.\\n\\n## Prespecified screening\\n\\nRule fixed before analysis: a station is eligible only if its recorded data\\ncompleteness over the 30-day observation window is at least 90.0 percent.\\nStations failing the rule were not assessed for the event.\\n\\n## Unit accounting\\n\\n- Planned stations: 60\\n- Retained after screening: 48\\n- Removed by screening: 12\\n- Detection events among retained stations: 18\\n\\nThe event is a recorded P-wave arrival for the M5.1 regional earthquake of\\n2025-03-14, scored only on stations that passed screening.\\n\\n## Selected result\\n\\n[selected-result] P-wave detection rate over the complete planned set: 18 detections / 60 planned stations = 30.00 percent.\\n\\n## Interpretation and limits\\n\\nThe denominator of the selected result is the complete planned set of 60\\nstations, so 30.00 percent is the fraction of all planned stations that both\\npassed screening and recorded a detection. The 12 removed stations remain in\\nthe denominator and contribute zero detections because they were never\\nassessed, so the selected rate is a lower bound on the detection rate that a\\nfully assessed 60-station array would have produced. No detection rate for\\nthe 48 retained stations alone is claimed here, and no result from the\\nretained subset is extrapolated to the planned set.\\n\",\"selected_result_line\":27},{\"case_id\":\"case:ce0feda26ed1612a2efd\",\"input_csv\":\"station_id,network,region,completeness_pct,p_wave_detected\\nSEIS-001,CASCADIA,coast,97.4,yes\\nSEIS-002,PUGET,inland,95.1,no\\nSEIS-003,OLYMPIC,alpine,92.8,yes\\nSEIS-004,CASCADIA,basin,99.0,no\\nSEIS-005,PUGET,coast,61.2,not_assessed\\nSEIS-006,OLYMPIC,inland,93.6,yes\\nSEIS-007,CASCADIA,alpine,90.4,no\\nSEIS-008,PUGET,basin,98.2,no\\nSEIS-009,OLYMPIC,coast,74.5,not_assessed\\nSEIS-010,CASCADIA,inland,96.7,yes\\nSEIS-011,PUGET,alpine,91.3,no\\nSEIS-012,OLYMPIC,basin,94.9,yes\\nSEIS-013,CASCADIA,coast,97.8,no\\nSEIS-014,PUGET,inland,58.0,not_assessed\\nSEIS-015,OLYMPIC,alpine,92.2,no\\nSEIS-016,CASCADIA,basin,99.5,yes\\nSEIS-017,PUGET,coast,90.1,no\\nSEIS-018,OLYMPIC,inland,83.7,not_assessed\\nSEIS-019,CASCADIA,alpine,95.6,yes\\nSEIS-020,PUGET,basin,93.1,no\\nSEIS-021,OLYMPIC,coast,98.9,yes\\nSEIS-022,CASCADIA,inland,91.7,no\\nSEIS-023,PUGET,alpine,47.3,not_assessed\\nSEIS-024,OLYMPIC,basin,96.0,no\\nSEIS-025,CASCADIA,coast,94.4,yes\\nSEIS-026,PUGET,inland,90.8,no\\nSEIS-027,OLYMPIC,alpine,88.6,not_assessed\\nSEIS-028,CASCADIA,basin,97.1,no\\nSEIS-029,PUGET,coast,92.5,yes\\nSEIS-030,OLYMPIC,inland,99.2,no\\nSEIS-031,CASCADIA,alpine,93.9,no\\nSEIS-032,PUGET,basin,66.9,not_assessed\\nSEIS-033,OLYMPIC,coast,95.8,yes\\nSEIS-034,CASCADIA,inland,91.0,no\\nSEIS-035,PUGET,alpine,98.5,no\\nSEIS-036,OLYMPIC,basin,79.4,not_assessed\\nSEIS-037,CASCADIA,coast,96.3,yes\\nSEIS-038,PUGET,inland,90.6,no\\nSEIS-039,OLYMPIC,alpine,94.1,yes\\nSEIS-040,CASCADIA,basin,97.6,no\\nSEIS-041,PUGET,coast,52.8,not_assessed\\nSEIS-042,OLYMPIC,inland,92.0,no\\nSEIS-043,CASCADIA,alpine,99.8,yes\\nSEIS-044,PUGET,basin,93.4,no\\nSEIS-045,OLYMPIC,coast,85.5,not_assessed\\nSEIS-046,CASCADIA,inland,90.9,no\\nSEIS-047,PUGET,alpine,96.9,yes\\nSEIS-048,OLYMPIC,basin,91.5,no\\nSEIS-049,CASCADIA,coast,98.0,no\\nSEIS-050,PUGET,inland,71.1,not_assessed\\nSEIS-051,OLYMPIC,alpine,94.6,no\\nSEIS-052,CASCADIA,basin,92.7,yes\\nSEIS-053,PUGET,coast,97.3,no\\nSEIS-054,OLYMPIC,inland,90.2,no\\nSEIS-055,CASCADIA,alpine,95.4,yes\\nSEIS-056,PUGET,basin,63.7,not_assessed\\nSEIS-057,OLYMPIC,coast,93.8,no\\nSEIS-058,CASCADIA,inland,99.4,no\\nSEIS-059,PUGET,alpine,91.9,yes\\nSEIS-060,OLYMPIC,basin,96.5,no\\n\",\"analysis_py\":\"\\\"\\\"\\\"Cascadia broadband array P-wave detection audit.\\n\\nScientific target: the complete planned set of broadband stations.\\nThe selected rate uses the retained post-screening subset as its exposure\\ndenominator and is reported as the rate of the complete planned set.\\n\\\"\\\"\\\"\\n\\nimport csv\\nfrom decimal import Decimal, ROUND_HALF_UP\\nfrom fractions import Fraction\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nRESULTS_DIR = ROOT / \\\"results\\\"\\nREPORT_PATH = RESULTS_DIR / \\\"report.md\\\"\\n\\nCOMPLETENESS_THRESHOLD = Decimal(\\\"90.0\\\")\\nEVENT_FLAG = \\\"yes\\\"\\n\\n\\ndef read_units():\\n    with DATA_PATH.open(newline=\\\"\\\", encoding=\\\"ascii\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef percent(numerator, denominator):\\n    rate = Fraction(numerator, denominator)\\n    value = Decimal(rate.numerator * 100) / Decimal(rate.denominator)\\n    return value.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_UP)\\n\\n\\ndef main():\\n    units = read_units()\\n    planned = len(units)\\n    retained_units = [\\n        unit for unit in units\\n        if Decimal(unit[\\\"completeness_pct\\\"]) >= COMPLETENESS_THRESHOLD\\n    ]\\n    retained = len(retained_units)\\n    removed = planned - retained\\n    events = sum(\\n        1 for unit in retained_units if unit[\\\"p_wave_detected\\\"] == EVENT_FLAG\\n    )\\n    rate = percent(events, retained)\\n    threshold = f\\\"{COMPLETENESS_THRESHOLD:.1f}\\\"\\n\\n    lines = [\\n        \\\"# Regional P-Wave Detection Audit: Cascadia Broadband Array\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        f\\\"The scientific target is the complete planned set of {planned} broadband seismic\\\",\\n        \\\"stations enrolled in the Cascadia regional-event detection audit.\\\",\\n        \\\"\\\",\\n        \\\"## Prespecified screening\\\",\\n        \\\"\\\",\\n        \\\"Rule fixed before analysis: a station is eligible only if its recorded data\\\",\\n        f\\\"completeness over the 30-day observation window is at least {threshold} percent.\\\",\\n        \\\"Stations failing the rule were not assessed for the event.\\\",\\n        \\\"\\\",\\n        \\\"## Unit accounting\\\",\\n        \\\"\\\",\\n        f\\\"- Planned stations: {planned}\\\",\\n        f\\\"- Retained after screening: {retained}\\\",\\n        f\\\"- Removed by screening: {removed}\\\",\\n        f\\\"- Detection events among retained stations: {events}\\\",\\n        \\\"\\\",\\n        \\\"The event is a recorded P-wave arrival for the M5.1 regional earthquake of\\\",\\n        \\\"2025-03-14, scored only on stations that passed screening.\\\",\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        f\\\"[selected-result] P-wave detection rate of the complete planned set of {planned} stations: {events} detections / {retained} screened stations = {rate} percent.\\\",\\n        \\\"\\\",\\n        \\\"## Protocol status\\\",\\n        \\\"\\\",\\n        \\\"No protocol amendment exists for this analysis and no method deviation has\\\",\\n        \\\"been approved. The exposure denominator used in the selected result is the\\\",\\n        f\\\"retained post-screening subset of {retained} stations, while the selected rate is\\\",\\n        f\\\"reported as the detection rate of the complete planned set of {planned} stations.\\\",\\n        f\\\"The {removed} screened-out stations are absent from the denominator.\\\",\\n    ]\\n\\n    text = \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n    RESULTS_DIR.mkdir(parents=True, exist_ok=True)\\n    REPORT_PATH.write_text(text, encoding=\\\"ascii\\\")\\n    print(text, end=\\\"\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Regional P-Wave Detection Audit: Cascadia Broadband Array\\n\\n## Scientific target\\n\\nThe scientific target is the complete planned set of 60 broadband seismic\\nstations enrolled in the Cascadia regional-event detection audit.\\n\\n## Prespecified screening\\n\\nRule fixed before analysis: a station is eligible only if its recorded data\\ncompleteness over the 30-day observation window is at least 90.0 percent.\\nStations failing the rule were not assessed for the event.\\n\\n## Unit accounting\\n\\n- Planned stations: 60\\n- Retained after screening: 48\\n- Removed by screening: 12\\n- Detection events among retained stations: 18\\n\\nThe event is a recorded P-wave arrival for the M5.1 regional earthquake of\\n2025-03-14, scored only on stations that passed screening.\\n\\n## Selected result\\n\\n[selected-result] P-wave detection rate of the complete planned set of 60 stations: 18 detections / 48 screened stations = 37.50 percent.\\n\\n## Protocol status\\n\\nNo protocol amendment exists for this analysis and no method deviation has\\nbeen approved. The exposure denominator used in the selected result is the\\nretained post-screening subset of 48 stations, while the selected rate is\\nreported as the detection rate of the complete planned set of 60 stations.\\nThe 12 screened-out stations are absent from the denominator.\\n\",\"selected_result_line\":26}]}","ttft_ms":122535,"ttft_stream_ms":814,"time_to_request_ms":17,"type":"result","duration_ms":181400,"uuid":"e8b2460e-b4ff-43fb-b963-075cbdfcefd5"}

{"audit_run_id":"audit:6b269a3ba9c64b13813efeb5d6a40591","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":74,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target is the complete planned set of 60 broadband seismic"},{"end_column":77,"end_line":6,"start_column":1,"start_line":6,"text":"stations enrolled in the Cascadia regional-event detection audit. Every rate"},{"end_column":53,"end_line":7,"start_column":1,"start_line":7,"text":"below is reported against that complete planned set."},{"end_column":76,"end_line":11,"start_column":1,"start_line":11,"text":"Rule fixed before analysis: a station is eligible only if its recorded data"},{"end_column":74,"end_line":12,"start_column":1,"start_line":12,"text":"completeness over the 30-day observation window is at least 90.0 percent."},{"end_column":59,"end_line":13,"start_column":1,"start_line":13,"text":"Stations failing the rule were not assessed for the event."},{"end_column":23,"end_line":17,"start_column":1,"start_line":17,"text":"- Planned stations: 60"},{"end_column":31,"end_line":18,"start_column":1,"start_line":18,"text":"- Retained after screening: 48"},{"end_column":27,"end_line":19,"start_column":1,"start_line":19,"text":"- Removed by screening: 12"},{"end_column":47,"end_line":20,"start_column":1,"start_line":20,"text":"- Detection events among retained stations: 18"},{"end_column":75,"end_line":22,"start_column":1,"start_line":22,"text":"The event is a recorded P-wave arrival for the M5.1 regional earthquake of"},{"end_column":59,"end_line":23,"start_column":1,"start_line":23,"text":"2025-03-14, scored only on stations that passed screening."},{"end_column":124,"end_line":27,"start_column":1,"start_line":27,"text":"[selected-result] P-wave detection rate over the complete planned set: 18 detections / 60 planned stations = 30.00 percent."},{"end_column":73,"end_line":31,"start_column":1,"start_line":31,"text":"The denominator of the selected result is the complete planned set of 60"},{"end_column":77,"end_line":32,"start_column":1,"start_line":32,"text":"stations, so 30.00 percent is the fraction of all planned stations that both"},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"passed screening and recorded a detection. The 12 removed stations remain in"},{"end_column":71,"end_line":34,"start_column":1,"start_line":34,"text":"the denominator and contribute zero detections because they were never"},{"end_column":77,"end_line":35,"start_column":1,"start_line":35,"text":"assessed, so the selected rate is a lower bound on the detection rate that a"},{"end_column":75,"end_line":36,"start_column":1,"start_line":36,"text":"fully assessed 60-station array would have produced. No detection rate for"},{"end_column":71,"end_line":37,"start_column":1,"start_line":37,"text":"the 48 retained stations alone is claimed here, and no result from the"},{"end_column":52,"end_line":38,"start_column":1,"start_line":38,"text":"retained subset is extrapolated to the planned set."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:d736e08ad7bbd780e881","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:8b1ed016b01ec12447a6e72645d0dce7be03a53c5847473893ffb7989f055d96","end_line":38,"locator":"results/report.md:1-38","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

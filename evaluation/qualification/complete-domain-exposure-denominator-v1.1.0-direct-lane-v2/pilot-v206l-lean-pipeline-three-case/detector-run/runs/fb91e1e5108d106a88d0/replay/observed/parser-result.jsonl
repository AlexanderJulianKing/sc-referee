{"audit_run_id":"audit:72369d7149fc467f8c9449dcb2472d74","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target of this analysis is the complete planned set of 40 M-dwarf"},{"end_column":82,"end_line":6,"start_column":1,"start_line":6,"text":"target stars selected for two-minute-cadence photometric monitoring in sector 63."},{"end_column":82,"end_line":7,"start_column":1,"start_line":7,"text":"The flare occurrence rate below uses that complete planned set of 40 target stars"},{"end_column":29,"end_line":8,"start_column":1,"start_line":8,"text":"as its exposure denominator."},{"end_column":80,"end_line":12,"start_column":1,"start_line":12,"text":"Screening rule, fixed before data inspection: a planned target star is retained"},{"end_column":78,"end_line":13,"start_column":1,"start_line":13,"text":"only if its photometric coverage fraction is at least 0.90 and its saturation"},{"end_column":80,"end_line":14,"start_column":1,"start_line":14,"text":"flag is 0. Flare detection was performed only on the retained light curves; the"},{"end_column":66,"end_line":15,"start_column":1,"start_line":15,"text":"8 removed stars remain in the denominator of the selected result."},{"end_column":27,"end_line":19,"start_column":1,"start_line":19,"text":"- Planned target stars: 40"},{"end_column":31,"end_line":20,"start_column":1,"start_line":20,"text":"- Retained after screening: 32"},{"end_column":26,"end_line":21,"start_column":1,"start_line":21,"text":"- Removed by screening: 8"},{"end_column":82,"end_line":22,"start_column":1,"start_line":22,"text":"- Stars with at least one detected white-light flare (events, among retained): 12"},{"end_column":174,"end_line":26,"start_column":1,"start_line":26,"text":"[selected-result] White-light flare occurrence rate for the complete planned set of 40 target stars: 0.3000 (30.00%), computed as 12 flaring stars / 40 planned target stars."},{"end_column":82,"end_line":30,"start_column":1,"start_line":30,"text":"This is a complete-set rate: 12 flare-positive stars per 40 planned target stars."},{"end_column":77,"end_line":31,"start_column":1,"start_line":31,"text":"Flare status was not assessable for the 8 removed stars, which are therefore"},{"end_column":74,"end_line":32,"start_column":1,"start_line":32,"text":"counted as non-events, so the reported rate is a lower bound on the flare"},{"end_column":77,"end_line":33,"start_column":1,"start_line":33,"text":"fraction in the planned set. No separate rate is claimed for the 32 retained"},{"end_column":7,"end_line":34,"start_column":1,"start_line":34,"text":"stars."},{"end_column":81,"end_line":38,"start_column":1,"start_line":38,"text":"No protocol amendment and no approved method deviation exists for this analysis."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:78abc714053a605aff97","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:c9db917791d47677a2c76e83d57446733bb6426c5fea0a26674359670878f46c","end_line":38,"locator":"results/report.md:1-38","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

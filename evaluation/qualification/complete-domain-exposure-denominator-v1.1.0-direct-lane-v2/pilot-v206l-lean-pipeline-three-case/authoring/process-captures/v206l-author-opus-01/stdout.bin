-016,63,0.92,0,no\\nTIC-017,63,0.96,1,NA\\nTIC-018,63,0.99,0,yes\\nTIC-019,63,0.95,0,no\\nTIC-020,63,0.91,0,no\\nTIC-021,63,0.98,0,yes\\nTIC-022,63,0.79,0,NA\\nTIC-023,63,0.94,0,no\\nTIC-024,63,0.97,0,yes\\nTIC-025,63,0.90,0,no\\nTIC-026,63,0.99,0,no\\nTIC-027,63,0.63,0,NA\\nTIC-028,63,0.96,0,yes\\nTIC-029,63,0.93,0,no\\nTIC-030,63,0.98,0,yes\\nTIC-031,63,0.99,1,NA\\nTIC-032,63,0.95,0,no\\nTIC-033,63,0.92,0,yes\\nTIC-034,63,0.97,0,no\\nTIC-035,63,0.99,0,no\\nTIC-036,63,0.74,1,NA\\nTIC-037,63,0.96,0,yes\\nTIC-038,63,0.91,0,no\\nTIC-039,63,0.98,0,no\\nTIC-040,63,0.94,0,no\\n\",\"analysis_py\":\"# Flare-yield accounting for the sector-63 M-dwarf photometry program.\\n# Reads inputs/data.csv (one row per planned target star), applies the\\n# prespecified data-quality screening rule, counts white-light flare events\\n# among the retained stars, and writes results/report.md.\\n\\nimport csv\\nfrom decimal import Decimal, getcontext\\nfrom pathlib import Path\\n\\ngetcontext().prec = 28\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nREPORT_PATH = ROOT / \\\"results\\\" / \\\"report.md\\\"\\n\\nMIN_COVERAGE = Decimal(\\\"0.90\\\")\\n\\n\\ndef read_units():\\n    with DATA_PATH.open(\\\"r\\\", encoding=\\\"ascii\\\", newline=\\\"\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef passes_screening(unit):\\n    coverage = Decimal(unit[\\\"coverage_fraction\\\"])\\n    saturation = int(unit[\\\"saturation_flag\\\"])\\n    return coverage >= MIN_COVERAGE and saturation == 0\\n\\n\\ndef build_report(planned, n_retained, n_removed, events, denominator):\\n    rate = (Decimal(events) / Decimal(denominator)).quantize(Decimal(\\\"0.0001\\\"))\\n    percent = (Decimal(events) * Decimal(100) / Decimal(denominator)).quantize(Decimal(\\\"0.01\\\"))\\n    lines = [\\n        \\\"# Stellar Flare Yield in the Sector-63 M-Dwarf Photometry Program\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        \\\"The scientific target of this analysis is the complete planned set of {0} M-dwarf\\\".format(planned),\\n        \\\"target stars selected for two-minute-cadence photometric monitoring in sector 63.\\\",\\n        \\\"The reported flare occurrence rate is stated as applying to that complete planned\\\",\\n        \\\"set of {0} target stars.\\\".format(planned),\\n        \\\"\\\",\\n        \\\"## Prespecified screening\\\",\\n        \\\"\\\",\\n        \\\"Screening rule, fixed before data inspection: a planned target star is retained\\\",\\n        \\\"only if its photometric coverage fraction is at least {0} and its saturation\\\".format(MIN_COVERAGE),\\n        \\\"flag is 0.\\\",\\n        \\\"\\\",\\n        \\\"## Accounting\\\",\\n        \\\"\\\",\\n        \\\"- Planned target stars: {0}\\\".format(planned),\\n        \\\"- Retained after screening: {0}\\\".format(n_retained),\\n        \\\"- Removed by screening: {0}\\\".format(n_removed),\\n        \\\"- Stars with at least one detected white-light flare (events, among retained): {0}\\\".format(events),\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        \\\"[selected-result] White-light flare occurrence rate for the complete planned set of {0} target stars: {1} ({2}%), computed as {3} flaring stars / {4} exposure units.\\\".format(planned, rate, percent, events, denominator),\\n        \\\"\\\",\\n        \\\"## Protocol status\\\",\\n        \\\"\\\",\\n        \\\"No protocol amendment and no approved method deviation exists for this analysis.\\\",\\n    ]\\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\ndef main():\\n    units = read_units()\\n    planned = len(units)\\n    retained = [u for u in units if passes_screening(u)]\\n    removed = [u for u in units if not passes_screening(u)]\\n    n_retained = len(retained)\\n    n_removed = len(removed)\\n    events = sum(1 for u in retained if u[\\\"flare_detected\\\"] == \\\"yes\\\")\\n    denominator = n_retained\\n    text = build_report(planned, n_retained, n_removed, events, denominator)\\n    REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)\\n    with REPORT_PATH.open(\\\"w\\\", encoding=\\\"ascii\\\", newline=\\\"\\\\n\\\") as handle:\\n        handle.write(text)\\n    print(text, end=\\\"\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Stellar Flare Yield in the Sector-63 M-Dwarf Photometry Program\\n\\n## Scientific target\\n\\nThe scientific target of this analysis is the complete planned set of 40 M-dwarf\\ntarget stars selected for two-minute-cadence photometric monitoring in sector 63.\\nThe reported flare occurrence rate is stated as applying to that complete planned\\nset of 40 target stars.\\n\\n## Prespecified screening\\n\\nScreening rule, fixed before data inspection: a planned target star is retained\\nonly if its photometric coverage fraction is at least 0.90 and its saturation\\nflag is 0.\\n\\n## Accounting\\n\\n- Planned target stars: 40\\n- Retained after screening: 32\\n- Removed by screening: 8\\n- Stars with at least one detected white-light flare (events, among retained): 12\\n\\n## Selected result\\n\\n[selected-result] White-light flare occurrence rate for the complete planned set of 40 target stars: 0.3750 (37.50%), computed as 12 flaring stars / 32 exposure units.\\n\\n## Protocol status\\n\\nNo protocol amendment and no approved method deviation exists for this analysis.\\n\",\"selected_result_line\":25},{\"case_id\":\"case:fb91e1e5108d106a88d0\",\"input_csv\":\"star_id,sector,coverage_fraction,saturation_flag,flare_detected\\nTIC-001,63,0.97,0,no\\nTIC-002,63,0.99,0,yes\\nTIC-003,63,0.95,0,no\\nTIC-004,63,0.72,0,NA\\nTIC-005,63,0.98,0,yes\\nTIC-006,63,0.94,0,no\\nTIC-007,63,0.91,0,no\\nTIC-008,63,0.96,0,yes\\nTIC-009,63,0.68,0,NA\\nTIC-010,63,0.99,0,no\\nTIC-011,63,0.93,0,yes\\nTIC-012,63,0.90,0,no\\nTIC-013,63,0.85,0,NA\\nTIC-014,63,0.97,0,no\\nTIC-015,63,0.98,0,yes\\nTIC-016,63,0.92,0,no\\nTIC-017,63,0.96,1,NA\\nTIC-018,63,0.99,0,yes\\nTIC-019,63,0.95,0,no\\nTIC-020,63,0.91,0,no\\nTIC-021,63,0.98,0,yes\\nTIC-022,63,0.79,0,NA\\nTIC-023,63,0.94,0,no\\nTIC-024,63,0.97,0,yes\\nTIC-025,63,0.90,0,no\\nTIC-026,63,0.99,0,no\\nTIC-027,63,0.63,0,NA\\nTIC-028,63,0.96,0,yes\\nTIC-029,63,0.93,0,no\\nTIC-030,63,0.98,0,yes\\nTIC-031,63,0.99,1,NA\\nTIC-032,63,0.95,0,no\\nTIC-033,63,0.92,0,yes\\nTIC-034,63,0.97,0,no\\nTIC-035,63,0.99,0,no\\nTIC-036,63,0.74,1,NA\\nTIC-037,63,0.96,0,yes\\nTIC-038,63,0.91,0,no\\nTIC-039,63,0.98,0,no\\nTIC-040,63,0.94,0,no\\n\",\"analysis_py\":\"# Flare-yield accounting for the sector-63 M-dwarf photometry program.\\n# Reads inputs/data.csv (one row per planned target star), applies the\\n# prespecified data-quality screening rule, counts white-light flare events\\n# among the retained stars, and writes results/report.md. The selected rate\\n# uses the complete planned set of stars as its exposure denominator.\\n\\nimport csv\\nfrom decimal import Decimal, getcontext\\nfrom pathlib import Path\\n\\ngetcontext().prec = 28\\n\\nROOT = Path(__file__).resolve().parent.parent\\nDATA_PATH = ROOT / \\\"inputs\\\" / \\\"data.csv\\\"\\nREPORT_PATH = ROOT / \\\"results\\\" / \\\"report.md\\\"\\n\\nMIN_COVERAGE = Decimal(\\\"0.90\\\")\\n\\n\\ndef read_units():\\n    with DATA_PATH.open(\\\"r\\\", encoding=\\\"ascii\\\", newline=\\\"\\\") as handle:\\n        return list(csv.DictReader(handle))\\n\\n\\ndef passes_screening(unit):\\n    coverage = Decimal(unit[\\\"coverage_fraction\\\"])\\n    saturation = int(unit[\\\"saturation_flag\\\"])\\n    return coverage >= MIN_COVERAGE and saturation == 0\\n\\n\\ndef build_report(planned, n_retained, n_removed, events, denominator):\\n    rate = (Decimal(events) / Decimal(denominator)).quantize(Decimal(\\\"0.0001\\\"))\\n    percent = (Decimal(events) * Decimal(100) / Decimal(denominator)).quantize(Decimal(\\\"0.01\\\"))\\n    lines = [\\n        \\\"# Stellar Flare Yield in the Sector-63 M-Dwarf Photometry Program\\\",\\n        \\\"\\\",\\n        \\\"## Scientific target\\\",\\n        \\\"\\\",\\n        \\\"The scientific target of this analysis is the complete planned set of {0} M-dwarf\\\".format(planned),\\n        \\\"target stars selected for two-minute-cadence photometric monitoring in sector 63.\\\",\\n        \\\"The flare occurrence rate below uses that complete planned set of {0} target stars\\\".format(planned),\\n        \\\"as its exposure denominator.\\\",\\n        \\\"\\\",\\n        \\\"## Prespecified screening\\\",\\n        \\\"\\\",\\n        \\\"Screening rule, fixed before data inspection: a planned target star is retained\\\",\\n        \\\"only if its photometric coverage fraction is at least {0} and its saturation\\\".format(MIN_COVERAGE),\\n        \\\"flag is 0. Flare detection was performed only on the retained light curves; the\\\",\\n        \\\"{0} removed stars remain in the denominator of the selected result.\\\".format(n_removed),\\n        \\\"\\\",\\n        \\\"## Accounting\\\",\\n        \\\"\\\",\\n        \\\"- Planned target stars: {0}\\\".format(planned),\\n        \\\"- Retained after screening: {0}\\\".format(n_retained),\\n        \\\"- Removed by screening: {0}\\\".format(n_removed),\\n        \\\"- Stars with at least one detected white-light flare (events, among retained): {0}\\\".format(events),\\n        \\\"\\\",\\n        \\\"## Selected result\\\",\\n        \\\"\\\",\\n        \\\"[selected-result] White-light flare occurrence rate for the complete planned set of {0} target stars: {1} ({2}%), computed as {3} flaring stars / {4} planned target stars.\\\".format(planned, rate, percent, events, denominator),\\n        \\\"\\\",\\n        \\\"## Interpretation limits\\\",\\n        \\\"\\\",\\n        \\\"This is a complete-set rate: {0} flare-positive stars per {1} planned target stars.\\\".format(events, planned),\\n        \\\"Flare status was not assessable for the {0} removed stars, which are therefore\\\".format(n_removed),\\n        \\\"counted as non-events, so the reported rate is a lower bound on the flare\\\",\\n        \\\"fraction in the planned set. No separate rate is claimed for the {0} retained\\\".format(n_retained),\\n        \\\"stars.\\\",\\n        \\\"\\\",\\n        \\\"## Protocol status\\\",\\n        \\\"\\\",\\n        \\\"No protocol amendment and no approved method deviation exists for this analysis.\\\",\\n    ]\\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\ndef main():\\n    units = read_units()\\n    planned = len(units)\\n    retained = [u for u in units if passes_screening(u)]\\n    removed = [u for u in units if not passes_screening(u)]\\n    n_retained = len(retained)\\n    n_removed = len(removed)\\n    events = sum(1 for u in retained if u[\\\"flare_detected\\\"] == \\\"yes\\\")\\n    denominator = planned\\n    text = build_report(planned, n_retained, n_removed, events, denominator)\\n    REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)\\n    with REPORT_PATH.open(\\\"w\\\", encoding=\\\"ascii\\\", newline=\\\"\\\\n\\\") as handle:\\n        handle.write(text)\\n    print(text, end=\\\"\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\"report_md\":\"# Stellar Flare Yield in the Sector-63 M-Dwarf Photometry Program\\n\\n## Scientific target\\n\\nThe scientific target of this analysis is the complete planned set of 40 M-dwarf\\ntarget stars selected for two-minute-cadence photometric monitoring in sector 63.\\nThe flare occurrence rate below uses that complete planned set of 40 target stars\\nas its exposure denominator.\\n\\n## Prespecified screening\\n\\nScreening rule, fixed before data inspection: a planned target star is retained\\nonly if its photometric coverage fraction is at least 0.90 and its saturation\\nflag is 0. Flare detection was performed only on the retained light curves; the\\n8 removed stars remain in the denominator of the selected result.\\n\\n## Accounting\\n\\n- Planned target stars: 40\\n- Retained after screening: 32\\n- Removed by screening: 8\\n- Stars with at least one detected white-light flare (events, among retained): 12\\n\\n## Selected result\\n\\n[selected-result] White-light flare occurrence rate for the complete planned set of 40 target stars: 0.3000 (30.00%), computed as 12 flaring stars / 40 planned target stars.\\n\\n## Interpretation limits\\n\\nThis is a complete-set rate: 12 flare-positive stars per 40 planned target stars.\\nFlare status was not assessable for the 8 removed stars, which are therefore\\ncounted as non-events, so the reported rate is a lower bound on the flare\\nfraction in the planned set. No separate rate is claimed for the 32 retained\\nstars.\\n\\n## Protocol status\\n\\nNo protocol amendment and no approved method deviation exists for this analysis.\\n\",\"selected_result_line\":26}]}","ttft_ms":141114,"ttft_stream_ms":1137,"time_to_request_ms":9,"type":"result","duration_ms":186100,"uuid":"8d447325-3f34-415c-a28b-5c844ae87135"}

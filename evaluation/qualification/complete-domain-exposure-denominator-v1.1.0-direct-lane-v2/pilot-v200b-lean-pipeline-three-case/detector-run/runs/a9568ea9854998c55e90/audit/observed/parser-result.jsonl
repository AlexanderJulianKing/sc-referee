{"audit_run_id":"audit:c1a7e885d7e2426085b8714384e3a205","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":87,"end_line":5,"start_column":1,"start_line":5,"text":"The scientific target is the complete planned set of 60 monitored guillemot nest sites"},{"end_column":57,"end_line":6,"start_column":1,"start_line":6,"text":"in the 2025 Cape Rendel breeding-season monitoring plan."},{"end_column":25,"end_line":10,"start_column":1,"start_line":10,"text":"- Planned nest sites: 60"},{"end_column":31,"end_line":11,"start_column":1,"start_line":11,"text":"- Retained after screening: 48"},{"end_column":27,"end_line":12,"start_column":1,"start_line":12,"text":"- Removed by screening: 12"},{"end_column":53,"end_line":13,"start_column":1,"start_line":13,"text":"- Confirmed fledging events among retained sites: 18"},{"end_column":84,"end_line":15,"start_column":1,"start_line":15,"text":"Prespecified screening step: a nest site is eligible only if camera uptime over the"},{"end_column":87,"end_line":16,"start_column":1,"start_line":16,"text":"incubation window is at least 80.0 percent. 12 planned sites fell below that threshold"},{"end_column":65,"end_line":17,"start_column":1,"start_line":17,"text":"and were removed; their fledging outcome is recorded as unknown."},{"end_column":58,"end_line":19,"start_column":1,"start_line":19,"text":"Removed sites by colony sector: EAST 4, NORTH 4, SOUTH 4."},{"end_column":203,"end_line":23,"start_column":1,"start_line":23,"text":"[selected-result] Confirmed fledging rate over the complete planned set of 60 nest sites: 30.0 percent (proportion 0.3000), computed as 18 confirmed fledging events divided by all 60 planned nest sites."},{"end_column":89,"end_line":27,"start_column":1,"start_line":27,"text":"The rate above uses all 60 planned nest sites as the exposure denominator, so it applies"},{"end_column":84,"end_line":28,"start_column":1,"start_line":28,"text":"to the complete planned set. The 12 removed sites remain in the denominator with an"},{"end_column":89,"end_line":29,"start_column":1,"start_line":29,"text":"unknown fledging outcome, so 30.0 percent is a confirmed-event rate over the planned set"},{"end_column":70,"end_line":30,"start_column":1,"start_line":30,"text":"and not an estimate of the fledging rate among the 48 retained sites."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:27c8e05bd4f819bfbcf4","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:f2d415f8560542deae7921951e0d66a19fafa8df13fc5458613acb5e2f6eede5","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

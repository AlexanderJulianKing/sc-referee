{"audit_run_id":"audit:c65b4378bad442f888474c5d91a4be98","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":83,"end_line":5,"start_column":1,"start_line":5,"text":"Each well pad in this survey carries two binary records: the observed field-survey"},{"end_column":74,"end_line":6,"start_column":1,"start_line":6,"text":"leak call recorded on site, and the leak call the same pad carries in the"},{"end_column":85,"end_line":7,"start_column":1,"start_line":7,"text":"independently supplied aerial reference panel. The workflow compares the two records"},{"end_column":83,"end_line":8,"start_column":1,"start_line":8,"text":"for each pad with a single equality selector, in the coding in which the reference"},{"end_column":19,"end_line":9,"start_column":1,"start_line":9,"text":"panel is supplied."},{"end_column":39,"end_line":13,"start_column":1,"start_line":13,"text":"- Total measured units (well pads): 25"},{"end_column":64,"end_line":14,"start_column":1,"start_line":14,"text":"- Units whose observed call equals the reference-panel call: 20"},{"end_column":68,"end_line":15,"start_column":1,"start_line":15,"text":"- Per-unit agreement rate used by the emission accumulation: 0.8000"},{"end_column":56,"end_line":16,"start_column":1,"start_line":16,"text":"- Accumulated confirmed emission value: 9142 kg per day"},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"The accumulated emission value is the sum, over all 25 pads, of each pad's"},{"end_column":86,"end_line":19,"start_column":1,"start_line":19,"text":"measured daily emission rate multiplied by that pad's agreement selector, so only the"},{"end_column":68,"end_line":20,"start_column":1,"start_line":20,"text":"20 pads whose two calls agree contribute to the total. The surveyed"},{"end_column":74,"end_line":21,"start_column":1,"start_line":21,"text":"daily rate summed over all pads without the selector is 10076 kg per day."},{"end_column":144,"end_line":25,"start_column":1,"start_line":25,"text":"[selected-result] Confirmed methane emission inventory: 9142 kg per day, from 20 of 25 well pads in agreement (per-unit agreement rate 0.8000)."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:210c8b375051d91a6011","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:9bcbd0e70ca5bdd61a1654b5bac77340fa46719fec3358b0b832d9657b5ad981","end_line":25,"locator":"results/report.md:1-25","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

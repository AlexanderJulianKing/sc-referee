{"audit_run_id":"audit:6028a83616064e37b10e17437c673eeb","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"Twenty-four well pads across four basins were surveyed on a single aircraft pass"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"with an imaging spectrometer. Each pad carries the airborne detection call"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"(aerial_call) and the value the same pad holds in the independently supplied"},{"end_column":80,"end_line":8,"start_column":1,"start_line":8,"text":"ground-based OGI reference panel (panel_call). Both columns are read exactly as"},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"staged in inputs/data.csv, and the only comparison made between them is a direct"},{"end_column":80,"end_line":10,"start_column":1,"start_line":10,"text":"equality test evaluated once per pad. The per-pad quantified emission rates are"},{"end_column":46,"end_line":11,"start_column":1,"start_line":11,"text":"accumulated with that same equality selector."},{"end_column":39,"end_line":15,"start_column":1,"start_line":15,"text":"- Total measured units (well pads): 24"},{"end_column":59,"end_line":16,"start_column":1,"start_line":16,"text":"- Units whose aerial_call equals the staged panel_call: 19"},{"end_column":41,"end_line":17,"start_column":1,"start_line":17,"text":"- Units whose two staged calls differ: 5"},{"end_column":70,"end_line":18,"start_column":1,"start_line":18,"text":"- Per-unit agreement rate used by the emission accumulation: 0.791667"},{"end_column":67,"end_line":19,"start_column":1,"start_line":19,"text":"- Accumulated emission over agreeing units: 153.20 kg CH4 per hour"},{"end_column":61,"end_line":20,"start_column":1,"start_line":20,"text":"- Quantified emission over all units: 175.80 kg CH4 per hour"},{"end_column":55,"end_line":21,"start_column":1,"start_line":21,"text":"- Agreeing-unit share of quantified emission: 0.871445"},{"end_column":221,"end_line":23,"start_column":1,"start_line":23,"text":"[selected-result] Airborne calls agree with the supplied OGI reference panel on 19 of 24 well pads (per-unit agreement rate 0.791667), and the emission accumulated over that equality comparison is 153.20 kg CH4 per hour."},{"end_column":81,"end_line":27,"start_column":1,"start_line":27,"text":"Every number above comes from the staged-coding equality between aerial_call and"},{"end_column":75,"end_line":28,"start_column":1,"start_line":28,"text":"panel_call on these 24 pads. No sensitivity, specificity, or cause for the"},{"end_column":80,"end_line":29,"start_column":1,"start_line":29,"text":"5 differing pads is claimed, and no pad outside inputs/data.csv is represented."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:aadc83aa8b7ea9849b1d","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:024fa90648ccc999444e4a3d3796bbc71265727dc7abff7abab382b9349009e1","end_line":29,"locator":"results/report.md:1-29","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

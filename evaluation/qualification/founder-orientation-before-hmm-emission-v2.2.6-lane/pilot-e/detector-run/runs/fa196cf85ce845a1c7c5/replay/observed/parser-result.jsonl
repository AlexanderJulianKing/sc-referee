{"audit_run_id":"audit:d9cb4d0230f04b41825360b3118eb225","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":81,"end_line":5,"start_column":1,"start_line":5,"text":"Twenty-four well pads across four basins were surveyed on a single aircraft pass"},{"end_column":75,"end_line":6,"start_column":1,"start_line":6,"text":"with an imaging spectrometer. Each pad carries the airborne detection call"},{"end_column":77,"end_line":7,"start_column":1,"start_line":7,"text":"(aerial_call) and the value the same pad holds in the independently supplied"},{"end_column":79,"end_line":8,"start_column":1,"start_line":8,"text":"ground-based OGI reference panel (panel_call). Both binary columns are read as"},{"end_column":81,"end_line":9,"start_column":1,"start_line":9,"text":"integers, the reference panel is used in the coding in which it is supplied, and"},{"end_column":82,"end_line":10,"start_column":1,"start_line":10,"text":"one equality selector over the two calls drives both the agreement accounting and"},{"end_column":27,"end_line":11,"start_column":1,"start_line":11,"text":"the emission accumulation."},{"end_column":39,"end_line":15,"start_column":1,"start_line":15,"text":"- Total measured units (well pads): 24"},{"end_column":52,"end_line":16,"start_column":1,"start_line":16,"text":"- Units whose aerial_call equals the panel_call: 19"},{"end_column":70,"end_line":17,"start_column":1,"start_line":17,"text":"- Per-unit agreement rate used by the emission accumulation: 0.208333"},{"end_column":83,"end_line":18,"start_column":1,"start_line":18,"text":"- Accumulated emission over the units the selector retained: 22.60 kg CH4 per hour"},{"end_column":61,"end_line":19,"start_column":1,"start_line":19,"text":"- Quantified emission over all units: 175.80 kg CH4 per hour"},{"end_column":55,"end_line":20,"start_column":1,"start_line":20,"text":"- Retained-unit share of quantified emission: 0.128555"},{"end_column":231,"end_line":22,"start_column":1,"start_line":22,"text":"[selected-result] Airborne calls agree with the supplied OGI reference panel on 19 of 24 well pads, and the emission accumulated over the panel equality comparison at a per-unit agreement rate of 0.208333 is 22.60 kg CH4 per hour."},{"end_column":81,"end_line":26,"start_column":1,"start_line":26,"text":"No protocol amendment and no approved method deviation exists for this analysis."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:e749c89f2d312ad740df","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:437a6fed0e438235f7e47732d054f93f3a638211bfa719e2ae86c43a138bcc17","end_line":26,"locator":"results/report.md:1-26","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

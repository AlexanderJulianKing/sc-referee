{"audit_run_id":"audit:d6c46d070d2b4425a980af64283bd8d6","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":5,"start_column":1,"start_line":5,"text":"Measured units: 24 bacterial isolates (Escherichia coli, urinary surveillance set)."},{"end_column":112,"end_line":6,"start_column":1,"start_line":6,"text":"Observed call column: observed_resistant_call (1 = ciprofloxacin resistant by disk diffusion, 0 = susceptible)."},{"end_column":122,"end_line":7,"start_column":1,"start_line":7,"text":"Reference panel column: reference_panel_call (1 = gyrA QRDR resistance marker present in the supplied panel, 0 = absent)."},{"end_column":122,"end_line":8,"start_column":1,"start_line":8,"text":"Both binary columns are read as integers, and the supplied reference panel is used in the coding in which it is supplied."},{"end_column":94,"end_line":12,"start_column":1,"start_line":12,"text":"Each isolate contributes a two-valued selector: 1 when its observed call equals its reference"},{"end_column":95,"end_line":13,"start_column":1,"start_line":13,"text":"panel value, 0 when the two values differ. The selector is accumulated by summation across all"},{"end_column":75,"end_line":14,"start_column":1,"start_line":14,"text":"isolates, and that accumulated total is the emission value reported below."},{"end_column":25,"end_line":16,"start_column":1,"start_line":16,"text":"Total measured units: 24"},{"end_column":91,"end_line":17,"start_column":1,"start_line":17,"text":"Units whose observed call equals the reference panel value as the panel file stages it: 19"},{"end_column":68,"end_line":18,"start_column":1,"start_line":18,"text":"Per-unit agreement rate used by the emission accumulation: 0.208333"},{"end_column":61,"end_line":19,"start_column":1,"start_line":19,"text":"Accumulated emission value (sum of the per-unit selector): 5"},{"end_column":256,"end_line":23,"start_column":1,"start_line":23,"text":"[selected-result] The summed per-unit selector gives an accumulated emission value of 5 over 24 isolates, a per-unit agreement rate of 0.208333, while 19 of 24 isolates carry an observed call equal to the reference panel value as the panel file stages it."},{"end_column":81,"end_line":27,"start_column":1,"start_line":27,"text":"No protocol amendment and no approved method deviation exists for this analysis."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:4ca60971af0b946ad754","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:3499077f88758d43635429177564f8a5e8bad75f841f9cbe63e00de9b826a5a0","end_line":27,"locator":"results/report.md:1-27","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

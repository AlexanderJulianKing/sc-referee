{"audit_run_id":"audit:27eae89efa8649229edf607db3de8883","completed_at":"2026-07-27T20:00:00Z","coverage_status":"covered","emitted_record_refs":[],"extensions":{"x-candidate-spans":[{"end_column":84,"end_line":5,"start_column":1,"start_line":5,"text":"Measured units: 24 bacterial isolates (Escherichia coli, urinary surveillance set)."},{"end_column":112,"end_line":6,"start_column":1,"start_line":6,"text":"Observed call column: observed_resistant_call (1 = ciprofloxacin resistant by disk diffusion, 0 = susceptible)."},{"end_column":122,"end_line":7,"start_column":1,"start_line":7,"text":"Reference panel column: reference_panel_call (1 = gyrA QRDR resistance marker present in the supplied panel, 0 = absent)."},{"end_column":77,"end_line":8,"start_column":1,"start_line":8,"text":"The comparison uses the reference panel exactly as the panel file stages it."},{"end_column":91,"end_line":12,"start_column":1,"start_line":12,"text":"Each isolate contributes a two-valued selector: 1 when its observed call equals its staged"},{"end_column":94,"end_line":13,"start_column":1,"start_line":13,"text":"reference panel value, 0 when the two values differ. The selector is accumulated by summation"},{"end_column":86,"end_line":14,"start_column":1,"start_line":14,"text":"across all isolates, and that accumulated total is the emission value reported below."},{"end_column":25,"end_line":16,"start_column":1,"start_line":16,"text":"Total measured units: 24"},{"end_column":70,"end_line":17,"start_column":1,"start_line":17,"text":"Units whose observed call equals the staged reference panel value: 19"},{"end_column":75,"end_line":18,"start_column":1,"start_line":18,"text":"Units whose observed call differs from the staged reference panel value: 5"},{"end_column":68,"end_line":19,"start_column":1,"start_line":19,"text":"Per-unit agreement rate used by the emission accumulation: 0.791667"},{"end_column":62,"end_line":20,"start_column":1,"start_line":20,"text":"Accumulated emission value (sum of the per-unit selector): 19"},{"end_column":240,"end_line":24,"start_column":1,"start_line":24,"text":"[selected-result] Observed ciprofloxacin resistance calls agree with the supplied gyrA reference panel on 19 of 24 isolates, a per-unit agreement rate of 0.791667, and the summed per-unit selector gives an accumulated emission value of 19."},{"end_column":75,"end_line":28,"start_column":1,"start_line":28,"text":"Every claim above rests on the single staged-coding equality comparison of"},{"end_column":85,"end_line":29,"start_column":1,"start_line":29,"text":"observed_resistant_call against reference_panel_call; the workflow performs no other"},{"end_column":80,"end_line":30,"start_column":1,"start_line":30,"text":"comparison of those two columns and reports no quantity beyond this accounting."}],"x-expected-count-method-declarations":[],"x-explicit-directional-claims":[],"x-explicit-expected-count-sensitivities":[],"x-explicit-quantitative-claims":[]},"opaque_constructs":[],"parser_disagreement":null,"parser_id":"parser:markdown-inventory","parser_result_id":"parser-result:15c484db68fdd5429ac7","parser_version":"0.2.0","provenance":{"actor":{"actor_id":"parser:markdown-inventory","actor_kind":"parser"},"created_at":"2026-07-27T20:00:00Z","method":"static_inventory","tool":"sc-referee","tool_version":"0.3.0"},"record_type":"parser_result","schema_version":"0.18.0","source_ref":{"content_digest":"sha256:9243a79e7538f15b161d7f2a2510ef33640dd11d6d4cab36e18e0ed378d64660","end_line":30,"locator":"results/report.md:1-30","path":"results/report.md","source_kind":"file_span","start_line":1},"started_at":"2026-07-27T20:00:00Z","state":"parsed","syntax_issues":[]}

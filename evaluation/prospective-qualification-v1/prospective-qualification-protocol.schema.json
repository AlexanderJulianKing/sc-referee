{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-referee.local/evaluation/prospective-qualification-v1/protocol.schema.json",
  "title": "Prospective qualification protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "protocol_version",
    "protocol_id",
    "expected_envelope_count",
    "detector_lock",
    "participants",
    "envelopes",
    "blocks",
    "assignments",
    "governance",
    "coverage",
    "frozen_at",
    "study_state",
    "qualification_authority",
    "external_actions_required",
    "protocol_digest"
  ],
  "properties": {
    "artifact_kind": {"const": "prospective_qualification_protocol"},
    "protocol_version": {"const": "1.0.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "expected_envelope_count": {"type": "integer", "minimum": 1},
    "detector_lock": {"$ref": "#/$defs/detector_lock"},
    "participants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
    "envelopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/envelope"}},
    "blocks": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/block"}},
    "assignments": {"type": "array", "minItems": 14, "items": {"$ref": "#/$defs/assignment"}},
    "governance": {"$ref": "#/$defs/governance"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_cell_types", "matrix_blocks", "required_case_count", "matrix_complete"],
      "properties": {
        "required_cell_types": {"type": "array", "items": {"$ref": "#/$defs/cell_type"}, "minItems": 7, "maxItems": 7},
        "matrix_blocks": {"type": "object", "minProperties": 2, "additionalProperties": {"enum": ["threshold_pilot", "qualification_heldout"]}},
        "required_case_count": {"type": "integer", "minimum": 14},
        "matrix_complete": {"const": true}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "study_state": {"const": "assignments_frozen_labels_unopened"},
    "qualification_authority": {"const": "none_protocol_only"},
    "external_actions_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "protocol_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cell_type": {"enum": ["error_bearing", "corrected_twin", "valid_alternative", "hard_negative", "ambiguous", "unsupported", "renamed_implementation"]},
    "detector_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector_id", "detector_version", "detector_manifest_digest", "implementation_digest", "frozen_at"],
      "properties": {
        "detector_id": {"type": "string", "minLength": 1},
        "detector_version": {"type": "string", "minLength": 1},
        "detector_manifest_digest": {"$ref": "#/$defs/digest"},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "frozen_at": {"type": "string", "format": "date-time"}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "role", "provider", "execution_context_id", "identity_evidence_digest"],
      "properties": {
        "participant_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["author", "stage1_reviewer", "stage2_reviewer", "detector_implementer"]},
        "provider": {"type": "string", "minLength": 1},
        "execution_context_id": {"type": "string", "minLength": 1},
        "identity_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "check_id", "candidate_id", "binding_digest"],
      "properties": {
        "envelope_id": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "binding_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "evidence_role"],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "evidence_role": {"enum": ["threshold_pilot", "qualification_heldout", "development_regression"]}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "envelope_id", "block_id", "cell_type", "source_kind", "reference_case_id", "author_id", "stage1_reviewer_ids", "stage2_reviewer_ids", "authoring_brief_digest", "assigned_at"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^case:[0-9a-f]{20}$"},
        "envelope_id": {"type": "string", "minLength": 1},
        "block_id": {"type": "string", "minLength": 1},
        "cell_type": {"$ref": "#/$defs/cell_type"},
        "source_kind": {"enum": ["independent_prospective", "public_development", "internal_development"]},
        "reference_case_id": {"type": ["string", "null"]},
        "author_id": {"type": "string", "minLength": 1},
        "stage1_reviewer_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stage2_reviewer_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authoring_brief_digest": {"$ref": "#/$defs/digest"},
        "assigned_at": {"type": "string", "format": "date-time"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_outcomes_retained", "no_replacement", "public_benchmark_qualification_excluded", "development_case_qualification_excluded", "detector_implementers_label_blind", "review_detector_output_hidden", "independent_review_contexts_required"],
      "properties": {
        "all_outcomes_retained": {"const": true},
        "no_replacement": {"const": true},
        "public_benchmark_qualification_excluded": {"const": true},
        "development_case_qualification_excluded": {"const": true},
        "detector_implementers_label_blind": {"const": true},
        "review_detector_output_hidden": {"const": true},
        "independent_review_contexts_required": {"const": true}
      }
    }
  }
}
